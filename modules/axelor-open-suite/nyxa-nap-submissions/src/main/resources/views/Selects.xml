  <!-- ===== Artifacts & files ===== -->
  <!-- The institution a regulatory file is addressed to. Shared core discriminator: НОИ files are
    stored through the same immutable-artifact path as НАП ones, and this is what tells them apart. -->
  <selection name="nap.institution.select">
    <option value="nap">NAP</option>
    <option value="noi">NOI</option>
  </selection>

  <selection name="nap.artifact.type.select">
    <option value="payload">Payload</option>
    <option value="signed_payload">Signed payload</option>
    <option value="signature">Signature</option>
    <option value="certificate">Certificate</option>
    <option value="response">Response</option>
    <option value="processing_result">Processing result</option>
    <option value="validation_report">Validation report</option>
    <option value="protocol">Protocol</option>
    <option value="schema">Schema</option>
    <option value="other">Other</option>
  </selection>

  <selection name="nap.submission.artifact.role.select">
    <option value="payload">Payload</option>
    <option value="signed_payload">Signed payload</option>
    <option value="signature">Signature</option>
    <option value="response">Response</option>
    <option value="processing_result">Processing result</option>
    <option value="validation_report">Validation report</option>
    <option value="other">Other</option>
  </selection>

  <selection name="nap.file.type.select">
    <option value="txt">txt</option>
    <option value="csv">csv</option>
    <option value="xml">xml</option>
  </selection>

  <selection name="nap.submission.file.status.select">
    <option value="pending">Pending</option>
    <option value="accepted">Accepted</option>
    <option value="rejected">Rejected</option>
    <option value="error">Error</option>
    <option value="unknown">Unknown</option>
  </selection>

  <!-- The EXTERNAL cloud electronic-signature service a personal QES profile signs through. This is
    NOT an Axelor Partner/supplier and is not scoped to a Company: it names which CloudQesProvider
    implementation handles the signing request.

    ⚠️ Each option value MUST stay byte-identical to the corresponding CloudQesProvider
    getProviderId(): QesSigningService refuses to sign when the profile's value does not equal the
    configured provider's id. CloudQesProviderIds holds the same three constants in Java, and
    CloudQesProviderSelectionTest pins this file against them. -->
  <selection name="nap.qes.provider.select">
    <option value="mock">Mock (tests only)</option>
    <option value="btrust">B-Trust</option>
    <option value="evrotrust">Evrotrust</option>
  </selection>

  <!-- Как се подписва подаването: двата реални метода. Нито един не чете частен ключ или PIN в
    Nyxa — USB токенът подписва на машината на потребителя през локалния компонент (BISS), а
    облачният КЕП подписва при доставчика след потвърждение от човека. Стойността `cloud` се запазва
    (исторически редове), а активният облачен доставчик се избира от конфигурацията
    (nyxa.qes.evrotrust.*). -->
  <selection name="nap.qes.signing.method.select">
    <option value="local_usb">USB QES (local component)</option>
    <option value="cloud">Evrotrust (cloud QES)</option>
  </selection>

  <!-- QES signing status of one file. SEPARATE from the НАП processing file-status above: a file can
    be SIGNED (here) and still be REJECTED by НАП (there). Mirrors QesSigningStatus. -->
  <selection name="nap.qes.signing.status.select">
    <option value="not_started">Not started</option>
    <option value="pending">Pending</option>
    <option value="completed">Completed</option>
    <option value="rejected">Rejected</option>
    <option value="failed">Failed</option>
    <option value="expired">Expired</option>
  </selection>

