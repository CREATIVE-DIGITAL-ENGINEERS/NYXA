<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">

  <!-- The persistence unit AiChatTranscriptJpaTest runs against: HSQLDB in memory, schema created from
    the same generated entities the WAR uses, so a unique constraint that exists here exists in PostgreSQL
    too. Connection settings come from src/test/resources/axelor-config.properties, which is where JpaModule
    reads them. Test scope only. -->
  <persistence-unit name="testUnit" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <exclude-unlisted-classes/>
  </persistence-unit>
</persistence>
