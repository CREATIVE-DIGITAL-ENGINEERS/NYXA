<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views
    http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

  <grid name="bg-vat-annual-correction-grid" title="Годишни корекции (чл. 79а/79б ЗДДС)"
    model="com.axelor.apps.bglocalization.db.BgVatAnnualCorrection">
    <field name="company"/>
    <field name="year"/>
    <field name="statusSelect"/>
    <field name="vatReturn"/>
  </grid>

  <form name="bg-vat-annual-correction-form" title="Годишна корекция (чл. 79а/79б ЗДДС)"
    model="com.axelor.apps.bglocalization.db.BgVatAnnualCorrection" onNew="action-bg-vat-annual-correction-defaults">

    <panel name="mainPanel" title="Период" colSpan="12">
      <field name="company" colSpan="4"/>
      <field name="year" colSpan="4"
        help="Календарната година, ПРЕЗ КОЯТО е настъпило изменението в използването (чл. 79а ал. 1). Корекцията се отразява в последния данъчен период на тази година."/>
      <field name="statusSelect" colSpan="4" readonly="true"/>
      <field name="vatReturn" colSpan="6"
        help="Данъчният период, който носи протоколите. По подразбиране декември. ППЗДДС чл. 66 ал. 10 го мести при дерегистрация: тогава последен данъчен период е онзи, за който възникват задълженията по чл. 111."/>
    </panel>

    <panel name="actionPanel" colSpan="12">
      <button name="proposeBtn" title="Предложи редове"
        onClick="save,action-bg-vat-annual-correction-propose" readonlyIf="statusSelect == 'CONFIRMED'"/>
      <button name="recomputeBtn" title="Преизчисли"
        onClick="save,action-bg-vat-annual-correction-recompute" readonlyIf="statusSelect == 'CONFIRMED'"/>
      <button name="confirmBtn" title="Потвърди и състави протоколи"
        onClick="save,action-bg-vat-annual-correction-confirm" readonlyIf="statusSelect == 'CONFIRMED'"/>
    </panel>

    <panel-related name="linePanel" field="bgVatAnnualCorrectionLineList" colSpan="12"
      form-view="bg-vat-annual-correction-line-form" grid-view="bg-vat-annual-correction-line-grid"
      canNew="false" canRemove="false"/>

    <panel name="boundaryPanel" title="Граници на изведеното" colSpan="12" collapseIf="true">
      <field name="bgBoundaryReport" showTitle="false" colSpan="12" readonly="true"/>
      <field name="comments" colSpan="12"/>
    </panel>

  </form>

  <action-record name="action-bg-vat-annual-correction-defaults"
    model="com.axelor.apps.bglocalization.db.BgVatAnnualCorrection">
    <field name="statusSelect" expr="eval: 'DRAFT'"/>
  </action-record>

  <action-method name="action-bg-vat-annual-correction-propose">
    <call class="com.axelor.apps.bglocalization.web.BgVatAnnualCorrectionController"
      method="propose"/>
  </action-method>

  <action-method name="action-bg-vat-annual-correction-recompute">
    <call class="com.axelor.apps.bglocalization.web.BgVatAnnualCorrectionController"
      method="recompute"/>
  </action-method>

  <action-method name="action-bg-vat-annual-correction-confirm">
    <call class="com.axelor.apps.bglocalization.web.BgVatAnnualCorrectionController"
      method="confirm"/>
  </action-method>

  <action-view name="action-bg-vat-annual-correction-view"
    title="Годишни корекции (чл. 79а/79б)"
    model="com.axelor.apps.bglocalization.db.BgVatAnnualCorrection">
    <view type="grid" name="bg-vat-annual-correction-grid"/>
    <view type="form" name="bg-vat-annual-correction-form"/>
  </action-view>

</object-views>
