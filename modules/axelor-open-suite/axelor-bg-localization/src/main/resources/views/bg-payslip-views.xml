  <action-method name="action-bg-payslip-print">
    <call class="com.axelor.apps.bglocalization.web.BgPaySlipController" method="print"/>
  </action-method>

  <action-method name="action-bg-payslip-confirm">
    <call class="com.axelor.apps.bglocalization.web.BgPaySlipController" method="confirm"/>
  </action-method>

  <action-method name="action-bg-payslip-pay">
    <call class="com.axelor.apps.bglocalization.web.BgPaySlipController" method="pay"/>
