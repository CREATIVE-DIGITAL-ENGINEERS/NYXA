  </action-method>

  <action-view name="bg.payslip.all" title="Фишове"
    model="com.axelor.apps.bglocalization.db.BgPaySlip">
    <view type="grid" name="bg-payslip-grid"/>
    <view type="form" name="bg-payslip-form"/>
  </action-view>

</object-views>
