                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">status_select</property>
                    <expression name="expression" type="javascript">(function(s){if(s=="DRAFT"){return "\u0427\u0415\u0420\u041d\u041e\u0412\u0410";}if(s=="CONFIRMED"){return "\u041f\u043e\u0442\u0432\u044a\u0440\u0434\u0435\u043d";}if(s=="PAID"){return "\u0418\u0437\u043f\u043b\u0430\u0442\u0435\u043d";}return s==null?"":s;})(dataSetRow["status_select"])</expression>
                    <property name="dataType">string</property>
                </structure>
