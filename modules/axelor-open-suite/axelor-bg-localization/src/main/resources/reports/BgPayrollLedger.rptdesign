                </structure>
                <structure>
                    <property name="name">names</property>
                    <expression name="expression" type="javascript">(function(a,b,c){var p=[a,b,c];var o=[];for(var i=0;i&lt;p.length;i++){if(p[i]!=null&amp;&amp;String(p[i]).length&gt;0){o.push(p[i]);}}return o.join(" ");})(dataSetRow["first_name"], dataSetRow["middle_name"], dataSetRow["last_name"])</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">personal_id_full</property>
                    <expression name="expression" type="javascript">(function(t,n){if(n==null||String(n).trim().length==0){return "";}var k=String(t).trim()=="1"?"ЕГН ":(String(t).trim()=="2"?"ЛНЧ ":"");return k+String(n).trim();})(dataSetRow["personal_id_type"], dataSetRow["personal_id"])</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">insured_type_code</property>
