                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">mismatch_note</property>
                    <expression name="expression" type="javascript">(function(){ var n = function(v){return v==null?0:parseFloat(String(v));}; if ((Math.abs(n(row["sum_gross_total"]) - n(params["CheckGross"])) &gt; 0.004) || (Math.abs(n(row["sum_employee_contributions"]) - n(params["CheckEmployeeContributions"])) &gt; 0.004) || (Math.abs(n(row["sum_tax_amount"]) - n(params["CheckTax"])) &gt; 0.004) || (Math.abs(n(row["sum_advance_amount"]) - n(params["CheckAdvance"])) &gt; 0.004) || (Math.abs(n(row["sum_deductions"]) - n(params["CheckDeductions"])) &gt; 0.004) || (Math.abs(n(row["sum_net_total"]) - n(params["CheckNet"])) &gt; 0.004) || (Math.abs(n(row["sum_employer_contributions"]) - n(params["CheckEmployerContributions"])) &gt; 0.004) || (Math.abs(n(row["sum_employer_cost"]) - n(params["CheckEmployerCost"])) &gt; 0.004)) { return "(!) \u0420\u0410\u0417\u041c\u0418\u041d\u0410\u0412\u0410\u041d\u0415 \u043c\u0435\u0436\u0434\u0443 \u0441\u0431\u043e\u0440\u0430 \u043d\u0430 \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u0430\u043d\u0438\u0442\u0435 \u0440\u0435\u0434\u043e\u0432\u0435 \u0438 \u0441\u0443\u043c\u0438\u0442\u0435, \u0441\u043c\u0435\u0442\u043d\u0430\u0442\u0438 \u043e\u0442 \u043f\u0435\u0440\u0430\u0442\u0430 \u043d\u0430 \u0444\u0438\u0448\u043e\u0432\u0435\u0442\u0435. \u041b\u0438\u0441\u0442\u044a\u0442 \u041d\u0415 \u0421\u0415 \u041f\u041e\u0414\u041f\u0418\u0421\u0412\u0410 \u0432 \u0442\u043e\u0432\u0430 \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435."; } return ""; })()</expression>
                    <property name="dataType">string</property>
                </structure>
