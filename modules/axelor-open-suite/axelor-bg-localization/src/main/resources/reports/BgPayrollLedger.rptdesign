            <xml-property name="queryText"><![CDATA[select
slip.reference as slip_reference,
person.first_name as first_name,
person.bg_middle_name as middle_name,
person.name as last_name,
employee.bg_personal_id_number as personal_id,
employee.bg_personal_id_type as personal_id_type,
coalesce(registration.bg_insured_type_code, contract.bg_insured_type_code) as insured_type_code,
slip.status_select as status_select,
slip.bg_worked_days as worked_days,
slip.bg_gross_total as gross_total,
coalesce(employee_side.amount, 0.00) as employee_contributions,
slip.bg_tax_amount as tax_amount,
coalesce(advance_side.amount, 0.00) as advance_amount,
coalesce(deduction_side.amount, 0.00) as deductions,
slip.bg_net_total as net_total,
coalesce(employer_side.amount, 0.00) as employer_contributions,
slip.bg_employer_cost as employer_cost
from bglocalization_bg_pay_slip as slip
left join hr_employment_contract as contract on (contract.id = slip.employment_contract)
left join bglocalization_bg_self_insured_registration as registration on (registration.id = slip.bg_self_insured_registration)
left join hr_employee as employee on (employee.id = coalesce(contract.employee, registration.employee))
left join base_partner as person on (person.id = employee.contact_partner)
left join (select line.pay_slip as pay_slip, sum(line.bg_amount) as amount from bglocalization_bg_pay_slip_line as line where line.bg_corrects_period is null and line.bg_sign = 'DEBIT' and line.bg_line_number / 100 = 5 group by line.pay_slip) as employee_side on (employee_side.pay_slip = slip.id)
left join (select line.pay_slip as pay_slip, sum(line.bg_amount) as amount from bglocalization_bg_pay_slip_line as line where line.bg_sign = 'CREDIT' and line.bg_line_number / 100 = 5 group by line.pay_slip) as employer_side on (employer_side.pay_slip = slip.id)
left join (select line.pay_slip as pay_slip, sum(line.bg_amount) as amount from bglocalization_bg_pay_slip_line as line where line.bg_corrects_period is null and line.bg_sign = 'DEBIT' and (line.bg_line_number = 600 or line.bg_line_number = 610) group by line.pay_slip) as advance_side on (advance_side.pay_slip = slip.id)
left join (select line.pay_slip as pay_slip, sum(line.bg_amount) as amount from bglocalization_bg_pay_slip_line as line where line.bg_sign = 'DEBIT' and line.bg_line_number / 100 = 8 group by line.pay_slip) as deduction_side on (deduction_side.pay_slip = slip.id)
where slip.id::varchar = any(string_to_array(?, ','))
order by array_position(string_to_array(?, ','), slip.id::varchar)]]></xml-property>
        </oda-data-set>
    </data-sets>
