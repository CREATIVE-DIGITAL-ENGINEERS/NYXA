    <body>
        <label id="1029">
            <property name="style">title</property>
            <text-property name="text">РАЗЧЕТНО-ПЛАТЕЖНА ВЕДОМОСТ</text-property>
        </label>
        <text id="1030">
            <property name="style">note</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>params["VariantLabel"]</value-of>]]></text-property>
        </text>
        <text id="1031">
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>((params["CompanyName"] + "").length ? params["CompanyName"] + "   \u00b7   \u0415\u0418\u041a: " + params["CompanyIdNumber"] : "\u0412\u0441\u0438\u0447\u043a\u0438 \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0430 (\u043f\u043e\u043b\u0435\u0442\u043e \u201e\u0414\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u043e\u201c \u0435 \u043f\u0440\u0430\u0437\u043d\u043e)")</value-of>]]></text-property>
        </text>
        <text id="1032">
            <property name="contentType">html</property>
