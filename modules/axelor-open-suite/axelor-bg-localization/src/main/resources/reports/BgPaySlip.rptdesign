                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">tax_amount</property>
                    </data>
                </cell>
                <cell id="4147">
                    <property name="style">note</property>
                    <label id="4148">
                        <text-property name="text">ЗДДФЛ чл. 42.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4156">
                <cell id="4150">
                    <property name="style">totlbl</property>
                    <label id="4151">
                        <text-property name="text">НЕТО ЗА ПОЛУЧАВАНЕ</text-property>
                    </label>
                </cell>
                <cell id="4152">
                    <property name="style">total</property>
                    <data id="4153">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">net_total</property>
                                <expression name="expression" type="javascript">dataSetRow["net_total"]</expression>
                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">net_total</property>
                    </data>
                </cell>
                <cell id="4154">
                    <property name="style">note</property>
                    <label id="4155">
                        <text-property name="text">Всичко начислено минус всичко удържано. Вноските на работодателя НЕ участват.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4159">
                <cell id="4157">
                    <property name="style">section</property>
                    <property name="colSpan">3</property>
                    <label id="4158">
                        <text-property name="text">За сметка на работодателя — НЕ е доход и НЕ е удръжка на лицето</text-property>
                    </label>
                </cell>
            </row>
            <row id="4166">
                <cell id="4160">
                    <property name="style">lbl</property>
