                    </data>
                </cell>
                <cell id="4164">
                    <property name="style">note</property>
                    <label id="4165">
                        <text-property name="text">Перата от 5xx със знак „начислено“.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4173">
                <cell id="4167">
                    <property name="style">lbl</property>
                    <label id="4168">
                        <text-property name="text">Разход за работодателя</text-property>
                    </label>
                </cell>
                <cell id="4169">
                    <property name="style">val</property>
                    <data id="4170">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">employer_cost</property>
                                <expression name="expression" type="javascript">dataSetRow["employer_cost"]</expression>
                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">employer_cost</property>
                    </data>
                </cell>
                <cell id="4171">
                    <property name="style">note</property>
                    <label id="4172">
                        <text-property name="text">Бруто плюс вноските за негова сметка.</text-property>
                    </label>
                </cell>
            </row>
        </grid>
        <text id="4178">
            <property name="style">warn</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of format="html">(params["ReconciliationReport"] + "").length ? "(!) СВЕРКАТА НЕ ИЗЛИЗА — хартията и перата твърдят различни неща:<br/>" + (params["ReconciliationReport"] + "").replace(/\n/g, "<br/>") : ""</value-of>]]></text-property>
        </text>
        <label id="4179">
            <property name="style">note</property>
            <text-property name="text">Числата на този лист са ПРОЧЕТЕНИ от фиша, не изчислени от отчета. Празна клетка значи непопълнена стойност, а не нула; перо с неразпознат знак излиза с предупреждение и НЕ влиза в нито един тотал. Разпечатка на ЧЕРНОВА не е окончателна — черновата се мени.</text-property>
        </label>
        <text id="4180">
            <property name="style">note</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>"Разпечатан на " + params["GenDate"]</value-of>]]></text-property>
        </text>
        <grid id="4191">
            <property name="style">report</property>
            <property name="width">100%</property>
            <column id="4188"><property name="width">33%</property></column>
            <column id="4189"><property name="width">33%</property></column>
            <column id="4190"><property name="width">34%</property></column>
            <row id="4187">
                <cell id="4181">
                    <property name="style">signlbl</property>
                    <label id="4182">
                        <text-property name="text">Изготвил: ................................</text-property>
                    </label>
                </cell>
                <cell id="4183">
                    <property name="style">signlbl</property>
                    <label id="4184">
                        <text-property name="text">Работодател: ................................</text-property>
                    </label>
                </cell>
                <cell id="4185">
