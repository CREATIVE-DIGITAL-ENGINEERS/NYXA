            <property name="style">report</property>
            <property name="width">100%</property>
            <column id="4174"><property name="width">42%</property></column>
            <column id="4175"><property name="width">18%</property></column>
            <column id="4176"><property name="width">40%</property></column>
            <row id="4121">
                <cell id="4115">
                    <property name="style">lbl</property>
                    <label id="4116">
                        <text-property name="text">БРУТО (начислено)</text-property>
                    </label>
                </cell>
                <cell id="4117">
                    <property name="style">val</property>
                    <data id="4118">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">gross_total</property>
                                <expression name="expression" type="javascript">dataSetRow["gross_total"]</expression>
                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">gross_total</property>
                    </data>
                </cell>
                <cell id="4119">
                    <property name="style">note</property>
                    <label id="4120">
                        <text-property name="text">Перата от 1xx и 9xx със знак „начислено“.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4128">
                <cell id="4122">
                    <property name="style">lbl</property>
                    <label id="4123">
                        <text-property name="text">Осигурителен доход</text-property>
                    </label>
                </cell>
                <cell id="4124">
                    <property name="style">val</property>
                    <data id="4125">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">insurance_income</property>
                                <expression name="expression" type="javascript">dataSetRow["insurance_income"]</expression>
                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">insurance_income</property>
                    </data>
                </cell>
                <cell id="4126">
                    <property name="style">note</property>
                    <label id="4127">
                        <text-property name="text">След МОД и максималния осигурителен доход — затова може да се различава от брутото.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4135">
                <cell id="4129">
                    <property name="style">lbl</property>
                    <label id="4130">
                        <text-property name="text">Вноски за сметка на ЛИЦЕТО</text-property>
                    </label>
                </cell>
                <cell id="4131">
                    <property name="style">val</property>
                    <data id="4132">
                        <list-property name="boundDataColumns">
