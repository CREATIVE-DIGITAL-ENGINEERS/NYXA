            <property name="style">report</property>
            <property name="width">7.25in</property>
            <property name="dataSet">Lines</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">num</property>
                    <expression name="expression" type="javascript">dataSetRow["line_number"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">nm</property>
                    <expression name="expression" type="javascript">dataSetRow["line_name"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">sg</property>
                    <expression name="expression" type="javascript">(function(s){return s=="CREDIT"?"начислено":(s=="DEBIT"?"удържано":(s==null||s==""?"(!) без знак":"(!) "+s))})(dataSetRow["sign"])</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">qty</property>
                    <expression name="expression" type="javascript">dataSetRow["quantity"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">rt</property>
                    <expression name="expression" type="javascript">dataSetRow["rate"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">amt</property>
                    <expression name="expression" type="javascript">dataSetRow["amount"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">fl</property>
                    <expression name="expression" type="javascript">(function(p,t,i,s,n){var o=[];if(p!=null)o.push("за минал период");var g=Math.floor(n/100);if(s=="CREDIT"&amp;&amp;(g==1||g==9)){if(t!=true)o.push("необлагаемо");if(i!=true)o.push("извън ос. доход");}return o.join(", ")})(dataSetRow["corrects_period"],dataSetRow["is_taxable"],dataSetRow["is_insurance_income"],dataSetRow["sign"],dataSetRow["line_number"])</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
