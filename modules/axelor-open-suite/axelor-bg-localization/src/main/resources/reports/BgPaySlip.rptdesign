                        </list-property>
                        <structure name="numberFormat">
                            <property name="category">Fixed</property>
                            <property name="pattern">#,##0.00</property>
                        </structure>
                        <property name="resultSetColumn">employeeContributions</property>
                    </data>
                </cell>
                <cell id="4133">
                    <property name="style">note</property>
                    <label id="4134">
                        <text-property name="text">Перата от 5xx със знак „удържано“ — КСО чл. 6 ал. 3.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4142">
                <cell id="4136">
                    <property name="style">lbl</property>
                    <label id="4137">
                        <text-property name="text">Данъчна основа</text-property>
                    </label>
                </cell>
                <cell id="4138">
                    <property name="style">val</property>
                    <data id="4139">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">tax_base</property>
                                <expression name="expression" type="javascript">dataSetRow["tax_base"]</expression>
                                <property name="dataType">decimal</property>
                            </structure>
                        </list-property>
                            <structure name="numberFormat">
                                <property name="category">Fixed</property>
                                <property name="pattern">#,##0.00</property>
                            </structure>
                        <property name="resultSetColumn">tax_base</property>
                    </data>
                </cell>
                <cell id="4140">
                    <property name="style">note</property>
                    <label id="4141">
                        <text-property name="text">Облагаемите начисления минус личните вноски (ЗДДФЛ чл. 42 ал. 2), след облекченията по ал. 3.</text-property>
                    </label>
                </cell>
            </row>
            <row id="4149">
                <cell id="4143">
                    <property name="style">lbl</property>
                    <label id="4144">
                        <text-property name="text">Данък върху доходите (ДОД)</text-property>
                    </label>
                </cell>
                <cell id="4145">
                    <property name="style">val</property>
                    <data id="4146">
                        <property name="dataSet">Slip</property>
                        <list-property name="boundDataColumns">
                            <structure>
                                <property name="name">tax_amount</property>
