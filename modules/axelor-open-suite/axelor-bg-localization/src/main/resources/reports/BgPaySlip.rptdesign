    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Slip" id="24">
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">BgPaySlipId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">reference</property>
                    <property name="nativeName">reference</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">working_days</property>
                    <property name="nativeName">working_days</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">worked_days</property>
                    <property name="nativeName">worked_days</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">base_salary</property>
                    <property name="nativeName">base_salary</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">gross_total</property>
                    <property name="nativeName">gross_total</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">insurance_income</property>
                    <property name="nativeName">insurance_income</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">tax_base</property>
                    <property name="nativeName">tax_base</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">tax_amount</property>
                    <property name="nativeName">tax_amount</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">net_total</property>
                    <property name="nativeName">net_total</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">employer_cost</property>
                    <property name="nativeName">employer_cost</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">paid_date</property>
                    <property name="nativeName">paid_date</property>
                    <property name="dataType">date</property>
                    <property name="nativeDataType">91</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select reference, bg_working_days_in_period as working_days, bg_worked_days as worked_days, bg_base_salary as base_salary, bg_gross_total as gross_total, bg_insurance_income as insurance_income, bg_tax_base as tax_base, bg_tax_amount as tax_amount, bg_net_total as net_total, bg_employer_cost as employer_cost, bg_paid_date as paid_date
from bglocalization_bg_pay_slip
where id = ?]]></xml-property>
        </oda-data-set>
