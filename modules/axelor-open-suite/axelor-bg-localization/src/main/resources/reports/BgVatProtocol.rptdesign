<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Nyxa BG localization (ДДС · протокол по чл. 117 ЗДДС)</property>
    <property name="units">in</property>
    <text-property name="description"><![CDATA[Печатна форма на протокола по чл. 117 ЗДДС (ВОП, услуга по чл. 82, чл. 163а, внос по чл. 167а). Законен образец няма — законът изброява реквизитите (ал. 2 т. 1–10), затова всеки ред носи номера на точката. ⚠️ БЕЗ НАБОР ДАННИ ОТ БАЗАТА: всичко е параметър от BgVatProtocolPrint.params(), вече форматирано — номерът, датата, основата и данъкът са тези на реда в PRODAGBI/POKUPKI. Редовете на т. 3 идват през скриптовия набор Items от параметъра ItemsData (ред на ред, полета с табулация). ⚠️ В CDATA на скриптовете няма entity-та и няма знаци за сравнение.]]></text-property>
