<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Nyxa BG localization (WS-D)</property>
    <property name="units">in</property>
    <parameters>
        <!-- ⚠️ БЕЗ ЕДНО `isRequired=false` ПРАЗНИЯТ НИЗ ПОВАЛЯ ЦЕЛИЯ ОТЧЕТ. BIRT смята скаларния
            параметър за ЗАДЪЛЖИТЕЛЕН по подразбиране (ROM 4.4.2: <Default>true</Default>) и хвърля
            ParameterValidationException („Required parameter … is blank“) още преди първата
            заявка — тоест не се отпечатва празна клетка, а не се отпечатва НИЩО.

            А празното тук е НОРМАЛНО състояние, не повреда: адресът на регистрираното лице се
            снима само при onChange на дружество/период и само ако партньорът вече има mainAddress;
            името и качеството на декларатора са празни, докато декларацията не е генерирана;
            четирите параметъра за връзка с базата са ЗАВАРЕНИ (наборите данни ползват
            PASS_IN_CONNECTION, а odaURL по-долу е закован), а db.default.password е празен на
            всяка инсталация с trust/peer автентикация.

            Същото важи и за BgPaySlip.rptdesign и BgPayrollLedger.rptdesign.

            ⚠️ BgVatReturnId и GenDate НАРОЧНО остават задължителни. Те се изчисляват на всяко
            извикване и липсата им не е „непопълнени данни“, а счупен извикващ: декларация без
            номер на запис би се отпечатала ПРАЗНА, но валидна на вид. По-добре да падне. -->
        <scalar-parameter name="BgVatReturnId" id="1000">
            <property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="dataType">decimal</property>
            <property name="distinct">true</property>
