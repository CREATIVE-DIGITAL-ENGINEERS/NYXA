<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Nyxa BG localization (блок Ф · Декларация обр. 6)</property>
    <property name="units">in</property>
    <text-property name="description"><![CDATA[Печатен образец на Декларация обр. № 6 по Приложение № 4 към чл. 2 ал. 2 на Наредба Н-13. ⚠️ ЕДИН РЕД ЗА ЦЯЛОТО ДРУЖЕСТВО, а не по едно на лице — затова оформлението е ФОРМУЛЯР, а не таблица, и всяка стойност е вързана поотделно към набора данни (същият идиом като BgVatDeclaration.rptdesign). ⚠️ ИМЕНАТА НА КОЛОНИТЕ СА ИЗВЕДЕНИ, НЕ НАПИСАНИ: Axelor слага долна черта САМО когато главната буква стои МЕЖДУ две малки (PhysicalNamingStrategyImpl), тоест t10Doo дава t10doo, а t17AdvanceTax дава t17advance_tax. Заявката чете действителните имена и им дава псевдоними; сверява се машинно в BgReportQueryColumnTest. ⚠️ Хартиеният носител е РАЗРЕШЕН по чл. 8 ал. 1 т. 1 — този отчет е пълноценен изход, не заместител на файла.]]></text-property>
