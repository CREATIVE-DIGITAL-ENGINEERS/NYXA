    <body>
        <label id="3009">
            <property name="style">title</property>
            <text-property name="text">ДЕКЛАРАЦИЯ ОБРАЗЕЦ № 6</text-property>
        </label>
        <label id="3010">
            <property name="style">subtitle</property>
            <text-property name="text">„Данни за дължими вноски и данък по чл. 41а и/или чл. 42 от Закона за данъците върху доходите на физическите лица“</text-property>
        </label>
        <label id="3011">
            <property name="style">note</property>
            <text-property name="text">Приложение № 4 към чл. 2, ал. 2 от Наредба № Н-13 от 17.12.2019 г.   ·   Входящ № ................. / ................. г. (попълва се от приходната администрация)</text-property>
        </label>
        <text id="3012">
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>params["CompanyName"] + "   ·   ЕИК по БУЛСТАТ: " + params["CompanyIdNumber"] + "   ·   т. 9 Месец и година: " + params["PeriodLabel"]</value-of>]]></text-property>
        </text>
