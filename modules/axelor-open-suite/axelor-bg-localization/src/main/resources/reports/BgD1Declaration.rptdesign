        <text id="2103">
            <property name="style">warn</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>params["RefusalReport"].value ? "ОТКАЗАНИ ФИШОВЕ (НЕ са в тази декларация):<br/>" + String(params["RefusalReport"].value).replace(/\n/g, "<br/>") : ""</value-of>]]></text-property>
        </text>
        <label id="2104">
            <property name="style">note</property>
            <text-property name="text">Тази РАЗПЕЧАТКА съдържа т. 1–7, 12, 12.1, 12.3, 21, 22, 22.1, 22.2, 23, 25, 26, 30, 31а и 34. Извън нея остават т. 16 и кофите ѝ, т. 17/18, т. 27/28, т. 29, т. 31, т. 12.2 и т. 13 — те ИМАТ носител на записа и излизат във файла, но не се печатат тук: редът не носи двайсет колони четимо. Празната т. 34 НЕ е сметната нула — за 20-те кода на забележката към т. 34 точката не се полага, а трите други празни изхода са назовани в „Проверки“.</text-property>
        </label>
        <text id="2105">
            <property name="style">note</property>
            <property name="contentType">html</property>
            <text-property name="content"><![CDATA[<value-of>"Разпечатана на " + params["GenDate"] + "   ·   Декларатор: " + params["DeclarantNames"]</value-of>]]></text-property>
        </text>
