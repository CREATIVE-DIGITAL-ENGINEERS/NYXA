            <xml-property name="queryText"><![CDATA[select t1correction_code as t1_correction_code, t2month as t2_month, t3year as t3_year, t5personal_id as t5_personal_id, t51personal_id_code as t51_personal_id_code, t6surname as t6_surname, t7initials as t7_initials, t12insured_type_code as t12_insured_type_code, t121qualification_group as t121_qualification_group, t123activity_row as t123_activity_row, t21insurance_income as t21_insurance_income, t22doo_rate_employer as t22_doo_rate_employer, t22doo_rate_insured as t22_doo_rate_insured, t221health_rate_employer as t221_health_rate_employer, t221health_rate_insured as t221_health_rate_insured, t222tzpb_rate as t222_tzpb_rate, t23teacher_pf_rate as t23_teacher_pf_rate, t25ppf_rate as t25_ppf_rate, t26upf_rate_employer as t26_upf_rate_employer, t26upf_rate_insured as t26_upf_rate_insured, t30gvrs_rate as t30_gvrs_rate, t31a_tax as t31a_tax, t34net_pay as t34_net_pay
from bglocalization_bg_d1_record
where bgd1declaration = ?
order by t6surname, t5personal_id]]></xml-property>
        </oda-data-set>
