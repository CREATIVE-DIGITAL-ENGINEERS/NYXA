        <scalar-parameter name="RefusalReport" id="1006">
            <property name="hidden">true</property>
            <!-- ⚠️ БЕЗ isRequired=false ПРАЗНИЯТ НИЗ ПОВАЛЯ ЦЕЛИЯ ПЕЧАТ:
                BIRT смята скаларния параметър за задължителен по подразбиране и хвърля
                ParameterValidationException „Required parameter RefusalReport is blank“ преди
                първата заявка. А празният доклад за откази е НОРМАЛНОТО състояние — декларация
                без нито един отказан фиш. Същото важи за името, ЕИК-а, периодите и декларатора. -->
            <property name="isRequired">false</property>
