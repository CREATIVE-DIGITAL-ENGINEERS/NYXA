  <!-- Официални празници (България) — контейнер; namespaced importId, за да не се засича с base EventsPlanning
    (importId=1). -->
  <input file="bg_eventsPlanning.csv" separator=";"
    type="com.axelor.apps.base.db.EventsPlanning" search="self.importId = :importId"/>

  <!-- Празнични дни 2026 (изместените дати по чл.154 ал.2 КТ; ISO дати). -->
  <input file="bg_eventsPlanningLine.csv" separator=";"
    type="com.axelor.apps.base.db.EventsPlanningLine" search="self.importId = :importId"/>

  <!-- ШАБЛОНЪТ ЗА РЕГИСТРАЦИОНЕН НОМЕР НА БЪЛГАРИЯ — един ред, който решава наведнъж ВИДИМОСТТА на siren/nic
    и ЕТИКЕТА на registrationCode. Без шаблон за БГ това не е липса на настройка, а видим дефект: PartnerRegistrationCodeViewServiceImpl#isSirenHidden
    връща `isIndividual` при липсващ шаблон (ред 51-53), тоест false за ФИРМА — а в partner-form двете полета
    стоят статично hidden="true" и се ОТСКРИВАТ от onLoad-а. Затова екранен extend с hidden не помага: той
    мени базовата стойност, която контролерът презаписва след зареждането на изгледа. useSiren=false и useNic=false
    обръщат същия израз на true и полетата остават скрити. ⚠️ useTaxNbr=true НЕ Е „включи ДДС номера“, а
    ЕДИНСТВЕНАТА неутрална стойност. isTaxNbrHidden смята `!useTaxNbr || (!isCustomer && !isSupplier)`: при
    true клаузата за клиент/доставчик остава такава, каквато е днес; при false (или при празна колона — генерираните
    Boolean getter-и връщат FALSE, не null) taxNbr изчезва за БГ ЗАВИНАГИ. Тоест пропуснатата колона тук
    е регрес, а не подразбиране. ⚠️ validationMethodSelect е ПРАЗЕН НАРОЧНО, и това е решение, а не недовършена
    работа. Три измерени причини: (1) requiredSize е ЕДНО число, а проверката е точно равенство (RegistrationNumberValidator:84),
    докато ЕИК по ЗРБУЛСТАТ чл. 6 е 9-значен за юридическите лица и 13-значен за клоновете по чл. 3 ал. 1
    т. 8 — каквото и число да сложим, половината законни кодове стават „невалидни“; (2) setRegistrationCodeValidationValues
    ЗАПИСВА, не само проверява — ред 110 презаписва taxNbr от getTaxNbrFromRegistrationCode при всяка промяна
    на кода, а за България ДДС регистрацията е правен статут, а НЕ производна на ЕИК, тоест валидатор, който
    върне null, би ИЗТРИВАЛ ръчно въведени ДДС номера; (3) OCR приемът на доставчици също минава през същата
    фабрика (SupplierMaintenanceService:1100) и би започнал да предупреждава върху всеки чуждестранен код.
    Празен → фабриката връща null → цялата валидация е изключена, а видимостта и етикетът минават по ДРУГ
    сервиз (PartnerRegistrationCodeViewService) и работят без валидатор. Собствен BGR валидатор с двете дължини
    е отделна задача. ⚠️ importId-ът е ИМЕНУВАН (RNT-BG), не число — по прецедента на редиците SEQ-BG-… (виж
    бележката по-горе). Номерата в това пространство ги раздава axelor-base (Франция държи „1“) и всяко число
    оттам насетне е чужда територия. ⚠️ requiredSize, sirenPos И nicPos СА ЗАДЪЛЖИТЕЛНИ КОЛОНИ, ВЪПРЕКИ ЧЕ
    СА ИНЕРТНИ — НЕ ГИ МАХАЙ. В домейна на axelor-base и трите са `<integer … min="1"/>`, а генераторът прави
    ДВЕ неща наведнъж: слага `@Min(1)` И инициализира полето на `0` (RegistrationNumberTemplate:59-92). Тоест
    пропусната колона НЕ оставя null (който Bean Validation щеше да прескочи), а оставя НУЛА — и записът
    пада с „Constraint violation: must be greater than or equal to 1“ по трите полета наведнъж. Синкът тръгва,
    файлът се намира, редът се парсва правилно, и точно тук пада — а `CSVImporter.run()` лови ПО ФАЙЛ, тоест
    съседните 24 входа минават и липсва един ред, мълчаливо, завинаги. Еталонът France минава само защото
    подава 14/1/10. Стойността „1“ е НЕУТРАЛНИЯТ МИНИМУМ, а не твърдение: „9“ би излъгало, че ЕИК е деветзначен,
    при положение че точка (1) по-горе обяснява защо requiredSize не може да изрази 9-или-13. Инертна е доказано
    и на ДВАТА четеца: RegistrationNumberValidator:84 не се стига, защото фабриката връща null при празен
    validationMethodSelect, а checkSirenLegality/checkNicLegality (RegistrationNumberTemplateServiceImpl:29-38)
    са гейтнати от useSiren/useNic — и двете false. -->
  <input file="base_registrationNumberTemplate.csv" separator=";"
    type="com.axelor.apps.base.db.RegistrationNumberTemplate" search="self.importId = :importId">
    <bind to="isRequiredForCompanies" column="isRequiredForCompanies" adapter="Boolean"/>
    <bind to="useSiren" column="useSiren" adapter="Boolean"/>
    <bind to="useNic" column="useNic" adapter="Boolean"/>
    <bind to="useTaxNbr" column="useTaxNbr" adapter="Boolean"/>
  </input>

  <!-- ЗАКАЧАНЕТО НА ШАБЛОНА КЪМ ДЪРЖАВАТА. Шаблонът се намира САМО през partner.mainAddress.country.registrationNumberTemplate
    (Country.xml:21-22) — друг път няма. Редът за БЪЛГАРИЯ вече съществува (създаден от axelor-base data-init),
    а колоната му registration_number_template е NULL; тук се пълни само тя. ⚠️ ТЪРСЕНЕТО Е ПО alpha2Code,
    НИКОГА ПО importId. axelor-base data-init дава на България importId „99“, но в пълния списък държави
    на AOS (apps/demo-data) 99 е ЛАОС, а България е 30. Внесат ли се демо данните, редът с importId 99 става
    LAO, появява се нова България с importId 30 — и търсене по importId би закачало RNT-BG за Лаос при всеки
    boot (DataInitSync). importId е локален ключ на вноса, alpha2Code е ISO кодът на държавата и не зависи
    от това кой списък е минал. Проверката при старт (BgCountrySeedCheck) пази същото на живата база. ⚠️
    ВХОДЪТ Е СЛЕД ШАБЛОНА, И РЕДЪТ ИМА ЗНАЧЕНИЕ. CSVImporter#run изпълнява входовете в реда на документа
    (CSVImporter:192-199), тоест шаблонът трябва вече да е в базата, когато търсенето по registrationNumberTemplate.importId
    тръгне. Разменени, връзката щеше да се запише NULL — тихо, защото ненамереният FK не е грешка. ⚠️ update="true"
    НЕ Е УКРАСА — БЕЗ НЕГО СЕ СЪЗДАВА ВТОРА БЪЛГАРИЯ. CSVBinder#find прави `newInstance()`, когато търсенето
    не намери ред (CSVBinder:212-217); с update="true" пътят е `if (update || bean != null) return bean;`
    (ред 206-209) и връща null, а CSVImporter:409 просто прескача реда. Разликата се мери в данни: новосъздадената
    държава щеше да е без addressTemplate, който е required, и щеше да дублира БЪЛГАРИЯ в номенклатурата.
    ⚠️ ДВЕ КОЛОНИ, И ТОВА Е ПРИЧИНАТА ОСТАНАЛИТЕ ПОЛЕТА ДА ОЦЕЛЕЯТ. CSVBinder#autoBind свързва само имена,
    които ги ИМА в заглавния ред (CSVBinder:135-167). Името, importId, economicArea и addressTemplate ги
    няма тук, тоест вносителят не ги докосва — нито ги чете, нито ги нулира. alpha2Code се записва обратно
    в същия ред със същата стойност („BG“), защото по нея е намерен. Пълен ред на държавата би презаписал
    addressTemplate с това, което пише в НАШИЯ файл. -->
  <input file="base_country.csv" separator=";" type="com.axelor.apps.base.db.Country"
    search="upper(self.alpha2Code) = :alpha2Code" update="true"/>

  <!-- ПЪЛНИЯТ СПИСЪК ДЪРЖАВИ (ISO 3166-1, 249) С БЪЛГАРСКИТЕ ИМЕНА. На чиста база axelor-base data-init
    носи само 5 държави (CA, US, FR, GB, BG) — пълният списък на AOS е в демо данните, които в production
    не се внасят. Без него не може да се въведе партньор от ЕС, тоест няма ВОД, VIES и SAF-T за него. ⚠️
    ТЪРСИ ПО alpha2Code, НИКОГА ПО importId — същият довод като входа горе (99 е ЛАОС в списъка на AOS).
    Няма update="true": липсващата държава се СЪЗДАВА, намерената се обновява. ⚠️ ВИНАГИ се пишат само name
    (българското) и bgNameEn (английското, както е в AOS — за печат на чужд език по-късно и за да съвпада
    с вече записаните адреси). Всичко останало е с if-empty="true": при заварен ред не се пипа (CSVBinder:322
    — „field is not empty“ → continue), при нов се попълва. • importId — този от пълния списък на AOS (BG
    30, DE 5…), НЕ наш: демо вносът търси по importId и така обновява същия ред, вместо да създаде втора
    Германия. AI, AW, BM, NF ги няма в списъка на AOS — те са без importId. XK (Косово) не е код по ISO и
    не е тук. • addressTemplate — по ИМЕ, не по importId: CA, US и GB към своите шаблони (data-init ги носи),
    всички останали към DEFAULT. Полето е required — без шаблон редът не се записва. • phonePrefix — по ITU;
    AOS греши в около 50 (US 372, CZ 235, KR 242…) — поправката важи само за нови редове. numericCode на
    KR е 410 (в AOS 140, това е на ЦАР). • economicArea — както в AOS (EEA за 27-те от ЕС и GB); на чиста
    база зона EEA няма и полето остава празно. Членството в ЕС кодът го взима от BgVatNumberValidator, не
    от зоната. -->
  <input file="bg_country.csv" separator=";" type="com.axelor.apps.base.db.Country"
    search="upper(self.alpha2Code) = :alpha2Code">
    <bind to="alpha2Code" column="alpha2Code"/>
    <bind to="name" column="name"/>
    <bind to="bgNameEn" column="bgNameEn"/>
    <bind to="alpha3Code" column="alpha3Code" if-empty="true"/>
    <bind to="numericCode" column="numericCode" if-empty="true"/>
    <bind to="phonePrefix" column="phonePrefix" if-empty="true"/>
    <bind to="importId" column="importId" if-empty="true"/>
    <bind to="economicArea" column="economicArea" search="self.code = :economicArea"
      if-empty="true"/>
    <bind to="addressTemplate" column="addressTemplate" search="self.name = :addressTemplate"
      if-empty="true"/>
  </input>

  <!-- „Шаблон за адрес по подразбиране“ в AppBase — по ИМЕ DEFAULT. На чиста база е празен (попълва
    го само studio_appBase.csv от демо данните), а CountryServiceImpl#createAndSaveCountry го слага на нова
    държава — без него създаването през REST-а за адреси гърми на required addressTemplate. Зададена стойност
    не се пипа (if-empty). update="true": AppBase не се създава оттук. -->
  <input file="bg_appBase_addressTemplate.csv" separator=";"
    type="com.axelor.studio.db.AppBase" search="self.app.code = :code" update="true">
    <bind to="defaultAddressTemplate" column="defaultAddressTemplate"
      search="self.name = :defaultAddressTemplate" if-empty="true"/>
  </input>

  <!-- ═══ ЧЕТИРИТЕ РЕФЕРЕНТНИ ТАБЛИЦИ НА SAF-T ═══ Кодовете на НАП се закачат за сметките, данъците
    и плащанията ОТТУК, а не от поле върху Account, Tax и PaymentMode. Доводът е в domains/BgSafMapping.xml;
    накратко: Account е по КОМПАНИЯ, тоест поле върху него значи един и същи код, преписан на всяка инсталация.
    ⚠️ ЧЕТИРИТЕ ВХОДА СА НЕЗАВИСИМИ ЕДИН ОТ ДРУГ И ОТ ВСИЧКО НАД ТЯХ. Нито един няма `search=` към чуждо
    entity, тоест редът спрямо останалите входове не носи нищо и не го пазим с коментар, който утре ще лъже.
    Вътрешната им връзка е по КОД и се сверява от пазачите, не от вносителя: bg_saf_account_mapping.accountCode
    срещу BG_COA, bg_saf_tax_mapping.taxCode срещу account_tax.csv, bg_saf_payment_mapping.paymentModeCode
    срещу account_paymentMode.csv — и трите чужди файла живеят в axelor-account, тоест вносителят на ТОЗИ
    модул изобщо не може да ги види. ⚠️ И ЧЕТИРИТЕ СА upsert ПО importId, КАКТО bg_nkid_mod_mapping.csv.
    Бизнес-кодът е unique на entity-то и пази от дубликат; importId носи идентичността на вноса, за да може
    следващ кръг да ДОПИШЕ колона по същия ключ, вместо да създаде втори ред. Номерата са производни от бизнес-кода
    (SAFTACC-411, SAFTTAX-BG_VOD…), а не броячи — преномериране при пренареждане на файла няма. -->
  <input file="bg_saf_account_mapping.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSafAccountMapping" search="self.importId = :importId">
    <bind to="isExcluded" column="isExcluded" adapter="Boolean"/>
  </input>

  <input file="bg_saf_tax_mapping.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSafTaxMapping" search="self.importId = :importId">
    <bind to="isDynamic" column="isDynamic" adapter="Boolean"/>
  </input>

  <input file="bg_saf_payment_mapping.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSafPaymentMapping" search="self.importId = :importId">
    <bind to="isExcluded" column="isExcluded" adapter="Boolean"/>
  </input>

  <input file="bg_saf_vat_cell_code.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSafVatCellCode" search="self.importId = :importId"/>

  <!-- G3b: вид доход → код за данък при източника (TAX-IMP вид 700). Връзката към bg_income_type.csv
    е по КОД и се сверява от BgSafWithholdingMappingSeedTest, не от вносителя — същият модел като горните. -->
  <input file="bg_saf_withholding_mapping.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSafWithholdingMapping"
    search="self.importId = :importId"/>

  <!-- ═══ НОМЕНКЛАТУРАТА НА НАП ЗА МЕРНИ ЕДИНИЦИ — 2071 кода, справочно ═══ ПРЕПИС на номенклатурата
    за мерни единици в nomenclatures/nra/, за да са 2071-те кода търсими от интерфейса и да има откъде да
    се избира стойност за Unit.bgUomCode. ⚠️ ТОВА НЕ СА ОПЕРАТИВНИ ЕДИНИЦИ — единиците, с които се работи,
    са Unit (data-init/input/base_unit.csv, 36 реда), всяка със свой код. Доводът защо 2071-те не стават
    Unit е в domains/BgNraUnitOfMeasure.xml; накратко: UOMTable в SAF-T е таблица НА ФАЙЛА (образецът на
