<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/data-import http://axelor.com/xml/ns/data-import/data-import_7.4.xsd">

  <!-- App board record (marker). call: празната „Мерна единица по подразбиране на ред от фактура“ става
    „Брой“ (base_unit importId 2); зададена стойност не се пипа. НЕ като колона тук — upsert-ът щеше да връща
    „Брой“ върху избора на администратора при всеки старт. Виж BgDefaultInvoiceLineUnitSeed. -->
  <input file="studio_appBgLocalization.csv" separator=";"
    type="com.axelor.studio.db.AppBgLocalization" search="self.app.code = :code"
    call="com.axelor.apps.bglocalization.service.invoice.BgDefaultInvoiceLineUnitSeed:fillIfEmpty">
    <bind to="app" column="code" search="self.code = :code"/>
  </input>

  <!-- Продуктът „Аванс“ и семейството му „Аванси“. Авансова фактура от поръчка иска AccountConfig.advancePaymentProduct
    — без него AOS гърми SO_INVOICE_MISSING_ADVANCE_PAYMENT_PRODUCT; BG_COA го сочи по importId BG-ADVANCE,
    а сметките 412/402 дава на семейството BG-ADV (account_accountManagement.csv). Ставката идва от реда
    на поръчката. Записите са ГЛОБАЛНИ, затова са тук, а не в BG_COA — той се внася по дружество и чак след
    първия старт. Семейството — първо. -->
  <input file="base_productFamily_advance.csv" separator=";"
    type="com.axelor.apps.base.db.ProductFamily" search="self.importId = :importId"/>

  <input file="base_product_advance.csv" separator=";" type="com.axelor.apps.base.db.Product"
    search="self.importId = :importId">
    <bind to="productFamily" search="self.importId = :productFamily_importId"/>
    <bind to="unit" search="self.importId = :unit_importId" if="unit_importId"/>
  </input>

  <!-- Шаблонът на сметкоплана BG_COA: зипът в базата (AccountingConfigTemplate.metaFile) се прави наново,
    ако CSV-тата в кода са се сменили. Ново дружество получава сметкоплана от ЗИПА, а data-init на axelor-account
    го прави само при първата инсталация — деплой не го опреснява. Входът само намира заварения шаблон (search
    по code); без шаблон редът се пропуска. Виж BgCoaTemplateRefresh. -->
  <input file="account_accountingConfigTemplate.csv" separator=";"
    type="com.axelor.apps.account.db.AccountingConfigTemplate" search="self.code = :code"
    call="com.axelor.apps.bglocalization.service.setup.BgCoaTemplateRefresh:refresh"/>

  <!-- Осигурителни фондове (речник). РОДИТЕЛ — зарежда се ПРЕДИ bg_insurance_contribution.csv, защото
    всеки ред със ставка сочи насам по код. Празни validFrom/validTo → null: тези фондове не са създадени
    и не са закрити в обхвата на данните ни, а датата на създаването им е от закони отпреди двайсет години
    и не е сверявана. Полетата за Д1 се внасят празни нарочно. -->
  <input file="bg_contribution_fund.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgContributionFund" search="self.importId = :importId">
    <bind to="validFrom" column="validFrom" eval="validFrom ? validFrom : null"/>
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Осигурителни вноски по нова схема (вид осигурен НАП × фонд × категория × режим УПФ × период).
    Всички колони се авто-мапват 1:1 по име (bgUpfRegime/bgSolScope са string selection-и). ISO дати чрез
    default LocalDate adapter; празно validTo → null. -->
  <input file="bg_insurance_contribution.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgInsuranceContribution"
    search="self.importId = :importId">
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
    <!-- FK-ът се извежда от СЪЩАТА колона, която пълни низа fundCode. Оттам следва, че двете не могат
      да се разминат при импорт — а BgContributionFundConsistencyTest го твърди и за редовете, които не идват
      от seed-а. Отделна колона в CSV-то би била втори източник на истина. ⚠️ ДВАТА BIND-А СА ЗАДЪЛЖИТЕЛНИ,
      НЕ Е ЕДИНИЯТ ИЗЛИШЕН. Изричен bind върху колона ИЗКЛЮЧВА същата колона от авто-мапването: CSVBinder#autoBind
      прескача всяко име, което getBoundCols е събрал от атрибутите column (CSVBinder.java: `if (boundCols.contains(field))
      continue;`). Тоест само с bind-а към FK-а низът fundCode не се пълни от нищо — а той е required. Заварените
      редове минават, защото upsert-ът само ги обновява и техният fund_code вече е записан; пада единствено
      INSERT на нов ред, с „fundCode: must not be null“. Пази се от BgImportBindingTest: всяко required поле,
      което е и колона в CSV-то, трябва да има binding след автоматичното свързване. -->
    <bind to="fundCode" column="fundCode"/>
    <bind to="bgContributionFund" column="fundCode" search="self.code = :fundCode"/>
  </input>

  <!-- Видове осигурени (НАП, Наредба Н-13 Прил.1). Седемте булеви флага чрез Boolean adapter; останалите
    (importId, code, name, validFrom) се авто-мапват. Празно validTo → null. ⚠️ bgIsSeafarer НЕ е флаг за
    Д1 като другите шест — той избира данъчната ставка по чл. 42 ал. 4 ЗДДФЛ (1 на сто вместо 10) и се чете
    от BgPaySlipService#incomeTaxRate. Тук е в същия списък по една причина: адаптерът е същият, а без него
    низът „true“ не става булево. ⚠️ Същото важи и за bgEntitledToLengthOfServiceBonus — той не е за Д1,
    а за начисленията: НСОРЗ чл. 12 ал. 1 дава класа прослужено време само на работниците и служителите по
    индивидуален трудов договор, и BgEarningsService го пита, преди да напише перото. -->
  <input file="bg_insured_type.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgInsuredType" search="self.importId = :importId">
    <bind to="bgAppliesMod" column="bgAppliesMod" adapter="Boolean"/>
    <bind to="bgAppliesModConditional" column="bgAppliesModConditional" adapter="Boolean"/>
    <bind to="bgFillsT31" column="bgFillsT31" adapter="Boolean"/>
    <bind to="bgZeroWorkTime" column="bgZeroWorkTime" adapter="Boolean"/>
    <bind to="bgNoHours" column="bgNoHours" adapter="Boolean"/>
    <bind to="bgNoNetPay" column="bgNoNetPay" adapter="Boolean"/>
    <bind to="bgIsSeafarer" column="bgIsSeafarer" adapter="Boolean"/>
    <bind to="bgEntitledToLengthOfServiceBonus" column="bgEntitledToLengthOfServiceBonus"
      adapter="Boolean"/>
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Номенклатурата на вида доход по ЗДДФЛ — 90 кода: 79 от образеца на справката по чл. 73 ал. 1 (Части
    І–ІV) и 11 от образеца по чл. 73 ал. 6. Булевите през Boolean adapter; празно validTo → null. ⚠️ ЕДИНСТВЕНИЯТ
    SEED В МОДУЛА С КАВИЧКИ В СТОЙНОСТ — и това не е стилово решение. Описанията са ДОСЛОВНИ от образеца,
    а описанието на код 101 изброява единайсетте букви на § 1 т. 26 ДР, разделени с ТОЧКА И ЗАПЕТАЯ, тоест
    със същия знак, който дели колоните. Вносителят чете през org.apache.commons.csv с CSVFormat.DEFAULT
    и кавичките са RFC4180; тестовете четат през BgSeed.quotedRows, който съществува точно за това. ⚠️ BgSeed.rows
    (голото цепене) НЕ ставa за този файл: код 101 му дава над 60 колони вместо 13 и BgSeed.col връща съседна
    стойност МЪЛЧЕШКОМ. -->
  <input file="bg_income_type.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgIncomeType" search="self.importId = :importId">
    <bind to="withheldByPayer" column="withheldByPayer" adapter="Boolean"/>
    <bind to="isAggregate" column="isAggregate" adapter="Boolean"/>
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Скаларни параметри за заплати -->
  <input file="bg_payroll_parameter.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgPayrollParameter" search="self.importId = :importId">
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Вноски ТЗПБ по 2-цифрен раздел КИД-2025. ИНВАРИАНТ: rate е процент-число (0.9 = 0.9%, НЕ 0.009);
    изчислението е base × rate / 100. -->
  <input file="bg_tzpb_rate.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgTzpbRate" search="self.importId = :importId">
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Скалата на несеквестируемия доход по ГПК чл. 446 — три прага × две редакции (без деца / с деца).
    Границите са КРАТНИ на МРЗ, не суми: сумата се чете от BgPayrollParameter MIN_WAGE за периода. ⚠️ Празните
    клетки НОСЯТ ЗНАЧЕНИЕ: празно bgToMultiple значи „без горна граница“ (само праг 3), а празни bgNumerator/bgDenominator
    значат „този праг не работи с дял, а с остатък“ (пак праг 3). Затова минават през eval, а не се оставят
    на голото авто-мапване. ⚠️ И ВЪПРЕКИ eval-а СТИГАТ ДО БАЗАТА КАТО НУЛА, НЕ КАТО NULL — след App Install
    bg_to_multiple = 0.00 за праг 3, bg_keep_multiple = 0.00 за прагове 1 и 2. Генерираните полета за decimal
    и integer се раждат със ZERO / 0, тоест „празно“ и „нула“ съвпадат и NULL няма. Това НЕ е дефект: BgGarnishmentResolver
    чете точно `signum() > 0` и `== 0`, никога null, и затова двата случая са неразличими и за него. Eval-ът
    остава, защото прави НАМЕРЕНИЕТО видимо в конфига — и защото ако някой ден полетата получат друго подразбиране,
    той вече ще е на място. -->
  <input file="bg_garnishment_scale.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgGarnishmentScale" search="self.importId = :importId">
    <bind to="bgWithChildren" column="bgWithChildren" adapter="Boolean"/>
    <bind to="bgToMultiple" column="bgToMultiple" eval="bgToMultiple ? bgToMultiple : null"/>
    <bind to="bgNumerator" column="bgNumerator" eval="bgNumerator ? bgNumerator : null"/>
    <bind to="bgDenominator" column="bgDenominator" eval="bgDenominator ? bgDenominator : null"/>
    <bind to="bgKeepMultiple" column="bgKeepMultiple"
      eval="bgKeepMultiple ? bgKeepMultiple : null"/>
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- МОД редове от Приложение №1 (нова схема: bgRow × период; сумите по квалиф. групи са в отделния
    вход по-долу). Колони importId;bgRow;bgName;bgActivityCount;validFrom;validTo — всички 1:1 по име. Празно
    validTo → null. РОДИТЕЛ — трябва да се зареди ПРЕДИ bg_min_insurance_income_amount. -->
  <input file="bg_min_insurance_income.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgMinInsuranceIncome" search="self.importId = :importId">
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Суми на МОД по квалификационна група (дете на BgMinInsuranceIncome). Колони importId;parentImportId;bgQualificationGroup;amount.
    parentImportId НЕ е поле на този модел — само ключ за търсене на родителя по неговия importId (низ-към-низ,
    без date coercion в JPQL). bgQualificationGroup и amount се авто-мапват. Единственият m2o в цялата операция. -->
  <input file="bg_min_insurance_income_amount.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgMinInsuranceIncomeAmount"
    search="self.importId = :importId">
    <bind to="bgMinInsuranceIncome" search="self.importId = :parentImportId"/>
  </input>

  <!-- Видове отсъствия (запетая-разделен CSV; booleans чрез Boolean adapter; d1Code може да е празно).
    Останалите колони (importId, code, sequence, name, category, payer, compensationPct, sicknessReasonCode,
    healthContributionRule, d1Code, legalBasis) се авто-мапват по име. -->
  <input file="bg_absence_type.csv" separator=","
    type="com.axelor.apps.bglocalization.db.BgAbsenceType" search="self.importId = :importId">
    <bind to="isPaid" column="isPaid" adapter="Boolean"/>
    <bind to="isFixedBenefit" column="isFixedBenefit" adapter="Boolean"/>
    <bind to="countsAsLaborService" column="countsAsLaborService" adapter="Boolean"/>
    <bind to="countsAsInsuranceService" column="countsAsInsuranceService" adapter="Boolean"/>
    <bind to="socialContributionsDue" column="socialContributionsDue" adapter="Boolean"/>
    <bind to="reducesWorkNorm" column="reducesWorkNorm" adapter="Boolean"/>
    <!-- ⚠️ ИЗРИЧЕН bind, а не autoBind: колоната е булева и без adapter="Boolean" низът „false“ би стигнал
      до полето като ИСТИНА (непразен низ). Тоест всичките 34 вида отпуск щяха да станат „по чл. 177“ мълчаливо
      — точно обратното на подразбирането, което домейнът пази. -->
    <bind to="bgPaidUnderArt177" column="bgPaidUnderArt177" adapter="Boolean"/>
    <bind to="requiresSickNote" column="requiresSickNote" adapter="Boolean"/>
    <bind to="active" column="active" adapter="Boolean"/>
  </input>

  <!-- Видове обезщетения при прекратяване. ТОЧКА-И-ЗАПЕТАЯ разделител (за разлика от bg_absence_type.csv),
    защото triggerGrounds е multi-select и стойността му е списък, разделен със ЗАПЕТАЯ. ВНИМАНИЕ ЗА ПРЕГЛЕДАЩИЯ:
    socialContributionsDue и d1Code са попълнени по ХИПОТЕЗА, изведена от типовете в OmegaTIM (чл. 222 ал.
    1 → собствен тип 71, чл. 224 → собствен тип 78, останалите → общия тип 18 заедно с ДМС и Награда). Потвърдени
    са само CT-01 и CT-08. Виж колоната note на всеки ред. ЛИПСВА редът за аналога по ЗВО — наименованието
    на вид осигурен 27 изброява „КТ, ЗДСл и ЗВО“, а legalBasis е required, тоест редът не може да се въведе
    без точния член. -->
  <input file="bg_compensation_type.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgCompensationType" search="self.importId = :importId">
    <bind to="socialContributionsDue" column="socialContributionsDue" adapter="Boolean"/>
    <bind to="isTaxable" column="isTaxable" adapter="Boolean"/>
    <bind to="countsAsInsuranceService" column="countsAsInsuranceService" adapter="Boolean"/>
    <bind to="appliesToAnyGround" column="appliesToAnyGround" adapter="Boolean"/>
    <bind to="requiresProof" column="requiresProof" adapter="Boolean"/>
    <bind to="canBeWaived" column="canBeWaived" adapter="Boolean"/>
    <bind to="isAmountAdjustable" column="isAmountAdjustable" adapter="Boolean"/>
    <bind to="arisesOnTermination" column="arisesOnTermination" adapter="Boolean"/>
    <bind to="active" column="active" adapter="Boolean"/>
  </input>

  <!-- Редиците bgPaySlip и bgCompensation НЕ се внасят оттук (base_sequence.csv) като ред БЕЗ дружество
    (importId SEQ-BG-PAYSLIP-2026, SEQ-BG-COMP-2026), тоест един общ брояч за всички фирми. ТРЗ редиците
    са по дружество (BgTrzSequences) — новото дружество ги получава при създаване (BgTrzCompanySequenceListener,
    по всеки път), заварените при старта (BgTrzSequenceBackfill). Внасян тук, общият ред би идвал при всеки
    старт (ModuleResourceSyncRegistry), а кодът не го чете. Заварени общи редове в базата не се ползват от
    нищо. -->

  <!-- КАПАЧКИТЕ НА СОЦИАЛНИТЕ РАЗХОДИ — праговете по ЗДДФЛ чл. 24 ал. 2 и ЗКПО чл. 208/209а като ТЕМПОРАЛЕН
    seed, не като число в Java. Зарежда се ПРЕДИ bg_pay_slip_line_type_social.csv, защото четиринайсетте
    реда от 2xx сочат насам по код. ⚠️ ЧЕТИРИТЕ eval-а са за ПРАЗНА КЛЕТКА, и точно тук тя има значение,
    различно от нула. bgCompanyCapAmount е празна за ONE_OFF_AID, защото фирмена ос НЯМА — помощта е в пари,
    тоест по § 1 т. 34 ДР ЗКПО не е социален разход в натура и не е обект по чл. 204 ал. 1 т. 2. Тя обаче
    е ИЗМЕРЕНО неразличима от 0,00 в базата (генерираните getter-и за decimal връщат ZERO), затова „няма
    фирмена ос“ се носи от ОТДЕЛНИЯ признак bgCompanyTaxApplies, а не от празната сума. Eval-ите остават,
    за да е видимо намерението — и защото ако полетата някога получат друго подразбиране, те вече ще са на
    място. Същият довод като при bg_garnishment_scale.csv. ⚠️ Петте булеви колони минават през adapter="Boolean"
    ПО ПРЕЦЕДЕНТ, а не защото без него не работят: същият adapter стои на bgWithChildren в bg_garnishment_scale.csv
    и на bgAmbiguous в bg_nkid_mod_mapping.csv. Че не е задължителен, се вижда от съседния вход — bg_pay_slip_line_type.csv
    няма НИТО ЕДИН bind и четирите му булеви колони (bgIsTaxable, bgIsInsuranceIncome, bgIsPermanentCharacter,
    active) се пълнят вярно от авто-мапването. Оставен е изричен, защото тези пет флага решават дали облекчението
    важи, а изричният bind е и мястото, където се вижда, че колоната е булева, а не низ с думата „false“. -->
  <input file="bg_social_expense_cap.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgSocialExpenseCap" search="self.importId = :importId">
    <bind to="bgCompanyTaxApplies" column="bgCompanyTaxApplies" adapter="Boolean"/>
    <bind to="bgWholeAmountOnConditionFail" column="bgWholeAmountOnConditionFail"
      adapter="Boolean"/>
    <bind to="bgRequiresNoPublicDebts" column="bgRequiresNoPublicDebts" adapter="Boolean"/>
    <bind to="bgRequiresSalaryNotBelowAverage" column="bgRequiresSalaryNotBelowAverage"
      adapter="Boolean"/>
    <bind to="bgRequiresLicensedOperator" column="bgRequiresLicensedOperator" adapter="Boolean"/>
    <bind to="bgPersonalCapAmount" column="bgPersonalCapAmount"
      eval="bgPersonalCapAmount ? bgPersonalCapAmount : null"/>
    <bind to="bgCompanyCapAmount" column="bgCompanyCapAmount"
      eval="bgCompanyCapAmount ? bgCompanyCapAmount : null"/>
    <bind to="validTo" column="validTo" eval="validTo ? validTo : null"/>
  </input>

  <!-- Речник на редовете на фиша, групи 1xx, 2xx (само БЕЗ капачка), 6xx, 7xx и 8xx — писани на ръка.
    Без FK колони: трите препратки (към фонд, към вид обезщетение и към капачка на социален разход) се срещат
    само в другите три входа, където винаги са попълнени. Празна клетка за m2o щеше да иска отделен eval,
    а отсъствието на колоната казва същото по-ясно. ⚠️ ЕДИНАЙСЕТТЕ БУЛЕВИ РЕДА ОТ 2xx СА ТУК, А ЧЕТИРИНАЙСЕТТЕ
    ПОД КАПАЧКА — В ОТДЕЛЕН ФАЙЛ, и разделението е точно по наличието на препратка, както при 5xx и 9xx.
    Облеклото, безплатната храна по КТ чл. 285, задължителните застраховки, помощта за лечение, транспортът
    и двойката „в натура“ носят ПРИЗНАК, не праг — за тях BgSocialExpenseCap няма какво да каже и колоната
    би стояла празна на всеки ред. -->
  <input file="bg_pay_slip_line_type.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgPaySlipLineType" search="self.importId = :importId"/>

  <!-- Група 5xx — ГЕНЕРИРАНА от речника на фондовете (фонд × платец). Зарежда се СЛЕД bg_contribution_fund.csv,
    защото сочи към него по код. -->
  <input file="bg_pay_slip_line_type_contribution.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgPaySlipLineType" search="self.importId = :importId">
    <bind to="bgContributionFund" column="bgContributionFund"
      search="self.code = :bgContributionFund"/>
  </input>

  <!-- Група 9xx — ГЕНЕРИРАНА от каталога на обезщетенията, по един ред за всеки вид. Зарежда се СЛЕД
    bg_compensation_type.csv. Името и правното основание са копия оттам — разминаването се хваща от BgPaySlipLineTypeCatalogueTest,
    а не се поправя тихо при следващ импорт. -->
  <input file="bg_pay_slip_line_type_compensation.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgPaySlipLineType" search="self.importId = :importId">
    <bind to="bgCompensationType" column="bgCompensationType"
      search="self.code = :bgCompensationType"/>
