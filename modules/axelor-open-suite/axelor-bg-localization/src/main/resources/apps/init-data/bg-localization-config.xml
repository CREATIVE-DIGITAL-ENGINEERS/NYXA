  <!-- МОД мапинг на НКИД — ОБНОВЯВАНЕ на съществуващите 649 реда (НЕ създаване). Търсенето по self.importId
    = :importId (importId-тата съвпадат с NKID-*-2026) → upsert, не дубликат. Колони importId;code;bgMinIncomeRowCode;bgAmbiguous;bgMinIncomeNote.
    Трябва да се зареди СЛЕД bg_nkid.csv. -->
  <input file="bg_nkid_mod_mapping.csv" separator=";"
    type="com.axelor.apps.bglocalization.db.BgNkid" search="self.importId = :importId">
