  <input file="bg_nkpd.csv" separator=";" type="com.axelor.apps.bglocalization.db.BgNkpd"
    search="self.importId = :importId">
    <bind to="qualificationGroup" eval="code ? (code.trim().substring(0, 1) as Integer) : null"/>
