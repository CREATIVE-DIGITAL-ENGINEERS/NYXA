<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ СПРАВКАТА ПО ЧЛ. 73 АЛ. 6 ЗДДФЛ — заглавната част (Част І) ═══

    Работодателят подава за всяко физическо лице, на което през годината са изплатени облагаеми
    доходи по трудови правоотношения, както и изброените необлагаеми по чл. 24 ал. 2.

    СРОК: до 28 февруари на следващата година. При открита грешка в данните за конкретно лице СЛЕД
    този срок подателят има право да ги променя до 30 СЕПТЕМВРИ на годината, през която е
    предоставена информацията. Двата срока са различни по естество и затова са две полета.

    ⚠️ ОТДЕЛНА ПОДСИСТЕМА ОТ Д1/Д6, ВЪПРЕКИ ЧЕ ЧЕТЕ СЪЩИТЕ ФИШОВЕ. Д1 и Д6 са по КСО и Наредба
    Н-13, месечни, с код на задължено лице и фондове; тази справка е по ЗДДФЛ, годишна, с код на
    дохода и данъчни облекчения. Общото им е носителят на данните, не правилата. -->
  <entity name="BgArt73Para6Report">

    <many-to-one name="company" title="Дружество" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- ДАНЪЧНАТА година, за която се подава — не периодът на подаване. -->
    <integer name="taxYear" title="Данъчна година" required="true"/>

    <string name="statusSelect" title="Състояние" selection="bg.art73.report.status.select"
      default="DRAFT" required="true"/>

    <!-- Част І т. 1 и 2 — ЕИК/Служебен № и наименование на РАБОТОДАТЕЛЯ, който подава.
      ⚠️ Замразени на справката, а не четени от Company при всеки прочит: подадена справка трябва да
      показва данните, с които Е БИЛА подадена. -->
    <string name="employerIdentifier" title="ЕИК/Сл. № (Част І, т. 1)"/>
    <string name="employerName" title="Наименование (Част І, т. 2)"/>

    <!-- Част І т. 3 — за контакт. ⚠️ Схемата ги дава като minOccurs="0", тоест файлът минава и без
      тях. Но образецът има поле за тях, а НАП ги ползва, за да потърси подателя при неясен запис —
      липсващи, те превръщат въпрос по телефона в отказ по пощата. Огледално на ал. 1
      (BgArt73Para1Report.contactPhone/contactEmail). -->
    <string name="contactPhone" title="Телефон (Част І, т. 3.1)"/>
    <string name="contactEmail" title="e-mail (Част І, т. 3.2)"/>

    <!-- Част І т. 4 — представляващият. Попълва се само когато платецът е юридическо лице. -->
    <string name="representativeName" title="Представляващ (Част І, т. 4.1)"/>
    <string name="representativeIdentifier" title="ЕГН/ЛН/ЛНЧ/Сл. № (Част І, т. 4.2)"/>

    <one-to-many name="recordList" title="Записи (Част ІІ)"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para6Record" mappedBy="report"/>

    <!-- ГОДИШНОТО ПРЕИЗЧИСЛЯВАНЕ ПО ЧЛ. 49 — по един ред за лице, и САМО за лицата, на които това
      дружество е работодател по основното трудово правоотношение към 31 декември.

      ⚠️ СПИСЪКЪТ Е ПО-КЪС ОТ recordList, И ТОВА НЕ Е ПРОПУСК. Указание т. 7: колона 6 на редове
      8.1–8.3 и колони 17–21 се попълват САМО от работодателя по основното ТПО. За лице без такова
      правоотношение към 31 декември справката е ВЯРНА без тези колони — годишният му данък се
      определя другаде (при другия работодател по чл. 49 или от самото лице по чл. 50). Ред тук,
      върнат с нули, би бил твърдение, каквото този работодател няма право да прави. -->
    <one-to-many name="annualList" title="Годишно преизчисляване по чл. 49"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para6Annual" mappedBy="report"/>

    <!-- ═══ ФАЙЛЪТ ПО ЗАПОВЕД № З-ЦУ-1877/05.12.2019 г. (dec736 / SPR73_6.xml) ═══ -->

    <!-- Генерираният файл, който екранът СВАЛЯ. -->
    <many-to-one name="generatedFile" title="Генериран файл"
      ref="com.axelor.meta.db.MetaFile"/>
    <datetime name="fileGeneratedOn" title="Файлът е генериран на"/>

    <!-- НЕПРОМЕНИМИЯТ артефакт на същите байтове.

      ⚠️ ДВЕ ВРЪЗКИ КЪМ ЕДНО И СЪЩО СЪДЪРЖАНИЕ, И ТОВА НЕ Е ДУБЛИРАНЕ — същият довод като при ал. 1:
      generatedFile е MetaFile-ът за сваляне, generatedArtifact е редът с отпечатъка, дължината и
      признака „замразен“, който подаването после сочи. Без него закачането щеше да вика
      createFromMetaFile и да ражда ВТОРИ артефакт за същите байтове. -->
    <many-to-one name="generatedArtifact" title="Артефакт (непроменим)"
      ref="com.axelor.apps.napsubmissions.db.NapArtifact"/>

    <!-- ⚠️ ОТПЕЧАТЪКЪТ СТОИ И ТУК, ВЪПРЕКИ ЧЕ NapArtifact го пази: там той се ражда при ЗАКАЧАНЕ, а
      тук е нужен ПРЕДИ него — за да може свалилият файла да сравни какво държи с това, което
      екранът твърди, че е генерирал. -->
    <string name="fileSha256" title="SHA-256 на файла"/>

    <!-- ⚠️ БРОЯТ ЛИЦА, А НЕ БРОЯТ РЕДОВЕ ДОХОД. При ал. 6 записът на Част ІІ е ЛИЦЕ и едно лице
      носи вложени редове по работодател. Преброени редовете, справката би твърдяла пред НАП
      по-голям брой записи от този, който файлът съдържа. -->
    <integer name="fileRecordCount" title="Брой записи (лица) във файла"/>

    <!-- Закачането към транспорта. ⚠️ ЛИПСВАЩА СТОЙНОСТ ТУК Е НОРМАЛНОТО СЪСТОЯНИЕ: справката се
      строи и се преглежда далеч преди да има какво да се подава. -->
    <many-to-one name="napSubmission" title="Подаване към НАП"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission"/>

    <!-- ⚠️ СВИДЕТЕЛЯТ НА ПОДАВАНЕТО Е НОМЕРЪТ, А НЕ ФАЙЛЪТ. Каналът е manual_portal и по устройство
      не извършва транспорт: човек качва на портала и получава входящ номер. Без тези две полета
      „Подадена“ е твърдение без нито едно доказателство — същият довод като при ал. 1
      (BgArt73Para1Report.napIncomingNumber/napResponseDate). -->
    <string name="napIncomingNumber" title="Входящ №/протокол (НАП)"/>
    <date name="napResponseDate" title="Дата на входящия №/отговора"/>

    <!-- „Оттегли отметката“: причината (задължителна), само вход на екрана — пази се в одита и в
      оттегленото подаване, не тук. -->
    <string name="withdrawReason" title="Причина за оттегляне" transient="true"/>

    <!-- Обявените граници на изведеното — какво НЕ е попълнено и защо. Пише се от строителя и се
      чете от човек ПРЕДИ подаване.

      ⚠️ ТОВА НЕ Е ЛОГ, А ЧАСТ ОТ ОТГОВОРА. Справка, на която колони 6 и 8–22 са празни, защото
      годишното преизчисляване по чл. 49 не съществува, изглежда еднакво със справка, на която те са
      празни, защото лицето няма облекчения. Разликата се вижда само ако е НАПИСАНА. -->
    <string name="bgBoundaryReport" title="Граници на изведеното" large="true"/>

    <unique-constraint columns="company,taxYear"/>

  </entity>

</domain-models>
