<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ГОДИШНОТО ПРЕИЗЧИСЛЯВАНЕ ПО ЧЛ. 49 — редове 8.1, 8.2 и 8.3 и колони 17–22, за ЕДНО ЛИЦЕ ═══

    Тук живее втората половина на Част ІІ: онова, което САМО работодателят по основното трудово
    правоотношение към 31 декември има право да попълни (указание т. 7). Първата половина — колони
    1, 2.1, 2.2, 3, 4, 5, 7 и 23 по код на дохода — живее в BgArt73Para6Record и е от Фаза 1.

    ⚠️ ОТДЕЛЕН ЗАПИС, А НЕ ОЩЕ КОЛОНИ НА BgArt73Para6Record — И ПРИЧИНАТА Е В САМИЯ ОБРАЗЕЦ.
    Редовете 8.1, 8.2 и 8.3 НЕ СА редове с код на дохода: те нямат код (колона 1), нямат платец
    (колони 2.1 и 2.2), нямат доход (колона 3), нямат осигуровки (колони 4 и 5) и нямат авансов
    данък (колона 7). Натъпкани в BgArt73Para6Record, всяка от тези колони щеше да стои на
    default="0" — а нула в колона 3 се чете като „лицето няма доход по този код“. Точно този
    неразличим случай Фаза 1 отказа да произведе, когато НЕ добави колони 6 и 8–22 със стойност
    нула. Отделният запис го решава на ниво схема, а не с уговорка.

    ⚠️ И ВТОРА ПРИЧИНА, ПО-СИЛНА ОТ ПЪРВАТА: КОЛОНИ 17–22 СА НА ЛИЦЕТО, НЕ НА КОДА. Годишната
    основа по чл. 49, дължимият годишен данък и изравняването до 31 януари се определят ВЕДНЪЖ за
    човек — не по веднъж за код 101 и за код 103. Сложени на реда с кода, те щяха да се повторят
    два пъти за морско лице с два вида доход и нищо в схемата нямаше да казва кое от двете е вярно.

    ⚠️ ЕДИН ЗАПИС ЗНАЧИ „ПРЕИЗЧИСЛЕНО Е“. Липсата му за лице, което има редове в Част ІІ, е
    отговорът на чл. 49 ал. 1: към 31 декември това дружество НЕ е работодател по основното трудово
    правоотношение на лицето и няма право да пише в колони 6 и 17–21. Затова признак „преизчислява
    ли се“ тук НЯМА — самото съществуване на реда е признакът, а поле с false би позволило
    преизчислен запис да твърди обратното. -->
  <entity name="BgArt73Para6Annual">

    <many-to-one name="report" title="Справка" required="true"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para6Report"/>

    <many-to-one name="employee" title="Лице" required="true"
      ref="com.axelor.apps.hr.db.Employee"/>

    <!-- ═══ РЕДОВЕ 8.1, 8.2 И 8.3, КОЛОНА 6 ═══ -->

    <!-- Ред 8.1: сборът с код 101 в колона 3 − сборът с код 101 в колони 4 и/или 5 (чл. 25 ал. 1). -->
    <decimal name="baseArt25Para1" title="Годишна основа по чл. 25 ал. 1 (ред 8.1, к. 6)"
      precision="20" scale="2" default="0"/>

    <!-- Ред 8.2: (сборът с код 103 в колона 3 − сборът с код 103 в колони 4 и/или 5) × 10 на сто.
      ⚠️ Десетте на сто СВИВАТ ОСНОВАТА по чл. 25 ал. 3 — те не са ставка. Върху свитата основа после
      ляга обикновената ставка по колона 18, което дава 1 на сто ефективно: точно ставката по чл. 42
      ал. 4 за морско лице. Двете норми се съгласуват — но по РЕЗУЛТАТ, не по величина. -->
    <decimal name="baseArt25Para3" title="Годишна основа по чл. 25 ал. 3 (ред 8.2, к. 6)"
      precision="20" scale="2" default="0"/>

    <!-- Ред 8.3: сумата в колона 6 на ред 8.1 + сумата в колона 6 на ред 8.2 (чл. 49). -->
    <decimal name="baseArt49" title="Годишна основа по чл. 49 (ред 8.3, к. 6)" precision="20"
      scale="2" default="0"/>

    <!-- ═══ КОЛОНИ 8–16 НА РЕД 8.3 — ДАНЪЧНИТЕ ОБЛЕКЧЕНИЯ ПО ЧЛ. 49 АЛ. 3 ═══

      ⚠️ ТРИ ОТ ТЯХ СЕ ИЗВЕЖДАТ, ШЕСТ СА РЪЧЕН ВХОД, И РАЗЛИКАТА Е В САМИЯ ЧЛ. 49 АЛ. 3.
      Ал. 3 т. 2 (чл. 18, 20, 22в и 22г) иска ДОКУМЕНТ — решение на ТЕЛК, декларация за деца — а
      документът има отражение в картона на лицето. Ал. 3 т. 1 (чл. 19 и чл. 22) иска сумите да са
      УДЪРЖАНИ ОТ РАБОТОДАТЕЛЯ при изплащане на дохода, тоест иска ПЕРО НА ФИША — а такива пера в
      речника няма (групата SOCIAL_EXPENSES е съзнателно празна, а липсата на чл. 19 ал. 2 е
      обявена в манифеста на параметрите). Затова колони 9–14 се въвеждат от човек по документите
      и НЕ се пренаписват при повторно генериране.

      ⚠️ ЗАПИСВА СЕ ПРИЛОЖЕНОТО, А НЕ ПОИСКАНОТО. Колона 17 е „колона 6 на ред 8.3 − сборът от
      колони 8 до 16“ — тя се връзва само ако колоните носят реално приспаднатото. Въведена сума
      над тавана се записва СВИТА до тавана и това се НАЗОВАВА в текста с границите, за да не
      изглежда като приета такава, каквато е въведена. -->

    <!-- Чл. 49 ал. 4 — предоставени ли са документите в срок от 30 НОЕМВРИ до 31 ДЕКЕМВРИ.

      ⚠️ ТОВА Е ВРАТАТА КЪМ ЦЯЛАТА АЛ. 3, А НЕ КЪМ ПРЕИЗЧИСЛЯВАНЕТО. Без нея колони 8–16 излизат
      нула, но колона 6 и колони 17–22 се смятат както винаги: работодателят по основното ТПО е
      задължен да преизчисли по ал. 1 независимо какво му е дало лицето. Слети в едно условие, лице
      без документи щеше да остане съвсем без годишен данък — тоест справката щеше да мълчи там,
      където законът иска число.

      ⚠️ И признакът е РЪЧЕН по устройство: подаването на документи е събитие между лицето и
      работодателя, което никъде в модела не оставя следа. Подразбирането е FALSE, тоест
      предпазливата посока — облекчение се прилага само когато някой е потвърдил основанието. -->
    <boolean name="reliefDocumentsProvided" title="Документите по чл. 49 ал. 4 са предоставени"
      default="false"/>

    <!-- Колона 8 — чл. 18: лица с 50 и над 50 на сто намалена работоспособност. ИЗВЕДЕНА от
      признака и срока на решението в картона на лицето. ⚠️ Годината на изтичане на решението брои
      ЦЯЛА (чл. 18 ал. 1, дословно), тоест решение, изтекло през януари, дава пълния годишен размер. -->
    <decimal name="reliefDisability" title="Намалена работоспособност, чл. 18 (к. 8)" precision="20"
      scale="2" default="0"/>

    <!-- Колона 9 — чл. 19: лични вноски за допълнително ДОБРОВОЛНО ОСИГУРЯВАНЕ, до 10 на сто. -->
    <decimal name="reliefVoluntaryPension" title="Доброволно осигуряване, чл. 19 (к. 9)"
      precision="20" scale="2" default="0"/>

    <!-- Колона 10 — чл. 19: доброволно ЗДРАВНО осигуряване и застраховки „Живот“, до 10 на сто.
      ⚠️ ВТОРИ, ОТДЕЛЕН ТАВАН ОТ 10 НА СТО, а не половината от общ. Чл. 19 ал. 1 изброява двете
      групи поотделно, всяка със свое „в общ размер до 10 на сто“ — оттам и двете колони. -->
    <decimal name="reliefVoluntaryHealthLife" title="Доброволно здравно и „Живот“, чл. 19 (к. 10)"
      precision="20" scale="2" default="0"/>

    <!-- Колона 11 — чл. 20: внесените през годината за сметка на лицето вноски по чл. 9а КСО
      (закупуване на осигурителен стаж при пенсиониране). Без процентен таван. -->
    <decimal name="reliefServiceYears" title="Осигурителен стаж при пенсиониране, чл. 20 (к. 11)"
      precision="20" scale="2" default="0"/>

    <!-- Колони 12, 13 и 14 — дарения по чл. 22, по номенклатурата към справката.
      ⚠️ ЧЕТИРИ ТАВАНА, А НЕ ТРИ: 5, 15 и 50 на сто поотделно И общо 65 на сто. Сборът 5+15+50 е 70
      — общият таван НЕ се извежда от трите и е записан изрично в указание т. 7. -->
    <decimal name="reliefDonationsCode01" title="Дарения код 01, чл. 22 (к. 12)" precision="20"
      scale="2" default="0"/>
    <decimal name="reliefDonationsCode02" title="Дарения код 02 — култура, чл. 22 (к. 13)"
      precision="20" scale="2" default="0"/>
    <decimal name="reliefDonationsCode03" title="Дарения код 03, чл. 22 (к. 14)" precision="20"
      scale="2" default="0"/>

    <!-- Колона 15 — чл. 22в: облекчение за деца. ИЗВЕДЕНА от децата в картона на лицето.
      ⚠️ СТЪПАЛО, А НЕ „ПО ТОЛКОВА НА ДЕТЕ“: чл. 22в ал. 1 дава три отделни суми — при едно, при две
      и при три И ПОВЕЧЕ деца. При пет деца сумата остава тази за три и повече.
      ⚠️ РАЗМЕРЪТ ЗА ГОДИНАТА НЕ Е В ЧЛ. 22в. Указание т. 7 препраща към § 3 от ПЗР на ЗДБРБ за
      съответната година — виж BgArt49ReliefEntitlement. -->
    <decimal name="reliefChildren" title="Деца, чл. 22в (к. 15)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 16 — чл. 22г: деца с 50 и над 50 на сто увреждане. ИЗВЕДЕНА от децата в картона.
      ⚠️ ТУК Е НА ДЕТЕ, за разлика от чл. 22в: ал. 1 не изброява брой, а дава едно число „за
      отглеждане на дете с … увреждане“. И възрастовата граница е ДРУГА — „към 1 ЯНУАРИ на данъчната
      година“ (ал. 2 т. 2), докато чл. 22в ал. 7 дава цялата година на пълнолетието. -->
    <decimal name="reliefDisabledChildren" title="Деца с увреждания, чл. 22г (к. 16)" precision="20"
      scale="2" default="0"/>

    <!-- Сборът от колони 8 до 16 — умалителят на колона 17. Записан, за да може човек да свери
      колона 17 срещу колона 6, без да сумира девет полета на екрана. -->
    <decimal name="reliefTotal" title="Сбор на облекченията (к. 8–16)" precision="20" scale="2"
      default="0"/>

    <!-- ═══ КОЛОНИ 17–22 НА РЕД 8.3 ═══ -->

    <!-- Колона 17 — основата по чл. 49 ал. 1 СЛЕД намаленията: колона 6 на ред 8.3 − сборът от
      колони 8 до 16 на ред 8.3. -->
    <decimal name="taxableBase" title="Годишна основа след намаленията (к. 17)" precision="20"
      scale="2" default="0"/>

    <!-- Колона 18 — дължимият годишен данък: колона 17 × 10 на сто.
      ⚠️ Ставката НЕ е закована в кода: чете се от BgPayrollParameter.INCOME_TAX_RATE за годината,
      също както я чете и месечният авансов данък по чл. 42. Едно число на две места е един ден
      различно на двете места. -->
    <decimal name="annualTax" title="Дължим годишен данък (к. 18)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 19 — разликата между колона 18 и сбора в колона 7 ЗА КОДОВЕ 101 И 103.

      ⚠️ СТОЙНОСТТА Е ЦЯЛО ЧИСЛО, ВЪПРЕКИ ЧЕ КОЛОНАТА Е scale=2. Указание т. 7: „всички суми се
      посочват в левове и стотинки до втория десетичен знак, С ИЗКЛЮЧЕНИЕ на сумата в колона 19,
      която се закръглява към всеки пълен лев“. Мащабът на колоната остава общият, за да не се чете
      различно от съседните си; закръглянето живее в BgArt49Recalculation, където му е мястото — и
      е ОТРЯЗВАНЕ, не „до най-близкото“: и двата примера в указанието падат надолу.

      ⚠️ ПОЛОЖИТЕЛНА ЗНАЧИ ДОВНАСЯНЕ, ОТРИЦАТЕЛНА — ВЪЗСТАНОВЯВАНЕ. Знакът се пази, вместо да се
      разнесе само по колони 20 и 21: колона 19 е ЕДНА колона на образеца и на нея се сверява. -->
    <decimal name="settlement" title="Разлика за изравняване (к. 19)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 20 — сумата по колона 19, УДЪРЖАНА от лицето до 31 януари (чл. 49 ал. 5). -->
    <decimal name="toWithhold" title="Удържано до 31 януари (к. 20)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 21 — сумата по колона 19, ВЪЗСТАНОВЕНА на лицето до 31 януари (чл. 49 ал. 6).
      ⚠️ Възстановената сума се прихваща от работодателя от СЛЕДВАЩИ вноски към държавния бюджет за
      данъци върху доходите от трудови правоотношения на лицето или на ДРУГИ лица (чл. 49 ал. 7) —
      тоест тя не се иска обратно от бюджета с искане за прихващане. Прихващането е счетоводно
      действие извън тази справка. -->
    <decimal name="toRefund" title="Възстановено до 31 януари (к. 21)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 22 — общият удържан данък: сборът в колона 7 + колона 20 − колона 21.
      ⚠️ ТУК СБОРЪТ В КОЛОНА 7 Е БЕЗ ОГРАНИЧЕНИЕ ПО КОД, за разлика от колона 19, която казва
      изрично „за доходите с код 101 и 103“. Разликата е написана в един и същ абзац на образеца и
      затова е нарочна: изравняването не пипа данъка по код 102 (по чл. 49 ал. 8 той изобщо не влиза
      в годишната основа), но общо удържаният данък за трудови доходи включва и него. -->
    <decimal name="totalWithheld" title="Общо удържан данък (к. 22)" precision="20" scale="2"
      default="0"/>

    <unique-constraint columns="report,employee"/>

  </entity>

</domain-models>
