<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ РЕГИСТРАЦИЯТА НА САМООСИГУРЯВАЩОТО СЕ ЛИЦЕ ═══

    ЗАЩО СЪЩЕСТВУВА. Видът осигурен има дом на ТРУДОВИЯ ДОГОВОР
    (EmploymentContract.bgInsuredTypeCode), а самоосигуряващият се НЯМА трудов договор — той има
    РЕГИСТРАЦИЯ. Пазачът BgInsuredTypeHomeFileTest отказва кодове 12, 13, 22 и 41 върху договор;
    техният дом е този ентитет.

    ⚠️ ДВЕ ПОЛЕТА НА Employee НЕ СА РЕГИСТРАЦИЯ (виж manifest/sol-2026.yml).
    Employee.bgIsSelfInsured и Employee.bgSolInsurableIncome не носят нито периода на дейността
    (започване, прекъсване, възобновяване, прекратяване), нито ОБХВАТА на осигуряването по чл. 4
    ал. 4 КСО, нито кода на задълженото лице за т. 4 на Д1. Оттам и решението: регистрацията е
    СВОЙ запис, а двете полета на Employee остават като СВЕРКА (виж bgIsSelfInsured долу), а не като
    източник.

    ⚠️ НА СЛУЖИТЕЛ, А НЕ НА ПАРТНЬОР. Свободната професия не е служител в HR смисъла и Partner е
    по-честният модел — но резолверът на вноските иска ЕГН, дата на раждане, категория труд, избор
    по ДЗПО и признак „пенсионер“, и петте вече живеят на Employee. На Partner те щяха да са пет
    нови колони, дублиращи HR модула, и втори източник за всяко от тях. Заемане, записано като
    заемане.

    ⚠️ ТУК НЯМА ПОВЕДЕНИЕ. Кой запис е валиден, кой обхват дава кои фондове и как се стига до фиш
    живее в BgSelfInsuredRules и BgPayrollInputBuilder — полетата само дават на отговорите къде да
    се запишат. Същият идиом като BgPaySlip. -->
  <entity name="BgSelfInsuredRegistration">

    <!-- Име за показване в m2o полета и в решетките. Пише се от
      BgSelfInsuredRegistrationManagementRepository при всеки запис — не се въвежда. -->
    <string name="fullName" title="Наименование" namecolumn="true" readonly="true"/>

    <many-to-one name="employee" title="Самоосигуряващо се лице" required="true"
      ref="com.axelor.apps.hr.db.Employee"/>

    <!-- ⚠️ ПРИЗНАКЪТ, А НЕ ИЗВОД ОТ СЪЩЕСТВУВАНЕТО НА РЕДА. Регистрация може да съществува и да е
      прекратена, а редът да остане за одит и за коригираща Д1 за минал период — точно както
      отказаният фиш остава видим. Оттам „има запис“ и „лицето се самоосигурява“ са РАЗЛИЧНИ
      твърдения и второто иска свое поле.

      ⚠️ И ТОЙ Е ЧИТАТЕЛЯТ НА Employee.bgIsSelfInsured. BgSelfInsuredRules сверява двете и
      разминаването е НАЗОВАНА причина, а не тиха поправка. Мълчаливото подравняване би скрило точно записа, който
      трябва да се види: чекбокс, вдигнат на служителя без регистрация, значи лице, за което никой
      не знае по кой ред от КСО се осигурява.

      Подразбирането false е самото правило: заварен ред идва с NULL, а генерираният getter за
      Boolean връща FALSE и за NULL (BgDefaultedGetterTest) — тоест непопълненото се чете като
      „не е действаща“, а не като „действаща“. Обратната посока би пуснала през СОЛ пътя всеки
      празен запис. -->
    <boolean name="bgIsSelfInsured" title="Действащо самоосигуряване" default="false"/>

    <!-- Вид осигурен по номенклатурата на НАП. НИЗ, не m2o — речниците са темпорални и коригираща
      Д1 за минал период ползва кода, валиден ТОГАВА. Дословно същият избор като при
      EmploymentContract.bgInsuredTypeCode и BgInsuranceContribution.bgInsuredTypeCode.

      ⚠️ Селекцията е СТЕСНЕНА (bg.sol.insured.type.select), а не пълните 43 кода: код 01 на
      регистрация на самоосигуряващо се лице е точно толкова невалиден, колкото код 12 на трудов
      договор, и двете грешки заслужават еднакво отношение. Кои кодове са вътре, се сверява машинно
      срещу seed-а от BgSelfInsuredRegistrationFileTest. -->
    <string name="bgInsuredTypeCode" title="Вид осигурен" required="true"
      selection="bg.sol.insured.type.select"/>

    <!-- Основанието по КСО, на което лицето се самоосигурява. ⚠️ НЕ Е ДУБЛИКАТ НА ВИДА ОСИГУРЕН, и
      разликата е измерима: под код 12 стоят и чл. 4 ал. 3 т. 1 (свободна професия), и т. 2 (ЕТ,
      съдружник), и т. 5 — а КСО чл. 6 ал. 8 дава авансовия режим само на т. 1, 2 и 4, чл. 6 ал. 10
      изважда т. 4 от годишното изравняване, а чл. 4 ал. 4 дава избора за ОЗМ пак само на т. 1, 2 и
      4. Тоест основанието решава ТРИ различни неща, които видът осигурен не може да реши. -->
    <string name="bgActivityGround" title="Основание (КСО)" required="true"
      selection="bg.sol.activity.ground.select"/>

    <!-- Т. 4 на Д1 и т. 1 на Д6 — кодът на ЗАДЪЛЖЕНОТО лице.

      ⚠️ ВЪВЕЖДА СЕ ОТ ОПЕРАТОР, НЕ СЕ ИЗВЕЖДА. Наредба Н-13, указания за Д1 т. 4, дословно: „ЕИК по
      БУЛСТАТ, ЕИК по ЗТРРЮЛНЦ, служебен номер, издаден от НАП“ — и не различава случаите. За
      свободна професия това е собственият БУЛСТАТ на лицето; за съдружник, който се самоосигурява
      ЧРЕЗ дружеството, това е ЕИК на дружеството. Извеждането му от основанието щеше да е правило,
      което нормата не дава, а мълчаливо сгрешен код на задължено лице прави декларацията чужда.

      ⚠️ РАЗЛИЧНО ОТ Т. 1 НА Д6. Там същата наредба иска ЕГН — виж BgSelfInsuredRules#d6ObligedCode.
      Двете точки НЕ носят едно и също число и точно затова тук стои само едната. -->
    <string name="bgObligedPersonCode" title="Код на задълженото лице (т. 4 Д1)" required="true"
      help="ЕИК по БУЛСТАТ, ЕИК по ЗТРРЮЛНЦ или служебен номер от НАП. Наредба Н-13, указания за
        декларация обр. 1, т. 4."/>

    <!-- ОБХВАТЪТ на осигуряването — КСО чл. 4 ал. 3 (задължителният набор) и чл. 4 ал. 4 (изборът
      за ОЗМ).

      ⚠️ ТРЕТАТА СТОЙНОСТ НА ОСТА (ART4A_AL2, морското лице) НЕ Е ТУК, и ANY също не е. Селекцията
      bg.insurance.sol.scope.select носи четири стойности, защото описва РЕДА в каталога със ставки;
      регистрацията описва ЛИЦЕТО и за него отговорът е точно един от два. ANY на регистрация би
      бил „обхватът не е решен“, а необявеният избор по чл. 4 ал. 4 значи „не е избрал“, тоест
      PENSION_ONLY — две различни неща с една стойност. -->
    <string name="bgSolScope" title="Обхват на осигуряването" required="true"
      selection="bg.sol.registration.scope.select" default="PENSION_ONLY"/>

    <!-- ⚠️ ГОДИНАТА, ЗА КОЯТО ВАЖИ ОБХВАТЪТ — а не „от днес нататък“. Изборът за ОЗМ по чл. 4 ал. 4
      КСО е ГОДИШЕН: чл. 6 ал. 9 говори за „самоосигуряващите се лица, които са избрали да се
      осигуряват в този фонд“ ЗА СЪОТВЕТНАТА ГОДИНА, а годишното изравняване се прави по нея.
      Обхват без година би пренесъл миналогодишния избор върху тази година мълчаливо — и то в
      посоката, която не се обажда: ОЗМ вноска, която лицето не дължи.

      ⚠️ СРОКЪТ ЗА ПОДАВАНЕ НА ИЗБОРА е в НООСЛБГРЧМЛ, наредба, която НЕ Е СВЕРЕНА срещу ДВ от този
      клон — виж manifest/sol-2026.yml. Тук се пази само ГОДИНАТА, не срокът: правило върху
      несверен член е втора грешка. -->
    <integer name="bgScopeYear" title="Обхватът важи за година" required="true"/>

    <!-- ИЗБРАНИЯТ МЕСЕЧЕН ОСИГУРИТЕЛЕН ДОХОД — КСО чл. 6 ал. 8. Единица: ЕВРО.

      Дословно: „вноските … се дължат авансово: върху месечен осигурителен доход МЕЖДУ минималния и
      максималния месечен размер на дохода, определен със закона за бюджета на държавното обществено
      осигуряване за съответната година“.

      ⚠️ ГРАНИЦИТЕ НЕ СЕ ПАЗЯТ ТУК. Те са ТЕМПОРАЛНИ и се сменят ПО СРЕДАТА на 2026 г. (ЗБДОО чл. 9
      т. 1 б. „б“ 550,66 € до 31.07 и т. 2 б. „б“ 620,20 € от 01.08; таванът 2111,64 € → 2300 €),
      тоест едно и също число е валидно за юли и под минимума за август. Налагането им е на
      BgInsurableIncomeService, по СЪЩИЯ път, по който минава и заплатата — виж
      BgPaySlipService#insurableIncomeFor.

      ⚠️ РАЗЛИЧНО ОТ Employee.bgSolInsurableIncome. Онова поле е на ЛИЦЕТО, тоест не може да се смени за една година, без да се пренапише историята. Изборът е
      годишен (чл. 6 ал. 8 казва „за съответната година“) и мястото му е тук, до bgScopeYear.

      ⚠️ И РАЗЛИЧНО ОТ BgPayrollInput.insurableIncomeOverride, който остава ОБЯВЕНА ЛИПСА. Онова е
      админ надписване, което ЗАОБИКАЛЯ изчислението; това е самата законова база. Сходни имена,
      противоположни неща. -->
    <decimal name="bgSelectedIncome" title="Избран осигурителен доход (чл. 6 ал. 8 КСО)"
      precision="20" scale="2"/>

    <!-- ⚠️ ПЕНСИОНЕР, КОЙТО СЕ ОСИГУРЯВА ПО СВОЕ ЖЕЛАНИЕ — КСО чл. 4 ал. 6, дословно: „Лицата по
      ал. 3, т. 1, 2, 4 - 6, на които е отпусната пенсия, се осигуряват по свое желание.“

      Тоест за пенсионера осигуряването за ДОО НЕ Е задължително и признакът е ТРЕТО състояние до
      „осигурява се“ и „не е регистриран“: регистрация има, а вноски за ДОО може и да не се дължат.
      Изведен от Employee.bgIsPensioner, той щеше да е ПРАВИЛО („всеки пенсионер се осигурява“),
      каквото нормата точно не дава.

      ⚠️ ПОЛЕТО НЕ СМЕНЯ НАБОРА ОТ ФОНДОВЕ САМО ПО СЕБЕ СИ. То казва, че осигуряването е доброволно,
      а КОИ фондове се дължат, продължава да идва от обхвата. Здравната вноска НЕ зависи от него —
      тя е по ЗЗО, не по КСО. -->
    <boolean name="bgVoluntaryPensioner" title="Пенсионер по чл. 4 ал. 6 КСО" default="false"/>

    <one-to-many name="bgActivityPeriodList" title="Периоди на дейност"
      mappedBy="bgSelfInsuredRegistration"
      ref="com.axelor.apps.bglocalization.db.BgSelfInsuredActivityPeriod"/>

    <string name="note" title="Забележка" large="true"/>

    <!-- ⚠️ ЕДНА ДЕЙСТВАЩА РЕГИСТРАЦИЯ НА (лице, вид осигурен, година на обхвата). Без него едно лице
      може да получи два реда за една и съща година с РАЗЛИЧЕН обхват, и кой от двата е верен, е
      въпрос без отговор. Прекратената регистрация остава — уникалността е по годината, не по
      признака. -->
    <unique-constraint columns="employee,bgInsuredTypeCode,bgScopeYear"/>

  </entity>

  <!-- ═══ ЕДИН НЕПРЕКЪСНАТ ИНТЕРВАЛ В ОСИГУРЯВАНЕ ═══

    ⚠️ КОЛЕКЦИЯ, А НЕ ДВЕ ДАТИ НА РЕГИСТРАЦИЯТА. Наредба Н-13, указания за Д1: т. 14 е „Ден, от
    който осигуряването е възникнало/възобновено“, а т. 15 — „Последен ден в осигуряване ПРИ ВСЯКО
    ПРЕКЪСВАНЕ ИЛИ ПРЕКРАТЯВАНЕ“. Формулярът носи ПЕТ двойки (BgD1Record.t14Day1…t15Day5), тоест
    самата наредба очаква повече от едно прекъсване в един месец. Две дати на регистрацията биха
    стигнали до първото прекъсване и после мълчаливо биха сгрешили стажа.

    ⚠️ ПРЕКЪСВАНИЯТА СА ПРОЛУКИТЕ, а не свои редове. Един ред = един интервал В осигуряване; онова
    между два реда е прекъсването. Обратното (ред за прекъсване) би позволило интервал, който е
    едновременно в и извън осигуряване, и щеше да иска правило, което да реши кой печели. -->
  <entity name="BgSelfInsuredActivityPeriod">

    <many-to-one name="bgSelfInsuredRegistration" title="Регистрация" required="true"
      ref="com.axelor.apps.bglocalization.db.BgSelfInsuredRegistration"/>

    <!-- Ден на възникване или ВЪЗОБНОВЯВАНЕ на осигуряването — т. 14 на Д1. -->
    <date name="fromDate" title="От дата" required="true"/>

    <!-- Последен ден в осигуряване — т. 15. ⚠️ ПРАЗНОТО ЗНАЧИ „ВСЕ ОЩЕ ТЕЧЕ“, а не „един ден“.
      Прочетено като „до fromDate“, действащата регистрация щеше да дава по един ден в осигуряване
      на месец — правдоподобно число, което никой контрол по обща сума не хваща. -->
    <date name="toDate" title="До дата"/>

    <string name="note" title="Забележка" large="true"/>

  </entity>

</domain-models>
