<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Декларация обр. № 1 по Наредба Н-13 — МЕСЕЧНИЯТ КОНТЕЙНЕР: една декларация на дружество и
    месец, а вътре по един запис ({@code BgD1Record}) за всеки фиш.

    ПОСТРОЕНА ПО ОБРАЗЕЦА НА BgVatReturn и това не е стилово решение. ДДС-стекът вече носи целия
    път „период-документ → адаптер → валидатор → печат“, а НАП модулът носи подаването. Втора,
    различна форма на същия път би значела втори набор навици за едно и също нещо.

    ⚠️ Тук се произвежда ЗАПИСЪТ, не файлът. Структурата на файла се утвърждава със ЗАПОВЕД
    на изпълнителния директор на НАП по ЧЛ. 8 АЛ. 5 („За декларациите, подавани на електронен носител
    или по електронен път, се използват структура и формат, утвърдени със заповед…“) — наредбата не
    описва нито ред, нито поле, нито дължина. Заповедта я няма нито в репото, нито в бъндъла на
    Declarations API (той носи само обвивката: fileName, fileType, numRecords, base64 блоб). Затова
    сериализацията е ОТЛОЖЕНА, а не забравена, и записът НЕ Е блокиран от нея: хартиеният носител е
    разрешен по чл. 8 ал. 1 т. 1, тоест печатният образец е пълноценен изход още днес.

    ⚠️ НЯМА ПОВЕДЕНИЕ ТУК. Кой фиш се отказва, коя точка какво число носи и кое правило пада —
    живее в service/d1/. Полетата само дават на отговорите къде да седнат. -->
  <entity name="BgD1Declaration">

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <!-- ═══ ДВАТА ПЕРИОДА, И ТЕ НАИСТИНА СА ДВА ═══
      Наредбата ги различава. bgDataPeriod е месецът, ЗА КОЙТО се отнасят
      данните — той и само той пълни т. 2 (месец) и т. 3 (година) на всеки запис.

      bgSubmissionPeriod е месецът, В КОЙТО декларацията се подава. Обичайно е същият. Разминава се
      по ЧЛ. 4 АЛ. 1 Т. 1 Б. „Б“: за допълнителни доходи, начислени или изплатени след 25-о число,
      декларацията се подава за МЕСЕЦА НА НАЧИСЛЯВАНЕТО, докато данните остават за месеца на
      полагането. Едно поле не може да носи двата отговора, а сгрешеният избор между тях мести цяла
      декларация в друг месец — тихо, защото и двете числа изглеждат правдоподобно.

      ⚠️ Празен bgSubmissionPeriod се чете като „подава се за своя месец“ — обичайният случай.
      Изключението се ОБЯВЯВА; не се предполага.

      ⚠️ Стандартният base.Period, не наш ентитет и не гола дата — по същия довод, с който
      BgPaySlipLine.bgCorrectsPeriod е m2o: дата не казва кой период е затворен, а низ се разминава
      мълчаливо при преименуване. Замразеният месец вече го има наготово (BgPaySlip.period). -->
    <many-to-one name="bgDataPeriod" title="Период на данните" required="true"
      ref="com.axelor.apps.base.db.Period"
      help="Месецът, ЗА КОЙТО се отнасят данните — пълни т. 2 и т. 3 на всеки запис."/>

    <many-to-one name="bgSubmissionPeriod" title="Период на подаване"
      ref="com.axelor.apps.base.db.Period"
      help="Месецът, В КОЙТО се подава. Празно значи „същият като периода на данните“. Различава се по чл. 4 ал. 1 т. 1 б. „б“."/>

    <string name="statusSelect" title="Статус" selection="bg.d1.declaration.status.select"
      default="draft"/>

    <!-- Декларатор — същият per-company ентитет, който ползва и ДДС-стекът. Преизползва се, не се
      копира: кой подава е свойство на дружеството, не на вида декларация. -->
    <many-to-one name="bgDeclarant" ref="com.axelor.apps.bglocalization.db.BgDeclarant"
      title="Декларатор"/>

    <!-- ⚠️ ДЕКЛАРАЦИЯТА НА САМООСИГУРЯВАЩОТО СЕ ЛИЦЕ Е НЕГОВА, НЕ НА ДРУЖЕСТВОТО — симетрично на
      BgD6Declaration. Попълнена, тя обхваща фишовете на ТАЗИ регистрация и нищо друго; празна, тя е
      декларацията на осигурителя и обхваща фишовете по трудов договор на дружеството.

      ⚠️ ЗАЩО ИЗБОРЪТ НЕ Е „една декларация за всички“. Форматът наистина носи кода на задълженото
      лице на ВСЕКИ запис (поле 3), тоест смесен файл е технически възможен. Но т. 4 при
      самоосигуряващия се идва от неговата регистрация, а не от дружеството — смесени, записите
      биха се подали от подател, който не е задължен за половината от тях. -->
    <many-to-one name="bgSelfInsuredRegistration" title="Регистрация (СОЛ)"
      ref="com.axelor.apps.bglocalization.db.BgSelfInsuredRegistration"/>

    <string name="napEntryNumber" title="НАП входящ №"/>

    <!-- ═══════════ ВИДЪТ НА ДЕКЛАРАЦИЯТА — редовна или коригираща ═══════════

      ⚠️ ВИД, А НЕ СТАТУС, И ТОВА Е РАЗДЕЛЯНЕ НА ДВА РАЗЛИЧНИ ВЪПРОСА. Селекцията
      bg.d1.declaration.status.select вече носи стойност „corrected“ и изкушението е тя да свърши
      работа — но статусът описва ЖИЗНЕНИЯ ЦИКЪЛ (чернова → генерирана → подадена → приета), а видът
      описва КАКВА Е декларацията. Слети в едно поле, „подадена коригираща“ е неизразима: тя иска и
      двете наведнъж. Затова „corrected“ остава непокътната и неползвана за Д1 (пише я само
      BgVatReturnController, на ДРУГ entity), а видът получава свое поле.

      ⚠️ И ЗАЩО ИЗОБЩО ТРЯБВА НОСИТЕЛ. Коригиращият фиш носи СЪЩИЯ период като оригинала
      (BgPaySlipService#retroCopyOf), а изборът на фишове пита точно периода — тоест без вид всяка
      декларация за онзи месец взима и двата фиша и произвежда файл с редовен И коригиращ запис за
      едно лице. Отказ върху СМЕСВАНЕТО не е решение — той затваря единствения изход, който сам
      сочи: правилният разграничител е видът на ДЕКЛАРАЦИЯТА, а не съставът на набора.

      ⚠️ ПОДРАЗБИРАНЕТО Е „РЕДОВНА“, НО СЕ ЧЕТЕ И ОТ КОДА, НЕ САМО ОТ КОЛОНАТА. default се превежда
      в ИНИЦИАЛИЗАТОР НА ПОЛЕТО на генерирания клас, не в getter-а — тоест всеки НОВ обект носи
      вида, но ред, записан ПРЕДИ колоната да съществува, се зарежда с NULL. Затова всеки читател
      минава през BgD1DeclarationKind#of, който чете липсата като REGULAR. Backfill НЯМА и не
      трябва: колоната описва какво декларацията Е БИЛА, а всяка заварена е била редовна по
      определение — друга не е могла да се направи.

      ⚠️ И ЗАТОВА ТУК НЯМА required="true". Axelor го превежда в
      @NotNull върху генерирания клас, а бийн-валидацията в ПРОДУКЦИЯ е включена (hibernate-validator
      е зависимост на платформата, libs.gradle:99; REST слоят лови ConstraintViolationException в
      ResponseInterceptor). Тоест ВСЕКИ запис на заварен ред — смяна на статуса, закачане на входящ
      номер — би падал заради колона, която този ред няма как да е имал. Същото важи и за
      бутона „Генерирай“: onClick започва със `save`.

      ⚠️ ВНИМАНИЕ КЪМ СВИДЕТЕЛИТЕ: интеграционните тестове НЕ могат да отговорят на този въпрос —
      test/resources/META-INF/persistence.xml:17 изключва бийн-валидацията изрично
      (javax.persistence.validation.mode=none). Там всеки @NotNull мълчи. Затова свидетелят за това
      е НАД валидатора (BgD1DeclarationKindTest), а не над записа.

      Задължителността остава там, където принадлежи: на НОВИЯ запис, в изгледа
      (requiredIf="id == null"), плюс инициализаторът, който вече дава REGULAR на всеки нов обект.

      ⚠️ Д1 Е ДЕКЛАРАЦИЯ ЗА ЕДНО ЛИЦЕ ЗА ЕДИН МЕСЕЦ (Н-13, чл. 9 ал. 1), тоест корекцията засяга
      само ЗАСЕГНАТИТЕ лица. Коригиращата декларация носи само ретро-фишовете; редовната — само
      останалите. Моделът е верен независимо от това дали един файл може да смесва кодове: той
      просто не ги смесва. -->
    <string name="bgDeclarationKind" title="Вид на декларацията"
      selection="bg.d1.declaration.kind.select" default="REGULAR"/>

    <!-- Коригираща декларация сочи онази, която замества.

      ⚠️ ПРЕДУСЛОВИЕ, НЕ САМО ПРОСЛЕДИМОСТ. С вида на декларацията полето е
      ЗАДЪЛЖИТЕЛНО за коригиращата и се СВЕРЯВА: сочената декларация трябва да е РЕДОВНА и за
      СЪЩИЯ период и СЪЩАТА фирма. Коригираща, която сочи чужд месец или чужда фирма, поправя
      нещо, което НАП не свързва с нея — а грешката се вижда чак при отхвърлянето.

      ⚠️ Пазачите по чл. 9 (ал. 1 т. 1 „с код за корекция НЕ се коригират месец, година, ЕИК, ЕГН и
      вид осигурен“, ал. 3 „заличаване, после нова“, ал. 6) си остават ИЗВЪН обхвата — те са за
      ЗАПИСА, а това поле е за ДЕКЛАРАЦИЯТА. -->
    <many-to-one name="correctsPrevious"
      ref="com.axelor.apps.bglocalization.db.BgD1Declaration" title="Коригира декларация"/>

    <one-to-many name="bgD1RecordList" ref="com.axelor.apps.bglocalization.db.BgD1Record"
      mappedBy="bgD1Declaration" title="Записи (по фиш)" orphanRemoval="true"/>

    <!-- ═══ ОТКАЗИТЕ СА ЧАСТ ОТ ИЗХОДА, НЕ СТРАНИЧЕН ЕФЕКТ ═══
      Фиш, за който емитерът ОТКАЗВА да произведе запис, оставя следа с НАЗОВАНА причина. Мълчаливо
      прескочен фиш е най-скъпият възможен дефект тук: декларацията изглежда пълна, а едно лице
      липсва в нея — и това се открива от НАП, не от нас.

      Текст, а не таблица: причината се чете от човек преди подаване и не се заявява по нея. -->
    <string name="bgRefusalReport" title="Откази (с причина)" large="true"/>

    <!-- Находките на валидатора, замразени при последното генериране — за да ги вижда човекът,
      който сверява записа, без да пуска генерирането пак. -->
    <string name="bgValidationReport" title="Проверки" large="true"/>

    <!-- ═══ МИГРАЦИЯ (от Microinvest) ═══ Записите ѝ са преписани от вече подадена историческа
      декларация (Microinvest Dekl1Value), не произведени от BgD1Emitter. ⚠️ BgD1DeclarationController#generate
      отказва да я презапише — генерирането Е ЗАМЯНА (виж класовия коментар на контролера), а замяна на
      исторически внесени записи с изхода на емитера би преписала НАД вече подадено съдържание. Same guard
      gates attachToSubmission в BgD6DeclarationController, защото то създава подаване за ДВЕТЕ декларации
      наведнъж. Подразбирането false е правилото: всяка декларация отпреди тази колона е обикновена. -->
    <boolean name="bgIsHistoricalImport" title="Исторически внесена (миграция)" default="false"/>

  </entity>

</domain-models>
