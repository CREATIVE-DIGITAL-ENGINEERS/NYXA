<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Вид осигурен по номенклатурата на НАП (Наредба Н-13, Приложение №1). Всеки код носи набор от флагове,
    определящи поведението при попълване на Декларация обр.1. Флаговете са ДАННИ (не hardcoded списъци в
    Java). Списъкът е темпорален (редакцията ДВ бр.15/2024 премахна кодове 07, 21, 23, 93) — коригираща Д1
    за минал период ползва кодовете, валидни тогава → връзката към този модел е по КОД, не m2o. -->
  <entity name="BgInsuredType">
    <string name="code" title="Код (вид осигурен)" required="true"/>
    <string name="name" title="Наименование" required="true"/>

    <boolean name="bgAppliesMod" title="Прилага МОД (т.12)" default="false"/>
    <boolean name="bgAppliesModConditional"
      title="МОД под условие (чл.6 ал.3 КСО, само код 94)" default="false"/>
    <boolean name="bgFillsT31" title="Попълва т.31 (облагаем доход)" default="false"/>
    <boolean name="bgZeroWorkTime" title="0 в поз. 3 и 4 на т.16" default="false"/>
    <boolean name="bgNoHours" title="Без т.16.7 и 16.8" default="false"/>
    <boolean name="bgNoNetPay" title="Без т.34 (нетно възнаграждение)" default="false"/>

    <!-- МОРСКО ЛИЦЕ — признакът, по който данъкът по чл. 42 ал. 4 ЗДДФЛ чете ДРУГА ставка.
      Разпоредбата казва: „месечната данъчна основа по ал. 3 се умножи по данъчна ставка 10 на сто, а за
      доходите, придобити като морско лице — по данъчна ставка 1 на сто.“ Тоест ОСНОВАТА е същата и се смята
      по същия ред; сменя се САМО ставката. Затова признакът е булев флаг тук, а не втора формула някъде.

      ⚠️ ФЛАГ, А НЕ HARDCODED СПИСЪК — по същия довод като шестте флага над него и като bgFloorType: кой код
      е морско лице е ДАННИ. Списък `if ("92".equals(code))` в Java би заковал номенклатурата в кода, а тя е
      темпорална (ДВ бр. 15/2024 премахна кодове 07, 21, 23 и 93) и се сменя с редакция на Наредба Н-13, не
      с комит. Днес флагът е вдигнат за един-единствен ред — код 92, „Морски лица“.

      ⚠️ ЧЕТЕ СЕ ОТ BgPaySlipService#incomeTaxRate и от никъде другаде. Той избира между
      BgPayrollParameter INCOME_TAX_RATE (10 на сто) и INCOME_TAX_RATE_SEAFARER (1 на сто) — двата кода
      съществуват в seed-а.

      ⚠️ НЕ БЪРКАЙ С ГОДИШНОТО. Чл. 25 ал. 3 ЗДДФЛ прави ГОДИШНАТА данъчна основа на морското лице 10 на
      сто от тази по ал. 1 — това е ДРУГ механизъм (намалена основа, а не намалена ставка) и не е този флаг.
      Тук е само месечното авансово удържане по чл. 42.

      ⚠️ И НЕ БЪРКАЙ С ОСИГУРЯВАНЕТО. Морското лице има и собствен осигурителен режим (чл. 4а КСО, избран
      доход, bgFloorType = MIN_INCOME_SOL, изборът по ал. 2 за безработица) — той се чете от ДРУГИ полета и
      този флаг не участва в него.

      НЕ е required, и колоната минава през ДВЕ състояния — второто не е онова, което се очаква:

        1. СЛЕД миграцията db/migration/2026-08-22-bg-insured-type-is-seafarer.sql, ПРЕДИ App Install —
           всичките 43 заварени реда носят NULL. Преходно състояние.
        2. СЛЕД App Install — 1 ред с true (код 92) и 42, КОИТО ОСТАВАТ NULL. Нито един false: редовете
           с false изобщо не се докосват от вноса.

      ⚠️ И ПРИЧИНАТА НЕ Е, ЧЕ CSV-то мълчи: bg_insured_type.csv носи ИЗРИЧЕН false за 42-та реда и
      BooleanAdapter го превръща в Boolean.FALSE. Спира се на Property#set (axelor-core), който първо чете
      старата стойност през ГЕНЕРИРАНИЯ getter — а той връща Boolean.FALSE и за непопълнено поле — и излиза
      по `if (old == value)`. Двете са един и същ кеширан обект, setter-ът не се вика, записът остава чист.
      За код 92 стойността е Boolean.TRUE, друг обект, и се записва.

      Оттам и прочитът: празната колона се чете като „НЕ е морско лице“ през същия този null-safe getter.
      Това НЕ е компромис — то е верният прочит по чл. 42 ал. 4: намалената ставка е изключение, което се
      ОБЯВЯВА, а неотбелязаното остава на общите 10 на сто. Опасната посока е обратната: сгрешено вдигнат
      флаг удържа 1 на сто вместо 10 и разликата не изглежда като грешка на нито един фиш. ⚠️ Затова и
      заявка по този флаг се пише `WHERE bg_is_seafarer` (NULL не е TRUE), а НИКОГА
      `WHERE bg_is_seafarer = false` — второто пропуска 42-та реда и в двете състояния. -->
    <boolean name="bgIsSeafarer" title="Морско лице (данък 1% по чл.42 ал.4 ЗДДФЛ)" default="false"/>

    <!-- НАЧИСЛЯВА ЛИ СЕ КЛАС ПРОСЛУЖЕНО ВРЕМЕ (допълнително възнаграждение за трудов стаж и професионален опит).

      ОСНОВАНИЕТО е НСОРЗ ЧЛ. 12 АЛ. 1, дословно: „За придобит трудов стаж и професионален опит НА
      РАБОТНИЦИТЕ И СЛУЖИТЕЛИТЕ се заплаща допълнително месечно възнаграждение в процент върху основната
      работна заплата, определена С ИНДИВИДУАЛНИЯ ТРУДОВ ДОГОВОР.“ Обхватът на самата наредба стои един
      член по-горе — чл. 2 ал. 2: тя „се прилага за работниците и служителите ПО ТРУДОВО ПРАВООТНОШЕНИЕ“.

      ВДИГНАТ ЗА ТРИНАЙСЕТ КОДА, всеки от които стъпва на трудов договор по КТ: 01, 02, 03, 04, 08, 16,
      25, 26, 42 (чл. 230 КТ — обучение чрез работа), 72, 92, 95 и 99 (чл. 121а КТ). СВАЛЕН за всички
      останали.

      ⚠️ 25/72 — СУБСИДИРАНА ЗАЕТОСТ ПО ТРУДОВ ДОГОВОР ПО КТ, КЛАС СЕ ДЪЛЖИ (НСОРЗ, БЕЗ ИЗКЛЮЧЕНИЕ ЗА
      ПРОГРАМИ). Чл. 2 се прилага за работниците и служителите по трудово правоотношение във ВСИЧКИ
      предприятия и не изважда програмите за заетост; заетостта по Закона за насърчаване на заетостта е
      по трудов договор. ⚠️ И „НЕ СЕ ОСИГУРЯВАТ ЗА БЕЗРАБОТИЦА“ — думите, с които наименованията на 25 и
      72 завършват — НЕ Е ДОВОД ТУК: той описва ОСИГУРИТЕЛНИЯ обхват, а класът е за придобит ТРУДОВ
      СТАЖ. Двете се четат от един и същи ред и точно затова се бъркат.

      ⚠️ 05/06/17/24/83 И 87 — ИЗВЪН НСОРЗ. Първите пет са ДЪРЖАВНА СЛУЖБА/СПЕЦИАЛНИ ЗАКОНИ (Н-13 т. 12,
      НЗСДА чл. 19): правоотношението им не е трудово по КТ, а възнаграждението им се урежда от
      собствените им актове. Код 87 е обратното — трудово правоотношение ИМА, но с ЧУЖД работодател,
      тоест българската наредба не важи за него. И трите групи НЕ получават клас — не по подразбиране, а
      по уредба. Ако някому от тях се дължи допълнително
      възнаграждение за прослужено време, то идва ПО ДРУГ АКТ и с друга ставка — тоест друго перо, не
      това.

      ⚠️ 10 (ДУК), 14 (граждански договор), 09 (кооперативен член БЕЗ трудово правоотношение) и 27
      (обезщетение след ПРЕКРАТЕНО правоотношение) са свалени по същия член: няма индивидуален трудов
      договор, върху чиято основна заплата да се смята процентът. Същото важи за 12, 13, 22 и 41
      (самоосигуряващи се), за 90 (личен труд на съдружник, член-кооператор или акционер — възнаграждение
      без трудов договор по КТ) и за 15, 28, 71, 86, 88, 89, 91, 96, при които възнаграждение по трудово
      правоотношение с български работодател изобщо няма. Свалени остават и 18, 19, 20, 29, 82 и 94,
      при които правоотношението не е установено като трудово по КТ.

      ⚠️ 97 Е ОТДЕЛЕН СЛУЧАЙ И ЗАСЛУЖАВА СВОЕТО ИЗРЕЧЕНИЕ: еднодневните договори по чл. 114а КТ СА
      трудови, тоест общото правило горе не ги изважда. Изважда ги ал. 1 на същия член, която казва
      дословно, че това време „не се признава за трудов стаж“ — а класът е ЗА ПРИДОБИТ ТРУДОВ СТАЖ и
      възниква при не по-малко от една година (чл. 12 ал. 9).

      ⚠️ ЗАЩО ОТДЕЛЕН ФЛАГ, А НЕ „ИМА ЛИ ГВРС“. Изкушението е да се преизползва сигналът за трудово
      правоотношение, който т. 29/т. 30 на Д1 вече ползват (BgD1Emitter#gvrsEligibleCodes: кой вид
      осигурен носи ред за фонд „Гарантирани вземания“). ДВЕТЕ МНОЖЕСТВА НЕ СЪВПАДАТ, и разминаването е
      именно в най-опасната посока: ВИД ОСИГУРЕН 09 — „членове на кооперации, получаващи възнаграждение
      за работа БЕЗ трудово правоотношение в кооперацията“ — НОСИ ред за ГВРС в bg_insurance_contribution.csv
      (публикуваната таблица на НАП към 01.08.2026 г. изключва от ГВРС само 10, 14 и 27), а ТПО няма.
      Преизползван, ГВРС-сигналът щеше да начисли клас на код 09 — тихо и без нито един червен тест.
      Самата бележка на seed-реда за 09 вече записва това разминаване. Оттам: ОТДЕЛНА, ИЗРИЧНА ОС.

      ⚠️ ФЛАГ, А НЕ HARDCODED СПИСЪК — по същия довод като bgIsSeafarer и шестте флага над него: кой код
      носи класа е ДАННИ. Номенклатурата е темпорална (ДВ бр. 15/2024 премахна кодове 07, 21, 23 и 93) и
      се сменя с редакция на Наредба Н-13, не с комит.

      ⚠️ ПОСОКАТА НА ПОДРАЗБИРАНЕТО Е ИЗБРАНА, НЕ СЛУЧАЙНА: начисляването се ОБЯВЯВА, а неотбелязаното
      остава без клас. Обратната посока („всеки, комуто не е забранено“) начислява клас на всеки
      НОВ код в номенклатурата — и то невидимо, защото начислен клас не изглежда като грешка на нито
      един фиш. Липсващият клас се вижда от първия фиш и се въвежда на ръка; неправомерно начисленият не
      се вижда никога.

      ⚠️ КОЛОНАТА МИНАВА ПРЕЗ СЪЩИТЕ ДВЕ СЪСТОЯНИЯ като bgIsSeafarer, по същата причина (Property#set
      излиза по `if (old == value)`, защото генерираният getter връща Boolean.FALSE и за непопълнено
      поле): преди App Install — всички редове NULL; след App Install — true само за отбелязаните, а
      останалите ОСТАВАТ NULL, нито един не става false. Затова заявка по този флаг се пише
      `WHERE bg_entitled_to_length_of_service_bonus` (NULL не е TRUE), а НИКОГА `= false`.

      ⚠️ И ЕДНА ГРАНИЦА, ЗАПИСАНА, ЗА ДА НЕ СЕ СВЛЕЧЕ ВТОРА НОРМА В ТОЗИ ФЛАГ: НСОРЗ чл. 12 ал. 8 плаща
      класа „само по ОСНОВНОТО трудово правоотношение, а при непълно работно време — по всеки отделен
      трудов договор, до допълването им“. Това е ДРУГА ос (основно срещу допълнително ТПО, пълно срещу
      непълно време) и тя е ФАКТ НА ДОГОВОРА, не на вида осигурен: вид 04 („работещи по допълнителен
      трудов договор“) покрива И хипотезата, която ал. 8 ЗАПАЗВА. Свален тук, флагът щеше да отрече
      правото и на нея. Затова 04 остава вдигнат, а ал. 8 чака своя ос върху договора. -->
    <boolean name="bgEntitledToLengthOfServiceBonus"
      title="Начислява клас прослужено време (НСОРЗ чл.12 ал.1)" default="false"/>

    <!-- Кой долен праг важи, когато МОД не се прилага (bgAppliesMod = false). МОД е един от три прага,
      не единственият: за самоосигуряващите се долният праг е минималният осигурителен доход за СОЛ, а за кодове
      05, 06 и 24 е самата МРЗ — праг, който не зависи от икономическа дейност или квалификационна група и
      затова не може да живее в таблицата на МОД. ОСНОВАНИЕТО е КСО ЧЛ. 6 АЛ. 5: осигурителните вноски за лицата
      по чл. 4 ал. 1 т. 2, 3, 4 и 10 се дължат върху не по-малко от минималната месечна работна заплата. Разпоредбата
      е от ДВ бр. 74/2002 с изменения до 2012 — тя НЕ е създадена от ЗБДОО 2026. Оттам и обхватът по кодове:
      т. 2 и 3 са държавните служители и съдебната власт (кодове 05 и 24), т. 4 са военнослужещите по ЗОВС,
      офицерите и сержантите по ЗНСО и държавните служители по ЗМВР, ЗСРС и ЗИНЗС (код 06), а т. 10 са кандидатите
      за младши съдии, прокурори и следователи, които код 24 носи в наименованието си.
      ⚠️ НЕ бъркай с чл. 6 ал. 5а — тя урежда съотношението 80:20 за държавните
      служители и съдебната власт от 01.08.2026 и няма нищо общо с праг.
      Стойността
      е КОД на BgPayrollParameter, не сума: сумите са темпорални (МРЗ и минималният за СОЛ се сменят на 01.08.2026)
      и се четат за датата на изчислението. НЕ е required и няма стойност NONE в базата за заварените редове:
      колоната се добавя към попълнена таблица без миграция.
      Празно се чете като NONE — единственото място, където това се решава, е BgInsurableIncomeService#floorCodeOf. -->
    <string name="bgFloorType" title="Долен праг при неприложим МОД" default="NONE"
      selection="bg.insured.type.floor.select"/>

    <date name="validFrom" title="В сила от" required="true"/>
    <date name="validTo" title="В сила до"/>

    <unique-constraint columns="code,validFrom"/>

  </entity>

</domain-models>
