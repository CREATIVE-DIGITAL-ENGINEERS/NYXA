<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ СПРАВКА ЗА ДАНЪЧНИТЕ ВРЕМЕННИ РАЗЛИКИ ОТ АМОРТИЗИРУЕМИ АКТИВИ ═══

    Храни годишната данъчна декларация по чл. 92 ЗКПО (образец 1010). Носи четири различни члена, и
    точно защото са различни, редовете са отделни, а не един сбор:
      • чл. 54 — годишната разлика: +счетоводна (ал. 2) − данъчна (ал. 1) амортизация;
      • чл. 66 ал. 1 — +СБС в годината на СЧЕТОВОДНОТО отписване;
      • чл. 66 ал. 2 — −ДБС в годината на отписване от ДАНЪЧНИЯ план (често ДРУГА година);
      • чл. 59 ал. 2 — обръщането на дванадесетте месеца, в годината на изтичане на срока.

    ⚠️ ЕДИН СБОР БИ СКРИЛ ИМЕННО ТОВА, КОЕТО ПРАВИ СПРАВКАТА НУЖНА. Плюсът по ал. 1 и минусът по
    ал. 2 на чл. 66 падат в различни години заради чл. 60 ал. 3 — тъй че „нето по чл. 66" е число,
    което не отива в никоя декларация. Виж BgTaxDifferenceRules.art66Decrease за гейта.

    ⚠️ СПРАВКАТА НЕ Е ДЕКЛАРАЦИЯ и не се подава. Структурата на образец 1010 за 2026 г. не е сверена
    (виж BgGddMapping) — стойностите са изведени от ЗКПО и се пренасят ръчно. Затова тук няма поле за
    „подадена на" и няма статус на подаване: обект, който изглежда като декларация, приканва да го
    третират като такава. -->
  <entity name="BgTaxDifferenceReport">

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <!-- Данъчната година, за която се определя данъчният финансов резултат. Редовете влизат в НЕЯ
      по своята собствена година, не по датата на изчисляване — виж коментара на taxYear в реда. -->
    <integer name="taxYear" title="Данъчна година" required="true"/>

    <date name="computedOn" title="Изчислена на"/>

    <one-to-many name="lineList" ref="com.axelor.apps.bglocalization.db.BgTaxDifferenceLine"
      mappedBy="report" title="Редове"/>

    <!-- Сборовете се пазят, а не се смятат в изгледа: справката е снимка към момента на
      изчисляване и трябва да може да се сравни с по-късна. -->
    <decimal name="totalIncrease" title="Общо увеличения (EUR)" precision="20" scale="2"/>

    <decimal name="totalDecrease" title="Общо намаления (EUR)" precision="20" scale="2"/>

    <!-- Брояч на редовете „чака потвърждение". Изнесен на заглавната част, защото е ПРЕДУПРЕЖДЕНИЕ,
      а не статистика: непотвърдено обръщане по чл. 59 ал. 2 е пропусната задължителна корекция,
      тоест скрит данъчен пасив. Стои горе, за да не се налага да се разгъва списъкът. -->
    <integer name="pendingCount" title="Чакат потвърждение"/>

    <string name="comments" title="Бележки" large="true"/>

    <unique-constraint columns="company,taxYear"/>

  </entity>

  <!-- Един ред = едно основание за един актив за една година. -->
  <entity name="BgTaxDifferenceLine">

    <many-to-one name="report" ref="com.axelor.apps.bglocalization.db.BgTaxDifferenceReport"
      title="Справка"/>

    <many-to-one name="fixedAsset" ref="com.axelor.apps.account.db.FixedAsset" title="Актив"/>

    <string name="kindSelect" title="Основание" selection="bg.tax.difference.kind.select"
      required="true"/>

    <!-- ⚠️ ПОЛОЖИТЕЛНА ВЕЛИЧИНА, ЗНАКЪТ Е В ОСНОВАНИЕТО. Чл. 66 ал. 1 увеличава, ал. 2 намалява, а
      чл. 54 може и двете според това дали счетоводната амортизация превишава данъчната. Знак,
      скрит в числото, кара всеки читател да гадае посоката; вид на реда плюс отделни колони за
      увеличения и намаления не оставя място за гадаене. Изключението е чл. 54 — там разликата носи
      естествения си знак, защото посоката ѝ не е свойство на члена. -->
    <decimal name="amount" title="Сума (EUR)" precision="20" scale="2"/>

    <!-- ⚠️ ГОДИНАТА НА РЕДА НЕ Е ВИНАГИ ГОДИНАТА НА СПРАВКАТА, и това не е грешка.
      За чл. 59 ал. 2 законът заковава годината: „за годината, през която е изтекъл
      дванадесетмесечният срок по ал. 1". Ако потвърждението дойде по-късно, редът пак носи ОНАЯ
      година и справката явно казва, че иска КОРИГИРАЩА декларация. -->
    <integer name="taxYear" title="Година на основанието"/>

    <boolean name="isPendingConfirmation" title="Чака потвърждение"/>

    <boolean name="requiresAmendedReturn" title="Иска коригираща ГДД"/>

    <!-- Дословното основание, изведено до реда. Съставителят го чете, вместо да го търси в закона —
      същият довод, по който причините за извеждане носят своята бележка. -->
    <string name="legalGround" title="Основание (дословно)" large="true"/>

  </entity>

</domain-models>
