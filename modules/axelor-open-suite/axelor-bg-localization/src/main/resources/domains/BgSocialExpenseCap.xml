<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- КАПАЧКАТА НА ЕДИН ВИД СОЦИАЛЕН РАЗХОД — праг-ентитет по образеца на BgGarnishmentScale.
    РЕФЕРЕНТНИ ДАННИ. Консумира се от BgSocialExpenseCapResolver, който я ПОЛУЧАВА и само прилага.

    ═══ ЗАЩО ЕНТИТЕТ, А НЕ ПОЛЕ НА ПЕРОТО ═══
    Защото капачката е НА ГРУПА ПЕРА, не на ред. ЗКПО чл. 204 ал. 1 т. 2 буква „а“, ДОСЛОВНО:
    „социалните разходи, предоставени в натура включват и: а) разходите за вноски (премии) за
    допълнително доброволно осигуряване, за доброволно здравно осигуряване и за застраховки
    „Живот““ — ТРИ различни разхода, а чл. 213 ал. 2 дава ЕДНА данъчна основа за тях: „превишението
    на ТЕЗИ РАЗХОДИ над 60 лв. месечно за всяко наето лице“. Тоест 60 лв. са за трите ЗАЕДНО.
    Записана като поле на перото, капачката щеше да е по 60 на всяко — тройно надценено облекчение,
    при което всяко перо поотделно изглежда вярно.

    Същото за ЗДДФЛ чл. 24 ал. 2 т. 11: „стойността на еднократните помощи, предоставени от
    работодателя за сметка на социалните разходи при: раждане или осиновяване на дете, сключване на
    граждански брак или смърт на член от семейството — ОБЩО до 2400 лв.“ Думата „общо“ е в закона.

    ═══ ДВЕ ОСИ, ДВЕ КОЛОНИ — И ДНЕС СЪВПАДАТ ═══
    ЛИЦЕ (ЗДДФЛ): облагаем ли е доходът на лицето и до какъв праг. Това е на фиша.
    ПРЕДПРИЯТИЕ (ЗКПО, данък върху разходите): каква е МЕСЕЧНАТА данъчна основа за всяко наето лице.

    Двете суми са 60 и 60, съответно 200 и 200 — и въпреки това са ДВЕ колони, защото идват от ДВЕ
    РАЗЛИЧНИ НОРМИ, които могат да се разминат с една поправка на едната. Точно този довод вече е
    приложен веднъж в този модул при employerRate/employeeRate на осигурителната вноска: съвпадащи
    днес стойности, сляти в една колона, правят разминаването НЕПРЕДСТАВИМО, а не невъзможно.

    ⚠️ ГОДИШНИЯТ ФИРМЕН ДАНЪК НЕ Е ТУК И НЕ Е В ТОЗИ МОДУЛ ДНЕС. ЗКПО чл. 213 ал. 1 и чл. 214 ал. 1
    са изрични: годишната данъчна основа е „СУМАТА ОТ ДАНЪЧНИТЕ ОСНОВИ ЗА МЕСЕЦИТЕ на календарната
    година“. Оттам следва, че МЕСЕЧНАТА пер-лице основа е самостоятелна и напълно определена величина
    — тя е тухлата, от която годишната се сглобява. Тя се записва на фиша (BgPaySlip
    bgSocialExpenseTaxBase). Ставката 10 на сто, натрупването през 12 месеца × N лица и
    декларирането са ОТДЕЛЕН отчет и решение за обхват — записано, не построено.

    ═══ ЗАЩО ДАННИ, А НЕ ЧИСЛО В JAVA ═══
    Праговете са ТЕМПОРАЛНИ: чл. 208 е менян през 2016 и 2021 г., чл. 209а е НОВ от 01.01.2024 г., а
    предшественикът му чл. 209 (ваучери на ХАРТИЕН носител) е ОТМЕНЕН от 01.01.2025 г. Закована
    сума в Java не може да смята МИНАЛ период по редакцията, валидна ТОГАВА.

    ═══ ⚠️ СУМИТЕ СА ПРЕОБРАЗУВАНИ, А НЕ ПРОЧЕТЕНИ ═══
    Актовете още се печатат в ЛЕВА: чл. 208 казва „60 лв.“, чл. 214 ал. 2 — „200 лв.“, чл. 24 ал. 2
    т. 11 ЗДДФЛ — „2400 лв.“ Евро стойностите идват по Закона за въвеждане на еврото: чл. 11 ал. 2
    (левовите стойности в заварени актове СЕ СЧИТАТ за стойности в евро по правилата на чл. 12 и 13),
    чл. 12 (дели се на пълния курс 1,95583 без закръгляне и без съкращаване на курса) и чл. 13 ал. 1
    (резултатът се закръгля до втория знак по третия, тоест половина нагоре). Проверено срещу ЗКПО и
    ЗДДФЛ (редакции 2026 г.) на 26.08.2026 г.: НЯМА изменителна норма, която да закръгля тези три
    прага на кръгло евро. Котвата е левовото число; сверява се от BgSocialExpenseCapSeedFileTest.

    ═══ ⚠️ ПРАЗНАТА КЛЕТКА СТИГА ДО БАЗАТА КАТО НУЛА, НЕ КАТО NULL ═══
    Същият капан като при BgGarnishmentScale, и по същата причина: генерираните getter-и за decimal
    връщат ZERO, а за Boolean — FALSE. Затова резолверът пита signum(), НИКОГА за null, а „няма
    фирмена ос“ НЕ се пише като празна фирмена сума — то си има СВОЙ признак
    (bgCompanyTaxApplies). Празна сума и сума нула са неразличими; „не се дължи данък върху
    разходите“ и „дължи се върху всичко“ са противоположни. Слети в едно поле, помощта при раждане
    щеше да влиза ЦЯЛА в данъчната основа на предприятието. -->
  <entity name="BgSocialExpenseCap">

    <string name="code" title="Код" required="true"
      help="DDO_HEALTH_LIFE, FOOD_VOUCHERS, ONE_OFF_AID. Стабилен ключ — по него сочат перата."/>
    <string name="name" title="Наименование" required="true" namecolumn="true"/>

    <!-- ═══ ОСТА ЛИЦЕ (ЗДДФЛ) ═══ -->
    <decimal name="bgPersonalCapAmount" title="Лична капачка (EUR)" precision="20" scale="2"/>
    <string name="bgPersonalLegalBasis" title="Основание · ос ЛИЦЕ (ЗДДФЛ)" large="true"/>

    <!-- ═══ ОСТА ПРЕДПРИЯТИЕ (ЗКПО, данък върху разходите) ═══
      ⚠️ bgCompanyTaxApplies Е ОТДЕЛЕН ПРИЗНАК, А НЕ „сума нула“. ЗКПО дели социалните разходи на
      две по чл. 204 ал. 1 т. 2 и чл. 205: предоставените В НАТУРА се облагат с данък върху
      разходите; тези, които НЕ са в натура и представляват доход на физическо лице, се облагат по
      реда на ЗДДФЛ. Еднократната помощ при раждане е пари и попада във втория случай — тоест за нея
      данък върху разходите НЯМА и месечната ЗКПО основа е нула ПО ПРИРОДА, а не защото капачката е
      празна. -->
    <boolean name="bgCompanyTaxApplies" title="Дължи се данък върху разходите (ЗКПО чл. 204 ал. 1 т. 2)"
      default="true"/>
    <decimal name="bgCompanyCapAmount" title="Фирмена капачка (EUR)" precision="20" scale="2"/>
    <string name="bgCompanyLegalBasis" title="Основание · ос ПРЕДПРИЯТИЕ (ЗКПО)" large="true"/>

    <string name="bgPeriodicity" title="Период на капачката"
      selection="bg.social.expense.periodicity.select" required="true"/>

    <!-- ⚠️ ЦЕЛИЯТ РАЗМЕР ПРИ НЕИЗПЪЛНЕНО УСЛОВИЕ — ЗКПО чл. 213 ал. 3 и чл. 214 ал. 3, ДОСЛОВНО:
      „Когато не е изпълнено условието за освобождаване от данък по чл. 208, данъчната основа за
      определяне на данъка върху разходите е ЦЕЛИЯТ РАЗМЕР на начислените разходи за календарния
      месец.“ (чл. 214 ал. 3 казва същото за чл. 209а.)

      Тоест паднало условие НЕ намалява облекчението — то го ЗАЛИЧАВА. Разликата при ваучер 150,00
      EUR е между 47,74 и 150,00 в основата, тоест между 4,77 и 15,00 данък: три пъти, а на фиша
      всяко число изглежда сметнато. Затова полето на фиша се казва „месечна ЗКПО основа“, а НЕ
      „превишение“ — в болния случай тя не е превишение и името не бива да лъже точно там. -->
    <boolean name="bgWholeAmountOnConditionFail" title="При паднало условие — ЦЕЛИЯТ размер"
      default="false"/>

    <!-- ═══ КОИ УСЛОВИЯ ОБВЪРЗВАТ ТАЗИ КАПАЧКА ═══
      ⚠️ ДЕКЛАРИРАНИ ТУК, А НЕ ИЗВЕДЕНИ ОТ КОДА НА КАПАЧКАТА. Резолверът НЕ познава нито един код:
      той пита реда кои условия го обвързват и проверява точно тях. Написано с `if
      ("FOOD_VOUCHERS".equals(code))`, добавянето на четвърта капачка щеше да иска комит в Java, а
      нова редакция на чл. 209а — да се търси къде е скрит кодът.

      Разпределението днес: чл. 208 обвързва 60-те САМО с публичните задължения; чл. 209а ал. 1
      обвързва ваучерите с ТРИТЕ едновременно; еднократните помощи по чл. 24 ал. 2 т. 11 ЗДДФЛ
      нямат нито едно. -->
    <boolean name="bgRequiresNoPublicDebts" title="Изисква: без публични задължения"
      default="false"
      help="ЗКПО чл. 208 (за 60-те) и чл. 209а ал. 1 т. 2 (за ваучерите). ФИРМЕНО-месечно условие."/>
    <boolean name="bgRequiresSalaryNotBelowAverage" title="Изисква: заплата ≥ 3-мес. средна"
      default="false"
      help="ЗКПО чл. 209а ал. 1 т. 1. ПЕР-ЛИЦЕ условие — пада за едно лице, не за фирмата."/>
    <boolean name="bgRequiresLicensedOperator" title="Изисква: лицензиран оператор"
      default="false" help="ЗКПО чл. 209а ал. 1 т. 3. ФИРМЕНО условие."/>

    <date name="validFrom" title="В сила от" required="true"/>
    <date name="validTo" title="В сила до"/>

    <string name="note" title="Бележка" large="true"/>

    <unique-constraint columns="code,validFrom"/>

  </entity>

</domain-models>
