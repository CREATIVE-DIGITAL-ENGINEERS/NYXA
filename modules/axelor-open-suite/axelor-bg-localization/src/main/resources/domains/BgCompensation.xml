<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ОБЕЗЩЕТЕНИЕТО КАТО ДОКУМЕНТ: с номер, жизнен цикъл и замразени стойности. ═══ ГЛАВНОТО РЕШЕНИЕ:
    ДОКУМЕНТЪТ ПАЗИ СУМАТА, ФИШЪТ Я ЧЕТЕ ═══ Заповедта за прекратяване е подписана на конкретна дата с конкретно
    число. Ако БТВ се промени после, или каталогът смени размера си, ПОДПИСАНИЯТ ДОКУМЕНТ НЕ СЕ ПРОМЕНЯ.
    Документ, който се преизчислява ретроактивно, е грешен по определение — той твърди за миналото нещо,
    което тогава не е било вярно. Затова при потвърждаване се ЗАМРАЗЯВАТ върху самия документ: сумата, базата
    (кое БТВ и за кой месец), видът на базата и данъчното и осигурителното третиране. Трите последни са КОПИЯ
    от BgCompensationType, а не препратки — препратка би се променила заедно с каталога и точно това трябва
    да се избегне. ═══ ⚠️ ОТНОШЕНИЕТО КЪМ BgTerminationCompensation — ПРОЧЕТИ, ПРЕДИ ДА ПИШЕШ КОД СРЕЩУ ДВЕТЕ
    ═══ В модула ВЕЧЕ има BgTerminationCompensation и той също е „обезщетение за договор“. Двата записа НЕ
    са дубликат, но и не са независими: BgTerminationCompensation е ПРАВОТО. Предлага се АВТОМАТИЧНО при
    запис на прекратен договор (BgEmploymentContractManagementRepository → BgTerminationCompensationService),
    уникален е по (договор, вид) — тоест едно право за една двойка, завинаги — и състоянията му са PROPOSED,
    CONFIRMED, EXCLUDED. Плащанията му са ДЪЩЕРНИ записи (BgCompensationPayment), защото регистърът по ПМС
    № 267/2024 брои седемдневния срок от ВСЯКО плащане поотделно. BgCompensation (тук) е ДОКУМЕНТЪТ. Има
    номер, замразява стойности и се ОТКАЗВА, вместо да се поправя — тоест за една и съща двойка (договор,
    вид) може да има няколко документа във времето: един отказан и един нов. Точно затова тук НЯМА уникално
    ограничение по (договор, вид) — то би направило поправката чрез отказ невъзможна. ⚠️ ТРИ ВЪПРОСА, КОИТО
    ТОВА ОСТАВЯ ОТВОРЕНИ и които НЕ се решават в тази стъпка: 1. Носи ли документът препратка към правото.
    Носи (bgTerminationCompensation, по-долу) — и я пише „Създай документ“ на правото.
    2. bgPaidDate тук е ЕДНА дата, а BgCompensationPayment вече моделира МНОГО плащания. Ако едно обезщетение
    се погасява на части, тази дата може да носи само последното. Полето е сложено, защото спецификацията
    го иска, но при разсрочено плащане детските записи са по-верният източник. 3. Кой от двата записа чете
    фишът. Спецификацията казва „фишът чете документа“. Докато трите стоят отворени, ДВАТА ЗАПИСА НЕ БИВА
    да се пълнят от един и същи процес. Наименованието е на спецификацията на блок Ф (§ 4.2),
    не е измислено тук. -->
  <entity name="BgCompensation">

    <!-- Номер от редицата bgCompensation НА ДРУЖЕСТВОТО. ⚠️ Без редица за дружеството записът се ОТКАЗВА
      с името му — резервен брояч няма (заварените номера OBEZ-RES-… остават).
      Уникален по (company, reference), не глобално — виж ограничението долу. -->
    <string name="reference" title="Номер" readonly="true"/>

    <!-- ДРУЖЕСТВОТО, В ЧИЙТО БРОЯЧ Е НОМЕРЪТ: платецът по договора. Записва се при номерирането и после НЕ
      СЕ СМЕНЯ (BgCompensationManagementRepository; по старото състояние — BgTrzNumberingCompanyGuard).
      ⚠️ САМО ЗА УНИКАЛНОСТТА (company, reference): никой не го чете (BgQueryFieldTest). Платецът е договорът.
      Nullable само заради заварените редове до миграцията за номерата по дружество. -->
    <many-to-one name="company" title="Дружество" ref="com.axelor.apps.base.db.Company" readonly="true"/>

    <!-- Служителят се чете ПРЕЗ договора, а не се дублира като поле: две препратки към едно и също лице
      се разминават в деня, в който някой смени договора. -->
    <many-to-one name="employmentContract" title="Трудов договор" required="true"
      ref="com.axelor.apps.hr.db.EmploymentContract"/>
    <many-to-one name="bgCompensationType" title="Вид обезщетение" required="true"
      ref="com.axelor.apps.bglocalization.db.BgCompensationType"/>
    <string name="bgTerminationGround" title="Основание за прекратяване"
      selection="bg.termination.ground.select"/>

    <!-- ПРАВОТО, което този акт признава. NULLABLE НАРОЧНО: обезщетенията по чл. 220 и чл. 221 се пораждат
      от НЕСПАЗЕНО ПРЕДИЗВЕСТИЕ, а не от основание за прекратяване, тоест може изобщо да нямат ред в правото.
      Задължителна връзка би направила такъв документ невъзможен. Разделението на ролите, за да не се търси
      в две таблици: BgTerminationCompensation = ПРАВОТО — какво се полага. Възниква веднъж, оттам и уникалният
      ключ (договор, вид). Автоматичното предлагане живее там. BgCompensation = АКТЪТ — какво е признато и
      платено. Има номер и състояние, замразява сумата си, отказва се и се заменя с нов. ⚠️ ФИШЪТ ЧЕТЕ ДОКУМЕНТА,
      НЕ ПРАВОТО. Правото казва „полага се“, документът казва „признато е толкова, на тази дата“ — на фиша
      влиза второто. ⚠️ ЗАПИСАН ДЪЛГ ЗА СТЪПКА 4: реконсилиацията между двете. Днес НИКОЙ процес не пълни двата
      записа наведнъж и това е нарочно. Единственото, което ги свързва, е проверката при потвърждаване — сумата
      на документа срещу сбора на плащанията по правото.
      ═══ ПРАВО ПРЕДИ ПАРИ ═══ Връзката ИМА писач: „Създай документ“ на ПОТВЪРДЕНО
      право (BgCompensationService#createFromEntitlement). За видовете с arisesOnTermination „Потвърди“
      ИСКА връзката — потвърдено право за същия договор и вид, прекратен основен договор, същата дата на
      прекратяване (BgCompensationResolver#refuseWithoutEntitlement). Ръчно създаден документ без връзка
      се отказва шумно. За видовете ПО ВРЕМЕ на договора (чл. 200, 213, 214, 216, 217, 232) връзката
      остава празна — право там няма. Полето е само за четене във формата: пише го само действието. -->
    <many-to-one name="bgTerminationCompensation"
      title="Право (предложено при прекратяване)"
      ref="com.axelor.apps.bglocalization.db.BgTerminationCompensation"/>

    <!-- ═══ ФАКТИЧЕСКИТЕ ПОЛЕТА, БЕЗ КОИТО НЯМА ОСНОВАНИЕ ═══ Сумата се признава срещу факт, а не
      срещу бележка. Липсващият факт спира „Потвърди“ с назована причина
      (BgCompensationResolver#refuseMissingFacts):
      · чл. 220 — срокът на предизвестието (начало и календарни дни, полетата по-долу);
      · чл. 221 — основанието за прекратяване (bgTerminationGround);
      · чл. 225 ал. 1 — влязлото в сила съдебно решение, с което уволнението е признато за незаконно:
        номер и дата на влизане в сила;
      · чл. 226 ал. 2 — датата на вписване на прекратяването в регистъра (ЕТЗ): до нея тече периодът,
        за който се дължи обезщетението. -->
    <string name="bgCourtDecisionNumber" title="Съдебно решение №"
      help="Решението, с което уволнението е признато за незаконно (чл. 225 ал. 1 КТ)."/>
    <date name="bgCourtDecisionEffectiveDate" title="Решението е влязло в сила на"/>
    <date name="bgEtzRegistrationDate" title="Вписано в ЕТЗ на"
      help="Датата, на която прекратяването е вписано в регистъра на трудовите договори (чл. 226 ал. 2 КТ)."/>

    <!-- Датата, на която е ВЪЗНИКНАЛО основанието — обикновено датата на прекратяване. От нея се извеждат
      и месецът на базата (чл. 228 ал. 1), и срокът за плащане (чл. 228 ал. 3), затова е required: без нея
      двете са налучкване. -->
    <date name="bgEventDate" title="Дата на основанието" required="true"/>

    <!-- ═══ БАЗА, ЧЛ. 228 АЛ. 1 КТ ═══ Брутното трудово възнаграждение за определяне на обезщетенията
      по този раздел е полученото за МЕСЕЦА, ПРЕДХОЖДАЩ месеца, в който е възникнало основанието, или последното
      получено месечно брутно трудово възнаграждение. Оттам следват ДВЕ полета, а не едно: кой месец е взет
      и колко е бил. Ако се пази само сумата, след година никой не може да каже дали е взет предходният месец,
      или „последното получено“ — а това е разликата, за която се спори. Полетата остават редактируеми в DRAFT,
      защото при неплатен отпуск или новопостъпил служител автоматично избраният месец може да е празен. -->
    <date name="bgBaseMonth" title="Месец на базата"/>
    <decimal name="bgBaseMonthGross" title="БТВ за месеца" precision="20" scale="2"/>

    <!-- КОПИЕ от BgCompensationType.baseKind при създаване, НЕ препратка. Ако утре каталогът смени вида
      на базата, вече издаденият документ трябва да продължи да казва по какво е сметнат. -->
    <string name="bgBaseKind" title="Вид база" selection="bg.compensation.base.select"/>
    <!-- ⚠️ ЕДИНИЦАТА ЗАВИСИ ОТ ВИДА БАЗА и е изписана в заглавието на всяка опция на bg.compensation.base.select:
      BTV_MONTHS → МЕСЕЦИ (1.00 = едно брутно трудово възнаграждение) UNUSED_LEAVE_DAYS → РАБОТНИ дни неползван
      отпуск NOTICE_DAYS → РАБОТНИ дни неспазено предизвестие При двете бази в дни сумата е (месечно БТВ ÷
      bgBaseWorkingDays) × количество, тоест делителят и множителят са в ЕДНА единица. Едномесечно предизвестие
      се въвежда като работните дни в него и дава точно едно месечно възнаграждение. Смесването — работни дни
      в делителя, календарни в множителя — плаща 143 на сто от заплата и изглежда правдоподобно. -->
    <decimal name="bgQuantity" title="Количество (месеци / работни дни)" precision="10"
      scale="2"/>

    <!-- ═══ ЧЛ. 220 Е ДВУСТЪПКОВ, И ТОВА Е ЦИТАТ, НЕ ИЗВОД ═══ КТ чл. 326 ал. 2: срокът на предизвестието
      при безсрочен трудов договор е 30 дни, доколкото страните не са уговорили по-дълъг, но не повече от 3
      месеца; при срочен е 3 месеца, но не повече от остатъка от срока. Ал. 4: срокът тече от следващия ден
      на получаването. Тоест срокът се мери в КАЛЕНДАРНИ дни. НСОРЗ чл. 18 ал. 1: среднодневното брутно трудово
      възнаграждение се получава, като начисленото БТВ се раздели на броя на ОТРАБОТЕНИТЕ дни. НСОРЗ чл. 19
      ал. 1: обезщетението се получава, като среднодневното БТВ се умножи по броя на РАБОТНИТЕ дни за периода.
      Оттам: срокът е календарен, а обезщетението покрива РАБОТНИТЕ дни В НЕГО. Тридесет календарни дни от
      1 април съдържат друг брой работни дни от тридесет календарни дни от 1 декември — 20 срещу 19 за 2026
      г. Затова тук се пазят НАЧАЛОТО и ДЪЛЖИНАТА на срока, а количеството се ИЗВЕЖДА от тях. Изведеното остава
      редактируемо в чернова: ТРЗ вижда случаи, които календарът не знае. Разминаването се показва, а не се
      мълчи. -->
    <date name="bgNoticeStartDate" title="Начало на предизвестието"
      help="Денят, от който тече срокът — по чл. 326 ал. 4 това е следващият ден на получаването."/>
    <integer name="bgNoticeCalendarDays" title="Срок на предизвестието (календарни дни)"
      help="30 по подразбиране за безсрочен трудов договор — чл. 326 ал. 2 КТ."/>

    <!-- ⚠️ ПОЛЕ ОТВЪД СПЕЦИФИКАЦИЯТА, добавено нарочно. При базите в ДНИ (неползван отпуск, неспазено
      предизвестие) сумата е СРЕДНОДНЕВНО БТВ × дни, а среднодневното се извежда от месечното чрез делител.
      Без записан делител замразената сума е непроверима: след година никой не може да каже дали са делили
      на 21, на 22 или на друго. Затова делителят се пази ЗАЕДНО с резултата. Празно при базите в месеци —
      там не участва. ⚠️ Откъде се четат работните дни (производствен календар) е отделен въпрос: тук полето
      само се пази, не се попълва автоматично. -->
    <integer name="bgBaseWorkingDays" title="Работни дни в месеца на базата"/>

    <!-- ДВЕ СУМИ, НАРОЧНО. Ако се пази само една, изчислението изчезва в мига, в който някой го поправи,
      и после няма как да се каже дали е коригирано и с колко. ⚠️ И ВТОРА ПРИЧИНА, ОТКРИТА ПО-КЪСНО: двете
      суми заедно правят „коригирано на ръка“ РАЗЛИЧИМО от „непопълнено“, без да е нужен отделен признак. Навсякъде
      другаде в модула въпросът „човек ли е сложил това число“ се свежда до „празно ли е полето“ — а генерираните
      getter-и за decimal връщат ZERO вместо null, тоест празно и нула са неразличими. Тук този въпрос НЕ се
      задава на полето: recompute презаписва окончателната сума само докато тя още повтаря ПРЕДИШНАТА изчислена.
      Оттам ръчно въведена нула оцелява — тя се различава от изчислената сума и затова е решение, а не празнота.
      ⚠️ НЕ „ПОПРАВЯЙ“ ТОВА НА signum() == 0. Изглежда като същия капан и не е: така въведената на ръка нула
      би минала за непопълнена и следващото преизчисляване би я изтрило. Виж BgCompensationService#recompute. -->
    <decimal name="bgComputedAmount" title="Изчислена сума" precision="20" scale="2"
      readonly="true"/>
    <decimal name="bgFinalAmount" title="Сума за изплащане" precision="20" scale="2"/>
    <string name="bgAdjustmentReason" title="Причина за корекцията" large="true"/>

    <!-- Попълва се от вида при създаване и НЕ се редактира: посоката е свойство на нормата, не на случая.
      Обезщетенията по чл. 220 ал. 2 и чл. 221 ал. 2 се дължат ОТ лицето НА работодателя. -->
    <string name="bgDirection" title="Посока на задължението"
      selection="bg.compensation.direction.select" readonly="true"/>

    <!-- КОПИЯ от вида при ПОТВЪРЖДАВАНЕ. Данъчният и осигурителният режим на подписан документ не се
      мени със задна дата, дори когато каталогът се поправи. -->
    <boolean name="bgIsTaxable" title="Облагаемо по ЗДДФЛ"/>
    <boolean name="bgSocialContributionsDue" title="Дължими осигурителни вноски"/>

    <!-- ═══ СРОК ЗА ПЛАЩАНЕ, ЧЛ. 228 АЛ. 3 КТ ═══ Обезщетенията се изплащат не по-късно от последния
      ден на месеца, СЛЕДВАЩ месеца, през който правоотношението е прекратено, освен ако в колективния трудов
      договор не е договорен друг срок. След този срок се дължи законната лихва. Оттам полето е редактируемо:
      КТД може да е договорил друго. Подразбирането е последният ден на следващия месец — 15.03.2026 дава 30.04.2026.
      ⚠️ ЛИХВАТА НЕ СЕ СМЯТА В ТАЗИ СТЪПКА. Документът само се маркира като просрочен, когато срокът е минал,
      а bgPaidDate е празна. Изчислена лихва без правило за закръгляне и без база е по-лоша от липсваща. -->
    <date name="bgDueDate" title="Срок за изплащане"/>
    <date name="bgPaidDate" title="Дата на изплащане"/>

    <!-- ⚠️ BgPayrollPeriod НЕ СЪЩЕСТВУВА в модула (проверено: няма домейн, няма и следа в кода). Затова
      тук стои гола дата, а не препратка — и това е ЗАПИСАН ДЪЛГ, не решение: когато периодите на ведомостта
      се появят, това поле става m2o и мигрира. Ентитет не се измисля тук. -->
    <date name="bgPayoutPeriod" title="Период на изплащане (месец)"/>

    <string name="statusSelect" title="Състояние"
      selection="bg.compensation.doc.status.select" default="DRAFT" required="true"/>
    <string name="bgCancelReason" title="Причина за отказа" large="true"/>

    <!-- ⚠️ ВХОДЪТ НА БУТОНА „Откажи“ — transient, НЕ се пази. Причината се записва в bgCancelReason
      САМО от успешния отказ, в неговата транзакция. bgCancelReason се показва едва СЛЕД отказа и
      само за четене, а отказът иска причината ПРЕДИ — затова входът е отделен. Същият идиом като
      BgPaySlip.bgCancelReasonInput: написана и записана с „Запиши“, причината би стояла върху
      документ, който никой не е отказал. -->
    <string name="bgCancelReasonInput" title="Причина за отказа" large="true" transient="true"/>
    <string name="note" title="Забележка" large="true"/>

    <!-- ⚠️ НЯМА уникално ограничение по (employmentContract, bgCompensationType). Виж коментара горе:
      поправката става чрез отказ и нов документ, тоест няколко документа за една двойка са НОРМАЛНО състояние,
      а не дефект. Ограничението живее при правото (BgTerminationCompensation), не тук. -->

    <!-- Номерът е уникален В ДРУЖЕСТВОТО. ddl=update не сваля старото глобално ограничение по reference —
      сваля го миграцията db/migration/2026-10-21-trz-numbering-per-company.sql. -->
    <unique-constraint name="uk_bg_compensation_company_reference" columns="company,reference"/>

  </entity>

</domain-models>
