<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- УДОСТОВЕРЕНИЕ ПРИЛОЖЕНИЕ № 9 — ОБСТОЯТЕЛСТВАТА ПО РАЗДЕЛ I, Т. 1–26, ЗА ЕДИН БОЛНИЧЕН ЛИСТ.

    ═══ СВЕРЕНО С ПЪРВОИЗТОЧНИКА ═══ НПОПДОО, Приложение № 9 към чл. 8 ал. 1 и чл. 11 ал. 1
    (ДВ бр. 115 от 2025 г., в сила от 1.01.2026 г.) — образецът И указанията към него. Същата
    редакция, която Ф0 ползва за т. 9. Всяко поле по-долу носи номера на точката, която пълни;
    полета без номер на точка са жизненият цикъл на записа, не обстоятелство.

    ═══ ЗАЩО ОТДЕЛЕН ЗАПИС, А НЕ ПОЛЕТА ВЪРХУ БОЛНИЧНИЯ ═══ Обстоятелствата не са свойства на
    ЛИСТА, а ДЕКЛАРАЦИЯ за него: те се подават, коригират и заличават като едно цяло, носят свой
    пореден номер (т. 6) и свое състояние. Разсипани по BgSickLeave, те щяха да смесят документа
    на лечебното заведение с твърдението на осигурителя пред НОИ — а второто се мени, без първото
    да е мръднало. Един лист → най-много едно удостоверение по раздел I, оттам one-to-one с unique.

    ═══ ⚠️ ЗАЩО ВСЯКО „ДА/НЕ“ ТУК Е НИЗ СЪС СЕЛЕКЦИЯ, А НЕ boolean ═══ ТОВА Е НАЙ-ВАЖНОТО
    РЕШЕНИЕ В ЦЕЛИЯ ЗАПИС. Генерираният getter за Boolean връща FALSE при NULL колона (закова се
    от BgDefaultedGetterTest). Тоест „резолверът изведе НЕ“ и „резолверът още не е пускан“ биха
    пристигнали като ЕДНА И СЪЩА стойност. За т. 1 това значи неотличимо „лицето не е осигурено“
    от „не е питано“, а за т. 16–23 е още по-остро: те са ОТРИЦАТЕЛНИ декларации („детето не е
    дадено за осиновяване“), тоест FALSE-при-NULL превръща непопълненото в ДЕКЛАРИРАНО ОТРИЦАНИЕ
    пред НОИ. Затова тук няма нито един boolean: null значи „няма отговор“, и то се вижда.

    ═══ КАКВО ТОЗИ ЗАПИС НЕ ПРАВИ ═══ НЕ ИЗНАСЯ НИЩО. Няма generatedFile, няма XML, няма XSD, няма
    транспорт до НОИ — това е Ф2. Записът е ОБСТОЯТЕЛСТВАТА, а не удостоверението като файл. И не
    смята пари: перото по чл. 40 ал. 5 КСО се смята от BgSickLeaveResolver и НЕ чете оттук.

    ═══ РАЗДЕЛ II НЕ Е ТУК, И ТОВА Е ОБЯВЕНО ═══ „Удостоверявам следните ПРОМЕНИ в обстоятелствата“
    (раздел II, т. 1–16) е ДРУГО подаване с друг повод: подава се в 3-дневен срок ОТ ПРОМЯНАТА и
    може да съпътства раздел I или да стои само. Свит в същия запис, той щеше да пренапише
    декларираното, вместо да го допълни — а НОИ иска и двете. Отделен запис, когато дойде Ф2.

    ⚠️ ВСИЧКИ КОЛОНИ ОСВЕН sickLeave И statusSelect СА НУЛИРУЕМИ. Нова таблица, тоест unique и
    required върху нея са безопасни; върху ПОПЪЛНЕНА таблица не биха били. -->
  <entity name="BgApp9Declaration">

    <!-- ЛИСТЪТ, ЗА КОЙТО Е УДОСТОВЕРЕНИЕТО. one-to-one с unique, по образеца на AccountConfig.company:
      удостоверението е ЗАВИСИМАТА страна, тоест чуждият ключ е тук, а не върху болничния.
      ⚠️ „За всеки болничен лист“ (чл. 8 ал. 1) — оттам unique. При лице с повече от едно
      правоотношение при СЪЩИЯ осигурител се подава по едно удостоверение за ВСЯКО от тях, но
      всяко от тях е свой болничен лист в този модел (Ф0: „един лист поражда епизод за всеки
      договор на лицето“), тоест unique по листа не пречи на многото удостоверения по т. 5. -->
    <one-to-one name="sickLeave" title="Болничен лист" required="true" unique="true"
      ref="com.axelor.apps.bglocalization.db.BgSickLeave"/>

    <string name="statusSelect" title="Състояние" selection="bg.app9.declaration.status.select"
      default="DRAFT" required="true"/>

    <!-- КОДЪТ ВЪРХУ ЛИЦЕВАТА СТРАНА НА ОБРАЗЕЦА: „ПРЕДСТАВЯНЕ / КОРЕКЦИЯ / ЗАЛИЧАВАНЕ“. Не е точка
      от раздел I, но е обстоятелство на самото удостоверение и без него правилото на указанията
      няма къде да живее: „НЕ СЕ КОРИГИРАТ: номер на болничен лист, ЕГН, ЕИК, брой правоотношения
      (т. 5) и пореден номер на удостоверението (т. 6) — при необходимост удостоверението се
      ЗАЛИЧАВА и се подава ново“. Тоест т. 5 и т. 6 не са редактируеми през „Корекция“, и това е
      норма, не UI предпочитание. Проверката на правилото е Ф2 (тя е част от подаването); полето
      стои тук, за да не се въвежда със задна дата. -->
    <string name="bgSubmissionTypeSelect" title="Вид подаване"
      selection="bg.app9.submission.type.select"/>

    <!-- ═══════════════ Т. 1 — ОСИГУРЕН ЗА РИСКА КЪМ ДЕНЯ НА НАСТЪПВАНЕТО ═══════════════
      „Към деня на настъпване на временната неработоспособност, трудоустрояването или бременността
      и раждането лицето е осигурено за съответния риск – да/не“.
      ⚠️ ДЕНЯТ Е BgSickLeave.bgIncapacityStartDate, НЕ fromDate. Ф0 въведе двете нарочно разделени
      и обяснява защо: листът може да започне по-късно от настъпването. Резолверът ОТКАЗВА при
      празна дата на възникване, вместо да я подмени с fromDate — подменена, тя щеше да изглежда
      вярна до първия закъснял лист. -->
    <string name="bgP1Insured" title="Т. 1 · Осигурен за риска (да/не)"
      selection="bg.app9.yes.no.select"/>

    <!-- Т. 1.1: „по безсрочно/срочно правоотношение до ............ 20..... г.“ Указание: „Ако в
      т. 1.1 е отбелязано, че правоотношението е срочно, се попълва датата, на която изтича срокът
      на договора.“ Датата идва от УГОВОРЕНИЯ край (EmploymentContract.endDate), не от
      bgTerminationDate: второто е действителното прекратяване и то пълни т. 7. -->
    <string name="bgP1TermTypeSelect" title="Т. 1.1 · Срочност на правоотношението"
      selection="bg.app9.term.type.select"/>
    <date name="bgP1TermEndDate" title="Т. 1.1 · Срокът изтича на"/>

    <!-- Т. 1.2: „с безсрочна/срочна регистрация до .............. 20..... г. като самоосигуряващо
      се лице.“ Отделна ос от 1.1, защото при СОЛ няма правоотношение — има РЕГИСТРАЦИЯ. -->
    <string name="bgP1SolRegTypeSelect" title="Т. 1.2 · Срочност на регистрацията (СОЛ)"
      selection="bg.app9.term.type.select"/>
    <date name="bgP1SolRegEndDate" title="Т. 1.2 · Регистрацията изтича на"/>

    <!-- ═══════════════ Т. 2 — ШЕСТ МЕСЕЦА ОСИГУРИТЕЛЕН СТАЖ ЗА ОЗМ ═══════════════
      ⚠️ ПОЛЯРНОСТТА НА ОБРАЗЕЦА Е ОБРАТНА НА ПОЛЯРНОСТТА НА ПРАВОТО, И ТУК СЕ ПАЗИ ПРАВОТО.
      Образецът гласи „лицето НЯМА 6 месеца осигурителен стаж“, а забележката към т. 2 и 3 казва
      „обстоятелството се отбелязва САМО когато лицето НЯМА необходимия осигурителен стаж“. Тоест
      отметката на хартия = НЕ Е ИЗПЪЛНЕНО. Тук се пази ИЗПЪЛНЕНО / НЕ Е ИЗПЪЛНЕНО / НЕ СЕ ОТНАСЯ,
      а превръщането в отметка е на образеца (Ф2) — точно както Ф0 пази и дни, и часове, а изборът
      коя колона да се печата е на образеца. Причината не е вкус: NOT_APPLICABLE (рискът е
      бременност и раждане, тоест важи т. 3, не т. 2) НЕ Е „изпълнено“ и не е „неизпълнено“, а
      върху булева отметка трите състояния стават две и се губи точно онова, което различава
      празната точка от изпълненото условие. Правно основание: КСО чл. 40 ал. 1. -->
    <string name="bgP2SixMonthStaySelect" title="Т. 2 · 6 месеца стаж за ОЗМ"
      selection="bg.app9.stay.select"/>

    <!-- „На ............ 20.... г. лицето придобива изискуемия осигурителен стаж“ — попълва се САМО
      когато тази дата пада В ПЕРИОДА по болничния лист, и тогава е ПОСЛЕДНИЯТ ден, с който стажът
      се набира. ⚠️ РЪЧНО, И ТОВА Е ФЛАГНАТО. Employee.bgInsuranceServiceMonths е стажът в ЦЕЛИ
      МЕСЕЦИ към момента на деклариране, без дата на измерване. От „12 месеца“ не се извежда кой
      КАЛЕНДАРЕН ДЕН стажът е станал шест — за това трябва хронология на осигурителните периоди,
      каквато моделът няма. Изведена от месеците, датата щеше да е правдоподобна и грешна. -->
    <date name="bgP2StayAcquiredDate" title="Т. 2 · Придобива стажа на"/>

    <!-- ═══════════════ Т. 3 — ДВАНАЙСЕТ МЕСЕЦА СТАЖ ЗА ОЗМ (БРЕМЕННОСТ И РАЖДАНЕ) ═══════════════
      Същата полярност и същият тристаен избор като т. 2. Рискът е ДРУГ — „бременността и
      раждането“ — и оттам двете точки са взаимноизключващи се: болничен за временна
      неработоспособност прави т. 3 неотносима и обратно. Правно основание: КСО чл. 48а. -->
    <string name="bgP3TwelveMonthStaySelect" title="Т. 3 · 12 месеца стаж за ОЗМ"
      selection="bg.app9.stay.select"/>
    <date name="bgP3StayAcquiredDate" title="Т. 3 · Придобива стажа на"/>

    <!-- ═══════════════ Т. 4 — КОД ЗА ВИД ОСИГУРЕН ПО ДЕКЛАРАЦИЯ ОБР. № 1 ═══════════════
      „в две позиции се попълва кодът за «Вид осигурен» КЪМ ДЕНЯ НА НАСТЪПВАНЕТО на риска“.
      ⚠️ БЕЗ selection, И ТОВА Е НАРОЧНО. Образецът изброява СВОЙ, ПО-ТЯСЪН набор от кодове
      (01; 02; 03; 04; 05; 06; 07; 08; 09; 10; 12; 13; 16; 17; 21; 24; 25; 26; 71; 72; 82; 83; 92;
      93; 95; 96; 99), който НЕ съвпада с bg.insured.type.select: образецът допуска 07, 21 и 93,
      които номенклатурата на модула не носи, а модулът носи 14, 18, 22, 27, 86, 91, 97 и още,
      които образецът НЕ допуска. Вързано за bg.insured.type.select, полето щеше да ПОКАЗВА като
      валидни кодове, които НОИ отказва, и да прави непредставими три, които иска. Втора селекция
      със свой набор би била втора номенклатура за същото нещо. Затова стойността е гол низ,
      КОПИРАН от договора, а допустимостта я казва СВИДЕТЕЛЯТ на резолвера — назована причина
      („код 14 е труд без трудово правоотношение, за него т. 4 не допуска стойност“) вместо
      мълчаливо преписване. -->
    <string name="bgP4InsuredTypeCode" title="Т. 4 · Код за вид осигурен"/>

    <!-- ═══════════════ Т. 5 — БРОЙ ПРАВООТНОШЕНИЯ ПРИ ОСИГУРИТЕЛЯ ═══════════════
      „броят на правоотношенията или основанията, по които лицето е осигурено при ЕДИН ОСИГУРИТЕЛ
      (СЪЩИЯ ЕИК) към деня на настъпването на риска“. ⚠️ ОСТА Е ЕИК, НЕ „лицето изобщо“.
      Резолверът брои активните договори при payCompany на този договор и НЕ добавя
      bgInsuredOnOtherGround — виж свидетеля му за причината. -->
    <integer name="bgP5RelationshipCount" title="Т. 5 · Брой правоотношения при осигурителя"/>

    <!-- ═══════════════ Т. 6 — ПОРЕДЕН НОМЕР НА УДОСТОВЕРЕНИЕ № 9 ═══════════════
      ⚠️ НЕ Е БРОЯЧ ПО ЛИЦЕ. Указанието е дословно: „в две позиции се попълва поредният номер на
      удостоверението В ЗАВИСИМОСТ ОТ БРОЯ НА ПРАВООТНОШЕНИЯТА/ОСНОВАНИЯТА за осигуряване,
      ПОСОЧЕНИ В Т. 5“. Тоест номерът се движи в 1..т.5 и брои удостоверенията ЗА ТОЗИ РИСК при
      ТОЗИ осигурител, а не всички удостоверения, издавани някога на човека. Брояч по лице би
      растял до трицифрен, докато полето е с ДВЕ позиции, и щеше да се разминава с т. 5 по
      построение. Виж свидетеля на резолвера. -->
    <integer name="certificateSeqNo" title="Т. 6 · Пореден номер на удостоверението"/>

    <!-- ═══════════════ Т. 7 — ПРЕКРАТЕНО ПРАВООТНОШЕНИЕ ═══════════════
      „Считано от ............ 20..... г. правоотношението/осигуряването на лицето е прекратено“.
      ⚠️ ДАТАТА НЕ Е ДАТАТА НА ПРЕКРАТЯВАНЕ. Указанието: „Датата, от която е прекратено
      правоотношението или осигуряването, е КАЛЕНДАРНИЯТ ДЕН НЕПОСРЕДСТВЕНО СЛЕД последния
      календарен ден, през който лицето е осигурено.“ Тоест bgTerminationDate + 1 ден. Записана
      без прибавения ден, стойността твърди, че лицето не е осигурено в ден, в който е — и точно
      този ден носи работни дни в т. 9. -->
    <date name="bgP7TerminatedFrom" title="Т. 7 · Прекратено считано от"/>

    <!-- ═══════════════ Т. 8 — ПРЕКЪСНАТО ОСИГУРЯВАНЕ ═══════════════
      „попълва се, ако правоотношението НЕ е прекратено, но осигуряването е прекъснато и НЕ е
      възобновено преди деня на настъпването на риска“. Същото правило „последен осигурен ден + 1“.
      ⚠️ РЪЧНО, И ТОВА Е ФЛАГНАТО. Указанието изброява поводите: самоотлъчка, неплатен отпуск,
      който не се зачита за осигурителен стаж, работа през определени дни в месеца, и периодите,
      които не се зачитат за осигурителен стаж. Само последният от тях има носител в модела
      (bgContractType = 114) и той сам не дава ДАТА — при работа през определени дни осигуряването
      се прекъсва и възобновява многократно в месеца, а точката иска ЕДНА дата, и то с условието
      „не е възобновено ПРЕДИ деня на настъпване“. Резолверът ПРЕДЛАГА в свидетеля си, когато
      види чл. 114 или незачитан неплатен отпуск, и не пише в полето. -->
    <date name="bgP8InterruptedFrom" title="Т. 8 · Прекъснато считано от"/>

    <!-- ═══════════════ Т. 9 — РАБОТНИ ДНИ/ЧАСОВЕ ═══════════════ НЯМА ПОЛЕ ТУК, И ТОВА Е РЕШЕНИЕТО.
      Редовете са BgSickLeave.bgPeriodLineList (Ф0) и се ПИШАТ от пресмятането на фиша. Копирани
      или преизчислени тук, те щяха да са втора сметка на нещо, което BgSickLeaveResolver вече е
      сметнал, и двете щяха да се разминат при първата поправка на фиша. Резолверът на
      обстоятелствата само РЕФЕРИРА: свидетелят му казва колко реда и колко дни е видял и че
      числата идват от Ф0. -->

    <!-- ═══════════════ Т. 10 — ТРУДОУСТРОЯВАНЕ ═══════════════ РЪЧНО, ЦЯЛОТО.
      „попълва се САМО когато удостоверението се представя за болничен лист за ТРУДОУСТРОЯВАНЕ.
      За дати … се попълват датите за трудоустрояване, посочени в ЗАПОВЕДТА на работодателя.“
      Заповедта за трудоустрояване няма носител в модела — нито номер, нито дати, нито предписание
      на органа. Затова четирите полета са входни. -->
    <date name="bgP10RehabFrom" title="Т. 10 · Трудоустроен от"/>
    <date name="bgP10RehabTo" title="Т. 10 · Трудоустроен до"/>
    <string name="bgP10OrderNo" title="Т. 10 · Заповед №"/>
    <date name="bgP10OrderDate" title="Т. 10 · Заповед от дата"/>

    <!-- Т. 10.1 и 10.2 (изм. ДВ бр. 115 от 2025 г.): полученото среднодневно ИЛИ средночасово
      брутно трудово възнаграждение като трудоустроен за месеца, в който трудоустрояването ЗАПОЧВА
      (10.1) и в който ИЗТИЧА (10.2). ⚠️ ЕДИНИЦАТА Е ЕВРО И ЦЕНТОВЕ — това е самата промяна от
      ДВ 115/2025, преди нея полето беше в левове. Основата (среднодневно или средночасово) се
      ОТМЕТВА на образеца, тоест е отделен избор, не се извежда от числото.
      ⚠️ Забележка към т. 10.2: за месеца, в който изтича трудоустрояването, данните се подават
      ДОПЪЛНИТЕЛНО с код „Корекция“ — тоест 10.2 обикновено се пълни във второ подаване. -->
    <decimal name="bgP10AvgPayAtStart" title="Т. 10.1 · Възнаграждение при започване (EUR)"
      precision="15" scale="2"/>
    <string name="bgP10BasisAtStartSelect" title="Т. 10.1 · Основа"
      selection="bg.app9.pay.basis.select"/>
    <decimal name="bgP10AvgPayAtEnd" title="Т. 10.2 · Възнаграждение при изтичане (EUR)"
      precision="15" scale="2"/>
    <string name="bgP10BasisAtEndSelect" title="Т. 10.2 · Основа"
      selection="bg.app9.pay.basis.select"/>

    <!-- ═══════════════ Т. 11 — АНКЕТЕН ЛИСТ ПО ЧЛ. 46 АЛ. 1 КСО ═══════════════ РЪЧНО.
      „С анкетен лист № ..... от ..... 20.. г. е установено …“ — попълва се за случаите по чл. 46
      ал. 1 КСО. Анкетният лист е документ на контролните органи на НОИ и няма носител в модела.
      ⚠️ ТАБЛИЦАТА НА Т. 11 (месец · година · от ден · до ден · работни дни · работни часове) НЕ Е
      ТУК. Тя иска свой ред-запис, точно както т. 9 получи BgSickLeavePeriodLine в Ф0, и по същия
      довод: агрегат губи кой период по анкетния лист е дал кои дни. Обявена липса, не пропуск.
      ⚠️ И ЕДНО ВЗАИМОДЕЙСТВИЕ, КОЕТО СЕ ЗАПИСВА ТУК, ЗА ДА НЕ СЕ ЗАБРАВИ: забележка 3 към т. 9
      казва, че когато т. 11 и/или т. 12 са попълнени, в т. 9 се попълва ПЪЛНИЯТ брой работни дни.
      Тоест т. 11 НЕ намалява т. 9 — редовете на Ф0 остават каквито са. -->
    <string name="bgP11SurveyNo" title="Т. 11 · Анкетен лист №"/>
    <date name="bgP11SurveyDate" title="Т. 11 · Анкетен лист от дата"/>
    <string name="bgP11FindingSelect" title="Т. 11 · Установено"
      selection="bg.app9.survey.finding.select"/>

    <!-- ═══════════════ Т. 12 — ПЛАТЕН ГОДИШЕН ОТПУСК В ПЕРИОДА ═══════════════
      „попълва се за случаите по чл. 9 ал. 3 от Наредбата за медицинската експертиза“ — тоест не
      при всяко припокриване, а при онова, което тази норма урежда.
      ⚠️ ПОТВЪРЖДЕНИЕТО Е РЪЧНО, ПРЕДЛОЖЕНИЕТО Е НА РЕЗОЛВЕРА. Резолверът вижда валидираните
      заявки за отпуск, които пресичат периода по листа, и ги ИЗБРОЯВА В СВИДЕТЕЛЯ СИ с точните
      дати. Не пише в bgP12ConfirmedSelect: припокриване по календар не е „разрешен платен годишен
      отпуск по заповед“, а заповедта е това, което точката удостоверява. Автоматично потвърдено,
      обстоятелството би било невярно точно тогава, когато отпускът е бил ОТМЕНЕН заради болничния
      — най-честият случай.
      ⚠️ И ТУК ТАБЛИЦАТА (месец · година · от ден · до ден · работни дни — БЕЗ колона „работни
      часове“, за разлика от т. 9 и т. 11) НЕ Е МОДЕЛИРАНА, по същия довод като при т. 11. -->
    <string name="bgP12ConfirmedSelect" title="Т. 12 · Ползва платен годишен отпуск"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP12LeaveOrderNo" title="Т. 12 · Заповед №"/>
    <date name="bgP12LeaveOrderDate" title="Т. 12 · Заповед от дата"/>

    <!-- ═══════════════ Т. 13 — ДЕТЕТО ═══════════════
      ⚠️ ЦЕЛИЯТ БЛОК Т. 13–23 СЕ ПОПЪЛВА САМО В ЕДИН СЛУЧАЙ, и това е бележка ** на самия образец:
      „само за деклариране на обстоятелства за изплащане на парично обезщетение по болничен лист за
      МАЙЧИНСТВО СЛЕД 42-РИЯ ДЕН от раждането и за случаите по ЧЛ. 167 КТ“. Тоест при обикновен
      болничен за общо заболяване тези единайсет точки са НЕОТНОСИМИ, а не „неотговорени“ — и
      резолверът го казва изрично, вместо да ги остави празни без обяснение.
      Детето се СОЧИ, а не се преписва: BgEmployeeChild вече носи имена, ЕГН и дата на раждане, и
      второ копие тук би се разминало с него при първата поправка. -->
    <many-to-one name="bgP13Child" title="Т. 13 · Детето"
      ref="com.axelor.apps.bglocalization.db.BgEmployeeChild"/>

    <!-- ⚠️ ОНОВА ОТ Т. 13, КОЕТО BgEmployeeChild НЕ НОСИ — и затова е ръчно, не изведено.
      Образецът иска още: „Когато детето няма ЕГН: Удостоверение за раждане № …… / …….“, плюс
      МАЙКА и БАЩА с имена и идентификатор „по удостоверението за раждане на детето“. BgEmployeeChild
      има fullName, bgEgn, birthDate — и нищо от останалото. Разширяването му е промяна по споделен
      домейн и е отделно решение; дотогава данните се въвеждат тук, вместо да липсват. -->
    <string name="bgP13BirthCertNo" title="Т. 13 · Удостоверение за раждане №"/>
    <date name="bgP13BirthCertDate" title="Т. 13 · Удостоверение за раждане от дата"/>
    <string name="bgP13MotherName" title="Т. 13 · Майка — име, презиме, фамилия"/>
    <string name="bgP13MotherId" title="Т. 13 · Майка — ЕГН/ЛН/ЛНЧ/служебен №"/>
    <string name="bgP13FatherName" title="Т. 13 · Баща — име, презиме, фамилия"/>
    <string name="bgP13FatherId" title="Т. 13 · Баща — ЕГН/ЛН/ЛНЧ/служебен №"/>

    <!-- Т. 14: „Децата са близнаци, ..…… на брой.“ Забележка на образеца: при близнаци данните се
      попълват ЗА ВСЯКО ДЕТЕ — тоест броят тук не заменя отделните редове по т. 13, а ги обявява. -->
    <integer name="bgP14TwinCount" title="Т. 14 · Близнаци — брой"/>

    <!-- ═══ Т. 15–23 — ДЕВЕТ ОТРИЦАТЕЛНИ ДЕКЛАРАЦИИ, ВСИЧКИТЕ РЪЧНИ ═══
      ⚠️ ТУК ТРИСТАЙНИЯТ ИЗБОР Е НАЙ-ОСТРО НУЖЕН. Заглавията са отрицания („детето НЕ е дадено за
      осиновяване“), тоест върху boolean непопълненото поле би се прочело като FALSE, а FALSE на
      отрицание е ТВЪРДЕНИЕТО — удостоверението щеше да декларира пред НОИ, че детето Е дадено за
      осиновяване, защото никой не е питал. Стойността „ДА“ значи „потвърждавам отрицанието, както
      е формулирано в точката“.
      ⚠️ И НИТО ЕДНА ОТ ДЕВЕТТЕ НЕ Е ИЗВОДИМА. Осиновяване, настаняване по чл. 26 ЗЗД, детско
      заведение на пълна държавна издръжка, програми за подкрепа на майчинството, лишаване и
      ограничаване на родителски права, настойничество — нито едно от тези обстоятелства няма
      носител никъде в модела, и не защото е пропуснато: те са факти от чужди регистри (съд,
      община, дирекция „Социално подпомагане“), които осигурителят УДОСТОВЕРЯВА по декларация на
      лицето. Изведени от каквото и да е тук, те щяха да са съчинени. -->
    <string name="bgP15ChildAlive" title="Т. 15 · Детето е живо"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP16NotForAdoption" title="Т. 16 · Детето не е дадено за осиновяване"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP17NotInStateCare"
      title="Т. 17 · Детето не е в заведение на пълна държавна издръжка"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP18NotUnderMaternityProgramme"
      title="Т. 18 · Детето не се отглежда от лице по програми за подкрепа на майчинството"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP19NotPlacedArt26"
      title="Т. 19 · Детето не е настанено по реда на чл. 26 ЗЗД"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP20NotDeprivedOfRights" title="Т. 20 · Лицето не е лишено от родителски права"
      selection="bg.app9.yes.no.select"/>
    <string name="bgP21RightsNotRestricted"
      title="Т. 21 · Родителските права не са ограничени" selection="bg.app9.yes.no.select"/>
    <string name="bgP22GuardianshipNotTerminated"
