    <string name="bgP23Art26PlacementNotTerminated"
      title="Т. 23 · Настаняването по чл. 26 ЗЗД не е прекратено"
      selection="bg.app9.yes.no.select"/>

    <!-- ═══════════════ Т. 24 — ДРУГИ ОБСТОЯТЕЛСТВА ═══════════════ Свободен текст, ръчно. -->
    <string name="bgP24OtherCircumstances" title="Т. 24 · Други обстоятелства" large="true"/>

    <!-- ═══════════════ Т. 25 — ВХОДЯЩ № И ДАТА ПРИ ОСИГУРИТЕЛЯ ═══════════════ НЯМА ПОЛЕ ТУК.
      Ф0 вече ги носи върху ЛИСТА: BgSickLeave.bgEmployerReceivedNo и bgEmployerReceivedDate.
      Копирани тук „за кеширане“, те щяха да са трето число на същия документ — точно това, което
      BgSickLeave.xml отказва да прави с платеца и процента („копирани, те щяха да се разминат с
      речника при първата му промяна“). Резолверът ги ЧЕТЕ през листа и свидетелства за тях,
      включително за правилото, че при болничен лист на САМООСИГУРЯВАЩО СЕ ЛИЦЕ т. 25 НЕ СЕ ПОПЪЛВА. -->

    <!-- ═══════════════ Т. 26 — ЛИЧНА ПЛАТЕЖНА СМЕТКА ═══════════════
      ⚠️ ТУК КЕШИРАНЕТО Е ВЯРНОТО РЕШЕНИЕ, И ТОВА Е ОБРАТНОТО НА Т. 25. Причината е бележка *** на
      образеца: „Т. 26 се попълва само при ПЪРВОТО представяне на удостоверение“, а раздел II т. 16
      урежда отделно ПРОМЯНАТА на сметката. Тоест т. 26 удостоверява сметката КАКВАТО Е БИЛА при
      това подаване, и когато лицето я смени, декларираното не се променя със задна дата — сменя се
      с ново подаване. Прочетена през Employee.bgBenefitIban на всяко гледане, стойността щеше да
      пренаписва историята: подадено удостоверение би показвало днешната сметка, а НОИ пази
      подадената. Затова се копира ПРИ ИЗВЕЖДАНЕТО и стои. -->
    <string name="benefitIban" title="Т. 26 · IBAN за обезщетението"/>
    <string name="bgP26FirstSubmissionSelect" title="Т. 26 · Първо представяне"
      selection="bg.app9.yes.no.select"/>

    <!-- ═══════════════ ПРИСЪДИТЕ НА РЕЗОЛВЕРА ═══════════════
      ⚠️ ТОВА ПОЛЕ Е ЗАДЪЛЖИТЕЛНАТА ПОЛОВИНА НА РЕЗОЛВЕРА, НЕ УКРАСА. Всяко изведено правило
      връща свидетел, всеки отказ — назована причина, и BgApp9DeclarationService ги записва ВСИЧКИТЕ
      тук. Без читател списъкът с присъди е мъртъв: правилата отказват с причина, а причината не
      стига до никого. При генераторите на фиша същата роля имат BgPaySlip.bgGeneratorNotes и
      bgGeneratorGaps.
      Тук отказът е ВИДИМ на екрана, до полето, което е останало празно заради него.
      readonly в домейна, а не само в изгледа: полето е ИЗХОД на резолвера и ръчно редактирано, би
      противоречило на стойностите, които обяснява. -->
    <string name="resolverNotes" title="Присъди на резолвера" large="true" readonly="true"/>

    <!-- Кога е пуснат резолверът за последно. Без нея resolverNotes е текст без възраст: не се
      различава свидетел, писан преди поправката на договора, от свидетел, писан след нея. -->
    <datetime name="bgResolvedAt" title="Обстоятелствата са изведени на" readonly="true"/>

    <!-- ═══════════════ ИЗНОСЪТ (Ф2) ═══════════════ Четирите полета по-долу са НУЛИРУЕМИ и нямат
      стойност, докато никой не е натиснал „Генерирай“. Заварените удостоверения от Ф1 остават
      валидни без тях — required върху попълнена таблица е миграция, не декларация.

      ⚠️ ФАЙЛЪТ НЕ СЕ ПАЗИ ТУК КАТО БАЙТОВЕ И ОТПЕЧАТЪКЪТ НЕ СЕ ПРЕПИСВА. И двете живеят на
      NapArtifact — общото ядро „институция“, което НАП стекът (Д1/Д6, ДДС, SAF-T) вече ползва и
      което Ф2 обобщи с дискриминатор {НАП, НОИ}. Артефактът смята SHA-256 и дължината ВЕДНЪЖ, при
      създаването, и оттам е неизменяем. Преписан тук „за грида“, отпечатъкът би бил второ число
      за същия файл — точно онова, което ядрото предотвратява. -->
    <many-to-one name="bgNoiArtifact" title="Файл към НОИ (неизменяем)"
      ref="com.axelor.apps.napsubmissions.db.NapArtifact"/>

    <datetime name="bgGeneratedOn" title="Файлът е генериран на" readonly="true"/>

    <!-- ═══════════════ ПОДАВАНЕТО В НОИ ═══════════════
      АКТИВНОТО ПОДАВАНЕ — отметката „подадено“ с входящия номер от портала. Пише го САМО
      BgApp9SubmissionService, в същата транзакция, в която вдига statusSelect = SUBMITTED; оттам
      т. 26 (BgApp9DeclarationService#hasEarlierSubmittedApp9) продължава да чете статуса и да е вярна.
      ⚠️ Подаденият ФАЙЛ е на подаването (NapSubmissionFile.payloadArtifact), не тук: bgNoiArtifact
      е последният ГЕНЕРИРАН файл и при корекция сочи новия, а подаденият остава непокътнат в
      подаването. Празно при SUBMITTED = заварено подадено, без входящ номер — не се преобразува. -->
    <many-to-one name="bgNoiSubmission" title="Подаване в НОИ (входящ №)"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission" readonly="true"/>

    <!-- Входовете на бутона „Отбележи като подадено в НОИ“ — НЕ се пазят тук (transient): мястото
      им е подаването. Същият идиом като NapSubmission.actionReason. -->
    <string name="bgPortalIncomingNumber" title="Входящ № от портала на НОИ" transient="true"/>
    <date name="bgPortalSubmittedDate" title="Дата на подаване в портала" transient="true"/>

    <!-- ⚠️ СПИСЪКЪТ „КАКВО ЛИПСВА“ Е ЗАДЪЛЖИТЕЛНАТА ПОЛОВИНА НА ОТКАЗА, точно както resolverNotes е
      задължителната половина на резолвера. Емисията СПИРА при неразрешено задължително
      обстоятелство и причината се записва ТУК, до полето, което е останало празно. Празно поле в
      удостоверение пред НОИ значи „обстоятелството не е налице“ — тоест тих непълен файл твърди
      неща, които никой не е проверявал.

      ⚠️ И НЕ Е СЪЩОТО КАТО resolverNotes. Резолверът може да е отказал т. 8 и файлът пак да тръгне
      (т. 8 е допустимо празна); може да не е отказал нищо и файлът пак да спре (ТП на НОИ няма
      носител, тоест няма и присъда за него). Двата списъка се четат поотделно. -->
    <string name="bgEmissionGaps" title="Какво липсва, за да е валидна" large="true"
      readonly="true"/>

    <string name="bgValidationReport" title="Проверки (XSD и контроли)" large="true"
      readonly="true"/>

    <!-- ПОСЛЕДНИЯТ ОПИТ ЗА ГЕНЕРИРАНЕ — кога, кой, с какъв изход. Пише се при ВСЕКИ опит,
      успешен или не, ОТДЕЛНО от файла: при отказ файл не се закача и полуготов износ не се записва.
      Без него резултатът от неуспешен опит не се вижда — клиентът не презарежда формата след
      грешка, и „Какво липсва“ може да показва отказ от предишен опит. -->
    <string name="bgLastAttempt" title="Последен опит за генериране" large="true"
      readonly="true"/>

  </entity>

</domain-models>
