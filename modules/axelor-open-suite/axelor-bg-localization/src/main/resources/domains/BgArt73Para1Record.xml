<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ЕДИН РЕД ОТ ЧАСТ ІІ „ДАННИ ЗА ИЗПЛАТЕНИТЕ ДОХОДИ“ — колони 1 до 15 ═══

    Полетата по-долу СА колоните на образец 5-2001 и стоят в неговия ред. Номерата в заглавията не
    са украса: те са единственото, по което човек сверява екрана срещу хартията.

      к. 1  Код корекция                к. 9  Код на държава
      к. 2  ЧФЛ (чуждестранно ФЛ)       к. 10 Код на дохода
      к. 3  Тип идентификатор           к. 11 Брутен размер на дохода
      к. 4  ЕГН/ЛН/ЛНЧ/Сл. №/БУЛСТАТ    к. 12 Удържани ЗОВ
      к. 5  Дата на раждане             к. 13 Удържан данък по ЗДДФЛ
      к. 6  Собствено име               к. 14 Брой лица
      к. 7  Презиме                     к. 15 ЕИК на преобразуващото се предприятие
      к. 8  Фамилно име

    ⚠️ ЕДИН РЕД = ЕДНО ЛИЦЕ И ЕДИН КОД ЗА ЦЯЛАТА ГОДИНА. Указание т. 7, дословно: „Ако на едно
    физическо лице са изплатени доходи с РАЗЛИЧЕН код, данните се записват на отделни редове.“
    Обратното също следва: няколко плащания по ЕДИН код се сливат в един ред с годишната сума. Затова
    редът е ИЗВЕДЕН от регистъра, а не е негово копие — виж BgArt73Para1Aggregator.

    ⚠️ И КОЛОНА 11 Е БРУТО, А НЕ ОСНОВАТА. Указание т. 8, дословно: „в колона 11 се посочва брутният
    размер на дохода, т.е. без приспадане на признатите разходи и/или направените удръжки от платеца
    на дохода“. Нормативните разходи и данъчната основа ЖИВЕЯТ в регистъра и НЯМАТ колона тук — те са
    за декларацията по чл. 55 и за ГДД на лицето. Поле за тях на този запис би поканило да се попълни
    колона, каквато образецът няма.

    ⚠️ СУМИТЕ СА В ЛЕВОВЕ И СТОТИНКИ ДО ВТОРИЯ ДЕСЕТИЧЕН ЗНАК (указание т. 10) — оттам scale="2".
    Тук НЯМА закръгляне към пълен лев: то важи за колона 19 на ДРУГИЯ образец, този по ал. 6. -->
  <entity name="BgArt73Para1Record">

    <many-to-one name="report" title="Справка" required="true"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para1Report"/>

    <!-- Колона 1. Указание т. 2, дословно: „вписва се „0“ за основни данни; „1“ – за коригиращи
      данни и „8“ – за заличаващи данни.“

      ⚠️ ПРИ ЗАЛИЧАВАНЕ („8“) СЕ ПЪЛНЯТ САМО КОЛОНИ 1, 2, 3, 4 ИЛИ 5, 6, 7, 8 И 10 — тоест
      идентификацията и кодът на дохода, и НИТО ЕДНА сума. Колони 11, 12, 13, 14 и 15 остават празни.
      ⚠️ Нулата в тях НЕ Е „нула лева“, а „не се попълва“, и разликата не се вижда от полето: Axelor
      връща ZERO и за непопълнено decimal. Затова кой ред носи суми се чете от ТОЗИ код, а не от
      сумите — виж BgArt73Para1Line#carriesAmounts. -->
    <string name="correctionCode" title="Код корекция (к. 1)" required="true" default="0"
      selection="bg.income.correction.code.select"/>

    <!-- Колона 2. Указание т. 3: „0“, ако лицето НЕ е чуждестранно, и „1“, ако е чуждестранно за
      Република България. Носи се от реда на регистъра, не се гадае от кода на държавата.

      ⚠️ НА СБОРЕН РЕД КОЛОНАТА НЕ СЕ ПОПЪЛВА, А ПОЛЕТО СТОИ НА false — двете НЕ са едно и също.
      Boolean няма трета стойност, тоест „не се попълва“ не може да се запише тук. Кой ред е сборен
      се чете от КОДА (incomeType.isAggregate), а не от това поле — същият прочит, който указание
      т. 5 прави, когато изброява кодовете 5031, 8141 и 820. -->
    <boolean name="isForeign" title="Чуждестранно лице (к. 2)" default="false"/>

    <!-- Колона 3. Указание т. 4: „0“ ЕГН; „1“ ЛН, ЛНЧ или Сл. № от регистъра на НАП; „2“ физическо
      лице с БУЛСТАТ; „3“ чуждестранно физическо лице без посочените идентификатори.
      ⚠️ ЧЕТИРИ стойности — образецът по ал. 6 познава само първите две. Затова изборът е ОБЩ С
      РЕГИСТЪРА (bg.income.payment.identifier.type.select) и НЕ е общ със справката по ал. 6. -->
    <string name="identifierType" title="Тип идентификатор (к. 3)"
      selection="bg.income.payment.identifier.type.select"/>

    <!-- Колона 4. ⚠️ При тип „3“ НЕ СЕ ПОПЪЛВА — указание т. 4, дословно: „като в тези случаи
      колона 4 не се попълва, а се попълва датата на раждане в колона 5“. Двете колони са
      ВЗАИМНОИЗКЛЮЧВАЩИ се, не допълващи се. -->
    <string name="identifier" title="ЕГН/ЛН/ЛНЧ/Сл. №/БУЛСТАТ (к. 4)"/>

    <!-- Колона 5 — дата на раждане (гггг/мм/дд). Попълва се САМО при тип идентификатор „3“. -->
    <date name="birthDate" title="Дата на раждане (к. 5)"/>

    <string name="firstName" title="Собствено име (к. 6)"/>
    <string name="middleName" title="Презиме (к. 7)"/>
    <string name="lastName" title="Фамилно име (к. 8)"/>

    <!-- Колона 9. Указание т. 6, дословно: „Колона 9, Част ІІ се попълва САМО за чуждестранни
      физически лица.“ -->
    <string name="countryCode" title="Код на държава (к. 9)"/>

    <!-- Колона 10 — кодът по номенклатурата след справката.
      ⚠️ m2o към каталога, а не низ: коригираща справка за минала година ползва кода, валиден ТОГАВА,
      и редът трябва да сочи точно него, а не днешния му наследник. -->
    <many-to-one name="incomeType" title="Код на дохода (к. 10)" required="true"
      ref="com.axelor.apps.bglocalization.db.BgIncomeType"/>

    <!-- Колона 11 — БРУТНИЯТ размер, сумиран за годината по този код. -->
    <decimal name="grossAmount" title="Брутен размер на дохода (к. 11)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 12 — удържаните задължителни осигурителни вноски. -->
    <decimal name="insuranceAmount" title="Удържани ЗОВ (к. 12)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 13 — удържаният данък по ЗДДФЛ. ⚠️ Нула тук е ЗАКОНЕН отговор за необлагаемите
      доходи по Част ІV, които чл. 73 ал. 1 т. 4 изрично иска да бъдат ОПИСАНИ в справката. -->
    <decimal name="taxAmount" title="Удържан данък по ЗДДФЛ (к. 13)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 14. Указание т. 5, дословно: „Колона 14 „Брой лица“ се попълва САМО за доходи с
      кодове 5031 и 8141.“

      ⚠️ INTEGER, А НЕ decimal, И БЕЗ default="0". Нула лица е твърдение, което нито един подаден ред
      не прави: сборен ред без лица не съществува. Празно тук значи „колоната не се попълва за този
      код“ — включително за 820, който е СБОРЕН, но брой лица НЕ носи. -->
    <integer name="personCount" title="Брой лица (к. 14)"/>

    <!-- Колона 15. Указание т. 11: ЕИК на ПРЕОБРАЗУВАЩОТО СЕ предприятие, когато данните се подават
      от правоприемник. Указание т. 8, дословно: за кодове 5031, 8141 и 820 тази колона „не се
      попълва“.
      ⚠️ НИКОЙ РЕД В МОДУЛА НЕ Я ПЪЛНИ ДНЕС — вход за преобразуване няма. Обявено в границите. -->
    <string name="predecessorIdentifier" title="ЕИК на преобразуващото се предприятие (к. 15)"/>

    <!-- ═══ ПРОСЛЕДИМОСТ — извън колоните на образеца ═══ -->

    <!-- Лицето, от чиито плащания е сглобен редът.
      ⚠️ ПРАЗНО ЗА СБОРНИТЕ РЕДОВЕ, И ТОВА Е СЪЩОТО ТВЪРДЕНИЕ, КОЕТО ПРАВИ ОБРАЗЕЦЪТ. Ред с код
      5031, 8141 или 820 обединява ВСИЧКИ лица и няма едно лице, към което да сочи; посочено едно от
      тях, полето би излъгало точно там, където колони 2–9 нарочно мълчат. -->
    <many-to-one name="partner" title="Лице (получател)" ref="com.axelor.apps.base.db.Partner"/>

    <!-- Колко реда на регистъра са слети в този ред — за проверимост на сумата в колона 11.
      ⚠️ РАЗЛИЧНО ОТ КОЛОНА 14: там са ЛИЦА, тук са ПЛАЩАНИЯ. Две плащания към едно лице дават
      к. 14 = 1 (ако кодът я иска) и paymentCount = 2. Слети, двете биха дали „брой лица 2“ за
      едно лице. -->
    <integer name="paymentCount" title="Слети плащания от регистъра"/>

  </entity>

</domain-models>
