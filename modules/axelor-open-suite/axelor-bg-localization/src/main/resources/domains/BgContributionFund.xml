<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Осигурителен фонд — ДОО (Пенсии, ОЗМ, Безработица, ТЗПБ), ДЗПО (УПФ, ППФ), УчПФ, здравно осигуряване,
    ГВРС. РЕФЕРЕНТНИ ДАННИ: речник, не конфигурация — редовете идват от seed-а и се сменят само когато законът
    създаде или закрие фонд. ЗАЩО ENTITY, А НЕ СТОЙНОСТ В СЕЛЕКЦИЯ. Решение 1 от WS-1, взето от клиента.
    Декларация 1 е разбита по фондове и всяко нейно поле е сума по фонд. Докато фондът е низ, връзката „ред
    от ставките → поле в Д1“ може да живее единствено в switch в Java — тоест невидима за човек, който не
    чете код, и недостъпна за заявка. Като entity връзката е колона: bgD1FieldEmployer и bgD1FieldEmployee
    се четат от екрана и се сверяват със справка. ЗАЩО ПЪРВО ТОВА. Решение 3 закотвя редовете на фиша към
    конкретни редове в BgInsuranceContribution. Преструктуриране на тази таблица СЛЕД като закотвянето тръгне
    значи пренасочване на указатели върху живи фишове; преди него е една миграция. ⚠️ НИЗЪТ fundCode В BgInsuranceContribution
    ОСТАВА и е още източникът на истина за изчислението: BgContributionResolver сравнява точно него ("PENSION",
    "UPF", "PPF", "TZPB") в пазачите си. FK-ът се въвежда пръв и се доказва — BgContributionFundConsistencyTest
    твърди, че двете никога не се разминават — и чак тогава низът си отива, в отделен клон. Махането ще иска
    ръчен SQL, защото App Install не изчиства стойности. -->
  <entity name="BgContributionFund" cacheable="true">

    <!-- Огледален на стойностите на BgInsuranceContribution.fundCode. Тъкмо това съвпадение прави миграцията
      еднозначна и е предмет на теста за съгласие. -->
    <string name="code" title="Код" required="true" unique="true"
      help="Напр. PENSION, UPF, HEALTH — същите стойности, които носи BgInsuranceContribution.fundCode."/>
    <string name="name" title="Наименование" required="true" namecolumn="true"
      help="Пълното наименование, както го изписва законът."/>
    <integer name="sequence" title="Пореден №"
      help="Ред на подреждане във ведомостта и в справките."/>

    <!-- Получателят на вноската. Не е козметика: определя към кого върви плащането и в коя справка влиза
      сумата — НОИ за фондовете на ДОО и за УчПФ, НЗОК за здравното, а при ДЗПО парите отиват в пенсионноосигурителното
      дружество, избрано от лицето. -->
    <string name="bgRecipient" title="Получател на вноската"
      selection="bg.contribution.fund.recipient.select"/>

    <!-- Правило за закръгляне на сумата по този фонд. Днес всички носят HALF_UP_2 (§5.3 от спецификацията,
      който вече има и законово основание — чл. 13 ал. 1 от Закона за въвеждане на еврото казва същото). Полето
      съществува, за да има КЪДЕ да седне изключение, ако се появи — а не защото такова е известно. ⚠️ ЕДНО
      ИЗКЛЮЧЕНИЕ ВЕЧЕ Е ИЗВЕСТНО, но НЕ е моделирано и НЕ е за днес. По чл. 35 ал. 3 от Закона за въвеждане
      на еврото вноските за ДЗПО, отнасящи се за месеци ПРЕДИ въвеждането на еврото, се превалутират в изключение
      на чл. 13 ал. 1: изчисляват се до втория знак БЕЗ закръгляване, тоест с ОТСИЧАНЕ. Това е работа за WS-9
      — исторически периоди. Записано е тук, защото HALF_UP_2 е единствената стойност в селекцията и ще бъде
      приложена по инерция върху стари данни, където дава друга стотинка. Виж README на модула. -->

    <string name="bgRoundingRule" title="Правило за закръгляне"
      selection="bg.contribution.fund.rounding.select"/>

    <!-- Точката от Декларация 1, в която влиза сумата по този фонд. Сверено срещу Приложение № 1 към
      чл. 2 ал. 1 от Наредба Н-13. ⚠️ ЕДНО ПОЛЕ, НЕ ДВЕ. Първоначално тук стояха bgD1FieldEmployer и bgD1FieldEmployee
      — грешка. Д1 НЕ разделя частта на осигурителя от частта на лицето: т. 22 иска „размерът на осигурителната
      вноска за фондовете на ДОО съгласно КСО за сметка на осигурителя И/ИЛИ за сметка на осигуреното лице“.
      Разделението живее у нас, в employerRate и employeeRate, и се сумира при подаването. ⚠️ ЧЕТИРИ ФОНДА
      СОЧАТ КЪМ ЕДНА И СЪЩА Т. 22 И ТОВА НЕ Е ДУБЛИКАТ В SEED-А. Декларацията слива Пенсии, Пенсии по чл. 69,
      ОЗМ и Безработица в едно число. Ведомостта и фишът искат трите поотделно, затова нашият речник остава
      ПО-ФИН от декларацията и не се свива до нея. Обратното — да съберем фондовете, защото Д1 ги събира —
      би направило фиша неразбираем, за да е удобна една справка. ⚠️ Точки 25 и 26 не са само за ДЗПО: т. 25
      поема и фонд „Пенсии“ в размера за ППФ по чл. 4в КСО, а т. 26 — и фонд „Пенсии“ в размера за УПФ по чл.
      4б ал. 1. Тоест едно поле на фонд покрива основния случай, но не всяка сметка е „един фонд → една точка“. -->
    <string name="bgD1Field" title="Точка в Д1"
      help="Номер на точката от Приложение № 1 към чл. 2 ал. 1 от Наредба Н-13, напр. 22, 22.1, 26."/>

    <!-- Фонд се създава и се закрива със закон — УчПФ тръгва от 2007 г., ППФ има собствена история.
      Периодът е тук, за да може закрит фонд да остане видим за минали периоди, вместо да се трие. -->
    <date name="validFrom" title="В сила от"/>
    <date name="validTo" title="В сила до"/>

    <!-- large=true, тоест TEXT, а не varchar(255) — по същата причина, по която я има и при BgCompensationType.note:
      тук стои основанието, а редовете вече минават 255 знака и App Install би ги отхвърлил ЦЕЛИТЕ с „value
      too long“. -->
    <string name="note" title="Бележка" large="true"/>
    <boolean name="active" title="Активен" default="true"/>

  </entity>

</domain-models>
