<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ЕДИН РЕД ОТ Т. 9 НА ПРИЛОЖЕНИЕ № 9 — дните на ЕДИН болничен лист в ЕДИН месец, за ЕДИН платец.
    ═══ ЗАЩО СЪЩЕСТВУВА ═══ Разбивът осигурител/ДОО се смята от BgSickLeaveResolver#split. Пазен само
    като два цели агрегата върху ФИША (bgSickDaysEmployer и bgSickDaysDoo), той губи необратимо три
    неща: КОЙ ЛИСТ е дал кои дни, ГРАНИЦИТЕ им в месеца, и ЧАСОВЕТЕ. Два болнични в един месец се сливат
    в едно число и обратният път до документа не съществува. Този запис е разбивът
    в разреза, в който НОИ го иска. ═══ СВЕРЕНО С ПЪРВОИЗТОЧНИКА ═══ НПОПДОО, Приложение № 9 към чл. 8 ал. 1
    и чл. 11 ал. 1 (ДВ бр. 115 от 2025 г., в сила от 1.01.2026 г.), т. 9: „Работни дни или работни часове през
    периода по болничния лист с право на парично обезщетение и работни дни/работни часове, за които осигурителят
    изплаща възнаграждение“. Колоните на официалната таблица са СЕДЕМ и стоят тук едно към едно: За месец ·
    Година · От ден · До ден вкл. · Работни дни · Работни часове · Дневно работно време по правоотношението
    на лицето за месеца (в часове). ⚠️ ОФИЦИАЛНИЯТ РЕД НЕ ДЕЛИ ПО ПЛАТЕЦ, А ТОЗИ ДЕЛИ — и това е нарочно.
    Указанието към колона „Работни дни“ казва „за които има право на възнаграждение от осигурителя И/ИЛИ на
    обезщетение“, тоест едно число за двете. Нашият ред е ЕДНО НИВО ПО-ФИН: официалният ред за (лист, месец)
    е СБОРЪТ на нашите редове за същия ключ. Посоката е избрана нарочно — от по-финото се стига до по-грубото
    със събиране, обратното е невъзможно, а разликата осигурител/ДОО е точно онова, което чл. 40 ал. 5 КСО
    вече е сметнал и което агрегатът губи. ═══ КАКВО ТОЗИ ЗАПИС НЕ ПРАВИ ═══ Не смята нищо и не е източник
    на пари. Перото по чл. 40 ал. 5 КСО (195) и здравната вноска по ЗЗО чл. 40 ал. 1 т. 5 се смятат от
    BgSickLeaveResolver и НЕ четат оттук. Този запис е ВТОРИ ИЗГЛЕД към същата сметка, не втора сметка —
    виж BgSickLeaveDays#linesReconcile за сверката между двата. ⚠️ И НЯМА ЧИТАТЕЛ ДНЕС: Приложение № 9 се
    строи във Ф1. Записът съществува, за да не се губят данните дотогава. -->
  <entity name="BgSickLeavePeriodLine">

    <!-- Листът, а не фишът. Ключовата разлика спрямо агрегатите: те висят на фиша и оттам не се
      стига до документа, а Приложение № 9 се подава ЗА ВСЕКИ БОЛНИЧЕН ЛИСТ поотделно (чл. 8 ал. 1). -->
    <many-to-one name="sickLeave" title="Болничен лист" required="true"
      ref="com.axelor.apps.bglocalization.db.BgSickLeave"/>

    <!-- ⚠️ ИЗВЕДЕНИ ОТ fromDay, НЕ ВТОРИ ИЗТОЧНИК. Официалната таблица има отделни колони „За месец“ и
      „Година“, затова те стоят тук като колони — но котвата е ДАТАТА, а тези две се пишат от нея при
      записа. Въведени независимо, рано или късно щяха да сочат друг месец, различен от този на границите,
      и редът щеше да е вътрешно противоречив, без нищо да пада. -->
    <integer name="periodYear" title="Година" required="true"/>
    <integer name="periodMonth" title="За месец" required="true"/>

    <!-- ⚠️ КАЛЕНДАРНИ ГРАНИЦИ, НЕ ПЪРВИЯТ И ПОСЛЕДНИЯТ РАБОТЕН ДЕН. Указанието към т. 9 е дословно:
      „в колони «От ден» и «До ден включително» се попълват първият и последният КАЛЕНДАРЕН ден на периода
      по болничния лист за съответния месец“. Оттам болничен от събота 1-ви носи 1-ви, не понеделник 3-ти.
      И оттам двата реда на един месец (осигурител и НОИ) носят ЕДНИ И СЪЩИ граници — точно затова
      официалният ред за месеца е сборът им, без граници да се сливат. ⚠️ Датите са ПЪЛНИ, а официалната
      колона е ден от месеца: денят се вади от датата при печата (Ф1). Обратното — да се пази число 1..31
      до месец и година — прави реконструкция на всяко четене и допуска ден 31 в месец с 30. -->
    <date name="fromDay" title="От ден" required="true"/>
    <date name="toDay" title="До ден вкл." required="true"/>

    <!-- Броят работни дни, паднали в ТОЗИ месец и за ТОЗИ платец. Указание: „броят на работните дни, през
      които лицето е следвало да работи, но не е работило поради състоянието си, за които има право на
      възнаграждение от осигурителя и/или на обезщетение, НЕЗАВИСИМО от продължителността на дневното
      работно време“. Тоест дни, не часове — часовете са отделна колона с отделно условие. -->
    <integer name="workDays" title="Работни дни" required="true"/>

    <!-- ⚠️ НУЛИРУЕМО, И ПРАЗНОТО НЕ Е НУЛА. Указанието към т. 9: „в колона «Работни часове» се попълват
      данни САМО когато лицето работи при сумирано изчисляване на работното време и/или на смени по часов
      график … съобразно ГРАФИКА на лицето за съответния период“. Модулът НЯМА график на смените. Затова
      часовете се пишат само при ПОДНЕВНО отчитане, където дни × дневна норма е точното число, а при СИРВ
      остават ПРАЗНИ — попълнени с dailyHours × workDays, те щяха да са правдоподобно грешни точно в
      случая, за който колоната изобщо съществува. ⚠️ Забележка 1 към т. 9 добавя, че дни и часове са
      ВЗАИМНОИЗКЛЮЧВАЩИ СЕ на един ред. Тук се пазят и двете, защото записът е ФАКТ, а изборът коя колона
      да се отпечата е на образеца (Ф1). -->
    <decimal name="workHours" title="Работни часове" precision="10" scale="2"/>

    <!-- Дневното работно време по правоотношението за месеца, в часове. ⚠️ Указанието дава и правило за
      закръгляне при променливо работно време („при остатък под 30 минути към пълния час“) и заместваща
      стойност „8 часа“ за лицата без определено работно време в часове. НИТО ЕДНОТО НЕ Е ПРИЛОЖЕНО ТУК:
      осемте часа са правило на ОБРАЗЕЦА при празно поле, а записани като факт, стават неразличими от
      действително уговорени осем. Празно значи „по договора не е уговорено в часове“. -->
    <decimal name="dailyHours" title="Дневно работно време (часове)" precision="5" scale="2"/>

    <!-- ⚠️ РАЗГРАНИЧИТЕЛЯТ, КОЙТО АГРЕГАТЪТ ГУБИ. EMPLOYER са първите два работни дни по чл. 40 ал. 5 КСО —
      те носят осигурителен доход и са перо на фиша. NOI са останалите — те НЯМАТ осигурителен доход,
      обезщетението по тях НОИ плаща на лицето директно, и точно те са базата на здравната вноска по ЗЗО
      чл. 40 ал. 1 т. 5. Двете мерят различни неща и не се сливат. -->
    <string name="payer" title="Платец" required="true"
      selection="bg.sick.leave.line.payer.select"/>

    <!-- ⚠️ НЯМА уникално ограничение по (лист, година, месец, платец), макар ключът да е точно този.
      Причината е същата като при BgSickLeave: поправката става чрез ПРЕЗАПИС на месеца, а презаписът
      минава през триене и вписване в една транзакция — ограничение тук би превърнало всяко второ
      пресмятане в конфликт вместо в обновяване. Ключът се пази от BgSickLeaveService#applyPeriodLines,
      който трие редовете на пресметнатите месеци, преди да впише новите. -->

  </entity>

</domain-models>
