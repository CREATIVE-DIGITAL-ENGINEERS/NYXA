<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ФИШЪТ. Заглавната част: чий е, за кой период, какви са замразените входове и какви са сумите.
    Самите пера са BgPaySlipLine. ═══ РЪЧНО ВЪВЕДЕНИ РЕДОВЕ ═══ ФИШЪТ ТРЯБВА ДА РАБОТИ С РЪЧНО ВЪВЕДЕНИ
    РЕДОВЕ. Автоматично се попълва само това, за което има източник, например обезщетенията (от потвърдени
    BgCompensation), осигуровките (през BgContributionResolver) и работните дни (през BgWorkingDayService);
    останалото се въвежда на ръка. ═══ ПЕРИОДЪТ Е СТАНДАРТЕН Period, А НЕ
    НАШ ЕНТИТЕТ ═══ Axelor base вече носи Year с typeSelect = 2 (TYPE_PAYROLL, „Payroll Year“) и Period със
    статуси OPENED / CLOSED / ADJUSTING / TEMPORARILY_CLOSED / CLOSURE_IN_PROGRESS. Тоест „замразен месец“
    го има наготово и BgPayrollPeriod НЕ се създава. ⚠️ Заплатната година с месечни периоди е ДАННИ,
    не код: трябва да се отвори. Докато я няма, фиш не може да се създаде и това е шумно, а не тихо: полето е required. ═══ ЗАМРАЗЯВАНЕ ═══ Каквото фишът
    взима отвън, се КОПИРА при създаване и не се чете повторно: работните дни, базовата заплата от договора,
    а на всеки ред — името, знакът, номерът и трите флага от речника. Издаден фиш не се променя, когато речникът
    или договорът се променят. Същият принцип като BgCompensation. ⚠️ CONFIRMED → DRAFT НЕ СЕ ПОЗВОЛЯВА.
    Грешният фиш се ОТКАЗВА и се прави нов. -->
  <entity name="BgPaySlip">

    <!-- Номер от редицата bgPaySlip НА ДРУЖЕСТВОТО. Годината в него идва от периода, НЕ от днешния ден — виж
      BgPaySlipManagementRepository. Заварените номера FISH-RES-… (от резервния брояч) остават.
      ⚠️ УНИКАЛЕН ПО (company, reference), НЕ ГЛОБАЛНО — виж ограничението долу. Две дружества имат по свой
      FISH-2026-0001.
      ⚠️ namecolumn: без него всяка препратка към фиша („Коригира фиш“, „Заличава фиш“, фишът на реда
      в Д1) би се показала с ИДЕНТИФИКАТОРА си, а не с номера. -->
    <string name="reference" title="Номер" readonly="true" namecolumn="true"/>

    <!-- ДРУЖЕСТВОТО, В ЧИЙТО БРОЯЧ Е НОМЕРЪТ. Записва се от BgPaySlipManagementRepository при номерирането по
      правилото на BgPaySlipWriteGuard#companyOf (платецът по договора; за самоосигуряващия се — по основния
      договор от регистрацията) и после НЕ СЕ СМЕНЯ.
      ⚠️ САМО ЗА УНИКАЛНОСТТА (company, reference). Платецът има ЕДИН източник — договорът: никоя заявка,
      филтър, изглед, право или справка не чете това поле (BgQueryFieldTest#nobodyReadsTheNumberingCompany).
      Хранилището отказва стойност, различна от платеца; BgTrzNumberingCompanyGuard отказва смяната по старото
      състояние по всеки път (UI, REST, услуга) — readonly тук е само подсказка за екрана.
      Nullable само заради заварените редове отпреди миграцията за номериране по дружество — новият фиш не се записва без нея. -->
    <many-to-one name="company" title="Дружество" ref="com.axelor.apps.base.db.Company" readonly="true"/>

    <!-- ═══ ЧИЙ Е ФИШЪТ — ЕДНО ОТ ДВЕТЕ, НИКОГА И ДВЕТЕ, НИКОГА НИТО ЕДНО ═══

      ⚠️ ДОГОВОРЪТ НЕ Е ЗАДЪЛЖИТЕЛЕН. Самоосигуряващото се лице НЯМА трудов договор — има
      РЕГИСТРАЦИЯ (BgSelfInsuredRegistration). С `required="true"` тук лице без договор не би могло
      дори да има фиш, тоест цялата верига надолу (пера → вноски → Д1 → Д6) би била недостижима по
      устройство.

      ⚠️ РАЗХЛАБВАНЕТО НЕ Е ОТСЛАБВАНЕ: изискването се мести от колоната в ПАЗАЧА. Точно едно от
      двете полета е попълнено — BgSelfInsuredRules#refuseCarrier, — и двата грешни случая се
      отказват ПОИМЕННО: „и двете“ значи фиш, който твърди две различни правоотношения наведнъж, а
      „нито едно“ значи фиш без лице. Оставени на `required`, вторият случай щеше да се хване, а
      ПЪРВИЯТ — не.

      ⚠️ И ЕДНО СЪСТОЯНИЕ НА СРЕДАТА, КОЕТО ORM-ЪТ НЕ ОПРАВЯ САМ. `db.default.ddl = update` ДОБАВЯ
      колони и ограничения, но НЕ СВАЛЯ `NOT NULL` от заварена колона. Тоест в база, създадена преди
      тази промяна, приложението ще смята, че може да запише фиш без договор, а Postgres ще откаже —
      с грешка на ниво драйвер, далеч от причината. Поправката е ръчна и е записана в
      manifest/sol-2026.yml: `ALTER TABLE bglocalization_bg_pay_slip ALTER COLUMN employment_contract
      DROP NOT NULL;` или свежа база. Свидетелят е BgSelfInsuredSchemaDbTest, който ЧЕТЕ
      information_schema и се пропуска с обявена причина, когато база няма. -->
    <many-to-one name="employmentContract" title="Трудов договор"
      ref="com.axelor.apps.hr.db.EmploymentContract"/>

    <!-- Регистрацията на самоосигуряващото се лице — другата страна на XOR-а отгоре.

      ⚠️ ЕДИН НОСИТЕЛ ЗА ДВАТА СЛУЧАЯ, А НЕ ВТОРИ ФИШ. Емитерът на Д1, строителят на записа,
      агрегаторът на ставките, агрегаторът на Д6, печатът и транспортът работят върху BgPaySlip и
      BgPaySlipLine. Втори носител би поискал втори прочит на всяко от тях — включително
      BgD1CorrectionRules#refuseMixedCodes, който по устройство гледа ЦЕЛИЯ набор записи в един
      файл и не може да го направи, ако половината записи идват отдругаде. -->
    <many-to-one name="bgSelfInsuredRegistration" title="Регистрация (СОЛ)"
      ref="com.axelor.apps.bglocalization.db.BgSelfInsuredRegistration"/>

    <!-- ⚠️ Стандартният Period. Годината му трябва да е от тип „заплатна“ (typeSelect = 2) — това се
      проверява при потвърждаване, а не с филтър на полето, защото филтър, който не намира нищо, изглежда като
      липсваща настройка, а съобщението казва какво липсва. -->
    <many-to-one name="period" title="Период" required="true"
      ref="com.axelor.apps.base.db.Period"/>

    <string name="statusSelect" title="Състояние" selection="bg.payslip.status.select"
      default="DRAFT" required="true"/>
    <string name="bgCancelReason" title="Причина за отказа" large="true"/>

    <!-- ⚠️ ВХОДЪТ НА БУТОНА „Откажи“ — transient, НЕ се пази. Причината се записва в
      bgCancelReason САМО от успешния отказ, в неговата транзакция. Отказът иска причината ПРЕДИ,
      а bgCancelReason е само за четене — без отделен вход от екрана няма изход: коригиращото
      копие остава чернова, а периодът — под корекция. Входът е отделно поле, а не самото bgCancelReason, по същия довод като
      NapSubmission.actionReason и входовете на BgApp9Declaration: написана и записана с „Запиши“,
      причината щеше да стои върху фиш, който никой не е отказал. -->
    <string name="bgCancelReasonInput" title="Причина за отказа" large="true" transient="true"/>

    <!-- ═══ ЗАМРАЗЕНИ ВХОДОВЕ ═══ Работните дни идват от BgWorkingDayService (производствен календар),
      базовата заплата — от договора. И трите се пазят НА ФИША: сума без съставките си е непроверима, а договорът
      се променя. -->
    <integer name="bgWorkingDaysInPeriod" title="Работни дни в периода"/>

    <!-- ⚠️ ЕДИНСТВЕНОТО ПОЛЕ НА ФИША, ЗА КОЕТО НУЛАТА Е ВАЛИДЕН ОТГОВОР, И ТО НЕ Е РАЗЛИЧИМО ОТ ПРАЗНО.
      Цял месец неплатен отпуск значи нула отработени дни — законен случай, същият, с който се обяснява и нулевото
      бруто. А генерираният getter за Integer връща 0 за непопълнена колона, тоест „не съм пипал полето“ и
      „отработени са нула дни“ изглеждат еднакво. Днес това не вреди по случайност: prepare попълва отработените
      дни само когато и работните дни са нула, а те се попълват първи — тоест втори път условието не се задейства
      и въведената нула оцелява. Пази я вложеността на две проверки, а не признак. КАКВО БИ ТРЯБВАЛО (НЕ Е
      ПОСТРОЕНО — иска решение): или булево поле „отработените дни са въведени“,
      каквото BgVatReturn вече има за клетки 71 и 82 (bgAutoFillK71/bgAutoFillK82 — там признакът казва кое
      се смята и кое не), или отработените дни да се пазят като перо от речника, а не като число в заглавната
      част. Първото е по-евтино, второто е по-вярно на устройството на фиша. -->
    <integer name="bgWorkedDays" title="Отработени дни"/>
    <decimal name="bgBaseSalary" title="Основна заплата" precision="20" scale="2"/>

    <!-- АВТО-ПОПЪЛНЕНА ЛИ Е ОСНОВНАТА ЗАПЛАТА ОТГОРЕ, или е нечие решение.

      ⚠️ ПРИЗНАК, А НЕ ДОГАДКА ПО СТОЙНОСТТА, и това е точно механизмът, който бележката при
      bgWorkedDays по-горе иска, но няма. Заплатата се извежда от договора и анексите му
      (BgAmendmentSalaryRule) и зависи от ПЕРИОДА; тоест при смяна на периода трябва да се
      преизчисли. Копиране само при нулева стойност не стига: избереш октомври (1200,00), после
      видиш, че си сбъркал и превключиш на септември — фишът би останал с 1200,00, а септември се
      дължи по 1000,00. Прецедентът е bgAutoFillK71/bgAutoFillK82 на
      BgVatReturn: там отметката казва коя клетка се смята и коя е ръчен вход.

      ⚠️ ПОДРАЗБИРАНЕТО TRUE ВАЖИ САМО ЗА НОВИ ЗАПИСИ. Заварените редове носят NULL, а генерираният
      getter за Boolean връща FALSE — тоест черновите в движение се четат като „ръчно“ и НЕ се
      преизчисляват. Това е верният край на несиметрията: непокътнат заварен фиш е поправим, тихо
      презаписана заплата на заварен фиш не е. Backfill НЯМА и не трябва.

      ⚠️ Пада на false при РЪЧНА редакция на заплатата (onChange в изгледа), не при запис. Ръчно
      въведената сума е решение и prepare() повече не я пипа — изходът е обявен, а не изведен от това, че стойността е ненулева. -->
    <boolean name="bgAutoFillBaseSalary" title="Авто-попълни основната заплата" default="true"
      help="Отметнато — основната заплата се извежда от договора и допълнителните му споразумения за периода на фиша и се преизчислява при всяка промяна на периода или договора. Изключва се САМО, когато сумата е въведена на ръка. ⚠️ Заварените фишове (отпреди въвеждането на полето) се четат като ръчни и не се пипат."/>

    <!-- ═══ ДНИТЕ БОЛНИЧЕН — ПОКАЗАНИ РАЗДЕЛЕНО, КАКТО НА ФИША ═══ Двата броя мерят РАЗЛИЧНИ неща и
      точно затова са две полета, а не едно „дни болничен“: · дните за сметка на РАБОТОДАТЕЛЯ (чл. 40 ал. 5
      КСО) носят ОСИГУРИТЕЛЕН ДОХОД — перото 195 е точно за тях и вноските се дължат върху него; · дните за
      сметка на ДОО НЕ носят осигурителен доход и точно затова са базата на здравната вноска по ЗЗО чл. 40
      ал. 1 т. 5. Слети в едно число, нито едната сметка не може да се провери от фиша. ⚠️ ДНИТЕ ЗА ДОО СА
      САМО ЗА ПОКАЗ И ЗА ЗДРАВНАТА ВНОСКА. Сумата, която НОИ плаща (Приложение 9, 80 или 90 на сто от осигурителния
      доход за 18 месеца), НЕ се смята тук и НЕ е перо на фиша — НОИ я плаща на лицето директно.
      ⚠️ ИЗВЕДЕНИ, НО РЕДАКТИРУЕМИ — както работните дни отгоре и по същия довод: BgSickLeaveService ги попълва
      от епизодите, а ТРЗ вижда случаи, които епизодите не знаят. Ръчна промяна значи, че числото е нечие решение.
      ⚠️ Нулата тук НЕ е различима от празно (генерираният getter за Integer връща 0) — същият капан, който
      bgWorkedDays носи по-горе; и тук нулата е ВЕРНИЯТ прочит, защото „няма болничен“ е нормалното състояние
      на фиша. -->
    <integer name="bgSickDaysEmployer" title="Дни болничен от работодател"/>
    <integer name="bgSickDaysDoo" title="Дни болничен от ДОО"/>
    <!-- ОТ ДНИТЕ ЗА ДОО — КОЛКО СА БЕЗ ПРАВО НА ОБЕЗЩЕТЕНИЕ (под прага на стажа по чл. 40 ал. 1 КСО, след
      изключенията за трудова злополука, професионална болест и ненавършили 18 години). Д1 ги обявява в
      т. 16.4, а не в т. 16.2. ⚠️ ПОДМНОЖЕСТВО на bgSickDaysDoo, не трети брой: здравната вноска по ЗЗО
      чл. 40 ал. 1 т. 5 (за сметка на работодателя) и т. 9 на Приложение № 9 продължават да четат всички
      дни ДОО. ⚠️ ЗАМРАЗЕНО като двата броя отгоре: попълва се при пресмятането по присъдата на
      BgSickLeaveResolver (стажът КЪМ ТОГАВА), влиза в отпечатъка на фиша и се наследява от коригиращото
      копие. Нова колона: заварените фишове я четат като 0 (генерираният getter), тоест декларираното
      дотук остава непокътнато, а чернова, пресметната преди нея, има остарял отпечатък и иска
      „Преизчисли“. -->
    <integer name="bgSickDaysNoBenefit" title="От тях без право на обезщетение (т. 16.4)"/>
    <!-- ОТКАЗАНИЯТ РАЗБИВ НА БОЛНИЧНИЯ — причината, или празно. Пише се САМО от BgSickLeaveService при
      „Преизчисли“: отказ → текстът на резолвера, разделени дни → празно. „Потвърди“ отказва, докато е
      попълнено. ⚠️ ЗАЩО ПОЛЕ, А НЕ САМО ПРИСЪДА В bgGeneratorGaps. Отказите на генераторите не спират
      потвърждаването (BgPaySlipResolver#generatorRefusalWarning), а при отказан разбив дните на фиша
      ОСТАВАТ каквито са били — тоест без полето фишът би се потвърдил с нула болнични дни и Д1 би
      обявила лицето за работило. Липсващ стаж или вид, който противоречи на присъдата за правото, НЕ бива да стига до НАП
      тихо. Чете се от фиша (без Guice и без заявка), по образеца на minIncomeRefusal. Нова колона:
      заварените фишове я имат празна. ⚠️ И ОТКАЗАНОТО ПЕРО 195 (дните са разделени, сумата не —
      напр. няма потвърден фиш за месеца на настъпване) се пише тук, с началото
      BgSickLeaveService.SICK_PAY_REFUSAL_LEAD: дните вече са извадени от отработените, тоест без 195
      те остават неплатени. Същото поле, не нова колона. -->
    <string name="bgSickDaysRefusal" title="Болничен — отказ" large="true" readonly="true"/>

    <!-- ОТКАЗАНИЯТ ОТПУСК ПО ЧЛ. 177 КТ — причината, или празно. Пише се САМО от
      BgArt177LeaveService#generate при „Преизчисли“: отказ → текстът на присъдата и перо 165 се маха;
      сметнато или неприложимо → празно. „Потвърди“ отказва, докато е попълнено. ⚠️ ЗАЩО ПОЛЕ, А НЕ
      САМО ПРИСЪДА В bgGeneratorGaps — по довода при bgSickDaysRefusal: отказите на генераторите не
      спират потвърждаването, а дните на платения отпуск ВЕЧЕ са изрязани от постоянните пера (карвът
      на BgEarningsService). Тоест без полето фишът би се потвърдил с неплатен отпуск и без грешка. Влиза в
      отпечатъка: заварена пресметната чернова иска „Преизчисли“, който записва отказа. Нова колона:
      заварените фишове я имат празна. -->
    <string name="bgArt177Refusal" title="Отпуск по чл. 177 — отказан" large="true" readonly="true"/>

    <!-- ═══ ДНИТЕ ОТПУСК ПО КОФА НА Т. 16 — ЗАМРАЗЕНИ ═══

      ⚠️ ЗАЩО ЗАМРАЗЕНИ, А НЕ СМЕТНАТИ ОТ Д1. Болничните дни се четат ОТТУК, а не от епизодите, и
      доводът е записан в BgD1DaySource: „Прочетено наново, то щеше да е ВТОРА СМЕТКА на едно число
      — и коригиращата Д1 за минал месец щеше да го сметне по днешните правила.“ Същото важи за
      отпуските: „огледална“ заявка в Д1 над същите заявки се държи само докато никой не пипне
      едната половина. Разминат ли се сглобителят и Д1 (часове, граница на периода, дробен ден),
      заявка 28.12–08.01 сваля 4 дни от декемврийската заплата и НУЛА от декемврийската т. 16.5,
      тоест декларацията обявява дни с вноски, за които вноски няма.

      ⚠️ ДРОБНИ, НЕЗАКРЪГЛЕНИ. Т. 16 се попълва в ЦЕЛИ дни (Numeric ≤2 във файловия формат), но
      закръглянето е ФОРМАТНА грижа и живее в Д1. Закръглено тук, две заявки по половин ден в един
      месец щяха да дадат 1 + 1 вместо 1.

      ⚠️ И ЗАЩО ИМА ОТДЕЛНА ДАТА. Генерираният getter за decimal връща НУЛА, не null — тоест „нула
      дни отпуск“ и „този фиш е отпреди замразяването“ са НЕРАЗЛИЧИМИ по самите числа. Разликата е
      скъпа: при второто Д1 трябва да падне на старата огледална сметка, инак всеки заварен месец
