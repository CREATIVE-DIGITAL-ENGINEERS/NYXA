<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Речник на видовете обезщетения при прекратяване на правоотношението (чл.220, 222, 224, 331 КТ
    и аналозите по ЗДСл и ЗВО). Отделен от BgAbsenceType, защото обезщетението няма продължителност в дни,
    не намалява работната норма и не иска болничен лист, а има база за изчисление, каквато отсъствията нямат.
    Общото между двете са атрибутите за осигурително третиране — те са преписани нарочно, не наследени. ЗАЩО
    РЕЧНИК, А НЕ СПИСЪК С КОДОВЕ: в OmegaTIM всяко обезщетение е отделно „разплащателно перо" и разграничителят
    живее в номера на перото. Оттам ~500 пера с дубликати (96 и 98 са едно и също; 205-209 са пет еднакви).
    Тук разграничителят е в атрибути, така че ново изискване добавя стойност на атрибут, а не нов код. d1Code
    е НИЗ, не m2o към BgInsuredType — по същата причина, по която BgInsuranceContribution пази код: списъкът
    на видовете осигурени е темпорален и коригираща Д1 за минал период ползва кода, валиден тогава. -->
  <entity name="BgCompensationType">

    <!-- Основни -->
    <string name="code" title="Код" required="true" unique="true"/>
    <integer name="sequence" title="Пореден №"/>
    <string name="name" title="Наименование" required="true" namecolumn="true"/>
    <string name="legalBasis" title="Правно основание" required="true"
      help="Членът, на който се дължи обезщетението, напр. „чл. 222 ал. 1 КТ“."/>
    <!-- Актът, който поражда обезщетението. Заедно с EndOfContractReason.bgLegalFamily решава кои обезщетения
      се предлагат — но НЕ по просто съвпадение: при appliesToAnyGround се сравнява видът правоотношение, не
      актът. КТ и ЗВО са трудово, ЗДСл е служебно, тоест обезщетение по КТ „при всяко основание“ се дължи и
      при прекратяване по ЗВО. Виж BgCompensationProposalResolver#relationshipKindOf за основанието (чл. 59
      ЗВО и ВКС Решение № 142/01.07.2019 г. по гр. д. № 3934/2018 г., III г. о.). ⚠️ ЛИПСА В КАТАЛОГА, записана
      нарочно: няма обезщетение за НЕПОЛЗВАН ОТПУСК при СЛУЖЕБНО правоотношение. Чл. 224 КТ е с legalFamily
      = KT и по правилото по-горе не стига до ЗДСл — което е вярно, защото ЗДСл има собствена уредба на паричното
      обезщетение за неползван отпуск. Членът обаче не е установен, тоест редът не може да се въведе (legalBasis
      е required и иска точния член). Отворени са и основанията по чл. 106 ал. 1 ЗДСл. Докато двата въпроса
      стоят, служебното прекратяване предлага само това, което каталогът има за него. -->
    <string name="legalFamily" title="Нормативен акт" selection="bg.legal.family.select"/>

    <!-- ПОСОКА НА ЗАДЪЛЖЕНИЕТО. Обичайно обезщетението е от работодателя към лицето, но чл. 221 ал. 2 КТ
      е обратното: при дисциплинарно уволнение ЛИЦЕТО дължи на работодателя. Без това поле такъв ред би бил
      просто грешен — сумата би се чела като доход, би влязла в осигурителен и данъчен обхват, и нищо не би
      се обадило. Оттам и защо
      е required с миграция, а не nullable: празна посока значи „никой не е казал“, а при пари в двете посоки
      това не е състояние, в което е безопасно да се остане. -->
    <string name="bgDirection" title="Посока на задължението" required="true"
      default="EMPLOYER_TO_EMPLOYEE" selection="bg.compensation.direction.select"/>

    <!-- База за изчисление. Точната аритметика е в изчислението; тук се пази само видът на базата. ⚠️ baseMonths
      значи РАЗНО при различните видове база и това е единственото място, където разликата е записана: BTV_MONTHS
      — baseMonths е РАЗМЕРЪТ (напр. 1.00 = едно БТВ) REMAINING_TERM_CAPPED — baseMonths е ТАВАН, не размер:
      дължи се остатъкът от срока на договора, но не повече от N месеца. Заглавието на опцията го казва нарочно,
      за да не лъже колоната при преглед на грида. UNUSED_LEAVE_DAYS, NOTICE_DAYS, FIXED — baseMonths не участва.
      ⚠️ 12 Е САМО ТАВАН — сумата НЕ се попълва автоматично. При REMAINING_TERM_CAPPED
      системата не изчислява дължимото, а го ПРИЕМА въведено, и baseMonths стои единствено като горна граница,
      срещу която се сверява. Затова същественото поле тук е isAmountAdjustable (true), а не baseMonths — второто
      е спомагателно. ОБХВАТЪТ: чл. 58 ал. 3 ЗВО важи ИЗКЛЮЧИТЕЛНО за СРОЧНИ трудови договори.
      Текстова опора — „до изтичане на трудовия им договор“ предполага уговорен край. Съдебна
      опора — ВКС Решение № 142/01.07.2019 г. по гр. д. № 3934/2018 г., III г. о.: освободеният е бил АСИСТЕНТ,
      а тази длъжност по чл. 48 ЗВО се заема със срочен договор. ⚠️ ПРИ БЕЗСРОЧЕН ТРУДОВ ДОГОВОР ОБЕЗЩЕТЕНИЕ
      НЕ СЕ ДЪЛЖИ. Нула е ВЕРНИЯТ резултат, а не признак за счупено изчисление — не го „поправяй“. Хабилитираните
      лица по правило се назначават за неопределено време и остават извън обхвата на ал. 3. Тоест REMAINING_TERM_CAPPED
      обслужва МАЛЦИНСТВОТО: асистентите (до 5 години по чл. 48 ал. 3) и удължаванията по § 11 (до 3 години).
      12 месеца е ТАВАН, не стойност. Сумата се въвежда, а същественото поле тук е isAmountAdjustable. ═══ ИЗИСКВАНЕ,
      ЗАПИСАНО НО НЕПОСТРОЕНО: чл. 222 ал. 3 — 2 срещу 6 БТВ ═══ Решено е изборът да е АВТОМАТИЧЕН, с възможност
      за ръчна корекция. Не е построен, защото няма къде да живее: изчисление още няма, а baseMonths е
      едно число и носи само общия случай (2.00). Предпоставката липсва отделно от изчислението, и това е по-същественото.
      Условието по закон е „10 години стаж при СЪЩИЯ работодател през последните 20“. Договорът пази признат
      стаж като ЧИСЛО (bgPriorExperienceYears/Months/Days и bgPriorSpecialtyService…), без да казва при кой
      работодател е натрупан — тоест от тези полета условието НЕ може да се провери. Нужно е или ново поле
      „стаж при този работодател“, или извеждане от датите на самите договори при непрекъсната заетост, което
      пък иска история на договорите на същото лице при същото дружество. Дотогава 2.00 е верният общ случай,
      а шестте заплати се въвеждат ръчно — което полето isAmountAdjustable вече позволява. -->
    <string name="baseKind" title="Вид база" selection="bg.compensation.base.select"/>
    <decimal name="baseMonths" title="Брой месеци БТВ" precision="5" scale="2"
      help="Попълва се само при база „брутно трудово възнаграждение × месеци“."/>

    <!-- ОТ КАКВО ЗАВИСИ БАЗАТА, когато не е една и съща за всички случаи. Полето е ДЕКЛАРАТИВНО, не
      изчислително: то не казва как се смята, а че се смята различно и че условието е известно. Днес такива
      условия живеят като свободен текст в note, тоест намират се само с четене. С това поле изчислението може да
      ги извади със заявка вместо да разчита, че някой ще ги е прочел: CONTRACT_TERM — срочно срещу безсрочно
      правоотношение (чл. 221 ал. 1 и ал. 2: при безсрочно базата е предизвестието, при срочно — действителните
      вреди по ал. 4) SENIORITY — стаж при същия работодател (чл. 222 ал. 3: 2 БТВ, а при 10 години през последните
      20 при същия работодател или в същата група предприятия — 6 БТВ) NONE — базата не зависи от условие ⚠️
      Изчисление за нито един от двата случая НЕ е писано и не бива да се допуска, че съществува. За SENIORITY
      предпоставката дори липсва: договорът пази признат стаж като едно число, без периоди, без работодател
      и без понятие „група предприятия“. -->
    <string name="bgBaseVariesBy" title="Базата зависи от" required="true" default="NONE"
      selection="bg.compensation.base.varies.select"/>

    <!-- Осигурително и данъчно третиране -->
    <boolean name="socialContributionsDue" title="Дължими ДОО вноски" default="false"/>
    <string name="healthContributionRule" title="Правило ЗОВ"
      selection="bg.health.contribution.rule.select"/>
    <boolean name="isTaxable" title="Облагаемо по ЗДДФЛ" default="true"/>
    <boolean name="countsAsInsuranceService" title="Зачита се за осигурителен стаж"
      default="false"/>

    <!-- Мостът към вида осигурен. Празно = обезщетението не поражда осигуряване и не влиза в Д1 с отделен
      вид осигурен. Попълнено (напр. „27“) = редовете в BgInsuranceContribution се търсят по този код И по
      legalBasis, което разделя двата иначе еднакви ключа при код 27. -->
    <string name="d1Code" title="Вид осигурен за Д1"
      help="Код по номенклатурата на НАП, напр. 27. Празно, когато обезщетението не е осигурителен доход."/>

    <!-- Автоматично предлагане при прекратяване -->
    <boolean name="appliesToAnyGround" title="Дължи се при всяко основание" default="false"
      help="Отметнато за обезщетения като неползвания платен отпуск, които не зависят от основанието."/>
    <string name="triggerGrounds" title="Поражда се при основания"
      selection="bg.termination.ground.select" multiple="true"
      help="Празно при отметнато „дължи се при всяко основание“."/>

    <!-- ВЪЗНИКВА ПРИ ПРЕКРАТЯВАНЕ: обезщетението се дължи заради прекратяването на договора. За
      тези видове „Потвърди“ на документа иска ПОТВЪРДЕНО ПРАВО (BgTerminationCompensation) за същия
      договор и вид, прекратен ОСНОВЕН договор и същата дата на прекратяване. Документът се прави от
      правото („Създай документ“), което записва връзката. За видовете без автоматично предлагане
      (чл. 220, 225 ал. 1, 226 ал. 2) правото се създава ръчно на договора.
      Изключено — обезщетенията ПО ВРЕМЕ на договора (чл. 200, 213, 214, 216, 217, 232): за тях
      „прекратен договор“ е юридически грешно и право не се иска.
      Заварените бази: отметката идва от init-data (bg_compensation_type.csv, колона arisesOnTermination). -->
    <boolean name="arisesOnTermination" title="Възниква при прекратяване" default="false"
      help="Отметнато: документът се потвърждава само срещу потвърдено право при прекратяване на основния договор, със същата дата. Неотметнато: обезщетение по време на договора — право не се иска."/>

    <!-- ЧЛ. 222 АЛ. 1 НЕ Е ЗНАЕН ПРИ ПРЕКРАТЯВАНЕТО: дължи се само ако лицето действително е останало
      без работа, и се доказва след това с трудовата книжка. Затова състоянието на конкретния запис остава
      „предложено“, докато доказването не приключи — виж BgTerminationCompensation.status. -->
    <boolean name="requiresProof" title="Изисква доказване след прекратяването"
      default="false"/>

    <!-- ДВА РАЗЛИЧНИ ВЪПРОСА, нарочно разделени. canBeWaived: може ли ПРАВОТО да падне по договорка
      между работник и работодател. Изключено при чл. 224 ал. 1 (правото е установено от закона и не се губи
      по споразумение) и при чл. 331 (изплащането е самата същност на договорката). isAmountAdjustable: може
      ли изчислената СУМА да се коригира ръчно. Това е друго нещо и е разрешено и там, където правото не пада
      — при чл. 224 ал. 1 сумата се изчислява от неползвания отпуск и трябва да може да се поправи, а при чл.
      331 базата е „не по-малко от четирикратно БТВ“, тоест договореното почти винаги се въвежда ръчно. -->
    <boolean name="canBeWaived" title="Правото може да падне по договорка" default="true"/>
    <boolean name="isAmountAdjustable" title="Изчислената сума може да се коригира"
      default="true"/>

    <!-- large=true, тоест TEXT, а не varchar(255). Тази колона носи основанието: цитата на нормата,
      кое е изведено и кое е четене, и кое решение чие е. Редовете минават 255 знака, а при varchar(255) App
      Install ги отхвърля с „value too long for type character varying(255)“ — редът просто не влиза, а
      импортът продължава с останалите. Тоест ограничението не съкращава текста, а мълчаливо изхвърля целия
      ред. BgInsuranceContribution.bgNote е със същата форма и е с максимум 168 знака — има запас, но същия
      таван. -->
    <string name="note" title="Бележка" large="true"/>
    <boolean name="active" title="Активен" default="true"/>

  </entity>

</domain-models>
