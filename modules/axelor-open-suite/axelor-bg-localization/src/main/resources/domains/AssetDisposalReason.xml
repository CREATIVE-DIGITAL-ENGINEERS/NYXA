<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="account" package="com.axelor.apps.account.db"/>

  <!-- Български признаци върху стандартната ПРИЧИНА за извеждане на актив.

    ЗАЩО ВЪРХУ ЗАВАРЕНОТО ENTITY, А НЕ НОВА СЕЛЕКЦИЯ. AssetDisposalReason вече съществува с име,
    уникален код и disposalTypeSelect; съветникът за отписване вече показва полето с
    domain="self.disposalTypeSelect = :disposalTypeSelect", а computeDisposal вече записва избора на
    актива (fixedAsset.assetDisposalReason). Нова селекция би дублирала всичко това и би оставила
    заварените причини без българско третиране.

    ⚠️ ENTITY-ТО НЯМА КОМПАНИЯ, а Account е company-scoped. Затова разходната сметка НЕ стои тук
    като връзка — причината избира СЛОТ от категорията (60908 или 60905), а самите сметки си остават на
    категорията, където вече са seed-нати per дружество. Виж bgWriteOffAccountSelect.

    ⚠️ Признаците са ПРЕДЛОЖЕНИЕ, не присъда. Данъчното третиране по ЗДДС се пренася в регистъра на
    отписванията при самото отписване и оттам съставителят може да го промени — но само срещу
    доказателство, виж BgFixedAssetWriteOffManagementRepository. -->
  <entity name="AssetDisposalReason">

    <!-- Отписване ли е това извеждане, само от ДАП, или изобщо не е извеждане. Виж селекцията защо
      разликата не е козметична: консервацията по чл. 59 ЗКПО оставя актива в ДАП, а базовият
      съветник няма как да не го отпише. -->
    <string name="bgRemovalKindSelect" title="Вид извеждане"
      selection="bg.asset.removal.kind.select" default="WRITE_OFF"/>

    <!-- Кой слот на категорията дава разходната сметка: 60908 при продажба/дарение, 60905 при брак,
      липси и непреодолима сила. Празно значи „както решава базата по вид отписване“. -->
    <string name="bgWriteOffAccountSelect" title="Разходна сметка (слот на категорията)"
      selection="bg.asset.write.off.account.select"/>

    <!-- Сметката по ПОДРАЗБИРАНЕ, когато базовият избор по вид отписване е счетоводно грешен —
      държана като КОД, а не като връзка, и то по същата причина, по която я няма и разходната:
      entity-то няма компания, а Account е company-scoped. Кодът се резолвира в чарта на ФИРМАТА,
      която извежда актива (виж BgRemovalAccountRules#defaultAccountCode и
      BgFixedAssetDisposalServiceImpl#repointChargeAccount).

      ⚠️ ЕДИНСТВЕНИЯТ ПЪЛНЕЖ Е 442 ПРИ ВЪЗСТАНОВИМА ЛИПСА, и това е СЧЕТОВОДНО, не данъчно
      твърдение: при отговорно лице стойността не напуска предприятието, а сменя формата си от
      актив във ВЗЕМАНЕ (претенция към това лице). Разходна сметка би намалила финансовия резултат
      с нещо, което ще се събере, и би извадила от баланса актив, който още стои там — само под
      друга форма. По приложимите СС вземането е балансова позиция (краткотрайни активи, раздел
      „Вземания“), а не позиция в ОПР.

      ⚠️ НОМЕРЪТ 442 Е ИЗБОР НА СЪСТАВИТЕЛЯ, НЕ НОРМАТИВЕН. „442 Вземания по липси и начети“ идва
      от стария национален сметкоплан, а задължителен национален сметкоплан няма от 2002 г. —
      сметкопланът е на предприятието. Затова номерът стои ТУК, в началните данни, където
      съставителят може да го смени, а не в кода. Сметкопланът BG_COA е на същия автор и носи 442
      точно заради този ред.

      ⚠️ ПРИОРИТЕТЪТ Е НА BgAssetRemovalAccount. Този код е подразбирането за всички фирми; редът в
      BgAssetRemovalAccount го припокрива за ЕДНА фирма. Празен код или код, който липсва в чарта
      на фирмата, значи „остави както е“ — поведението пада на 60905 и това се ВИЖДА в статията,
      вместо да падне тихо някъде. -->
    <string name="bgRemovalAccountCode" title="Сметка по подразбиране (код)"/>

    <!-- ПРЕДЛОЖЕНОТО третиране по ЗДДС. За брак, липси и непреодолима сила подразбирането е
      CORRECTION_DUE — чл. 79 ал. 1 дължи данък „при унищожаване, кражба, установяване на загуба
      или на липси или при бракуване“, а освобождаванията по чл. 80 ал. 2 висят под условие за
      доказаност, което системата не вижда. -->
    <string name="bgVatTreatmentSelect" title="ЗДДС третиране (предложено)"
      selection="bg.asset.vat.treatment.select" default="CORRECTION_DUE"/>

    <!-- Предложеното основание по чл. 80 ал. 2, когато причината сочи такова. Остава предложение,
      докато съставителят не потвърди документалното условие. -->
    <string name="bgVatGroundSelect" title="Предложено основание по чл. 80 ЗДДС"
      selection="bg.asset.vat.ground.select"/>

    <!-- Условието, което трябва да е доказано, за да важи предложеното основание — на български, за
      да го прочете съставителят, вместо да го търси в закона. -->
    <string name="bgVatProofNote" title="Какво трябва да е доказано" large="true"
      multiline="true"/>

    <!-- SAF-T A1: КОДЪТ ПО НАП на движението (AssetMovementTypes, SD.AT.5 — 13 кода). Глобален като
      самата причина. Празен при причина, която не е счетоводно извеждане (BG_TAXEND, BG_CONSRV), и
      при причините на AOS/клиента — тогава годишният файл дава ГРЕШКА за отписан с нея актив.
      Колоната идва от db/migration/2026-10-23-fixed-asset-inventory-number.sql. -->
    <string name="bgNapMovementCode" title="Код на движението по НАП (SAF-T)"
      selection="bg.saft.asset.movement.select"/>

  </entity>

</domain-models>
