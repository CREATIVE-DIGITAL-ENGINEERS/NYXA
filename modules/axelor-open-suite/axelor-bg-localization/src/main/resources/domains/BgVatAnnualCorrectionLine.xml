<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ЕДИН АКТИВ ЗА ЕДНА ГОДИНА — редът, който става протокол по ППЗДДС чл. 66 ал. 5/6 ═══

    Реквизитите, които правилникът иска от протокола, са ЕДИНАДЕСЕТ (ал. 5, за стоки и имоти) и
    ДЕВЕТ (ал. 6, за услуги), и почти всички са множители, а не сумата: т. 5 начислен ДДС, т. 7
    ПрНИД₀, т. 8 ПрНИДх, т. 9 К₀, т. 10 Кх, т. 11 размерът на увеличението/намалението.

    ⚠️ „БРОЙ ГОДИНИ“ ГО НЯМА В ТОЗИ СПИСЪК — и това не е пропуск на правилника. Той е реквизит на
    протокола по чл. 79 (ППЗДДС чл. 66 ал. 3 т. 7), защото там корекцията се прави ВЕДНЪЖ за всички
    оставащи години. Тук тя е 1/n за ЕДНА година, тъй че брой години няма какво да брои. Полето
    periodYears носи само n (20 или 5), за да е четим знаменателят.

    ⚠️ МНОЖИТЕЛИТЕ СЕ СНИМАТ НА РЕДА, А НЕ СЕ ЧЕТАТ ОТ АКТИВА ПРИ ПЕЧАТ. Активът се преоценява,
    препродава и превключва вид използване; протоколът за 2028 г. трябва да покаже числата, с които
    е бил съставен, а не днешните. Прочетени наживо, реквизитите щяха да се променят под вече
    подадена декларация.

    NOTE: importId is inherited from com.axelor.db.Model — do NOT declare it. -->
  <entity name="BgVatAnnualCorrectionLine">

    <many-to-one name="annualCorrection"
      ref="com.axelor.apps.bglocalization.db.BgVatAnnualCorrection" title="Годишна корекция"
      required="true"/>

    <many-to-one name="fixedAsset" ref="com.axelor.apps.account.db.FixedAsset" title="Актив"
      required="true"/>

    <!-- ═══ КОЙ НОСИТЕЛ на начислен ДДС описва редът ═══

      Един актив носи повече от един данък: този при придобиването и по един за всяко подобрение.
      Чл. 79а ал. 9 го казва дословно — „се извършват ОТДЕЛНИ корекции“ — а ППЗДДС чл. 66 ал. 5 иска
      СКАЛАРНИ реквизити (един НДДС, един К₀, един Кх, един размер). Тоест сумиране по актив би било
      грешно на ниво документ: два носителя = два протокола. -->

    <!-- Последващият разход, чийто данък този ред коригира; празно = носителят при ПРИДОБИВАНЕ. -->
    <many-to-one name="subsequentCost" ref="com.axelor.apps.bglocalization.db.BgSubsequentCost"
      title="Последващ разход (носител)"/>

    <!-- ⚠️ НЕНУЛЕВИЯТ ДИСКРИМИНАТОР, който пази идемпотентността.

      Уникалното ограничение не може да стъпи на `subsequentCost`, защото PostgreSQL НЕ дедуплицира
      NULL-и: два реда с (същата корекция, същия актив, NULL) минават през unique constraint без
      възражение и редът за придобиването остава незащитен срещу дубликат — точно той, най-честият.
      Затова ключът е низ, който винаги има стойност: „ACQUISITION“ или „COST:<id>“. -->
    <string name="carrierKey" title="Ключ на носителя" required="true" default="ACQUISITION"/>

    <string name="carrierRegimeSelect" title="Режим на носителя"
      selection="bg.vat.carrier.regime.select"/>

    <!-- ═══ Снимка на фактите от ПРИДОБИВАНЕТО (идват от актива, полетата на #182) ═══ -->

    <string name="assetKindSelect" title="Класификация" selection="bg.vat.asset.kind.select"/>

    <string name="creditTypeSelect" title="Вид данъчен кредит при придобиване"
      selection="bg.vat.acquisition.credit.type.select"/>

    <decimal name="vatCharged" title="НДДС — начислен ДДС при придобиване (EUR)" precision="20"
      scale="2"/>

    <!-- n от формулата: 20 за недвижим имот, 5 за останалите стоки и за услугите.

      ⚠️ ЗАКОНОВИЯТ период и за носителя по ППЗДДС чл. 67 ал. 4, не остатъкът. Ал. 4 мени ПРОЗОРЕЦА
      („за остатъка от годините“), но изрично назовава срока, който остава 20-, съответно
      5-годишен; подзаконов акт не мени знаменател, закован в закона, а 1/R би бил нов, по-къс срок
      — тъкмо забраненото от чл. 79а ал. 10. Стои явно на реда, за да е четимо в протокола и
      обратимо, ако излезе официално становище с другия прочит на „пропорционално“. -->
    <integer name="periodYears" title="Срок — знаменател (години)"/>

    <!-- R по ППЗДДС чл. 67 ал. 4 — остатъкът от срока на ЗАВАРЕНИЯ актив, броен от кредитната
      година на подобрението ВКЛЮЧИТЕЛНО.

      ⚠️ НЕ Е знаменател и НЕ Е брой коригиращи години. Коригиращите са R − 1, защото ал. 1 иска
      „годините, СЛЕДВАЩИ“ кредитната. Двете се разминават точно с едно и това е нарочно: R е
      мярката на разпоредбата, а коригиращите години са следствие от конвенцията за началната
      година. Нула за другите режими, където остатък няма смисъл. -->
    <integer name="remainingYears" title="Остатък R (чл. 67 ал. 4)"/>

    <!-- Годината, от началото на която тече срокът. Две различни начала според това дали кредитът е
      упражнен — виж BgArt79aCorrectionWindow#periodStartYear. -->
    <integer name="termStartYear" title="Срокът тече от година"/>

    <decimal name="k0" title="К₀ — коеф. чл. 73 за годината на кредита" precision="5" scale="2"/>

    <decimal name="proportion0" title="ПрНИД₀ — пропорция за НИД в годината на кредита"
      precision="5" scale="2"/>

    <!-- ═══ Фактите за ГОДИНАТА Х — те са новото, което 79а/79б искат ═══ -->

    <!-- Чл. 79в т. 1 и т. 2: чистите случаи заковават Кх на 1 и на 0 и коефициентът по чл. 73 „не се
      взема предвид“. Затова използването е ИЗБОР, а не извод от стойността на Кх: оставено на
      числото, непопълненото поле щеше да мине за „само освободени доставки“ и да поиска обратно
      целия кредит за годината. -->
    <string name="taxableUseSelect" title="Използване през годината (чл. 79в т. 1/2)"
      selection="bg.vat.annual.taxable.use.select"/>

    <!-- Кх — коефициентът по чл. 73 за ГОДИНАТА НА ИЗМЕНЕНИЕТО.

      ⚠️ ОКОНЧАТЕЛНИЯТ по ал. 6, не прогнозният по ал. 5 — виж BgVatCoefficient.finalCoefficient.
      Чете се само при смесено използване; при чистите случаи носи закованото 1 или 0. -->
    <decimal name="kx" title="Кх — коеф. чл. 73 за годината на изменението" precision="5"
      scale="2"/>

    <!-- Чл. 79в т. 6 и т. 7. Ползва се само от чл. 79а б. „а“ и б. „г“; чл. 79б няма ПрНИД изобщо. -->
    <string name="nidUseSelect" title="Използване за НИД през годината (чл. 79в т. 6/7)"
      selection="bg.vat.annual.nid.use.select"/>

    <decimal name="proportionX" title="ПрНИДх — пропорция за НИД за годината" precision="5"
      scale="2"/>

    <!-- Чл. 79а ал. 8 / чл. 79б ал. 7: „…срокът СПИРА ДА ТЕЧЕ за всяка календарна година, през
      която стоката, съответно недвижимият имот не се използва за дейностите, посочени в чл. 69 и 70.
      Срокът се ВЪЗОБНОВЯВА за всяка календарна година, през която … започне отново да се използва.“

      ⚠️ СПРЯНАТА ГОДИНА НЕ Е „НУЛЕВА КОРЕКЦИЯ“. Тя не се коригира И не изразходва срока, тоест мести
      края му с една година напред. Записана като обикновен ред със сума нула, тя щеше да затвори
      прозореца рано и последната дължима корекция просто нямаше да се предложи.

      ⚠️ ЗАТОВА ИСТОРИЯТА НА СПИРАНИЯТА ЖИВЕЕ ТУК, А НЕ В СВОЯ ТАБЛИЦА. Годишният процес минава през
      всяка година от прозореца, тъй че редовете за актива ВЕЧЕ са пълният му летопис: предложението
      за година х чете отметките на по-ранните си години и оттам знае колко пъти срокът е спирал. Своя
      таблица би дублирала същия факт и би позволила двете да си противоречат. -->
    <boolean name="isSuspendedYear" title="Годината не се брои (чл. 79а ал. 8 — без ползване)"
      default="false"/>

    <!-- ═══ Изчисленото ═══ -->

    <!-- ИРПДК — изменението в размера на ползвания данъчен кредит.

      ⚠️ ЗНАКЪТ Е ЧАСТ ОТ СУМАТА, А НЕ МАРШРУТ. Ал. 4 т. 1 и т. 2 искат (+) и (−), но ДВЕТЕ посоки
      отиват в една и съща колона — к.11 на дневника за покупките (ППЗДДС чл. 66 ал. 9). Разделено
      по посока на две колони, намалението щеше да излезе като начислен данък в дневника за
      продажбите, където законът не го праща. -->
    <decimal name="correctionAmount" title="ИРПДК — изменение на кредита (EUR)" precision="18"
      scale="2"/>

    <string name="legalGround" title="Основание на корекцията"/>

    <!-- Приложените множители — ИЗХОДЪТ на калкулатора, отделно от въведеното.

      ППЗДДС чл. 66 ал. 5 т. 10 (съответно ал. 6 т. 8) иска в протокола „коефициент по чл. 73 … за
      годината на настъпване на изменението“, а чл. 79в решава кой е той: при чист случай това е
      закованото 1 или 0, а не числото от таблицата с коефициентите.

      ⚠️ ЗАТОВА ПРИЛОЖЕНОТО НЕ СЕ ПИШЕ ВЪРХУ ВЪВЕДЕНОТО. Записан обратно в `kx`, закованият 1 щеше
      да изяде въведения коефициент: обявен по грешка чист случай и после върнат на „смесено“,
      редът щеше да смята с Кх = 1,00 — правдоподобно и мълчаливо грешно. Двете полета не могат да
      си противоречат, защото едното е вход, а другото — резултат. -->
    <decimal name="appliedKx" title="Приложен Кх (реквизит на протокола)" precision="5" scale="2"
      readonly="true"/>

    <decimal name="appliedProportionX" title="Приложен ПрНИДх (реквизит на протокола)"
      precision="5" scale="2" readonly="true"/>

    <!-- Чл. 79а ал. 6 / чл. 79б ал. 5: „Корекцията по ал. 3 МОЖЕ ДА НЕ СЕ ИЗВЪРШВА, когато е в
      посока УВЕЛИЧЕНИЕ на размера на ползвания данъчен кредит.“

      ⚠️ РЕШЕНИЕ НА РЕДА, не на дружеството, и САМО за увеличенията. Намалението е задължително:
      пропуснато, то е скрит данъчен пасив. Изгледът показва отметката само когато сумата е
      положителна, а услугата отказва да я зачете при отрицателна. -->
    <boolean name="isSkippedUnderPara6" title="Пропусни по чл. 79а ал. 6 / 79б ал. 5"
      default="false"/>

    <!-- Защо редът НЕ се смята — обявено, а не премълчано. Празен ред без причина е неразличим от
      „няма корекция“.

      Семействата са три: ППЗДДС чл. 67 ал. 2 (отказ по закон), спряна година по чл. 79а ал. 8, и
      разход, който не поражда носител по § 1 т. 32 ДР ЗДДС — включително подобрение на СГРАДА без
      нова сграда, което и трите текста изключват поотделно. -->
    <string name="refusalReason" title="Причина за отказ" large="true" multiline="true"/>

    <many-to-one name="correctionMove" ref="com.axelor.apps.account.db.Move"
      title="Статия на протокола"/>

    <string name="comments" title="Забележки" large="true" multiline="true"/>

    <unique-constraint columns="annualCorrection,fixedAsset,carrierKey"/>

  </entity>

</domain-models>
