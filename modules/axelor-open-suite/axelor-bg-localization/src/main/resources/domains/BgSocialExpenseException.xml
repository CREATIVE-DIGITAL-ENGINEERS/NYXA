<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ⚠️ ЕНТИТЕТ-ИЗКЛЮЧЕНИЕ. ЛИПСВАЩ РЕД ЗНАЧИ „ВСИЧКО Е НАРЕД“.

    ═══ ПРОЧЕТИ ТОВА ПРЕДИ ДА ПИПНЕШ КАКВОТО И ДА Е ТУК ═══
    Ред СЪЩЕСТВУВА само за ЛОШ месец — месец, в който ТРЗ-специалистът или счетоводителят е отметнал,
    че фирменото условие е паднало. Няма ред → условията са изпълнени → облекчението важи.

    ⚠️ ТОВА Е ОБРАТНОТО НА BgGarnishmentScale, И ОБЪРКВАНЕТО НЕ Е ХИПОТЕТИЧНО. Там липсващият ред е
    ОТКАЗ: без скала запор не се удържа, защото удържане без граница е необратимо. Тук липсващият ред
    е РАЗРЕШЕНИЕ, защото „по подразбиране фирмата има публични задължения“ би обложило всеки ваучер
    на всяка фирма, която не води този списък — тоест мълчанието щеше да вземе пари от всяко лице.

    Двете подразбирания са противоположни, защото ЦЕНАТА НА ГРЕШКАТА е противоположна, а не защото
    едното е по-предпазливо от другото.

    ═══ ЗАЩО ОПТИМИСТИЧНО — РЕШЕНИЕ НА КЛИЕНТА ═══
    Обичайният месец на обичайната фирма е БЕЗ публични задължения и С лицензиран оператор. Модел,
    който иска отметка за нормалното, събира 12 реда годишно на фирма, за да каже „нищо не се е
    случило“ — и първият пропуснат месец облага цялото предприятие. Обратната посока събира ред
    единствено когато има какво да се каже.

    ═══ ⚠️ РЕД С ДВА СВАЛЕНИ ФЛАГА СЪЩО ЗНАЧИ „НАРЕД“ ═══
    И това не е дефект. Флаговете, не съществуването на реда, са отговорът: ред може да съществува,
    защото носи бележка, или защото някой е отметнал и после е свалил отметката. Прочитът е един и
    същ на двете места — питат се ФЛАГОВЕТЕ. Написано „има ли ред → лош месец“, изтритата отметка
    щеше да продължи да облага.

    ═══ КЛЮЧЪТ Е (ФИРМА, ГОДИНА, МЕСЕЦ) ═══
    Не период (Period), защото условията са на КАЛЕНДАРНИЯ МЕСЕЦ по изричния текст: чл. 208 — „към
    края на месеца, през който са начислени разходите“; чл. 213 ал. 3 и чл. 214 ал. 3 — „за
    календарния месец“. Заплатен период, който не съвпада с календарен месец, би дал два отговора за
    един месец.

    ═══ НОРМИТЕ, ДОСЛОВНО ═══
    Сверено срещу ЗКПО (редакция 2026 г., ДВ) на 26.08.2026 г.

    ЗКПО чл. 208: „Не се облагат с данък социалните разходи по чл. 204, ал. 1, т. 2, буква „а“ в
    размер до 60 лв. месечно за всяко наето лице, когато към края на месеца, през който са начислени
    разходите, данъчно задълженото лице няма подлежащи на принудително изпълнение публични
    задължения. За целите на предходното изречение не са налице задължения, когато към края на
    месеца, през който са начислени разходите, задълженията не са отразени в
    данъчно-осигурителната сметка или не са отразени като предявени за принудително изпълнение в
    Националната агенция за приходите.“

    ЗКПО чл. 209а ал. 1: „Не се облагат с данък социалните разходи по чл. 204, ал. 1, т. 2, буква
    „в“ в размер до 200 лв. месечно, предоставени под формата на ваучери за храна на електронен
    носител на всяко наето лице, когато са налице едновременно следните условия: 1. договореното
    основно месечно възнаграждение на лицето в месеца на предоставяне на ваучерите е не по-малко от
    средномесечното договорено основно възнаграждение на лицето за предходните три месеца; 2. към
    края на месеца, през който са начислени разходите за ваучери, данъчно задълженото лице няма
    подлежащи на принудително изпълнение публични задължения; ... 3. ваучерите са предоставени на
    данъчно задълженото лице от лице, получило разрешение за осъществяване на дейност като оператор
    от министъра на финансите.“

    ⚠️ ТУК СЕДЯТ САМО ДВЕТЕ ФИРМЕНИ УСЛОВИЯ. Третото — заплата не по-ниска от средната за предходните
    три месеца (чл. 209а ал. 1 т. 1) — е ПЕР-ЛИЦЕ и ИЗЧИСЛИМО от фишовете. Отметка за него би
    поканила да се отмята нещо, което системата знае сама, и да се разминат двата отговора.

    ⚠️ И ДВЕТЕ УСЛОВИЯ НЕ СА ЕДНО. Публичните задължения чупят И 60-те (чл. 208), И ваучерите
    (чл. 209а ал. 1 т. 2). Нелицензираният оператор чупи САМО ваучерите — чл. 208 не го споменава.
    Слети в един флаг, отметката за оператора щеше да обложи и допълнителното осигуряване. -->
  <entity name="BgSocialExpenseException">

    <many-to-one name="company" title="Дружество" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- ⚠️ Година и месец като числа, не дата: ключът е КАЛЕНДАРНИЯТ МЕСЕЦ, а дата би поканила да се
      запише 15-о число и да се питат две различни неща за един месец. -->
    <integer name="bgYear" title="Година" required="true"/>
    <integer name="bgMonth" title="Месец (1–12)" required="true"/>

    <!-- ⚠️ ИМЕНАТА СА В ОТРИЦАТЕЛНАТА ПОСОКА, И ТОВА Е САМОТО ПОДРАЗБИРАНЕ. Boolean без стойност се
      чете като FALSE от генерирания getter — тоест „няма задължения“ и „операторът е лицензиран“,
      тоест наред. Написани положително (bgPublicDebtsClear), заварен ред с NULL и нов ред без
      отметка щяха да значат „фирмата НЕ е чиста“ и облекчението щеше да пада мълчаливо. -->
    <boolean name="bgPublicDebts" title="Има публични задължения (чл. 208 / чл. 209а ал. 1 т. 2)"
      default="false"
      help="Отметни САМО когато към края на месеца има подлежащи на принудително изпълнение публични задължения. Чупи И облекчението по чл. 208, И ваучерите."/>
    <boolean name="bgOperatorUnlicensed" title="Операторът НЕ е лицензиран (чл. 209а ал. 1 т. 3)"
      default="false"
      help="Отметни САМО когато ваучерите не са получени от оператор с разрешение от министъра на финансите. Чупи САМО ваучерите."/>

    <!-- КОЙ и КОГА е отметнал. Не е одит-украса: отметката оскъпява месеца на всяко лице във
      фирмата, тоест трябва да има кого да питаш. -->
    <many-to-one name="flaggedBy" title="Отметнал" ref="com.axelor.auth.db.User"/>
    <datetime name="flaggedAt" title="Отметнато на"/>

    <string name="note" title="Основание на отметката" large="true"/>

    <unique-constraint columns="company,bgYear,bgMonth"/>

  </entity>

</domain-models>
