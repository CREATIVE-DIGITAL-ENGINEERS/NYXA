<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ВХОДЪТ НА ЕДНА РАЗЧЕТНО-ПЛАТЕЖНА ВЕДОМОСТ — САМО СЪБИРА, НЕ ПАЗИ ═══

    Ползва се ПРЕХОДНО, по образеца на BgPayrollSepaWizard: бутонът работи
    върху контекста на формата и НЕ вика save.

    ⚠️ ЗАЩО НЯМА ПЕРСИСТИРАНА „ВЕДОМОСТ“, КАКВАТО Д1 И СПРАВКАТА ПО ЧЛ. 73 ИМАТ. Те са ПОДАВАНИ
    документи: съществува ден, в който едно тяхно състояние е било изпратено на НАП, и оттам нататък
    то трябва да се пази такова, каквото е било. Ведомостта не се подава никому — тя е ИЗГЛЕД към
    фишовете на един период и няма нито едно свое число. Записана, тя щеше да е второ копие, което
    остарява мълчаливо: фиш, поправен след разпечатката, би оставил на екрана ведомост, която вече
    не е вярна, но изглежда точно като вярната. Хартията носи дата и час на генериране — това е
    достатъчно и е честно.

    ⚠️ И ЗАТОВА ТУК НЯМА „СЪСТОЯНИЕ“. Няма какво да се потвърждава: потвърждават се фишовете, всеки
    поотделно, и състоянието на всеки от тях стои в своя графа върху листа. -->
  <entity name="BgPayrollLedgerWizard">

    <!-- ═══ ВХОД ═══ -->

    <!-- Периодът — единственото задължително поле. Ведомостта е месечен регистър. -->
    <many-to-one name="period" title="Период" required="true"
      ref="com.axelor.apps.base.db.Period"/>

    <!-- ⚠️ ДРУЖЕСТВОТО Е НЕЗАДЪЛЖИТЕЛНО, И ТОВА Е СЛЕДСТВИЕ ОТ УСТРОЙСТВОТО НА ФИША, А НЕ ОТ
      хлабавост. Фишът НЯМА свое дружество: то се чете през EmploymentContract.payCompany (същият
      прочит като в BgPayrollSepaService). Самоосигуряващото се лице обаче няма договор, а
      регистрацията му не носи дружество — BgD1Carrier#company() връща null за него ПО УСТРОЙСТВО и
      това е обяснено там. Тоест филтър по дружество изключва ВСИЧКИ самоосигуряващи се, винаги.

      Попълнено поле значи „ведомост на предприятието“ и изключването е вярно — и се БРОИ в доклада
      за границите, а не се премълчава. Празно поле значи „целият период“ и тогава самоосигуряващите
      се имат свой лист. Измисленият трети път — дружеството на лицето по някой друг негов договор —
      би приписал на предприятието разход, който не е негов. -->
    <many-to-one name="company" title="Дружество (по избор)"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- Кой от разрезите на образеца се печата.

      ⚠️ ИЗБОРЪТ НЕ Е СЪЩОТО КАТО РАЗРЕЗА, И РАЗЛИКАТА Е ЗАПИСАНА В BgPayrollLedgerSelection:
      „Всички“ и „Аванси“ не са видове правоотношение. Второто реже НАПРЕЧНО — аванс може да има и
      нает, и управител по ДУК, — затова то НЕ е шеста стойност на разбиването: такава стойност
      щеше да ИЗВАЖДА тези хора от ведомостта на трудовите договори точно защото са получили аванс.

      ⚠️ И ШЕСТАТА СТОЙНОСТ НА РАЗБИВАНЕТО („Без определен вид осигурен“) я няма на хартията на
      Микроинвест, защото там такъв фиш не може да съществува. Тук може: видът осигурен е
      незадължителен на договора и в базата днес има такъв ред. Без свой лист тези хора биха
      изчезнали от всичките пет ведомости наведнъж — тихо. -->
    <string name="variantSelect" title="Ведомост" required="true" default="TD"
      selection="bg.payroll.ledger.variant.select"/>

    <!-- ═══ ИЗХОД (сметнат, не съхраняван) ═══ -->

    <!-- ⚠️ ЦЕЛИЯТ ТЕКСТ СЕ ПОКАЗВА — същият довод като при SEPA пробега. Преброяването по разрези
      и поименният списък на несверените редове са ДЪЛГИ по устройство и са единственото, което
      казва на човека какво да поправи; едноредово известие би ги слепило в „N реда“. -->
    <string name="resultSummary" title="Преброяване и граници" large="true" multiline="true"
      transient="true"/>

  </entity>

</domain-models>
