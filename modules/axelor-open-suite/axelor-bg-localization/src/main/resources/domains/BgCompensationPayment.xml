<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Едно плащане по едно обезщетение. Дъщерен запис нарочно, а не поле „дата на плащане“ върху самото
    обезщетение. ЗАЩО СЪЩЕСТВУВА. Наредбата за вписване в регистъра на заетостта (ПМС № 267/2024, ДВ бр.
    65 от 02.08.2024, в сила от 01.06.2025) иска в Приложение №1 датата на изплащане на обезщетенията по
    чл. 222 ал. 2 (ред 28) и по ал. 3 (ред 29), със срок за вписване 7 дни СЛЕД ВСЯКО ПЛАЩАНЕ. Тоест датите
    са толкова, колкото са плащанията — едно поле върху обезщетението би могло да носи само последната и
    би загубило предишните точно там, където срокът се брои от всяка поотделно. И оттук идва отговорът на
    въпрос, който стоеше отворен от проектирането: МОЖЕ ли едно право да се погаси на части. Може. Уникалният
    ключ на обезщетението остава (договор, вид) и НЕ се пипа — правото си е едно, плащанията са под него.
    Разсрочването, заради което в OmegaTIM има отделни пера „минал месец“ (кодове 72, 96 и 98 за чл. 222
    ал. 1), тук е просто втори ред. ⚠️ ОТВОРЕНО: няма проверка, че сборът на плащанията е равен на сумата
    на обезщетението. Не е пропуск — още не знаем дали надплащане, частично отказване и корекции са възможни,
    а празна проверка е по-добра от грешна. Когато отговорът дойде, проверката е тук, не на обезщетението. -->
  <entity name="BgCompensationPayment">

    <many-to-one name="bgTerminationCompensation" title="Обезщетение"
      ref="com.axelor.apps.bglocalization.db.BgTerminationCompensation" required="true"/>

    <!-- Датата, от която тече 7-дневният срок за вписване в регистъра. -->
    <date name="paymentDate" title="Дата на изплащане" required="true"/>

    <decimal name="amount" title="Изплатена сума" precision="20" scale="2" required="true"/>

    <string name="note" title="Забележка" large="true"/>

  </entity>

</domain-models>
