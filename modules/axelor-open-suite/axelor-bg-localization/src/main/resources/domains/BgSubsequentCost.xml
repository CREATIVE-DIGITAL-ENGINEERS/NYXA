<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ПОСЛЕДВАЩИ РАЗХОДИ ПО АКТИВ — чл. 63 и чл. 64 ЗКПО ═══

    Записът е СЪБИТИЕТО, не поле на актива: един актив може да носи много последващи разходи през
    живота си, всеки със своя дата, сума, класификация и правен път. Поле на актива би запазило само
    последния и би загубило основанието на предишните.

    ⚠️ ДАТАТА НЕ Е 1 ЯНУАРИ. Чл. 62 ал. 2 отразява промените „към 1 януари на годината, в която са
    установени обстоятелствата", но целият чл. 62 е РЕТРОСПЕКТИВЕН: ал. 3 иска новите стойности да
    са равни на онези, „които биха били определени, ако обстоятелствата… са били известни през
    предходните години". Последващият разход е НОВ факт на текущата година, тъй че за него важи
    ал. 5 — „към момента на установяване на обстоятелството през текущата година" — а чл. 63 изр. 2
    прави момента точен: „от началото на месеца, през който са завършени последващите разходи".

    ⚠️ И КОРЕКЦИЯ ПО ЧЛ. 62 АЛ. 4 НЕ СЕ ПРАВИ. Ал. 4 коригира с разликата спрямо онова, което би
    било начислено през предходните години — а последващият разход не е съществувал тогава.

    Откриването на ГРЕШКА (чл. 62 ал. 2 + ал. 3) е ОТДЕЛЕН правен режим и нарочно не е стойност на
    това събитие: слети, двата биха споделили поле, чиято стойност мени правния резултат, без да го
    обяснява. -->
  <entity name="BgSubsequentCost">

    <many-to-one name="fixedAsset" ref="com.axelor.apps.account.db.FixedAsset" title="Актив"
      required="true"/>

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"/>

    <!-- Датата на ЗАВЪРШВАНЕ на разходите, не на фактурата и не на плащането — и двата члена
      говорят за „месеца, през който са ЗАВЪРШЕНИ последващите разходи". -->
    <date name="completionDate" title="Завършени на" required="true"/>

    <decimal name="amount" title="Сума (EUR)" precision="20" scale="3" required="true"/>

    <!-- ⚠️ ПРЕЦЕНКА НА СЪСТАВИТЕЛЯ, не изведена от сумата. И чл. 63, и чл. 64 ал. 1 препращат към
      счетоводното законодателство за критерия („водят до бъдещи икономически изгоди, свързани с
      актива") и не дават свой. Голяма сума за ремонт си остава текущ разход; малка сума за
      надграждане си остава капиталова. Затова полето се пита, а не се налучква. -->
    <string name="classificationSelect" title="Класификация"
      selection="bg.subsequent.cost.classification.select" required="true" default="CAPITAL"/>

    <!-- Основанието за класификацията — то е това, което прави записа проверим при ревизия. -->
    <string name="justification" title="Основание за класификацията" large="true"/>

    <!-- Изведено от присъствието на актива в ДАП: чл. 63 иска актив „наличен" в плана, чл. 64 ал. 1
      — актив „отписан от данъчния амортизационен план, но не отписан за счетоводни цели". -->
    <string name="routingSelect" title="Правен път" selection="bg.subsequent.cost.routing.select"
      readonly="true"/>

    <date name="effectiveFrom" title="В сила от" readonly="true"/>

    <decimal name="amortizableValueBefore" title="ДАС преди (EUR)" precision="20" scale="3"
      readonly="true"/>

    <decimal name="amortizableValueAfter" title="ДАС след (EUR)" precision="20" scale="3"
      readonly="true"/>

    <!-- Самостоятелният актив по чл. 64 ал. 1, ако разходът е поел по този път. -->
    <many-to-one name="generatedFixedAsset" ref="com.axelor.apps.account.db.FixedAsset"
      title="Породен самостоятелен актив (чл. 64)" readonly="true"/>

    <!-- ⚠️ Маркер „да се потвърди": чл. 64 ал. 1 казва императивно „се завежда самостоятелен
      данъчен амортизируем актив", БЕЗ да препраща към праг, а чл. 50/51 определят какво Е данъчен
      амортизируем актив. Приложили сме прага, защото чл. 64 ползва дефинирания другаде термин — но
      това е тълкуване, не цитат. Забележете и асиметрията: чл. 63 няма никакъв праг. -->
    <boolean name="isBelowThreshold" title="Под прага по чл. 50/51 — извън ДАП" readonly="true"/>

    <boolean name="isApplied" title="Приложен" readonly="true"/>

    <date name="appliedOn" title="Приложен на" readonly="true"/>

    <!-- ═══ ДДС БЛОК — ВТОРИЯТ НОСИТЕЛ на начислен данък (чл. 79а ал. 9/10, ППЗДДС чл. 67 ал. 4) ═══

      ⚠️ НА РАЗХОДА, А НЕ НА АКТИВА — и това е самият довод на това entity. Един актив носи МНОГО
      последващи разхода през живота си; сложени на актива, полетата биха запазили само последното
      подобрение и биха загубили основанието на предишните. Законът иска обратното: чл. 79а ал. 9
      казва „се извършват ОТДЕЛНИ корекции“, тоест всеки носител си има свой НДДС, свой прозорец и
      свой протокол.

      ⚠️ И НЕ Е `classificationSelect`. Онова поле е ЗКПО чл. 63/64 („водят до бъдещи икономически
      изгоди“); ЗДДС пита друго — § 1 т. 32 ДР. Двете оси са независими: капиталов по ЗКПО разход
      върху сграда, който не прави нова сграда, е CAPITAL и въпреки това НЕ е подобрение по ЗДДС.
      Слепени, едната ос би решавала вместо другата. -->

    <!-- Разходът „подобрение“ ли е по § 1 т. 32 ДР ЗДДС. Без нея носител изобщо не възниква.

      Декларирана, защото и двете букви на т. 32 искат преценка: б. „а“ иска резултатът да е нова
      сграда, б. „б“ — „икономическа изгода над тази от първоначално оценената стандартна
      ефективност“. Нито едното не е изводимо от сумата. -->
    <boolean name="bgVatIsImprovement" title="Подобрение по § 1 т. 32 ДР ЗДДС" default="false"/>

    <!-- Активът СГРАДА ли е — § 1 т. 32 дели точно по това.

      ⚠️ Свойство на АКТИВА, обявено тук. `bgVatAssetKindSelect` на актива различава недвижим имот
      от стока и услуга, но НЕ различава сграда от друг недвижим имот, а цялата трета пътека виси
      на тази разлика: подобрение на СГРАДА без нова сграда няма носител, докато същото подобрение
      на не-сграда има. Два разхода на един актив, които си противоречат тук, се ОТКАЗВАТ — виж
      BgArt79aCarriers#buildingContradiction. -->
    <boolean name="bgVatAssetIsBuilding" title="Активът е сграда (§ 1 т. 32 б. „а“)"
      default="false"/>

    <!-- Подобрението дава ли „нова сграда“ по § 1 т. 5 б. „в“ ПОДТ. „аа“ ⇒ чл. 79а ал. 9.

      ⚠️ САМО подточка „аа“. § 1 т. 32 б. „а“ сочи именно нея, не цялата т. 5: 60-месечният часовник
      на подт. „бб“ важи за режима на ДОСТАВКАТА на сградата, не за корекцията. Прочетено „нова
      сграда = цялата т. 5“, подобрение отпреди шест години би престанало да е подобрение и вторият
      носител би изчезнал.

      ⚠️ НЕ Е ИЗВОДИМО от системата. „аа“ дава две алтернативи — обособени самостоятелни обекти,
      годни за отделни доставки (правно-фактическа преценка), или преки разходи ≥ 1/3 от ПАЗАРНАТА
      ЦЕНА към датата на НОВО разрешение за ползване. Нито пазарната цена, нито разрешението
      съществуват в модела. Затова отметката е декларирана, но иска основание. -->
    <boolean name="bgVatResultsInNewBuilding" title="Дава нова сграда (§ 1 т. 5 б. „в“ подт. „аа“)"
      default="false"/>

    <!-- Основанието, което прави отметката проверима при ревизия: номер и дата на новото разрешение
      за ползване, размер на преките разходи, пазарна цена към същата дата. -->
    <string name="bgVatImprovementJustification" title="Основание за „нова сграда“" large="true"
      multiline="true"/>

    <!-- НДДС на ТОЗИ носител — „начисленият ДДС за извършените разходи за извършеното подобрение“
      (чл. 79а ал. 9 т. 2 дословно).

      ⚠️ НЕ Е `amount`. Онова е капитализираната сума по ЗКПО, БЕЗ данък. Подаден вместо НДДС, той
      би занижил корекцията с цялата ставка. -->
    <decimal name="bgVatChargedOnCost" title="НДДС на подобрението (EUR)" precision="20" scale="2"/>

    <!-- Годината на упражняване на кредита ЗА ПОДОБРЕНИЕТО — началото на неговия прозорец.

      ⚠️ Едно поле, две значения, точно както при актива: когато кредит НЕ е упражнен, тук стои
      годината, през която изтича срокът по чл. 72 ал. 1 (чл. 79а ал. 9 т. 1 б. „а“ срещу б. „б“).
      Двете са взаимно изключващи се по конструкция и видът кредит казва кое е налице. -->
    <integer name="bgVatCreditYear" title="Година на кредита за подобрението"/>

    <string name="bgVatCreditTypeSelect" title="Вид данъчен кредит за подобрението"
      selection="bg.vat.acquisition.credit.type.select"/>

    <!-- ⚠️ СВОИ коефициенти, не тези на актива. Кредитът за подобрението е от ДРУГА година, тъй че
      К₀ на втория носител по конструкция се различава от К₀ при придобиването. Пренесени от актива,
      те биха описали оборота на чужда година. -->
    <decimal name="bgVatCoefficientK0" title="К₀ за годината на кредита за подобрението"
      precision="5" scale="2"/>
    <decimal name="bgVatProportionNid0" title="ПрНИД₀ за същата година" precision="5" scale="2"/>

    <!-- „Годината на фактическото използване на СГРАДАТА СЛЕД извършеното подобрение“
      (чл. 79а ал. 9 т. 1 б. „а“/„б“) — мери се по сградата, не по разхода. Само за ал. 9. -->
    <integer name="bgVatFirstUseYear" title="Година на фактическо използване след подобрението"/>

    <!-- Изведеният режим, за четимост на екрана: NEW_TERM_ART9 / REMAINDER_ART67_4 / NONE.
      Истината се смята от BgArt79aCarriers при всяко предлагане; тук стои само отпечатък. -->
    <string name="bgVatRegimeSelect" title="Режим на носителя" selection="bg.vat.carrier.regime.select"
      readonly="true"/>

    <string name="comments" title="Бележки" large="true"/>

  </entity>

</domain-models>
