<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ РАЗХОДНА/РАЗЧЕТНА СМЕТКА ПО ПРИЧИНА ЗА ИЗВЕЖДАНЕ ═══

    Базата избира сметката при отписване от ВИДА на извеждането: продажба (2) → сметката за
    балансова стойност при продажба (60908), всичко останало → липси и брак (60905). Две сметки,
    два вида — и нито едното не стига за ВЪЗСТАНОВИМАТА ЛИПСА.

    ⚠️ ВЪЗСТАНОВИМАТА ЛИПСА НЕ Е РАЗХОД, А ВЗЕМАНЕ. Когато има отговорно лице, стойността не
    напуска предприятието — тя сменя формата си от актив в вземане от това лице. Осчетоводена на
    60905, тя намалява финансовия резултат с нещо, което ще се събере.

    ⚠️ И ТОВА Е СЧЕТОВОДНА КОНВЕНЦИЯ И ИЗБОР НА СЪСТАВИТЕЛЯ, НЕ ЗАКОНОВО ИЗИСКВАНЕ. Номерът „442
    Вземания по липси и начети" идва от традицията на националния сметкоплан, а задължителен
    национален сметкоплан няма от 2002 г. — сметкопланът е на предприятието. Затова номерът НЕ е
    закован никъде в кода: подразбирането стои в началните данни, на колоната
    AssetDisposalReason.bgRemovalAccountCode, а този обект го припокрива.

    ⚠️ ЗАЩО ПРИЧИНА, А НЕ КАТЕГОРИЯ НА АКТИВА. Машина и сграда при възстановима липса отиват на едно
    и също вземане — сметката е свойство на ПРИЧИНАТА и дружеството, не на вида актив. Слот върху
    категорията би поискал един и същ отговор да се повтори на всяка категория.

    ⚠️ ПРИПОКРИВАНЕ, НЕ ЕДИНСТВЕН ИЗТОЧНИК. Seed ред тук няма и не може да има: `company` е
    задължителна, а началните данни не знаят кои дружества ще съществуват. Затова подразбирането
    живее на ПРИЧИНАТА, като КОД (bgRemovalAccountCode = „442“ за възстановима липса), и се
    резолвира в чарта на фирмата, която извежда актива. Сметкопланът BG_COA носи 442 „Вземания по
    липси и начети“ под групата на вземанията (B020) точно заради това.

    Редът на резолюция е: ред ТУК (една фирма, една причина) → кодът от причината, потърсен в чарта
    на ТАЗИ фирма → нищо, тоест 60905. Последното е видимо в статията, а не тихо — и важи и когато
    442 липсва в чарта на дружеството или е деактивирана.

    ⚠️ ДДС ТРЕТИРАНЕТО НЕ СЕ ПИПА. Този обект сменя САМО дебитната сметка. Дали се дължи корекция по
    чл. 79 ЗДДС се решава от причината (vatTreatmentSelect) и остава CORRECTION_DUE за липсите —
    независимо дали са възстановими. Двата въпроса са различни: счетоводното третиране на липсата и
    данъчният ѝ кредит. -->
  <entity name="BgAssetRemovalAccount">

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <many-to-one name="assetDisposalReason" ref="com.axelor.apps.account.db.AssetDisposalReason"
      title="Причина за извеждане" required="true"/>

    <!-- Сметката, която ЗАМЕСТВА избраната от базата при отписване с тази причина. -->
    <many-to-one name="account" ref="com.axelor.apps.account.db.Account" title="Сметка"
      required="true"/>

    <string name="comments" title="Основание" large="true"/>

    <!-- Една причина, едно дружество, една сметка. Два реда биха дали два отговора на един въпрос,
      а услугата чете първия — тоест изборът щеше да зависи от реда на вмъкване. -->
    <unique-constraint columns="company,assetDisposalReason"/>

  </entity>

</domain-models>
