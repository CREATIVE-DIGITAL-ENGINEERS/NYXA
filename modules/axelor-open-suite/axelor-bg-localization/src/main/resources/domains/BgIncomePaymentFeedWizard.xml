<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ВХОДЪТ НА ЕДИН ПРОГОН НА ЗАХРАНВАНЕТО — САМО СЪБИРА, НЕ ПАЗИ ═══

    Ползва се ПРЕХОДНО: бутонът работи върху контекста на
    формата и НЕ вика save. Изходните полета са transient — те са резултат от прогона, а не
    състояние на нещо.

    ⚠️ ЗАЩО НЕ Е ПЕРСИСТИРАН „ПРОГОН“. Захранването няма свой документ: то пише в регистъра и
    редовете ТАМ носят цялата истина (референция, дата, суми). Запис на прогона би бил ЧЕТВЪРТО
    нещо за сверяване — до фиша, до фактурата и до реда — и първото, което се разминава с тях,
    защото никой не го препрочита. Границите на прогона се четат веднага и се хвърлят.

    ⚠️ И ЗАТОВА ПОВТОРНИЯТ ПРОГОН НЕ ЧЕТЕ ИСТОРИЯ. Той намира своите редове по референцията им
    (source + sourceRef + incomeType), не по спомен какво е правил миналия път. Виж
    BgIncomePaymentFeedService. -->
  <entity name="BgIncomePaymentFeedWizard">

    <!-- ═══ ВХОД ═══ -->

    <!-- Платецът. Обходът чете фишовете през EmploymentContract.payCompany, а фактурите — през
      Invoice.company: фишът НЯМА свое дружество (виж BgQueryFieldTest). -->
    <many-to-one name="company" title="Платец (дружество)" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <integer name="taxYear" title="Данъчна година" required="true"/>

    <!-- ⚠️ ПО ИЗБОР, И ТОВА Е РЕШЕНИЕ, А НЕ НЕДОВЪРШЕНОСТ. Двете справки питат различно: чл. 73 е
      ГОДИШНА, чл. 55 — ТРИМЕСЕЧНА. Заковано на тримесечие, действието би искало четири прогона
      преди годишната справка; заковано на година, то не би могло да се пусне пак само за
      поправеното тримесечие. Празно значи ЦЯЛАТА ГОДИНА.

      ⚠️ Обхватът НЕ участва в идемпотентния ключ. Прогон за годината и прогон за второто
      тримесечие пипат едни и същи редове и не се сблъскват — ключът е референцията към изходния
      документ. -->
    <integer name="quarter" title="Тримесечие (празно = цялата година)"
      selection="bg.income.feed.quarter.select"/>

    <!-- ⚠️ ПРОБНИЯТ РЕЖИМ Е ПОДРАЗБИРАНЕТО, а не обратното. Прогонът пише в регистър, който храни
      две подавани декларации; първото, което операторът трябва да види, е КОЛКО реда и КОИ
      откази — не факт, който вече се е случил. Изключването е едно щракване и е съзнателно. -->
    <boolean name="dryRun" title="Пробен прогон (нищо не се записва)" default="true"/>

    <!-- ═══ ИЗХОД (сметнат, не съхраняван) ═══ -->
    <string name="resultSummary" title="Резултат и граници" large="true" multiline="true"
      transient="true"/>

  </entity>

</domain-models>
