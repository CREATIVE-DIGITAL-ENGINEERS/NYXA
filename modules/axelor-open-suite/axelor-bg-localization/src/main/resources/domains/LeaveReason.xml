<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="human-resource" package="com.axelor.apps.hr.db"/>

  <!-- СЪПОСТАВЯНЕТО „ВИД ОТПУСК НА КЛИЕНТА → ВИД ОТСЪСТВИЕ ПО БЪЛГАРСКОТО ПРАВО“. ═══ ЗАЩО ИЗОБЩО ═══
    LeaveReason на базовия модул носи name, unitSelect, exportCode и няколко флага за начисляване — и НИТО
    ЕДИН признак „платен“, нито връзка към BgAbsenceType. Тоест от модела НЕ СЕ ЧЕТЕ дали даден отпуск е
    платен, неплатен или нещо трето. Точно това записваше BgPayrollInputBuilder.DECLARED_ABSENT за paidLeaveDays:
    „платен не се ЧЕТЕ от модела, а съпоставянето LeaveReason → BgAbsenceType е решение на човек“. ═══ ⚠️
    ТОВА Е ОПЕРАЦИОНЕН ИЗБОР, НЕ ЗАКОН ═══ Как е кръстен видът отпуск в конкретната инсталация е решение
    на КЛИЕНТА, не на норма: „Годишен отпуск“, „Основен платен“ и „Отпуск чл. 155“ може да значат едно и
    също, а може и да не значат. Затова съпоставянето е КОНФИГУРИРУЕМО поле, а не таблица в кода — хардкод
    по име щеше да е догадка, представена като правило. ⚠️ И ЗАТОВА ИМА ВТОРО ПОЛЕ. Подразбиране, което не
    се различава от потвърден избор, е догадка с вид на решение. bgAbsenceTypeDefaulted казва „това го сложи
    машината, чака потвърждение“ — видимо на екрана и събираемо в списък за преглед. Потвърденото се маха
    от списъка чрез сваляне на флага, а не чрез мълчание. -->
  <entity name="LeaveReason" cacheable="true">

    <!-- Видът отсъствие по българската номенклатура. NULLABLE НАРОЧНО: несъпоставеният вид отпуск трябва
      да е РАЗЛИЧИМ от съпоставения, а не да получи мълчаливо подразбиране. Сглобителят ОТКАЗВА, когато срещне
      валидирана заявка с несъпоставена причина — отказът се вижда, тихата нула не. -->
    <many-to-one name="bgAbsenceType" title="Вид отсъствие (БГ)"
      ref="com.axelor.apps.bglocalization.db.BgAbsenceType"/>

    <!-- ⚠️ default="false" И ТОВА Е ВЕРНИЯТ ПРОЧИТ ЗА ЗАВАРЕНИТЕ РЕДОВЕ. Генерираният getter за Boolean
      връща FALSE за NULL, тоест заварен ред се чете като „не е подразбиран“. Заварените редове обаче нямат
      и съпоставяне — те са NULL в bgAbsenceType и затова изобщо не стигат до въпроса „потвърдено ли е“. Флагът
      има смисъл САМО заедно с попълнено съпоставяне. -->
    <boolean name="bgAbsenceTypeDefaulted"
      title="Съпоставянето е подразбирано (чака потвърждение)" default="false"/>

  </entity>

</domain-models>
