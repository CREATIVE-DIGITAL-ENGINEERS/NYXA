<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="human-resource" package="com.axelor.apps.hr.db"/>

  <!-- Bulgarian localization fields added to the standard Employee entity. These are merged into com.axelor.apps.hr.db.Employee
    by the code generator. NOTE: validation (e.g. EGN checksum) is intentionally NOT implemented here. -->
  <entity name="Employee" cacheable="true">

    <!-- ЕГН / ЛНЧ -->
    <string name="bgPersonalIdNumber" title="ЕГН/ЛНЧ"/>
    <string name="bgPersonalIdType" title="Тип идентификатор"
      selection="bg.personal.id.type.select"/>

    <!-- Лична карта -->
    <string name="bgIdCardNumber" title="Лична карта №"/>
    <string name="bgIdCardIssuedBy" title="Издадена от"/>
    <date name="bgIdCardIssueDate" title="Дата на издаване"/>
    <date name="bgIdCardValidTo" title="Валидна до"/>

    <!-- Категория труд (I, II, III) -->
    <string name="bgLaborCategory" title="Категория труд"
      selection="bg.labor.category.select"/>

    <!-- Роден след 31.12.1959 (влияе на ДЗПО/УПФ) -->
    <boolean name="bgBornAfter1959" title="Роден след 31.12.1959 г."/>

    <!-- Пенсионен избор. „Роден преди 1960" и „избор по чл.4б" имат ЕДНАКВИ ставки, но РАЗЛИЧНО Д1 отчитане
      (цялото в т.22 срещу увеличението в т.26) → отделно поле, не се извежда от bgBornAfter1959. -->
    <string name="bgPensionChoice" title="Пенсионен избор"
      selection="bg.pension.choice.select" default="DEFAULT"/>

    <!-- Пенсионер -->
    <boolean name="bgIsPensioner" title="Пенсионер"/>

    <!-- Самоосигуряващо се лице -->
    <boolean name="bgIsSelfInsured" title="Самоосигуряващо се лице"/>

    <!-- Осигурителен статус -->
    <string name="bgInsuranceStatus" title="Осигурителен статус"
      selection="bg.insurance.status.select"/>

    <!-- Данъчно облекчение при трайно намалена работоспособност ≥50% (чл. 18 ЗДДФЛ). Заглавията НЕ казват
      „ТЕЛК": ТЕЛК е органът (Териториална експертна лекарска комисия), който издава решението, а полетата
      описват степента и валидността на самото решение. Освен това решение може да е издадено и от НЕЛК — „ТЕЛК"
      би било просто невярно за тези случаи. Имената на полетата НЕ се пипат — ползват се другаде. -->
    <boolean name="bgDisabilityRelief"
      title="Намалена работоспособност ≥50% (данъчно облекчение)"/>
    <date name="bgDisabilityValidUntil"
      title="Решение за намалена работоспособност — валидно до"/>

    <!-- Избран осигурителен доход за самоосигуряващи се лица (СОЛ) -->
    <decimal name="bgSolInsurableIncome" title="Избран осиг. доход (СОЛ)" precision="15"
      scale="2"/>

    <!-- Ръчен минимален осигурителен доход — за случаи, които КИД×група lookup не покрива (напр. началник
      клиника/отделение). Precision/scale съвпадат с BgMinInsuranceIncome.minIncome. -->
    <decimal name="bgMinIncomeOverride" title="Ръчен минимален осигурителен доход (EUR)"
      precision="20" scale="2"/>

    <!-- ПРИЗНАТ ОСИГУРИТЕЛЕН СТАЖ НА ЛИЦЕТО, в месеци — деклариран вход, не изчислен. ЗАЩО НА ЛИЦЕТО,
      А НЕ НА ДОГОВОРА. Осигурителният стаж се носи от ЧОВЕКА през всичките му правоотношения: сменил работодател,
      лицето не започва от нула. EmploymentContract.bgPriorExperience{Years,Months,Days} е
      ДРУГО нещо: там е признатият ТРУДОВ стаж за този договор (клас за прослужено време), а трудовият и осигурителният
      стаж се разминават — платеният отпуск например е трудов стаж, а неплатеният над 30 дни не е нито единият.
      ⚠️ ДВЕ КОЛОНИ, А НЕ ЕДНА, И ТОВА НЕ Е УКРАСА. Генерираният getter за Integer връща 0 и за NULL колона
      (виж BgDefaultedGetterTest), тоест „нула месеца стаж“ и „никой не е попълвал“ пристигат като ЕДНО И СЪЩО
      число. Разликата е съществена: нула месеца е ВЕРНИЯТ отговор за човек, който постъпва на първата си работа,
      и по чл. 40 ал. 1 КСО тъкмо той НЯМА право на парично обезщетение (иска се 6 месеца осигурителен стаж).
      Слети в едно, „новопостъпил“ и „непопълнено“ дават един отговор на два въпроса с различна поправка. Затова
      стойността се ЧЕТЕ само когато флагът я обявява за декларирана. Флагът е boolean и неговият генериран
      getter връща FALSE за NULL — тоест заварените редове се четат като „не е декларирано“, което е верният
      прочит: никой още не ги е питал. -->
    <integer name="bgInsuranceServiceMonths" title="Признат осигурителен стаж (месеци)"/>
    <boolean name="bgInsuranceServiceDeclared" title="Осигурителният стаж е деклариран"
      default="false"/>

    <!-- КЪМ КОЯ ДАТА Е ДЕКЛАРИРАН СТАЖЪТ. Без нея числото е стаж „към неизвестно кога“ и правото на
      обезщетение би се мерило към деня на ПРЕСМЯТАНЕТО на фиша, а не към началото на неработоспособността
      (КСО чл. 40 ал. 1). С нея стажът към всяка дата D се ИЗВЕЖДА: декларираните месеци плюс месеците
      между тази дата и D, удостоверени с потвърдени фишове при осигурителя
      (BgSickBenefitVerdictRules). D преди тази дата, или месец без потвърден фиш → отказ: назад
      стажът не се изважда, а липсващ месец не е „осигурен“. Нулируемо: заварените служители я нямат и
      първото определяне на право за тях се отказва, докато не се попълни. -->
    <date name="bgInsuranceServiceAsOf" title="Стажът е към дата"/>

    <!-- ЛИЧНАТА ПЛАТЕЖНА СМЕТКА ЗА ПАРИЧНИ ОБЕЗЩЕТЕНИЯ ОТ ДОО — т. 26 на Приложение № 9 към
      чл. 8 ал. 1 и чл. 11 ал. 1 НПОПДОО.

      ⚠️ ОТДЕЛНО ОТ Employee.bankDetails, И ТОВА НЕ Е ДУБЛИКАТ. Двете сметки отговарят на различни
      въпроси и се менят независимо. bankDetails е сметката, ПО КОЯТО ДРУЖЕСТВОТО ПЛАЩА — тя се
      ползва от разчетите и от импорта на банкови извлечения. Тази тук е сметката, по която НОИ
      плаща ДИРЕКТНО НА ЛИЦЕТО обезщетението за дните по чл. 40 ал. 1 КСО: осигурителят само я
      удостоверява и няма нищо общо с превода. Лице може да получава заплатата си по една сметка и
      обезщетението по друга, и точно това е обичайното при сменена банка — НОИ иска сметката,
      която лицето е декларирало пред него.

      ⚠️ НИЗ, А НЕ ВРЪЗКА КЪМ BankDetails. Образецът иска IBAN и нищо друго; BankDetails носи и
      банка, и BIC, и притежател, тоест въвеждането щеше да иска цял запис там, където точката иска
      едно поле. Освен това BankDetails на служителя се ползва от импорта на извлечения и нов ред
      там би влязъл в съпоставянето на плащания — страничен ефект върху чужд поток.

      ⚠️ БЕЗ ВАЛИДАЦИЯ НА IBAN, съзнателно и по същия довод, по който този файл не проверява ЕГН:
      валидацията е отделно решение за целия модул, а половинчата тук би отхвърляла чужди сметки. -->
    <string name="bgBenefitIban" title="IBAN за обезщетения от ДОО"/>

    <!-- Деца (за данъчни облекчения чл.22в/22г ЗДДФЛ и отпуски за гледане на дете) -->
    <one-to-many name="bgChildren" title="Деца"
      ref="com.axelor.apps.bglocalization.db.BgEmployeeChild" mappedBy="employee"/>

    <!-- Личен номер на служителя (номер в личния състав). Нужен е при миграцията от Microinvest:
      нито socialSecurityNumber, нито exportCode са номер на служител. -->
    <string name="bgPersonnelNumber" title="Личен номер (личен състав)"/>

  </entity>

</domain-models>
