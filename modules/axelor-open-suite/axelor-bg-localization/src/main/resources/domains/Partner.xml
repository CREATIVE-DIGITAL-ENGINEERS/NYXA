<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <!-- Bulgarian localization fields added to the standard Partner entity. Merged into com.axelor.apps.base.db.Partner
    by the code generator. -->
  <entity name="Partner">

    <!-- Презиме (трипартитно БГ име: firstName собствено, bgMiddleName презиме, name фамилия). Живее
      на Partner (не на Employee), защото е характеристика на лицето и се ползва и за хонорар-партньори без
      Employee. Показва се само за физически лица (partnerTypeSelect = 2). БЕЗ промяна на fullName/simpleFullName
      (остават firstName+name) — само видимо поле. NOTE: importId се наследява от com.axelor.db.Model — НЕ
      се декларира. -->
    <string name="bgMiddleName" title="Презиме"/>

    <!-- Дата на раждане на ФИЗИЧЕСКО ЛИЦЕ — колона 5 на образец 5-2001 (справката по чл. 73 ал. 1).

      ⚠️ ТЯ Е ЕДИНСТВЕНИЯТ ИДЕНТИФИКАТОР, КОГАТО ЛИЦЕТО НЯМА ДРУГ. Указание т. 4 към справката,
      дословно: „„3“ за чуждестранно физическо лице без посочените идентификатори, като в тези
      случаи колона 4 НЕ се попълва, а се попълва датата на раждане в колона 5.“ Тоест колони 4 и 5
      са ВЗАИМНОИЗКЛЮЧВАЩИ се, а не допълващи се: без това поле ред с тип идентификатор „3“ няма с
      какво да назове лицето и справката е непълна по смисъла на указание т. 6.

      ⚠️ НА Partner, А НЕ НА ПЛАЩАНЕТО — по същия довод като bgMiddleName и като идентификатора:
      това е характеристика на ЛИЦЕТО. Преписана на всеки ред от регистъра, тя би се разминала сама
      със себе си. Живее и за партньори без Employee — получателят на хонорар или наем рядко е
      служител, а точно неговите доходи описва тази справка.

      ⚠️ И Е РАЗЛИЧНА ОТ Employee.birthDate: HR-модулът я държи за служителите, но Част ІІ описва
      ЛИЦА (Partner), не служители. Прочетена оттам, тя би била празна за всеки получател без
      трудово или служебно правоотношение — тоест точно за случая, в който колона 5 се пълни. -->
    <date name="bgBirthDate" title="Дата на раждане"/>

    <!-- ТИПЪТ на идентификатора — колона 3 на образец 5-2001 (справката по чл. 73 ал. 1).

      Указание т. 4, ДОСЛОВНО: „0“ за лице с ЕГН; „1“ за лице с ЛН, ЛНЧ или „Сл. № от регистъра на
      НАП“; „2“ за физическо лице с БУЛСТАТ; „3“ за чуждестранно физическо лице без посочените
      идентификатори.

      ⚠️ ПОЛЕТО СЪЩЕСТВУВА, ЗАЩОТО РЕГИСТЪРЪТ ГО ИСКА ЗАДЪЛЖИТЕЛНО.
      BgIndividualIncomePayment.identifierType е required, а авто-захранването няма ръка на
      въвеждащ: без този признак то или би отказвало всеки ред, или би ПОЗНАВАЛО — а познаването тук е избор между четири стойности, от които
      само две са проверими.

      ⚠️ ДВЕ ОТ ЧЕТИРИТЕ СТОЙНОСТИ СА ИЗВОДИМИ, ДРУГИТЕ ДВЕ — НЕ, И ТОВА РЕШАВА ЗАЩО Е ДАННИ.
      ЕГН и ЛНЧ носят контролна цифра и се проверяват (BgIdentifierValidator); затова празно поле
      при валиден ЕГН се чете като „0“, а при валиден ЛНЧ — като „1“. БУЛСТАТ („2“) и чуждестранното
      лице без идентификатор („3“) НЯМАТ такъв признак: първото се различава от ЕГН само по дължина,
      а второто по определение няма какво да се провери. Изведени по догадка, те биха дали
      правдоподобна колона 3 върху ред, който НАП отхвърля — и то мълчаливо. Затова признакът е
      ДАННИ, а валидаторът е само подразбирането.

      ⚠️ НЕ Е Employee.bgPersonalIdType. Онова поле познава ДВЕ стойности (ЕГН, ЛНЧ) и е на
      СЛУЖИТЕЛЯ; тази справка описва ЛИЦА, а получателят на хонорар или наем рядко е служител.
      Общото поле би предложило стойност, каквато образецът тук не приема, и би мълчало точно за
      лицата, за които съществува. -->
    <string name="bgIdentifierType" title="Тип идентификатор (чл. 73, ал. 1)"
      selection="bg.income.payment.identifier.type.select"/>

    <!-- ДАТАТА НА ПИСМЕНАТА ДЕКЛАРАЦИЯ ПО ЧЛ. 43 АЛ. 5 ЗДДФЛ.

      Чл. 43 ал. 5, ДОСЛОВНО: „Алинея 4 не се прилага, когато лицето, придобиващо дохода, Е
      САМООСИГУРЯВАЩО СЕ ЛИЦЕ по смисъла на Кодекса за социално осигуряване И ДЕКЛАРИРА това
      обстоятелство С ПИСМЕНА ДЕКЛАРАЦИЯ пред платеца на дохода.“

      ⚠️ ДВЕ УСЛОВИЯ, НЕ ЕДНО — И ТОЧНО ЗАТОВА ТОВА НЕ Е ИЗВОД ОТ BgSelfInsuredRegistration.
      Регистрацията доказва първото („лицето Е самоосигуряващо се“) и виси на Employee, не на
      Partner. Второто е ДОКУМЕНТ, подаден пред НАС, и никъде другаде не се появява. Изведен само от
      първото, признакът би оставил данък НЕУДЪРЖАН върху лице, което не е декларирало нищо — тоест
      задължение на платеца, пропуснато при чист зелен екран. Отговорността по чл. 43 ал. 4 остава
      на платеца и когато получателят наистина е СОЛ.

      ⚠️ ДАТА, А НЕ БУЛЕВ — И РАЗЛИКАТА СЕ МЕРИ В ПЛАЩАНИЯ. Декларацията важи от деня, в който е
      подадена; плащане ПРЕДИ нея се е случило, докато платецът още е бил длъжен да удържи.
      Записана като флаг, декларация от октомври би отменила удържането и по мартенското плащане —
      със задна дата, върху вече внесен данък. Затова захранването сравнява: удържане отпада само
      когато датата на декларацията НЕ Е СЛЕД датата на придобиване на дохода.

      ⚠️ И ДЕЙСТВА САМО ПРИ ШАБЛОН A. Чл. 43 ал. 5 отменя ал. 4 на СЪЩИЯ член, тоест обхватът му са
      доходите по чл. 29. Чл. 44 (наем) и чл. 44а (чл. 35) нямат съответна алинея — прочетено там,
      полето би оставило данък неудържан без норма. Виж BgIncomePaymentFeedMapper. -->
    <date name="bgSelfInsuredDeclaredOn"
      title="Писмена декларация по чл. 43, ал. 5 (дата)"/>

    <!-- ДРУЖЕСТВОТО НА ПАРТНЬОРА — точно едно (общи партньори няма).

      Попълва го сървърът при създаването: активното дружество на потребителя, а без потребител
      (внос, AI, задачи) — изричното дружество на контекста (BgExplicitCompany). След създаването
      не се сменя. И двете ги пази BgPartnerCompanyListener на ниво Hibernate, по всеки път.

      ⚠️ ЗАВАРЕНИТЕ ПАРТНЬОРИ СА С ПРАЗНО ПОЛЕ — нарочно. Попълва ги миграцията на партньорите;
      дотогава те не получават нов номер (няма обща поредица).

      ⚠️ НЕ Е companySet. Наборът казва с кои дружества работи партньорът в AOS (и остава); това
      поле казва чий е записът. -->
    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Company"
      readonly="true"/>

    <!-- СИСТЕМЕН ПАРТНЬОР — партньорът на потребител. Единственият партньор
      без дружество: създава се само с нов потребител (BgUserRepository → BgSystemPartner), вижда и
      пипа го само nyxa.admin, и не се сменя. Различава системния от заварения без дружество. -->
    <boolean name="nxSystem" title="System partner" readonly="true"/>

    <!-- НОМЕРЪТ Е УНИКАЛЕН В ДРУЖЕСТВОТО, НЕ ГЛОБАЛНО. axelor-base го декларира с unique="true"
      (едно ограничение за цялата база); тук то се отменя и се заменя с (company, partnerSeq) по-долу.
      Всяко дружество брои от своята поредица, тоест P0001 в А и P0001 в Б са два различни партньора.

      ⚠️ ddl=update НЕ трие старото ограничение, а приложението не променя схемата: маха го
      db/migration/2026-10-20-partner-seq-per-company.sql. При старт BgPartnerSchemaCheck само проверява и спира, ако е още там. -->
    <string name="partnerSeq" unique="false"/>

    <unique-constraint columns="company,partnerSeq"/>

  </entity>

</domain-models>
