<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- БОЛНИЧНИЯТ ЛИСТ КАТО ЕПИЗОД: от кога до кога, продължение ли е, и по кой вид отсъствие. ═══ ЗАЩО
    ENTITY, А НЕ БРОЙ ДНИ ═══ Изкушението е едно число на фиша: „толкова дни болничен“. То не стига, и то
    не заради удобство, а заради чл. 40 ал. 5 КСО: първите ДВА РАБОТНИ ДНИ от ВСЕКИ болничен се плащат от
    осигурителя, останалите — от ДОО. Тоест отговорът зависи от това КЪДЕ ЗАПОЧВА епизодът, а гол сбор дни
    не го знае. Пет дни болничен са два дни за сметка на работодателя, ако са ЕДИН епизод, и четири, ако
    са ДВА епизода по два и три дни. Едно число не различава двата случая, а разликата е в парите. ⚠️ И ВТОРАТА
    ПОЛОВИНА НА СЪЩОТО: ПРОДЪЛЖЕНИЕТО. Болничен лист, издаден като ПРОДЪЛЖЕНИЕ на предходен, НЕ открива нов
    епизод — тоест по него работодателят НЕ плаща отново два дни. Продължението не е изводимо от датите:
    два съседни листа може да са и продължение, и два отделни епизода, а между тях може да има почивни дни.
    Затова признакът се ДЕКЛАРИРА от документа, не се гадае от календара. ═══ КАКВО ТОЗИ ЗАПИС НЕ ПРАВИ ═══ Не смята
    нищо. Платецът и процентът НЕ се пазят тук — те се четат от BgAbsenceType през кода на вида (виж BgSickLeaveService#episodesOf).
    Копирани тук, те щяха да са трето копие на речника и щяха да се разминат с него при първата промяна.
    Документът носи ФАКТИТЕ (кой, кога, по кой вид, продължение ли е), а какво следва от тях е на BgSickLeaveResolver.
    ⚠️ ОТНОШЕНИЕТО КЪМ BgAbsenceType: този entity е читателят на речника в главния код. -->
  <entity name="BgSickLeave">

    <!-- Договорът, а не лицето: обезщетението по чл. 40 ал. 5 КСО се дължи от ОСИГУРИТЕЛЯ, а осигурител
      е страната по конкретния трудов договор. Лице с два договора при двама работодатели има два отделни епизода
      за един и същ болничен лист и всеки от двамата плаща своите два дни. -->
    <many-to-one name="employmentContract" title="Трудов договор" required="true"
      ref="com.axelor.apps.hr.db.EmploymentContract"/>

    <!-- ВИДЪТ от речника — оттам идват платецът, процентът и кодът за Декларация 1. required: епизод
      без вид е епизод, за който нищо не може да се сметне, а „нищо не може да се сметне“ не бива да изглежда
      като „нула лева“. -->
    <many-to-one name="bgAbsenceType" title="Вид отсъствие" required="true"
      ref="com.axelor.apps.bglocalization.db.BgAbsenceType"/>

    <!-- ⚠️ И ДВЕТЕ СА ЗАДЪЛЖИТЕЛНИ, включително краят. Отворен епизод („от 3-ти, докато оздравее“) би
      влязъл в пропорцията с неизвестен знаменател: неограниченият интервал прави броя дни в периода зависим
      от това кога питаш. Болничният лист ВИНАГИ носи край — той е документ за конкретен брой дни — тоест празният
      край тук би бил липсващи данни, а не отворен случай. -->
    <date name="fromDate" title="От дата" required="true"/>
    <date name="toDate" title="До дата" required="true"/>

    <!-- ПРОДЪЛЖЕНИЕ НА ПРЕДХОДЕН БОЛНИЧЕН — декларира се, не се извежда. false (подразбиране) значи
      НОВ епизод, тоест работодателят плаща първите два работни дни. ⚠️ Подразбирането е нарочно „нов епизод“,
      а не „продължение“: сгрешено в тази посока, работодателят плаща два дни в повече — видимо в парите. Сгрешено
      в обратната, ДОО плаща дни, които дължи осигурителят, и това не се вижда никъде. -->
    <boolean name="bgIsContinuation" title="Продължение на предходен болничен"
      default="false"/>

    <!-- ПРЕДХОДНИЯТ ЛИСТ, КОЙТО ТОЗИ ПРОДЪЛЖАВА — ВРЪЗКА, НЕ САМО ОТМЕТКА. Отметката казва на
      фиша, ЧЕ листът е продължение, но не и НА КОЙ: заявката чете листовете, засягащи периода, и
      първият лист от предходен месец остава извън нея. Тогава продължение от 1-во число излиза
      първо в списъка, открива нов период и работодателят плаща първите два дни ВТОРИ път. По връзката заявката
      на фиша тегли ЦЯЛАТА верига назад, и правото и първите два дни идват от началото ѝ.
      ⚠️ bgIsContinuation остава — производно: вдига се от repository-то при попълнена връзка, а
      отметка без връзка се отказва (BgSickLeaveManagementRepository). Нулируемо: заварените листове
      нямат връзка; продължение без нея се отказва шумно чак когато фишът стигне до него. -->
    <many-to-one name="bgContinuationOf" title="Продължава лист"
      ref="com.axelor.apps.bglocalization.db.BgSickLeave"/>

    <!-- Номерът на болничния лист. Не unique: един лист поражда по един епизод за ВСЕКИ договор на лицето,
      тоест един и същ номер законно се среща няколко пъти. -->
    <string name="bgDocumentNumber" title="Номер на болничния лист"/>

    <!-- ⚠️ ВАЛИДИРАН ЕПИЗОД, ИЛИ НИКАКЪВ. Същият довод, с който BgPayrollInputBuilder иска ВАЛИДИРАН
      отчет за време: черновата е нечие намерение, не вход за ведомост. Сглобителят чете само VALIDATED. -->
    <string name="statusSelect" title="Състояние" selection="bg.sick.leave.status.select"
      default="DRAFT" required="true"/>

    <string name="note" title="Забележка" large="true"/>

    <!-- ═══════════════ ИДЕНТИФИКАТОРИТЕ НА ЛИСТА — Приложение № 9 (Ф0) ═══════════════ ⚠️ ОСЕМТЕ ПОЛЕТА
      ПО-ДОЛУ НЯМАТ НИТО ЕДИН ЧИТАТЕЛ ДНЕС, И ТОВА Е ОБЯВЕНО, НЕ ПРОПУСНАТО. Приложение № 9 се строи във
      Ф1; тук стоят само данните, без които то не може да се попълни, за да се събират от деня, в който
      операторът въвежда листа, а не със задна дата от хартия. Нито едно от тях не влиза в изчисление и
      нито едно не мени пари. Всичките са НУЛИРУЕМИ нарочно: заварените листове ги нямат, а required
      върху попълнена таблица е миграция, не декларация. ⚠️ Сверени срещу НПОПДОО, Приложение № 9 към
      чл. 8 ал. 1 и чл. 11 ал. 1 (ДВ бр. 115 от 2025 г., в сила от 1.01.2026 г.) — заглавната част
      („по болничен лист № …, дата на издаване …“) и т. 25. -->

    <!-- Серията и годината на листа. ⚠️ ОТДЕЛНИ ОТ НОМЕРА, а не слепени в bgDocumentNumber: болничният
      лист се идентифицира от ТРОЙКАТА серия-номер-година и НОИ ги иска в отделни позиции. Слепени в един
      низ, те стават неразделими без разбор на формат, а форматът се е менял. -->
    <string name="bgSeries" title="Серия на болничния лист"/>
    <integer name="bgYear" title="Година на болничния лист"/>

    <!-- Датата на ИЗДАВАНЕ от лечебното заведение — заглавната част на Приложение № 9. ⚠️ НЕ Е fromDate:
      листът се издава след прегледа, а отпускът тече от датата на настъпване. Разликата е точно случаят,
      в който листът идва със закъснение. -->
    <date name="bgIssueDate" title="Дата на издаване"/>

    <!-- Датата на НАСТЪПВАНЕ на неработоспособността. ⚠️ И ТЯ НЕ Е fromDate. Приложение № 9 брои от нея
      няколко обстоятелства („към деня на настъпване … лицето е осигурено“, т. 1 и т. 2), а отпускът по
      листа може да започне по-късно. Днес двете съвпадат при почти всеки лист — и точно затова
      изведеното от fromDate щеше да изглежда вярно, докато не срещне първия случай, в който не е. -->
    <date name="bgIncapacityStartDate" title="Дата на възникване"/>

    <!-- ═══════════════ ПРАВОТО НА ОБЕЗЩЕТЕНИЕ — ЗАМРАЗЕНАТА ПРИСЪДА ═══════════════
      Правото по чл. 40 ал. 1 КСО (6 месеца стаж; при бременност и раждане — 12 по чл. 48а) се
      определя КЪМ НАЧАЛОТО на неработоспособността (bgIncapacityStartDate), ВЕДНЪЖ, и се пази на
      ПЪРВИЯ лист от периода. Фишът, Д1 и Приложение № 9 (т. 2/т. 3) я ЧЕТАТ, не я смятат: мерено
      по днешния стаж при всяко пресмятане, лист, започнал при 5 месеца, би дал „с право“ за дните
      си в следващия месец. Пише се само от BgSickBenefitVerdictService — при първото
      пресмятане, което се нуждае от нея, или с изричното „Определи правото наново“ с причина.
      Всички полета са нулируеми: заварените листове нямат присъда и я получават при първото пресмятане. -->
    <string name="bgBenefitVerdict" title="Право на обезщетение"
      selection="bg.sick.benefit.verdict.select" readonly="true"/>
    <date name="bgBenefitVerdictAsOf" title="Правото е към дата" readonly="true"/>
    <integer name="bgBenefitVerdictServiceMonths" title="Стаж към датата (месеци)" readonly="true"/>
    <string name="bgBenefitVerdictWhy" title="Основание за правото" large="true" readonly="true"/>
    <many-to-one name="bgBenefitVerdictBy" title="Правото е определено от"
      ref="com.axelor.auth.db.User" readonly="true"/>
    <datetime name="bgBenefitVerdictOn" title="Правото е определено на" readonly="true"/>
    <string name="bgBenefitVerdictReason" title="Причина за последното определяне" large="true"
      readonly="true"/>
    <!-- Входът на бутона — transient по образеца на BgPaySlip.bgCancelReasonInput: записана с
      „Запиши“, причината щеше да стои върху присъда, която никой не е определил наново. -->
    <string name="bgBenefitVerdictReasonInput" title="Причина за ново определяне" large="true"
      transient="true"/>

    <!-- Т. 25: „Входящ номер и дата на представяне на болничния лист на осигурителя“. Номерът е РЕГИСТЪР
      НА ОСИГУРИТЕЛЯ, не на НОИ и не на лечебното заведение — трето различно число върху същия документ. -->
    <string name="bgEmployerReceivedNo" title="Входящ № при осигурителя"/>
    <date name="bgEmployerReceivedDate" title="Дата на представяне при осигурителя"/>

    <!-- Датата, на която удостоверението е ПРЕДАДЕНО в НОИ. Празно значи „още не е подадено“ — състояние,
      а не липсващи данни, и точно то ще движи списъка с неподадени листове във Ф1. -->
    <date name="bgSubmittedDate" title="Предаден на"/>

    <!-- ⚠️ МЕСЕЦЪТ ЗА ЕКСПОРТ Е ОТДЕЛЕН ОТ ПЕРИОДА НА ЛИСТА, И ТОВА Е ЦЯЛАТА МУ ПРИЧИНА. Лист за юли,
      донесен през септември, се подава в септемврийския пакет — а периодът му остава юлски. Изведен от
      fromDate, закъснелият лист щеше да се опита да влезе в затворен месец. Празно значи „води се по
      периода си“; попълнено надписва само ПАКЕТА, никога дните. Единица: първият ден на месеца (дата,
      а не низ „2026-09“ — низът не се сортира и не се сравнява с период). -->
    <date name="bgExportMonth" title="Месец за експорт"/>

    <!-- ═══════════════ РАЗБИВЪТ ПО Т. 9 ═══════════════ Редовете се ПИШАТ от BgSickLeaveService при
      пресмятането на фиша и се четат от Приложение № 9 (Ф1). Виж BgSickLeavePeriodLine за това защо
      разрезът е (лист × месец × платец), а не двата агрегата върху фиша. -->
    <!-- ⚠️ orphanRemoval — задължително, а не по избор. Редовете се ПРЕЗАПИСВАТ по месеци (виж
      BgSickLeaveService#writePeriodLines) и махнатият от списъка ред трябва да СЕ ИЗТРИЕ. Без него
      Hibernate само занулява чуждия ключ, а sickLeave е required — тоест всяко второ пресмятане би
      падало с нарушено ограничение. Същият избор и по същата причина като при BgD1Declaration. -->
    <one-to-many name="bgPeriodLineList" title="Дни по месеци (Приложение № 9, т. 9)"
      ref="com.axelor.apps.bglocalization.db.BgSickLeavePeriodLine" mappedBy="sickLeave"
      orphanRemoval="true"/>

    <!-- ОДИТЪТ НА „Изведи т. 9 от потвърдения фиш“ — кой, кога и от кой фиш. Попълва се САМО от
      това действие (BgApp9Point9FromSlipService), за листове, отразени без разбив по т. 9. Празно значи, че редовете (ако ги има) са от пресмятането на фиша или от „Отрази
      пристигнал болничен“. Нула backfill. -->
    <many-to-one name="bgPoint9DerivedBy" title="Т. 9 изведена от потребител"
      ref="com.axelor.auth.db.User" readonly="true"/>
    <datetime name="bgPoint9DerivedOn" title="Т. 9 изведена на" readonly="true"/>
    <string name="bgPoint9DerivedFrom" title="Т. 9 изведена от фишовете" large="true"
      readonly="true"/>

    <!-- УДОСТОВЕРЕНИЕТО ПО ПРИЛОЖЕНИЕ № 9 ЗА ТОЗИ ЛИСТ (Ф1) — обстоятелствата по раздел I, т. 1–26.
      Обратната страна на one-to-one: чуждият ключ е върху УДОСТОВЕРЕНИЕТО, защото то е зависимата
      страна — лист без удостоверение е нормално състояние, удостоверение без лист не е. По образеца на
      AccountConfig ↔ Company. ⚠️ Самият запис НЕ ИЗНАСЯ НИЩО — износът към НОИ е Ф2. -->
    <one-to-one name="bgApp9Declaration" title="Удостоверение (Приложение № 9)"
      ref="com.axelor.apps.bglocalization.db.BgApp9Declaration" mappedBy="sickLeave"/>

    <!-- ═══════════════ СРОКЪТ ЗА ПРИЛОЖЕНИЕ № 9 ═══════════════
      ⚠️ ВСИЧКИ ПОЛЕТА ПО-ДОЛУ СА НУЛИРУЕМИ И ДОПЪЛНИТЕЛНИ: заварените листове ги нямат, required
      върху попълнена таблица е миграция, не декларация. Нула backfill — първият запис или бутонът
      „Опресни сроковете“ ги попълва. -->

    <!-- ⚠️ МИГРАЦИЯ (Microinvest). Огледално на BgPaySlip, BgD1Declaration, BgD6Declaration и
      LeaveRequest.bgIsHistoricalImport: внесеният лист е история, а не задача пред НОИ. Вдига се
      само при НОВИ импорти; заварените внесени листове ги пази границата на дружеството
      (Company.bgApp9TrackFrom), не този флаг. -->
    <boolean name="bgIsHistoricalImport" title="Исторически внесен (миграция)" default="false"/>

    <!-- НПОПДОО чл. 8 ал. 2: болничен лист, ОБЖАЛВАН от осигурителя по чл. 112 от Закона за
      здравето — удостоверението се подава СЛЕД приключване на обжалването. Докато датата на
      приключване е празна, срокът НЕ ТЕЧЕ; попълнена, той тече от месеца на приключването.
      Подразбирането false е правилото: незаявено обжалване не спира срока. -->
    <boolean name="bgAppealedByEmployer" title="Обжалван от осигурителя (чл. 112 ЗЗдр)"
      default="false"/>
    <date name="bgAppealClosedDate" title="Обжалването е приключило на"/>

    <!-- ⚠️ ЧЕТИРИТЕ ПОЛЕТА ПО-ДОЛУ СЕ ПИШАТ САМО ОТ BgApp9DeadlineService (присъдата е на
      BgApp9Obligation, срокът — на BgApp9Deadline). readonly в домейна: ръчно поправен срок би бил
      второ мнение без свидетел. Пишат се при всеки запис на листа и при „Опресни сроковете“. -->
    <string name="bgNoiObligationSelect" title="Прил. 9 · група"
      selection="bg.app9.obligation.select" readonly="true"/>
    <date name="bgNoiDueDate" title="Прил. 9 · срок за подаване" readonly="true"/>
    <!-- От тази дата до срока остават ДО 3 работни дни (броени след днешния ден до срока
      включително). Изчислява се от същата функция и по същия календар като самия срок. -->
    <date name="bgNoiDueSoonFrom" title="Прил. 9 · до 3 работни дни от" readonly="true"/>
    <!-- ФЛАГЪТ ЗА НАДЕЖДНОСТ: празно = срокът е изчислен по зареден календар. Попълнено = годината
      не е заредена и срокът е ненадежден — с причината („ненадежден срок (2028 не е заредена)“).
      Низ, а не boolean: генерираният getter връща FALSE при NULL и „не е смятан“ би се слял с
      „надежден“. -->
    <string name="bgNoiDueWarning" title="Прил. 9 · надеждност на срока" readonly="true"/>

    <!-- ДНИ ДО СРОКА — ИЗЧИСЛИМА колона, не втора сметка на срока: разлика между две дати.
      Отрицателно = просрочено с толкова дни. ⚠️ Без CAST: в PostgreSQL date − date е integer, а
      в HSQLDB (тестовете) е INTERVAL DAY, който getInt чете вярно — измерено и в двете. -->
    <integer name="bgNoiDaysLeft" title="Прил. 9 · дни до срока" formula="true"><![CDATA[
      (bg_noi_due_date - CURRENT_DATE)
    ]]></integer>

    <!-- СЪСТОЯНИЕТО НА ПОДАВАНЕТО — изчислява се при показване, не се пази. Цяло число, а не низ:
      HSQLDB допълва низовите стойности на CASE с интервали. 1 — не е генерирано; 2 — генерирано;
      3 — подадено (има NapSubmission с входящ №); 4 — подадено ЗАВАРЕНО (статус SUBMITTED без
      NapSubmission — не се преобразува). Пише се от никого: изводът е от удостоверението. -->
    <integer name="bgNoiSubmissionState" title="Прил. 9 · подаване"
      selection="bg.app9.submission.state.select" formula="true"><![CDATA[
      COALESCE((SELECT CASE
        WHEN x.status_select = 'SUBMITTED' AND x.bg_noi_submission IS NOT NULL THEN 3
        WHEN x.status_select = 'SUBMITTED' THEN 4
        WHEN x.bg_noi_artifact IS NOT NULL THEN 2
        ELSE 1 END
        FROM bglocalization_bg_app9_declaration x WHERE x.sick_leave = id), 1)
    ]]></integer>

    <!-- ⚠️ НЯМА уникално ограничение по (договор, от дата). Един ден законно се покрива от два записа:
