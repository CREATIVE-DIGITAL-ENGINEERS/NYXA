<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="human-resource" package="com.axelor.apps.hr.db"/>

  <!-- Bulgarian localization fields added to the standard EmploymentContract entity. Merged into com.axelor.apps.hr.db.EmploymentContract
    by the code generator. -->
  <entity name="EmploymentContract">

    <!-- Вид на договора по Кодекса на труда (чл.67, чл.68, чл.111 и др.), ПЛЮС двата договора,
      които са ИЗВЪН КТ: за управление и контрол (duk) и гражданският (gd).

      ⚠️ ЗАГЛАВИЕТО НЕ Е „по КТ“. ДУК се сключва по Търговския закон и ЗЗД — управителят по КСО
      чл. 4 ал. 1 т. 7 няма трудов договор. Озаглавено „Вид договор по КТ“ с ДУК вътре, полето би
      твърдяло, че управителят е нает по Кодекса на
      труда: точно недоразумението, което пълни т. 29 с брутна работна заплата и иска ГВРС.

      ⚠️ И СЪЩОТО ВАЖИ ЗА ГРАЖДАНСКИЯ ДОГОВОР, но с ОБРАТНА посока на грешката. ГД се сключва по
      ЗЗД (изработка или поръчка) и КСО чл. 4 ал. 3 т. 5 и 6 го назовават отрицателно — „труд БЕЗ
      трудово правоотношение“. Номер на член от КТ тук би твърдял тъкмо онова, което нормата
      отрича.

      ⚠️ ОПИСАТЕЛНО ПОЛЕ. Нула реда производствен код го четат — фишът и декларациите се клонят по
      bgInsuredTypeCode. Тук стои, за да може ТРЗ да отличи ДУК-а и ГД-то в списъка и в договорното
      досие, и за да има къде да се закачи бъдещото печатно основание. -->
    <string name="bgContractType" title="Вид договор"
      selection="bg.employment.contract.type.select"/>

    <!-- Код по НКПД (длъжност) — на ниво договор (а не Employee), за да пази история при смяна на длъжност
      и декларация обр.1 да носи актуалния код за периода. -->
    <many-to-one name="bgNkpd" title="Код по НКПД"
      ref="com.axelor.apps.bglocalization.db.BgNkpd"/>

    <!-- Основен / допълнителен трудов договор. ПОДРАЗБИРАНЕТО Е TRUE нарочно, и причината е несиметрична
      цена. По допълнителен договор обезщетение при прекратяване изобщо не се поражда, тоест флагът управлява дали правото възниква. При подразбиране false непопълненият флаг
      СКРИВА дължимо обезщетение — грешка, която не се вижда никъде и излиза при съд. При подразбиране true
      непопълненият флаг предлага излишен ред — грешка, която се вижда на екрана, изключва се с едно действие
      и оставя записана причина. Посоката „предложи повече“ е поправима, другата не е. ⚠️ Подразбирането важи
      само за НОВИ записи. Заварените редове в базата остават каквито са — тоест заварен договор, оставен
      непопълнен, носи false и не поражда обезщетения. Същото важи и за bgFloorType и се урежда по същия
      начин: преглед на заварените данни, не промяна по кода. -->
    <boolean name="bgIsPrimaryContract" title="Основен трудов договор" default="true"/>

    <!-- Основно месечно възнаграждение (основна месечна брутна заплата). Стандартните полета не го покриват:
      monthlyGlobalCost = общ разход за работодателя, annualGrossSalary = годишна, hourlyGrossSalary = почасова. -->
    <decimal name="bgBaseSalary" title="Основно месечно възнаграждение" scale="2"
      precision="20"/>

    <!-- Договорено работно време. Часовете на седмица се ползват от стандартното поле weeklyDuration;
      тук добавяме само липсващите часове/ден и дни/седмица. -->
    <decimal name="bgHoursPerDay" title="Договорени часове на ден" precision="5" scale="2"/>
    <decimal name="bgDaysPerWeek" title="Договорени дни на седмица" precision="5" scale="2"/>

    <!-- ЗАКОНОУСТАНОВЕНОТО работно време ЗА ДЛЪЖНОСТТА — т. 16 позиция 3 на Декларация обр. 1.

      ⚠️ ДВЕ РАЗЛИЧНИ ЧИСЛА, КОИТО СЪВПАДАТ ПРИ ПЪЛЕН ЩАТ, И ТОЧНО ЗАТОВА СА ДВЕ КОЛОНИ. Позиция 3 е
      законоустановеното работно време за ДЛЪЖНОСТТА (8 часа по общото правило на КТ чл. 136 ал. 3,
      но 7 или 6 при НАМАЛЕНО работно време по чл. 137 за изброените в наредбата видове работи);
      bgHoursPerDay е ДОГОВОРЕНОТО на ЛИЦЕТО (4 при половин щат по чл. 138). За лице на пълен щат
      двете са 8 и всяко копиране на едното в другото изглежда вярно.

      ⚠️ ЗАЩО НА ДОГОВОРА, А НЕ НА ЗАПИСА НА ДЕКЛАРАЦИЯТА. Въвеждано само в колоната на записа,
      числото трябва да се пише от ТРЗ наново за ВСЯКО лице, за ВСЕКИ месец, при ВСЯКО генериране (генерирането е ЗАМЯНА: второ
      натискане изтрива записите и прави нови, тоест ръчно въведеното изчезва). Законоустановеното
      работно време обаче се сменя при СМЯНА НА ДЛЪЖНОСТТА, не всеки месец. Мястото му е там, където
      вече живее работното време по договора — и оттам записът го чете.

      ⚠️ ПРАЗНО ОСТАВА ПРАЗНО. Подразбиране 8 би било вярно за повечето и невярно точно за онези,
      заради които полето съществува — а „8 часа“ за длъжност с намалено работно време е валидна цифра,
      която НАП приема. -->
    <decimal name="bgLegalHoursPerDay" title="Законоустановено работно време за длъжността (часове)"
      precision="5" scale="2"
      help="КТ чл. 136 ал. 3 (8 часа) или чл. 137 при НАМАЛЕНО работно време (7 или 6). ⚠️ НЕ е договореното на лицето — при непълно работно време по чл. 138 двете се разминават. Пълни т. 16 позиция 3 на Декларация обр. 1."/>

    <!-- Режим на отчитане на работното време (чл. 142 КТ). Подневно отчитане (стандартно) или сумирано
      изчисляване (СИРВ). -->
    <string name="bgWorkTimeMode" title="Режим на отчитане на работното време"
      selection="bg.work.time.mode.select"/>

    <!-- Отчетен период в месеци при СИРВ (1-6 месеца). Празно при подневно отчитане. -->
    <integer name="bgSirvPeriodMonths" title="Отчетен период при СИРВ (месеци)"/>

    <!-- НАУЧНАТА СТЕПЕН — НСОРЗ чл. 11. Източникът на перо 120 (pl_nauchna_stepen).

      ⚠️ НА ДОГОВОРА, А НЕ НА ЛИЦЕТО, И ТОВА Е ТЕКСТЪТ НА НОРМАТА. Чл. 11 ал. 1 дава
      възнаграждението за степен, „СВЪРЗАНА С ИЗПЪЛНЯВАНАТА РАБОТА на работника или служителя“.
      Тоест относимостта е към ДЛЪЖНОСТТА: едно лице с два договора може да има степен, която е
      свързана само с единия. Сложена на Employee, степента щеше да плаща и по втория.

      ⚠️ ЕДНО ПОЛЕ СЪС СЕЛЕКЦИЯ, А НЕ ДВА БУЛЕВИ ФЛАГА. Чл. 11 ал. 2: „при наличие на повече от
      едно от основанията по ал. 1 лицето има право на допълнителното възнаграждение с
      ПО-БЛАГОПРИЯТНИЯ размер“. Две отметки правят състоянието „и доктор, и доктор на науките“
      изразимо, а нормата го изключва — и някой рано или късно щеше да събере двете суми. Едно
      поле го прави неизразимо по устройство, а не по проверка.

      ⚠️ ПРАЗНО ОСТАВА ПРАЗНО. Непопълнено НЕ значи „няма степен“ — значи, че никой не е питан, и
      перото излиза като обявена липса, а не като сума 0,00. -->
    <string name="bgAcademicDegree" title="Научна степен (НСОРЗ чл. 11)"
      selection="bg.academic.degree.select"
      help="Образователна и научна степен „доктор“ или научна степен „доктор на науките“, СВЪРЗАНА с изпълняваната по този договор работа (НСОРЗ чл. 11 ал. 1). Размерите от 01.01.2026 г. са 7,67 EUR и 25,56 EUR месечно и се четат от bg_payroll_parameter, не оттук. ⚠️ При повече от едно основание се дължи по-благоприятният размер (ал. 2) — затова полето е едно, а не две отметки. Празно оставя перото несметнато, а не нулево."/>

    <!-- НЕНОРМИРАН РАБОТЕН ДЕН — КТ чл. 139а, установен със заповед на работодателя (ал. 3).

      ⚠️ ФЛАГЪТ МЕНИ ПЛАЩАНЕТО, НЕ ОПИСВА ГРАФИКА. КТ чл. 263 ал. 1: „За извънреден труд, положен
      В РАБОТНИ ДНИ от работници и служители с ненормиран работен ден, НЕ СЕ ЗАПЛАЩА трудово
      възнаграждение.“ Ал. 2 връща плащането за дните на седмичната почивка и на официалните
      празници, в размерите по чл. 262 ал. 1 т. 2 и т. 3.

      ⚠️ И НЕ СЕ КОМБИНИРА СЪС СИРВ — ЗАБРАНЕНО, А НЕ „ОТВОРЕН ВЪПРОС“. КТ чл. 142 ал. 5: „Не се
      допуска сумирано изчисляване на работното време за работниците и служителите с ненормиран
      работен ден.“ Чл. 139а ал. 2 забранява ненормиран ден при НАМАЛЕНО работно време;
      забраната спрямо СИРВ е в ДРУГ член. Записът на двойката се отказва
      (BgWorkTimeModeRule, викан от BgEmploymentContractManagementRepository), а заварената я
      отказват и перата на фиша, вместо да я плащат.

      ⚠️ Заварените редове получават NULL, а генерираният getter за Boolean връща FALSE — тоест
      четат се като „не е ненормиран“, което е верният прочит за всеки, когото никой не е питал:
      ненормираният ден се установява със ЗАПОВЕД и е изключението, не правилото. -->
    <boolean name="bgIsUnregulatedWorkDay" title="Ненормиран работен ден (КТ чл. 139а)"
      default="false"
      help="Отметнато, извънредният труд в РАБОТНИ дни не се заплаща (КТ чл. 263 ал. 1). Извънредният труд в почивни дни и на официални празници се заплаща както на всички останали (ал. 2, размерите по чл. 262 ал. 1 т. 2 и т. 3). ⚠️ Установява се със заповед на работодателя по чл. 139а ал. 3 и не може да се установява при намалено работно време (ал. 2). ⚠️ НЕСЪВМЕСТИМО със сумирано изчисляване на работното време — КТ чл. 142 ал. 5 не го допуска, затова записът с режим „СИРВ“ се отказва."/>

    <!-- Признат предходен трудов стаж (за клас „прослужено време"). Това е ПРИЗНАТИЯТ ОБЩ СТАЖ
      (bgPriorService* се преизползва оттук — не се дублира). -->
    <integer name="bgPriorExperienceYears" title="Признат стаж — години"/>
    <integer name="bgPriorExperienceMonths" title="Признат стаж — месеци"/>
    <integer name="bgPriorExperienceDays" title="Признат стаж — дни"/>

    <!-- Признат стаж по специалността (за професии с изискване за стаж по специалност). -->
    <integer name="bgPriorSpecialtyServiceYears" title="Стаж по специалността — години"/>
    <integer name="bgPriorSpecialtyServiceMonths" title="Стаж по специалността — месеци"/>
    <integer name="bgPriorSpecialtyServiceDays" title="Стаж по специалността — дни"/>

    <!-- ДЕЙСТВИТЕЛНА дата на прекратяване, отделна от стандартното endDate. Причината не е излишен педантизъм:
      при СРОЧЕН договор (чл. 68) endDate се попълва при подписването и значи УГОВОРЕН край. Ако договорът
      се прекрати предсрочно, презаписването на endDate губи уговорения край — а точно разликата между двете
      различава „изтекъл срок“ (чл. 325 ал. 1 т. 3, обезщетение по чл. 222 ал. 1 НЕ се дължи) от „прекратен
      предсрочно“ (чл. 328, дължи се). При безсрочен договор (чл. 67) endDate е празно до прекратяването и
      двете съвпадат. Основанието за прекратяване НЕ е тук — виси на стандартния endOfContractReason (виж EndOfContractReason.xml
      в този модул). -->
    <date name="bgTerminationDate" title="Дата на действително прекратяване"/>

    <!-- Учителска длъжност по този договор. Нужно е, защото учител на втори или допълнителен трудов
      договор се подава под ВИД ОСИГУРЕН 04 (решение на клиента, не извод от норма): под 04 стоят и учители,
      и неучители, тоест учителството не се изразява чрез вида осигурен. Стойността избира реда за учителския
      фонд през BgInsuranceContribution.bgTeacherScope. ЗАЩО НЕ СЕ ИЗВЕЖДА ОТ НКПД. Чл. 19 НПОС определя учителския
      осигурителен стаж през ДЛЪЖНОСТТА В УЧЕБНО ИЛИ ВЪЗПИТАТЕЛНО ЗАВЕДЕНИЕ, а не през кода на професията.
      Двете се припокриват в голяма част от случаите, но не съвпадат: една и съща длъжност по НКПД може да
      е в учебно заведение и извън него, а признакът зависи от второто. Извеждане от кода би било пазач, който
      мери близък заместител вместо самото нещо. -->
    <boolean name="bgIsTeacherPosition" title="Учителска длъжност" default="false"/>

    <!-- ВИДЪТ ОСИГУРЕН по номенклатурата на НАП (Наредба Н-13, Приложение №1) — ДОМЪТ МУ. ЗАЩО НА ДОГОВОРА,
      А НЕ НА ЛИЦЕТО. Едно лице може да има повече от едно правоотношение едновременно и видът осигурен е свойство
      на ПРАВООТНОШЕНИЕТО, не на човека: същият човек е 01 по основния си договор и 04 по допълнителния, а
      учител на втори договор е 04 при код 08 на първия. Поле на Employee би дало ЕДИН отговор на въпрос, който
      има по един отговор НА ДОГОВОР, и разминаването нямаше да се види никъде — Д1 се подава по правоотношение.
      ЗАЩО СЪХРАНЕНО, А НЕ ИЗВЕДЕНО. В началните данни НИТО ЕДИН сигнал в модела
      не фиксира кода еднозначно. Категорията труд дава 1 → {02, 04, 92}, тоест три кода; учителската длъжност
      дава {04, 08}; видът договор по КТ няма нито една колона, която да го свързва с код. Извеждането би значело
      избор между кандидати — тоест правило, съчинено на мястото на данните. Затова кодът се СЪХРАНЯВА, а изводимите
      сигнали го СВЕРЯВАТ: пазачът е BgInsuredTypeHomeFileTest и той пада при разминаване, вместо да го оправя
      мълчаливо. ⚠️ БЕЗ СТОЙНОСТ ТУК ФИШЪТ НЕ СЕ СМЯТА. BgPayrollInputBuilder ОТКАЗВА с назована причина —
      не подразбира 01. Без вида осигурен BgContributionResolver няма какво да попита: кодът е първият ключ
      в речника на ставките. ⚠️ ЧЕТИРИ ОТ 43-ТЕ КОДА НЕ СА ВАЛИДНИ ТУК: 12, 13, 22 и 41 са самоосигуряващи
      се БЕЗ работодател, тоест регистрация по чл. 1 ал. 1 НООСЛБГРЧМЛ, а не трудов договор. Появят ли се на
      този запис, това сочи ЛИПСВАЩИЯ СОЛ път, а не валиден договор — виж manifest/sol-2026.yml. Селекцията
      ги показва (тя е номенклатурата), пазачът ги отказва. -->
    <string name="bgInsuredTypeCode" title="Вид осигурен (НАП)"
      selection="bg.insured.type.select"/>

    <!-- ИЗБОРЪТ ПО ЧЛ. 4а АЛ. 2 КСО на МОРСКОТО ЛИЦЕ — осигурява ли се за безработица. ⚠️ ТЯСНО ПОЛЕ
      С ТЯСНО ИМЕ, НАРОЧНО. Изкушението беше „обхват при самоосигуряване“ (пълната ос bg.insurance.sol.scope.select
      с трите ѝ стойности) да слезе цяла на договора. Това щеше да е грешно: ALL_RISKS и PENSION_ONLY са обхватът
      на САМООСИГУРЯВАЩОТО СЕ ЛИЦЕ, а самоосигуряващият се няма трудов договор — тоест двете стойности нямаше
      да могат да се появят тук законно никога. Оставаше ART4A_AL2, а то е булев въпрос: упражнил ли е морското
      лице избора си. ЗАЩО ПОДРАЗБИРАНЕТО Е FALSE. Чл. 4а ал. 2 КСО казва „по свой избор и желание“. Неупражнената
      опция е неупражнена: без изричен избор безработица НЕ се дължи. Точно това пише и коментарът на самата
      стойност в bg.insurance.sol.scope.select, и точно затова трите реда IC-131, IC-137 и IC-144 излизат от
      подразбиращия се набор. Обратната посока — подразбиране true — би начислила 1 на сто на всяко морско
      лице, тоест завишена вноска, която не се вижда. ⚠️ ЗАЕМАНЕ НА ЧУЖДА ОС, ЗАПИСАНО КАТО ТАКОВА. BgPayrollInputBuilder
      мапва true → solScope ART4A_AL2, а морското лице НЕ е самоосигуряващо се. Чистото решение е собствена
      колона bgArt4aAl2Scope на BgInsuranceContribution и собствена ос във филтъра — записано като открит въпрос
      в manifest/seafarers-2026.yml, не решено тук. -->
    <boolean name="bgSeafarerUnemploymentChoice"
      title="Морско лице — избор за безработица (чл. 4а ал. 2 КСО)" default="false"/>

    <!-- ═══ ГРАЖДАНСКИ ДОГОВОР · ВИДЪТ ДОХОД ПО ЗДДФЛ, ОТ КОЙТО ИДВА РАЗХОДНАТА СТАВКА ═══

      КСО чл. 6 ал. 4, ДОСЛОВНО: „Възнаграждението за лицата по чл. 4, ал. 3, т. 5 и 6, върху което
      се дължат осигурителни вноски, се определя след намаляването му с разходите за дейността,
      ОПРЕДЕЛЕНИ ПО РЕДА НА ЗАКОНА ЗА ДАНЪЦИТЕ ВЪРХУ ДОХОДИТЕ НА ФИЗИЧЕСКИТЕ ЛИЦА.“ Тоест ставката
      НЕ е осигурителна: тя е данъчната по чл. 29 ал. 1, взета назаем от осигуряването. Затова тук
      стои връзка към каталога на видовете доход, а не ново процентно поле.

      ⚠️ ЕДНО ЧИСЛО, ЕДИН ИЗТОЧНИК — И ТОВА Е САМАТА ПРИЧИНА. Собствено поле „нормативни разходи
      (%)“ на договора би било ВТОРО копие на ставка, която законът определя веднъж: 25 на сто по
      т. 3 (услуги и извънтрудови правоотношения), 40 на сто по т. 2 (авторски, занаят, адвокат и
      нотариус), 60 на сто по т. 1 (непреработена земеделска продукция). Две копия се разминават
      мълчаливо и разминаването е точно между ОСИГУРИТЕЛНАТА основа и ДАНЪЧНАТА — две числа, които
      по чл. 6 ал. 4 са ЕДНО. Операторът, който може да напише 30, е операторът, който ще го
      напише.

      ⚠️ И ЗАЩОТО ДАНЪЧНАТА СТРАНА ИСКА СЪЩИЯ КОД. Данъчната страна на гражданския договор влиза в
      регистъра BgIndividualIncomePayment, чието поле incomeType е връзка към СЪЩИЯ каталог.
      Авто-захранването така пренася обекта, а не превежда код в код.

      ⚠️ ВРЪЗКАТА СОЧИ ЕДНА ВЕРСИЯ НА РЕДА, А КАТАЛОГЪТ Е ТЕМПОРАЛЕН (уникалност по code+validFrom)
      — ОБЯВЕНО ОГРАНИЧЕНИЕ, не пропуск. Излезе ли ред за нова година, договор, сключен по стария,
      продължава да сочи стария и носи неговата ставка. За граждански договор това е поносимо:
      той е кратък по устройство, а ставките по чл. 29 не са се движили от 2015 г. насам (движи се
      ОБХВАТЪТ — ДВ бр. 30/2026 добави нотариуса към т. 2 б. „г“). Обратното — код като низ,
      разрешаван по дата — би било вярно темпорално и би отнело на ТРЗ избора от списък, а
      сгрешеният ръчно въведен код е по-тихата грешка от остарялата версия. -->
    <many-to-one name="bgIncomeType" title="Вид доход по ЗДДФЛ (нормативни разходи, чл. 29)"
      ref="com.axelor.apps.bglocalization.db.BgIncomeType"/>

    <!-- ═══ ГРАЖДАНСКИ ДОГОВОР · ОСИГУРЕН ЛИ Е НА ДРУГО ОСНОВАНИЕ ═══

      ⚠️ ТОВА Е РАЗГРАНИЧИТЕЛЯТ МЕЖДУ Т. 5 И Т. 6, И ДВЕТЕ ТОЧКИ СА РАЗЛИЧНИ ОСНОВАНИЯ, НЕ ЕДНО С
      УСЛОВИЕ. КСО чл. 4 ал. 3:

        т. 5 — „лицата, които полагат труд без трудово правоотношение и получават месечно
        възнаграждение, равно или над една минимална работна заплата, СЛЕД НАМАЛЯВАНЕТО МУ С
        РАЗХОДИТЕ ЗА ДЕЙНОСТТА, АКО НЕ СА ОСИГУРЕНИ НА ДРУГО ОСНОВАНИЕ през съответния месец“;

        т. 6 — „лицата, които полагат труд без трудово правоотношение, КОИТО СА ОСИГУРЕНИ НА ДРУГО
        ОСНОВАНИЕ през съответния месец, НЕЗАВИСИМО ОТ РАЗМЕРА на полученото възнаграждение“.

      Тоест прагът МРЗ важи САМО по т. 5. Вдигнат и по т. 6, той би оставил без осигуряване лице,
      което законът осигурява безусловно — вноска, която не се начислява, и Д1, която не се подава.
      ЗЗО чл. 40 ал. 1 т. 3 б. „а“ и б. „б“ повтарят същото разделение и за здравното.

      ⚠️ ПРАГЪТ Е ВРАТА, А НЕ ПОД — и точно затова bgFloorType на код 14 стои на NONE. Под МРЗ по
      т. 5 вноски НЕ СЕ ДЪЛЖАТ; над МРЗ се дължат върху ДЕЙСТВИТЕЛНАТА намалена сума. Праг,
      разбран като под, би вдигнал база 525,00 до 620,20 — правдоподобно число, за което няма
      основание в нито една от двете точки.

      ⚠️ НОРМАТА ПИТА ЗА МЕСЕЦА, А ТОВА ПОЛЕ Е НА ДОГОВОРА — ОБЯВЕНО ОГРАНИЧЕНИЕ. Хибридът
      „стояща стойност на договора + месечно надписване на фиша“ вече съществува за съседното поле
      bgOtherPayerInsurableIncome и там работи, защото носителят е decimal и „>0 надписва“. За
      булев признак този трик НЕ РАБОТИ: генерираният getter връща FALSE за непопълнена колона,
      тоест „не съм пипал“ и „не, този месец“ са неразличими, и месечното поле не би могло да каже
      „не“ срещу договор, който казва „да“. Пълният три-стейт е същата обявена бъдеща итерация,
      която стои записана и при bgOtherPayerInsurableIncome — не втори половинчат отговор на един и
      същи въпрос. Дотогава стойността се вижда на формата на договора и се поправя там.

      ⚠️ НЕ СЕ ИЗВЕЖДА ОТ Employee.bgInsuranceStatus. Онова поле е на ЛИЦЕТО и описва статуса му
      изобщо; за човек с трудов договор при НАС стойност „1 — осигурен по трудово правоотношение“
      описва ТОВА правоотношение, не чуждо. Прочетено тук, то би обявило за осигурено на друго
      основание всяко лице, което сме наели ние. -->
    <boolean name="bgInsuredOnOtherGround"
      title="Осигурен на друго основание (КСО чл. 4 ал. 3 т. 6)" default="false"/>

    <!-- ═══ ДЕКЛАРИРАН ОСИГУРИТЕЛЕН ДОХОД ПРИ ДРУГ ПЛАТЕЦ — СТОЯЩАТА СТОЙНОСТ ═══
      Единица: ЕВРО, МЕСЕЧЕН размер. Източник: ДЕКЛАРАЦИЯ НА ЛИЦЕТО, въведена от ТРЗ веднъж, за да
      не се преписва на всеки фиш. Правилото, което я ползва, е КСО чл. 6 ал. 11 — виж
      BgIncomeCoordinationResolver.

      ⚠️ ДВЕ ПОЛЕТА ЗА ЕДНО ЧИСЛО, И ТОВА Е ХИБРИД, НЕ ДУБЛИКАТ. Тук стои ПОДРАЗБИРАНЕТО (то важи
      за всеки месец на този договор), а BgPaySlip.bgOtherPayerInsurableIncome НАДПИСВА за КОНКРЕТЕН
      месец. Двете живеят на различни места, защото мерят различно: чуждият доход обикновено е
      постоянен (второто правоотношение си стои), но се мени при отпуск, болничен или напускане при
      другия платец. Само на договора — ТРЗ не може да поправи един месец; само на фиша — трябва да
      го въвежда дванайсет пъти в годината.

      ⚠️ РАЗРЕШАВАНЕТО Е НА ЕДНО МЯСТО и е BgPaySlipService#effectiveOtherPayerIncome. Тук няма
      поведение — само стойност.

      ⚠️ „>0 НАДПИСВА" — И ОТТАМ ЕДНО ОГРАНИЧЕНИЕ, КОЕТО СЕ ОБЯВЯВА, А НЕ СЕ ПРЕМЪЛЧАВА. Празно или
      0,00 на ФИША значи „ползвай стоящата стойност", НЕ „без координация" — генерираният getter за
      decimal връща ZERO за непопълнена колона, тоест двете са неразличими по модела. Следствието:
      при попълнен default тук ЕДИН месец НЕ може да се занули от фиша. Зануляването става с
      зануляване на ТОВА поле. Пълният три-стейт (булев признак „този месец няма чужд доход", по
      образеца на BgVatReturn.bgAutoFillK71) е ОБЯВЕНА БЪДЕЩА ИТЕРАЦИЯ, не решено тук.

      ⚠️ Нулата и празното значат едно и също и ТУК, по същия довод: читателите питат signum() > 0,
      не != null. -->
    <decimal name="bgOtherPayerInsurableIncome"
      title="Осигурителен доход при друг платец (по подразбиране)" precision="20" scale="2"/>

    <!-- Код по ЕКАТТЕ на МЯСТОТО НА РАБОТА — реквизит т. 22 на електронния трудов запис.

      ⚠️ НА ДОГОВОРА, А НЕ НА ДРУЖЕСТВОТО, и това е разликата, която прави полето нужно. Наредбата
      иска „кода на населеното място, където е МЯСТОТО НА РАБОТА НА ЛИЦЕТО“ — не седалището на
      работодателя. Едно дружество със седалище в София и обект в Пловдив подава различни кодове за
      различните си хора; сложен на Company, кодът би бил един и същ за всички и би бил верен само
      по съвпадение.

      ⚠️ ДВЕ СЛУЖЕБНИ СТОЙНОСТИ, КОИТО НЕ СА „НЕ ЗНАМ“. Наредбата (т. 22) ги дефинира изрично:
      „00000“ — когато лицето изпълнява задълженията си в ПОВЕЧЕ ОТ ЕДНО населено място, както и
      когато кодът не може да се определи; „99999“ — при работа от разстояние с уговорено повече от
      едно място на работа. И двете са ИЗЯВЛЕНИЯ на работодателя, затова се въвеждат съзнателно и
      НИКОГА не се слагат по подразбиране от кода.

      ⚠️ И ТРЕТА, УСЛОВНА: когато т. 12 е попълнена с код 017 или 018 (командироване по чл. 121а),
      в т. 22 се попълва „00000“, а след изтичане на командироването се подава нов ЕТЗ с
      действителния код. Тази зависимост е между ДВЕ полета и затова живее в BgEtzMandatory, не тук.

      Полето е СВОБОДЕН текст от 5 цифри, а не връзка към речник: пълната номенклатура по ЕКАТТЕ е
      около 5300 населени места и внасянето ѝ е отделна задача. До
      тогава форматът се пази от регулярен израз, а верността на кода — от проверката на НАП. -->
    <string name="bgWorkplaceEkatte" title="Код по ЕКАТТЕ (място на работа)" max="5"
      help="Петцифреният код по ЕКАТТЕ на населеното място, където е мястото на работа на лицето (реквизит т. 22 на ЕТЗ). „00000“ — повече от едно населено място или кодът не може да се определи; „99999“ — работа от разстояние с повече от едно уговорено място."/>

    <!-- ЕТЗ за сключването — ръчното подаване от панела на договора. ⚠️ TRANSIENT:
      без колони. Входящият номер и датата от портала се ЗАПИСВАТ върху подаването (NapSubmission
      .napIncomingNumber / submittedOn) през ManualSubmissionService — тук са само полетата, в които
      човек ги въвежда, по образеца на NapSubmission.portalSubmittedDate. -->
    <string name="bgEtzIncomingNumber" title="Вх. № от портала на НАП" transient="true"/>
    <date name="bgEtzPortalDate" title="Дата на подаване в портала" transient="true"/>
    <!-- Същото за ЕТЗ за прекратяването — отделни полета, защото двата реда на панела може
      да са видими едновременно. -->
    <string name="bgEtzEndIncomingNumber" title="Вх. № от портала на НАП (прекратяване)"
      transient="true"/>
    <date name="bgEtzEndPortalDate" title="Дата на подаване в портала (прекратяване)"
      transient="true"/>

    <!-- Полагаем годишен отпуск (основен + допълнителен). -->
    <decimal name="bgAnnualLeaveDays" title="Полагаем основен отпуск (дни)" precision="5"
      scale="2"/>
    <decimal name="bgAdditionalLeaveDays" title="Полагаем допълнителен отпуск (дни)"
      precision="5" scale="2"/>

    <!-- Обезщетенията при прекратяване на ТОЗИ договор. Обратната страна на връзката, която BgTerminationCompensation
      носи — за да има какво да се сложи на формата на договора. Без нея записите съществуват,
      но операторът няма откъде да стигне до тях: те нямат нито меню, нито панел, а механизъм, до който системата
      не стига, е същото като да го няма. mappedBy, не отделна колона: собственик на връзката остава BgTerminationCompensation,
      тоест уникалният ключ (договор, вид) продължава да пази от дубликати. -->
    <one-to-many name="bgTerminationCompensationList"
      title="Обезщетения при прекратяване"
      ref="com.axelor.apps.bglocalization.db.BgTerminationCompensation"
      mappedBy="employmentContract"/>

    <!-- Допълнителните споразумения по чл. 119 ал. 1 КТ (и едностранните увеличения по чл. 118 ал. 3).
      Обратната страна на връзката, която BgContractAmendment носи — за да има какво да се сложи на
      формата и операторът да стига до записите.

      ⚠️ mappedBy, НЕ отделна колона: собственик на връзката остава BgContractAmendment, тоест уникалният
      ключ (договор, дата на споразумението, основание) продължава да пази от дубликати. Нула промени по
      схемата на hr_employment_contract.

      ⚠️ И ТОЗИ СПИСЪК МЕСТИ ПАРИ. BgAmendmentSalaryRule го чете, за да каже коя е основната заплата
      за периода на фиша — договорът носи заплатата КАКТО Е СКЛЮЧЕНА, анексите лягат отгоре по датата си на
      влизане в сила. Едно презаписвано поле, четено без дата, би платило анекс от 1-ви октомври, въведен
      на 20-ти септември, и за септември. -->
    <one-to-many name="bgContractAmendmentList"
      title="Допълнителни споразумения"
      ref="com.axelor.apps.bglocalization.db.BgContractAmendment"
      mappedBy="employmentContract"/>

  </entity>

