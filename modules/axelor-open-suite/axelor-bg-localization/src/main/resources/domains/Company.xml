<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <!-- Bulgarian localization fields added to the standard Company entity. Merged into com.axelor.apps.base.db.Company
    by the code generator. -->
  <entity name="Company">

    <!-- Код по НКИД (икономическа дейност на работодателя, определя минималния осигурителен доход (МОД)
      за служителите). -->
    <many-to-one name="bgNkid" ref="com.axelor.apps.bglocalization.db.BgNkid"
      title="Код по НКИД"/>

    <!-- Предмет на дейност при код 35.40 (двусмислен: ел. енергия / природен газ). Използва се
      за избор на правилния ред от МОД, когато КИД×група lookup не разграничава. -->
    <string name="bgEnergyBrokerSubject" title="Предмет на дейност (енергетика)"
      selection="bg.energy.broker.subject.select"/>

    <!-- Ръчен избор на ред от Приложение №1 (МОД), когато КИД кодът на дружеството сочи двусмислено
      два реда (напр. 35.40 „брокери" → Ред 49 електроенергия или Ред 50 природен газ). Взима приоритет над
      BgNkid.bgMinIncomeRowCode. Свободен текст по КОД (не m2o) — темпоралният ред се резолвира в lookup-а.
      Nullable. -->
    <string name="bgMinIncomeRowCodeOverride" title="МОД ред (ръчно за двусмислен КИД)"/>

    <!-- Специализирано предприятие за хора с увреждания (ЗХУ) — влияе на осигурителните задължения. -->
    <boolean name="bgIsDisabilityEnterprise" title="Специализирано предприятие по ЗХУ"/>

    <!-- Процент за клас „прослужено време" за всяка година трудов стаж. -->
    <decimal name="bgSeniorityRatePct" title="Процент клас за година (%)" precision="5"
      scale="2" default="0.60"/>

    <!-- ДДС/NAP декларатори на дружеството. НЕ ПОВЕЧЕ от един може да е isDefault.

      ⚠️ И ТОВА НЕ СЕ ПАЗИ ОТ РЕПОЗИТОРИЯТА НА ДЕКЛАРАНТА. Полето е one-to-many, тоест генераторът му
      слага CascadeType.ALL: при запис на формата Дружество Hibernate записва децата по cascade и
      BgDeclarantManagementRepository.save НЕ се вика. Затова пазачът за този път седи на самото
      дружество — BgCompanyManagementRepository отказва запис с два вдигнати флага. -->
    <one-to-many name="bgDeclarantList"
      ref="com.axelor.apps.bglocalization.db.BgDeclarant" mappedBy="company" title="Декларатори"/>

    <!-- Стойностният праг на същественост от СЧЕТОВОДНАТА ПОЛИТИКА на дружеството — първата от двете
      стойности, чиято по-ниска решава дали активът е данъчен амортизируем (чл. 50 ал. 1 т. 1 и
      чл. 51 ал. 1 т. 1 б. „г" аа) ЗКПО).

      ⚠️ ДВА ПРАГА, НЕ ЕДИН, И ТОВА Е В ТЕКСТА. Чл. 50 ал. 1 т. 1 казва „стойностния праг на
      същественост за дълготрайния МАТЕРИАЛЕН актив", а чл. 51 ал. 1 т. 1 б. „г" аа) — „за
      дълготрайния НЕМАТЕРИАЛЕН актив". Счетоводната политика може да ги постави различни и законът
      го допуска, тъй че едно поле би слял два независими избора.

      Празно (нула) значи „политиката не е обявила праг" — тогава решава само законовата сума. Тъй
      минава и заварена база: полето е нулируемо и старите дружества не се променят. -->
    <decimal name="bgTangibleAssetMaterialityEur"
      title="Праг на същественост — ДМА (EUR)" precision="15" scale="2"/>

    <decimal name="bgIntangibleAssetMaterialityEur"
      title="Праг на същественост — ДНА (EUR)" precision="15" scale="2"/>

    <!-- ═══ SAF-T: РЕКВИЗИТИТЕ НА HEADER-А, КОИТО НЯМАТ ДРУГ ИЗТОЧНИК ═══

      Книгата на НАП (SAF-T_BG_Structure_Definition_V_1.0.2.xlsx, лист „5. Structures“) е
      авторитетът; XSD-то само изброява стойностите.

      ⚠️ ПРАЗНО НЕ Е ГРЕШКА, А ПОДРАЗБИРАНЕ, И ТО Е В КОДА (BgSaftHeaderAssembler), НЕ ТУК. Полетата
      са без default, за да не трябва миграция на заварените дружества: празната група е „5 — Не“,
      празната основа е „A“. Тоест заварена база и нова база дават един и същи файл.
    -->

    <!-- S.O.1 IsPartOfGroup: 1 централа на местна група, 2 централа на мултинационална група,
      3 част от местна група, 4 част от мултинационална група, 5 не. -->
    <string name="bgSaftIsPartOfGroup" title="SAF-T: част от група"
      selection="bg.saft.is.part.of.group.select"/>

    <!-- S.O.7–S.O.11 — крайното предприятие майка. Четат се САМО при група 3 или 4; при 1, 2 и 5
      във файла стои „00“ (бележката към S.O.7). Едно предприятие майка: книгата допуска няколко,
      а повече от едно е рядкост, която ще иска отделен ред, не още колони. -->
    <string name="bgSaftUltimateOwnerNameBg" title="SAF-T: предприятие майка (БГ, кирилица)"
      max="70"/>
    <string name="bgSaftUltimateOwnerEikBg" title="SAF-T: ЕИК на предприятието майка (БГ)"
      max="35"/>
    <string name="bgSaftUltimateOwnerNameForeignCyr"
      title="SAF-T: предприятие майка (чуждестранно, кирилица)" max="70"/>
    <string name="bgSaftUltimateOwnerNameForeignLat"
      title="SAF-T: предприятие майка (чуждестранно, латиница)" max="70"/>
    <string name="bgSaftUltimateOwnerCountry"
      title="SAF-T: държава на предприятието майка (ISO)" max="2"/>

    <!-- H.2 TaxAccountingBasis: A търговски предприятия, P бюджетни, BANK кредитни и небанкови
      финансови институции, INSURANCE застрахователи. -->
    <string name="bgSaftTaxAccountingBasis" title="SAF-T: счетоводна основа"
      selection="bg.saft.tax.accounting.basis.select"/>

    <!-- ПРИЛОЖИМАТА СЧЕТОВОДНА БАЗА — НСС или МСФО. Нужна е, защото методите за изписване на
      материалните запаси се различават: СС 2 т. 10 допуска LIFO като алтернативен подход, а МСС 2
      не го допуска (да се потвърди срещу официалния текст). Празно значи „не е избрана“ — тогава
      LIFO се отказва, защото не може да се докаже, че е допустим. НЕ е bgSaftTaxAccountingBasis:
      онова е H.2 на SAF-T (вид предприятие), а не стандартите. -->
    <string name="bgAccountingFramework" title="Приложима счетоводна база"
      selection="bg.accounting.framework.select"/>

    <!-- ГРАНИЦАТА НА НАПОМНЯНЕТО ЗА ПРИЛОЖЕНИЕ № 9 — само напред. Листовете, представени ПРЕДИ тази
      дата (без дата на представяне — започнали преди нея), не влизат в „Прил. 9 за подаване“ и не
      се броят. ⚠️ ПРАЗНО = НАПОМНЯНЕТО Е ИЗКЛЮЧЕНО за дружеството: по-добре нищо, отколкото списък,
      наводнен със заварени листове, за които никой не може да подаде нищо. По дружество, а не една
      дата на деплоя, защото дружествата влизат в Nyxa по различно време. -->
    <date name="bgApp9TrackFrom" title="Следи сроковете за Прил. 9 от дата"/>

    <!-- КОГА СРОКОВЕТЕ ЗА ПРИЛ. 9 СА ОПРЕСНЕНИ ЗА ПОСЛЕДНО — за съобщението на „Прил. 9 за подаване“ на
      потребител без право за запис (той отваря списъка, без да опреснява). Пише се с UPDATE от
      BgApp9DeadlineService#refresh, без да вдига версията на дружеството. -->
    <datetime name="bgApp9DeadlinesRefreshedOn" title="Сроковете за Прил. 9 — опреснени на"
      readonly="true"/>

    <!-- АДРЕСЪТ ЗА КОРЕСПОНДЕНЦИЯ ЗА ДДС — ППЗДДС чл. 117, ал. 2, т. 1; Прил. № 13, секция А; Прил.
      № 15, VTR поле 4. НЕЗАДЪЛЖИТЕЛНО: празно = „Адрес“ на дружеството. Изричен избор между двете
      полета на ДРУЖЕСТВОТО, изписан в етикета — не резерв към партньора. Единственият читател е
      BgVatRegisteredAddress. Ново поле, nullable. -->
    <many-to-one name="bgVatCorrespondenceAddress"
      title="Адрес за кореспонденция (ако е различен от „Адрес“)"
      ref="com.axelor.apps.base.db.Address"/>

    <!-- КАСОВА ОТЧЕТНОСТ ПО ДДС (глава 17а ЗДДС) — периодът, в който ДРУЖЕСТВОТО прилага режима.
      „От“ = първият ден на прилагане: „от първия ден на месеца, следващ месеца на получаване на
      разрешението“ (чл. 151б ал. 1). „До“ = последният ден: прекратяването е „от деня, следващ деня на
      връчване на акта“ (чл. 151б ал. 9); празно = режимът продължава. И двете празни = дружеството не
      е по режима. Сверено 26.10.2026 с консолидирания ЗДДС (lex.bg, последно изм. ДВ бр. 69/2026).
      Чете го SAF-T: получените документи по режима при дружество ПО режима към датата им са ГРЕШКА
      „да се потвърди“ — НАП описва само получател извън режима (отговор на НАП;
      BgSaftCashAccounting). Две нови незадължителни колони — добавя ги ddl=update и на
      заварена, и на чиста база; SQL файл и проверка при старт не трябват (db/migration/README). -->
    <date name="bgVatCashAccountingFrom" title="Касова отчетност по ДДС — от"/>
    <date name="bgVatCashAccountingTo" title="Касова отчетност по ДДС — до (последен ден)"/>

  </entity>

</domain-models>
