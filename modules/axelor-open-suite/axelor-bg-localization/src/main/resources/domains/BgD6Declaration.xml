<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Декларация обр. № 6 по Наредба Н-13 — „Данни за дължими вноски и данък по чл. 41а и/или чл. 42
    от ЗДДФЛ“. ЕДИН РЕД ЗА ЦЯЛОТО ДРУЖЕСТВО И МЕСЕЦА, а не по едно на лице.

    ⚠️ И ТОЧНО ТОВА Е РАЗЛИКАТА С Д1, КОЯТО РЕШАВА ЦЯЛАТА ФОРМА. Д1 е по ЛИЦЕ: един фиш → един запис,
    с базата и СТАВКИТЕ. Д6 е по ДРУЖЕСТВО: една декларация → едно число на фонд, в ЛЕВОВЕ. Затова тук
    НЯМА дъщерни записи — няма какво да седне в тях.

    ⚠️ ЛЕВОВЕТЕ ЖИВЕЯТ ТУК, А НЕ В Д1: файловият формат обявява полета 35–47 на Д1 за „(процент)“.
    Сумите са ПРЕДМЕТЪТ на тази декларация, и чл. 2 ал. 4 иска равенство между двете: „Всяко от
    декларираните месечни задължения по ал. 2 т. 2 … трябва да бъде равно на изчислените задължителни
    осигурителни вноски … от подадените декларация/и образец № 1.“

    ⚠️ ТРИТЕ ЗДРАВНИ ТОЧКИ НА Д1 СЕ СЛИВАТ В ЕДНА ТУК, и това е независимото потвърждение на
    база-дискриминатора на перото (BgPaySlipLine.bgHealthBaseKind). Указание т. 14: „сумата на дължимите осигурителни вноски за здравно
    осигуряване за ВСИЧКИ осигурени лица“ — без разграничение по база. Тоест на ниво Д1 три точки
    (22.1, 18 и 28), на ниво Д6 едно число. Ако дискриминаторът беше нов ФОНД, тук щеше да трябва
    обратно сливане; като БАЗА на перото той просто не участва в групирането за Д6.

    ⚠️ ПОСТРОЕНА ПО ОБРАЗЕЦА НА BgD1Declaration — същият път „период → адаптер → валидатор“, същите
    отказ и находки като текст. Втора, различна форма за втората декларация от една и съща наредба би
    значела два набора навици за едно и също нещо. -->
  <entity name="BgD6Declaration">

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <!-- ЕДИН ПЕРИОД, НЕ ДВА — и това е разлика спрямо Д1, не пропуск. Д1 различава периода на
      ДАННИТЕ от периода на ПОДАВАНЕ (чл. 4 ал. 1 т. 1 б. „б“). Д6 носи месеца и годината „за които се
      отнасят вноските“ (указание т. 9), а моментът на подаване се изразява ЧРЕЗ ДАТАТА НА ИЗПЛАЩАНЕ
      (т. 18) и чрез ВИДА ПЛАЩАНЕ (т. 8) — тоест през две други полета, не през втори период. -->
    <many-to-one name="bgPeriod" title="Период (месец и година)" required="true"
      ref="com.axelor.apps.base.db.Period"
      help="Месецът и годината, ЗА КОИТО се отнасят вноските — т. 9."/>

    <string name="statusSelect" title="Статус" selection="bg.d1.declaration.status.select"
      default="draft"/>

    <many-to-one name="bgDeclarant" ref="com.axelor.apps.bglocalization.db.BgDeclarant"
      title="Декларатор"/>

    <string name="napEntryNumber" title="НАП входящ №"/>

    <!-- ═══ ИДЕНТИФИКАЦИЯ (т. 1 – т. 6) ═══ -->

    <!-- ⚠️ ЕИК ПО БУЛСТАТ, НЕ ДДС НОМЕРЪТ — същият капан като при т. 4 на Д1, и същият източник:
      Partner.registrationCode, а не taxNbr. -->
    <!-- ⚠️ ДЕКЛАРАЦИЯТА НА САМООСИГУРЯВАЩОТО СЕ ЛИЦЕ Е НЕГОВА, НЕ НА ДРУЖЕСТВОТО.
      Наредба Н-13, указания за декларация обр. 6, т. 1, ДОСЛОВНО: „работодателите, осигурителите и
      техните клонове и поделенията попълват ЕИК по БУЛСТАТ/ЕИК по ЗТРРЮЛНЦ или служебен номер,
      издаден от НАП; САМООСИГУРЯВАЩИТЕ СЕ ЛИЦА и лицата по чл. 4, ал. 9 от КСО попълват ЕГН (ЛН,
      ЛНЧ) или служебен номер, издаден от НАП.“ Тоест т. 1 носи РАЗЛИЧЕН вид число според подателя,
      а т. 2 — имена по документ за самоличност вместо наименование на осигурител.

      ⚠️ И ОТТАМ ДЕКЛАРАЦИИТЕ НЕ СЕ СМЕСВАТ. Един файл има ЕДНО задължено лице; фиш на нает и фиш на
      самоосигуряващо се лице в една Д6 биха дали сбор, деклариран под чуждо ЕИК. Отказът е
      BgD6Emitter#refuseMixedCarriers и е ОТКАЗ, а не находка: тук няма верен изход. -->
    <many-to-one name="bgSelfInsuredRegistration" title="Регистрация (СОЛ)"
      ref="com.axelor.apps.bglocalization.db.BgSelfInsuredRegistration"/>

    <string name="t1ObligedPersonCode" title="т. 1 Код на задълженото лице (ЕИК или ЕГН)"/>
    <string name="t2Name" title="т. 2 Наименование"/>

    <!-- „0“ ако осигурителят НЕ е член на осигурителна каса, „1“ ако е. -->
    <string name="t3InsuranceFundMember" title="т. 3 Член на осигурителна каса"/>

    <string name="t4Email" title="т. 4 E-mail"/>
    <string name="t5Phone" title="т. 5 Телефон"/>
    <string name="t6Gsm" title="т. 6 GSM"/>

    <!-- ═══ КОД КОРЕКЦИЯ И ВИД ПЛАЩАНЕ (т. 7.1, т. 8.1) ═══

      ⚠️ КОРЕКЦИЯТА НА Д6 РАБОТИ ОБРАТНО НА ИНТУИЦИЯТА, и това е чл. 9 ал. 7 дословно: „Декларация
      образец № 6 се подава с код за корекция, когато се НАМАЛЯВА размерът на декларирано задължение.“
      Забележката към указание т. 7 добавя другата половина: „При УВЕЛИЧАВАНЕ размера на декларирано
      задължение НЕ СЕ ПОДАВА декларация с код корекция, а се подава нова декларация, в която се
      попълва само размерът на установената ПОЛОЖИТЕЛНА РАЗЛИКА.“

      Тоест намалението е корекция, а увеличението е НОВА декларация с ДЕЛТАТА. Обратното — корекция
      при увеличение — би дало декларация, която НАП приема и която удвоява задължението. -->
    <string name="t71CorrectionCode" title="т. 7.1 Код корекция (К)"
      help="Буква „К“ САМО когато се НАМАЛЯВА декларирано задължение (чл. 9 ал. 7). При увеличение се подава НОВА декларация с положителната разлика."/>

    <!-- ⚠️ ВИДЪТ ПЛАЩАНЕ НА ВНОСКИТЕ Е РЪЧЕН: 5 или 6 зависи от това КОГА е
      изплатено, а фишът не е вързан с реалното плащане. Непопълнен, генерирането спира със същия
      текст като помощта (BgD6Point#PAYMENT_KIND_HINT). Вид 8 за данъка НЕ се избира тук — файлът го
      пише сам в блок 2, когато има данък. -->
    <string name="t81PaymentKind" title="т. 8.1 Вид плащане"
      selection="bg.d6.payment.kind.select"
      help="5 — изплатено през същия месец; 6 — изплатено в по-късен месец"/>

    <!-- ═══ ДЪЛЖИМИТЕ ВНОСКИ (т. 10 – т. 15) — ЛЕВОВЕ ═══

      ⚠️ ГРУПИРАНЕТО НЕ Е ОГЛЕДАЛНО НА Д1, И НАЙ-ГОЛЯМАТА РАЗЛИКА Е ТЗПБ. Д1 т. 22 е формулирана „за
      фондовете на ДОО БЕЗ ТЗПБ“ и дава на ТЗПБ своя точка (22.2). Д6 т. 10, обратно, иска „сумата на
      дължимите осигурителни вноски за фондовете на ДОО за всички осигурени лица“ — БЕЗ изключение,
      тоест ТЗПБ Е ВЪТРЕ. Пренесено едно към едно от Д1, т. 10 щеше да е по-малка точно с ТЗПБ, а
      равенството по чл. 2 ал. 4 да не се затвори — при това с правдоподобна разлика от порядъка на
      половин процент. -->
    <decimal name="t10Doo" title="т. 10 Дължими вноски ДОО" scale="2" precision="20"
      help="ВСИЧКИ фондове на ДОО, ВКЛЮЧИТЕЛНО ТЗПБ. ⚠️ Д1 т. 22 е БЕЗ ТЗПБ — тук е с нея. Поле 12."/>
    <decimal name="t11TeacherPf" title="т. 11 Дължими вноски УчПФ" scale="2" precision="20"
      help="За наетите по трудови правоотношения. Поле 13."/>
    <decimal name="t12Upf" title="т. 12 Дължими вноски ДЗПО-УПФ" scale="2" precision="20"
      help="Включително фонд „Пенсии“ от увеличената вноска за лицата по чл. 4б ал. 1 КСО. Поле 14."/>
    <decimal name="t13Ppf" title="т. 13 Дължими вноски ДЗПО-ППФ" scale="2" precision="20"
      help="Включително фонд „Пенсии“ от увеличената вноска за лицата по чл. 4в ал. 1 КСО. Поле 15."/>

    <!-- ⚠️ ТРИТЕ БАЗИ НА Д1 СЕ СЛИВАТ ТУК. Указание т. 14 не различава база: „за всички осигурени
      лица“. Тоест т. 22.1 + т. 18 + т. 28 → едно число. -->
    <decimal name="t14Health" title="т. 14 Дължими вноски здравно осигуряване" scale="2"
      precision="20" help="СБОРЪТ на трите здравни точки на Д1 — т. 22.1, т. 18 и т. 28. Поле 16."/>
    <decimal name="t15Gvrs" title="т. 15 Дължими вноски ГВРС" scale="2" precision="20"
      help="За наетите по трудови правоотношения, БЕЗ лицата по чл. 7 т. 1–3 ЗГВРСНР. Поле 17."/>

    <!-- ═══ ДАНЪКЪТ (т. 16 – т. 17) ═══

      ⚠️ ДВЕ РАЗЛИЧНИ ПОЛЕТА ЗА ДАНЪК, И ГРАНИЦАТА МЕЖДУ ТЯХ Е ЧАСТИЧНОТО ПЛАЩАНЕ. Т. 16 е „удържаният
      през съответния месец данък по чл. 41а и/или чл. 42“, а т. 17 — „дължимият за внасяне от
      работодателя данък, когато през съответния месец са направени САМО ЧАСТИЧНИ плащания“ (чл. 42
      ал. 6 ЗДДФЛ). Указанието изрично казва: „Не се включва данъкът по т. 17.“ Тоест двете НЕ се
      събират и не се дублират.

      ⚠️ Т. 17 НЯМА НОСИТЕЛ В МОДЕЛА ДНЕС: „направени само частични плащания“ е факт за ПЛАЩАНЕТО, а
      фишът носи начисляване и една дата на изплащане. Колоната съществува, за да има къде да седне
      ръчната стойност, а емитерът я оставя празна и валидаторът го ОБЯВЯВА. -->
    <decimal name="t16Tax" title="т. 16 Удържан данък по чл. 41а/42/49 ал. 5 ЗДДФЛ" scale="2"
      precision="20" help="БЕЗ данъка по т. 17. Във файла е в блок 2 (вид плащане 8), поле 31."/>
    <decimal name="t17AdvanceTax" title="т. 17 Авансов данък по чл. 42 ал. 6 ЗДДФЛ" scale="2"
      precision="20"
      help="Само когато през месеца са направени САМО ЧАСТИЧНИ плащания. Няма носител в модела — попълва се на ръка. Във файла е в блок 2 (вид плащане 8), поле 32."/>

    <!-- ═══ ДАТА НА ИЗПЛАЩАНЕ/НАЧИСЛЯВАНЕ (т. 18) ═══

      Указанието дава ШЕСТ различни правила според случая — 25-о число при неначислени възнаграждения,
      последният календарен ден на месеца при начислени и/или изплатени, датата на изплащане при код 6,
      и още три. ⚠️ Затова полето е ДАТА, която емитерът предлага, а човек потвърждава: правило,
      избрано в кода, би било вярно за обичайния случай и невярно за петте останали. -->
    <date name="t18PaymentDate" title="т. 18 Дата на изплащане/начисляване"/>

    <string name="bgRefusalReport" title="Откази (с причина)" large="true"/>
    <string name="bgValidationReport" title="Проверки" large="true"/>

    <!-- ═══ МИГРАЦИЯ (от Microinvest) ═══ Огледално на BgD1Declaration.bgIsHistoricalImport —
      виж домейна му за пълния довод. Пазено тук поотделно, а не изведено от Д1, защото двете
      декларации се генерират и подават през различни бутони и НЯМА гаранция, че за всеки исторически
      месец съществуват и двете. -->
    <boolean name="bgIsHistoricalImport" title="Исторически внесена (миграция)" default="false"/>

  </entity>

</domain-models>
