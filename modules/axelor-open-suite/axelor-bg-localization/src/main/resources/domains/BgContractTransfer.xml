<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ПРОМЯНА НА РАБОТОДАТЕЛЯ по чл. 123 / чл. 123а КТ — отделен запис, отделна схема.

    ═══ ЗАЩО ОТДЕЛНА ENTITY, А НЕ ВИД НА BgContractAmendment ═══

    Двете събития приличат отвън — и двете са „нещо се смени на дата X“ — и се различават във всичко
    съществено:

      • ДРУГА СХЕМА. Изменението върви по etzemploy (DEC_ETZ62, 33 полета), прехвърлянето — по
        etz123employer (DEC_ETZ123, 14 полета) с ДВА ЕИК в заглавната част.
      • ДРУГ КЛЮЧ. Приложение №1 дава за тип 2 ключови полета 1, 3, 4, 5, 6, 10, 12 и 16;
        Приложение №2 дава за чл. 123 полета 1, 2, 3, 4, 5, 6, 7, 11, 12 и 13. За фиксиран договор
        първото се свежда до (дата, основание), второто — до (дата, основание на промяната, предишен
        ЕИК).
      • ДРУГА НОМЕНКЛАТУРА. Поле 12 при изменение носи 018–021; тук Поле 3 носи 1–11 и значи съвсем
        друго. Слети в една колона, двете биха изглеждали взаимозаменяеми.

    Слети в една таблица, половината колони стоят празни при всеки ред и ограничението не може да се
    изрази без частичен индекс. Разделени, всяка носи пълен <unique-constraint> в domain XML.

    ⚠️ ПРАВООТНОШЕНИЕТО СЕ ЗАПАЗВА. По чл. 123 не се сключва нов договор и не се прекратява старият —
    сменя се СТРАНАТА по него. Затова записът виси на СЪЩИЯ EmploymentContract, а не на нов. -->
  <entity name="BgContractTransfer">

    <many-to-one name="employmentContract" title="Трудов договор" required="true"
      ref="com.axelor.apps.hr.db.EmploymentContract"/>

    <!-- Поле 13 — датата на промяната. Задължителна и по схема, и по приложение. -->
    <date name="changeDate" title="Дата на промяната на работодателя" required="true"/>

    <!-- Поле 4 — ЕИК на ПРЕДИШНИЯ работодател.

      ⚠️ ПРЕДИШНИЯТ, А НЕ НОВИЯТ. Новият е ЕИК-ът на дружеството по договора (Поле 5) и се чете
      оттам; тук се пази този, който вече не е страна. Разменени, файлът остава валиден по схема —
      двата елемента са от един и същ тип — и вписва прехвърлянето в ОБРАТНАТА посока.

      ⚠️ Свободен текст, а не връзка към Partner: предишният работодател е ЧУЖДО дружество и по
      правило го няма в нашата база. Дължината следва схемата: string(min=9, max=13). -->
    <string name="formerEik" title="ЕИК на предишния работодател" max="13" required="true"/>

    <!-- Поле 3 — основанието на промяната, 1–11 по Приложение №2.

      ⚠️ РАЗЛИЧНО ПОЛЕ ОТ „КОД КОРЕКЦИЯ“ (Поле 2), въпреки близките имена в схемата
      (correctiontype срещу codecorrection). Поле 2 казва редовни/корекция/заличаване; Поле 3 казва
      ЗАЩО се сменя работодателят. Разменени, файлът минава схемата — и двете са малки цели числа —
      и вписва грешно правно основание. -->
    <string name="bgChangeReason" title="Основание на промяната" required="true"
      selection="bg.etz.change.reason.select"/>

    <!-- Поле 14 — ЕКАТТЕ на мястото на работа СЛЕД прехвърлянето.

      ⚠️ Задължително при вид правоотношение 01 или 02 и код корекция 0 или 1 (Приложение №2) — и е
      единственото поле, което код корекция 1 изобщо може да поправи. Празно тук значи, че се чете
      от договора; попълнено — че мястото се мени заедно с работодателя. -->
    <string name="newWorkplaceEkatte" title="Нов код по ЕКАТТЕ (място на работа)" max="5"/>

    <many-to-one name="napSubmission" title="Подаване към НАП"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission"/>

    <!-- ⚠️ ОГЛЕДАЛО НА КЛЮЧОВИТЕ ПОЛЕТА ПО ПРИЛОЖЕНИЕ №2. Един договор може да бъде прехвърлен
      повече от веднъж (верига от преобразувания), затова датата сама не стига; а два записа с
      еднаква дата, основание И предишен ЕИК са дубликат. -->
    <unique-constraint columns="employmentContract,changeDate,bgChangeReason,formerEik"/>

  </entity>

</domain-models>
