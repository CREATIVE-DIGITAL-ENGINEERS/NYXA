<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ВХОДЪТ НА ЕДИН ПРОБЕГ ПО ПЛАЩАНЕТО НА НЕТАТА — САМО СЪБИРА, НЕ ПАЗИ ═══

    Ползва се ПРЕХОДНО, по образеца на BgIncomePaymentFeedWizard: бутонът
    работи върху контекста на формата и НЕ вика save.

    ⚠️ ЗАЩО НЕ Е ПЕРСИСТИРАН „ПРОБЕГ“. Пробегът вече има свой документ и той не е тукашен: това е
    BankOrder-ът, който се ражда от бутона. Той носи платеца, валутата, датата на изпълнение,
    сбора, редовете по лице и САМИЯ ФАЙЛ като приложение; фишовете сочат обратно към него през
    BgPaySlip.bgPaymentBankOrder. Запис и тук би бил ВТОРО нещо за сверяване до него — и първото,
    което се разминава, защото никой не го препрочита.

    ⚠️ И ЗАТОВА ПОВТОРНИЯТ ПРОБЕГ НЕ ЧЕТЕ ИСТОРИЯ. Той намира вече платените фишове по тяхното
    поле (bgPaymentBankOrder IS NOT NULL), а не по спомен какво е правил миналия път — точно
    както захранването на регистъра намира своите редове по референцията им.

    ⚠️ И ТОВА НЕ Е ПЛАЩАНЕ. Бутонът ражда ФАЙЛ. Файлът се преглежда и се качва в банката от ЧОВЕК;
    нищо тук не се свързва с банка, не подава и не мести пари. Затова и фишът не става PAID от
    този пробег — виж BgPaySlip.bgPaymentBankOrder. -->
  <entity name="BgPayrollSepaWizard">

    <!-- ═══ ВХОД ═══ -->

    <!-- Платецът. Обходът чете фишовете през EmploymentContract.payCompany — фишът НЯМА свое
      дружество (същият прочит като в BgIncomePaymentFeedService). Дружеството решава и КОЯ сметка
      плаща: настройките са на AccountConfig за него. -->
    <many-to-one name="company" title="Платец (дружество)" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- Периодът на ведомостта — един пробег, един файл, едно нареждане.

      ⚠️ ЕДИН ПЕРИОД, А НЕ ОБХВАТ ОТ-ДО. Файлът отива в банката като едно нареждане с едно
      основание („Работна заплата <период>“); два месеца в един файл биха дали на всяко лице по два
      реда с различно основание и един общ сбор, който не се сверява с нито една ведомост. -->
    <many-to-one name="period" title="Период" required="true"
      ref="com.axelor.apps.base.db.Period"/>

    <!-- ДАТАТА НА ИЗПЪЛНЕНИЕ — <ReqdExctnDt> в pain.001: денят, в който банката дебитира сметката.

      ⚠️ МИНАЛА ДАТА СЕ ВДИГА ДО ДНЕС, И ТО НЕ ОТ ТУК. BankOrderCreateService#createBankOrder прави
      `bankOrderDate.isBefore(todayDate) ? todayDate : bankOrderDate` — тоест вчерашна дата НЕ е
      отказ, а тиха замяна. Полето стои на екрана точно за да се вижда какво е поискано.

      ⚠️ И НЕ ПОВЕЧЕ ОТ ГОДИНА НАПРЕД: самата схема на pain.001 го ограничава. -->
    <date name="executionDate" title="Дата на изпълнение"/>

    <!-- ═══ ИЗХОД (сметнат, не съхраняван) ═══ -->

    <!-- ⚠️ ЦЕЛИЯТ ТЕКСТ СЕ ПОКАЗВА, а не се свежда до известие — същият довод като при захранването
      на регистъра. Пробегът брои изключените ПО ПРИЧИНА и всяка причина е или попълнимо поле, или
      решение на оператора; едноредово известие би ги слепило в „N изключени“. -->
    <string name="resultSummary" title="Резултат и граници" large="true" multiline="true"
      transient="true"/>

  </entity>

</domain-models>
