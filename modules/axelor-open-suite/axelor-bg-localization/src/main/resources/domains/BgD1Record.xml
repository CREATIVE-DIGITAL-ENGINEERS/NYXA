  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ЕДИН ЗАПИС ОТ ДЕКЛАРАЦИЯ ОБР. № 1 — „Данни за осигуреното лице“. Един фиш → един запис.

    ИМЕНАТА НА ПОЛЕТАТА СА НОМЕРАТА НА ТОЧКИТЕ от Приложение № 1 към чл. 2 ал. 1 на Наредба Н-13
    ({@code t21InsuranceIncome} = т. 21). Това е нарочно и е същият избор, който ДДС-стекът прави с
    {@code k01}…{@code k82}: човекът, който сверява декларацията, държи в ръцете си образеца на НАП,
    а не нашия речник. Име, което описва СМИСЪЛА, но не носи номера, го кара да превежда наум при
    всеки ред — и точно там се появяват разминаванията.

    ⚠️ ГРАНИЦИТЕ СА ОБЯВЕНИ, НЕ ПРЕМЪЛЧАНИ. Всичките 54 полета на файла имат носител. Отложена
    точка няма колона, вместо да стои празна: празна колона в базата е неразличима от сметната
    нула, а „0,00 лв. вноска“ е валидно число, което НАП приема. {@code BgD1PhaseBoundariesTest}
    пази границата: отложена точка не може да се появи мълчаливо като нула, нито да бъде добавена,
    без някой да я впише там с причина.

    ⚠️ ЗАЩО НЕ САМО DTO. Записът се СВЕРЯВА ОТ ЧОВЕК преди подаване (чл. 8 ал. 1 т. 1 разрешава
    хартиен носител) и се печата. Тоест той има живот извън едно извикване на услугата. -->
  <entity name="BgD1Record">

    <many-to-one name="bgD1Declaration" title="Декларация" required="true"
      ref="com.axelor.apps.bglocalization.db.BgD1Declaration"/>

    <!-- Фишът-източник. Оставя одитната следа „от кое число дойде“ — без него сверката е срещу
      нищо. Не е required: заличаващият запис по буква „З“ може да няма жив фиш. -->
    <many-to-one name="paySlip" title="Фиш" ref="com.axelor.apps.bglocalization.db.BgPaySlip"/>

    <!-- ═══ ИДЕНТИФИКАЦИЯ (т. 1 – т. 7) ═══ -->

    <!-- ⚠️ БУКВА, НЕ ЧИСЛО. Приложение № 1 т. 1 казва дословно „попълва се буква „К““ и „попълва се
      буква „З““ — кодът не е число. Празно значи редовна декларация. -->
    <string name="t1CorrectionCode" title="т. 1 Код корекция (К/З)"
      selection="bg.d1.correction.code.select"
      help="Буква „К“ при корекция, буква „З“ при заличаване. Празно при редовна декларация."/>

    <!-- Две позиции („01“…„12“) и четири позиции. Низ, не число: водещата нула Е част от
      стойността, а Integer я губи мълчаливо. -->
    <string name="t2Month" title="т. 2 Месец" help="Две позиции, напр. „05“."/>
    <string name="t3Year" title="т. 3 Година" help="Четири позиции, напр. „2026“."/>

    <!-- ⚠️ ЕИК ПО БУЛСТАТ, НЕ ДДС НОМЕРЪТ. Наредбата иска за т. 4 „ЕИК по БУЛСТАТ, ЕИК по ЗТРРЮЛНЦ,
      служебен номер, издаден от НАП“ — тоест Partner.registrationCode. ДДС-стекът чете
      company.partner.taxNbr („ЕИК по ДДС“, регистрационният номер по ЗДДС) и това е ДРУГО поле на
      същия Partner. Взето по инерция оттам, т. 4 би носила ДДС номера: правдоподобен низ на верния
      ред, който никой не поглежда втори път. -->
    <string name="t4ObligedPersonCode" title="т. 4 Код на задълженото лице (ЕИК по БУЛСТАТ)"/>

    <string name="t5PersonalId" title="т. 5 ЕГН/ЛН/ЛНЧ"/>

    <!-- ⚠️ „0“ ИЛИ „2“, И НИКОГА „1“. Наредбата: „0 — ако лицето е с единен граждански номер;
      2 — ако лицето е с личен номер на чужденец, личен номер или служебен номер“. Нашата селекция
      bg.personal.id.type.select обаче носи „1“ = ЕГН и „2“ = ЛНЧ. Тоест стойността се ПРЕВЕЖДА, а
      не се препраща: препратената „1“ е низ, който НАП не познава. -->
    <string name="t51PersonalIdCode" title="т. 5.1 Код за ЕГН/ЛНЧ"
      help="„0“ при ЕГН, „2“ при ЛН/ЛНЧ/служебен номер. Не е същото като bg.personal.id.type.select."/>

    <string name="t6Surname" title="т. 6 Фамилия"/>

    <!-- „първата буква от името и първата буква от презимето“ — оттам и презимето е наше
      разширение на Partner (bgMiddleName): без него вторият инициал няма източник. -->
    <string name="t7Initials" title="т. 7 Инициали"/>

    <!-- ═══ ВИД ОСИГУРЕН, ДЕЙНОСТ И ДНИ-ГРАНИЦИ (т. 12, 12.1, 12.2, 12.3, 14, 15) ═══ -->

    <!-- Две позиции. Връзката към речника е ПО КОД, не m2o — списъкът е темпорален (ДВ бр. 15/2024
      премахна кодове 07, 21, 23 и 93), а коригираща Д1 за минал период ползва кодовете, валидни
      тогава. Същият довод, с който EmploymentContract.bgInsuredTypeCode е низ. -->
    <string name="t12InsuredTypeCode" title="т. 12 Вид осигурен"/>

    <!-- Попълват се само за 18-те кода с вдигнат bgAppliesMod (+ код 94 под условието на чл. 6
      ал. 3 КСО, заб. 2). За останалите остават ПРАЗНИ — и това е стойност, не пропуск. -->
    <string name="t121QualificationGroup" title="т. 12.1 Квалификационна група"/>

    <!-- ⚠️ ЧЕТИРИ ЦИФРИ БЕЗ ТОЧКА, И ТОЧКАТА НЕ Е КОЗМЕТИКА. Указанието иска „4-значният код по КИД
      2008 г.“, а файлът дава на поле 29 тип Char с размер РАВЕН НА 4. Нашият речник носи кода в
      точкувана форма — всичките 651 реда на bg_nkid.csv са точно „NN.NN“, тоест 5 знака. Препратен
      както е, кодът е с един знак по-дълъг от полето: НАП го отхвърля, а на екрана „01.11“ и „0111“
      изглеждат като едно и също нещо. Затова стойността се ПРЕВЕЖДА (BgD1RecordBuilder#activityCode),
      а не се препраща — същият клас грешка като т. 5.1.

      ⚠️ ЕДНА ДЕЙНОСТ НА ФИРМА, тоест източникът е Company.bgNkid за
      ВСЯКО лице и договорът НЕ получава свое поле. Указанието познава и другия случай: „за лицата,
      наети в спомагателни дейности на работодателя, КОГАТО ТОЙ ИЗВЪРШВА ПОВЕЧЕ ОТ ЕДНА икономическа
      дейност, се попълва „0000““. Предпоставката му не е налице тук — а „0000“ би било невярно
      твърдение за структурата на осигурителя, не празна стойност. Записано, за да се види, че
      случаят е ПРОЧЕТЕН и отхвърлен, а не пропуснат.

      ⚠️ И ТЗПБ ОСТАВА ФИРМЕНА по същия довод: ставката ѝ следва икономическата дейност на
      ОСИГУРИТЕЛЯ, а тя е една. -->
    <string name="t122ActivityCode" title="т. 12.2 Код икономическа дейност (КИД 2008)" max="4"
      help="Четири цифри БЕЗ точка, от Company.bgNkid. Поле 29 е Char с размер точно 4."/>

    <string name="t123ActivityRow" title="т. 12.3 Ред основна дейност"/>

    <!-- ═══ т. 13 — КОД ЗА СУМИРАНО ИЗЧИСЛЯВАНЕ НА РАБОТНОТО ВРЕМЕ (поле 31, Char =4) ═══

      УКАЗАНИЕТО ДОСЛОВНО: „когато в т. 12 е попълнен код за вид осигурен 16, в двете позиции се
      попълва: Позиция 1: от 02 до 12 в съответствие с БРОЯ МЕСЕЦИ в установения период на сумирано
      изчисляване на работното време. Позиция 2: от 01 до 12 според ПОРЕДНОСТТА НА МЕСЕЦА от периода
      на сумирано изчисляване, за който се подават данните.“

      ⚠️ ДВЕ КОЛОНИ ЗА ЕДНО ПОЛЕ, и това е същият избор като при т. 16: поле 31 е Char с размер РАВЕН
      НА 4, тоест две позиции по две цифри, слепени в един низ („0302“ = триМЕСЕЧЕН период, ВТОРИ
      месец). Записано като едно поле, „0302“ не може да се провери: позиция 1 има таван 12 и под 02,
      позиция 2 има таван броя месеци от позиция 1 — а проверка на диапазон не се прави върху слепен
      низ. Слепването прави сериализаторът.

      ⚠️ И ЗАЩО НИЗ, А НЕ ЧИСЛО: „в двете позиции“. Водещата нула Е част от стойността, а генерираният
      getter за Integer връща 0, НИКОГА null — тоест разликата „не се попълва“ / „нула месеца“ не
      може да живее в Integer колона. Същият измерен довод като при кофите на т. 16.

      ⚠️ ПОЗИЦИЯ 1 ИМА АВТОМАТИЧЕН ИЗТОЧНИК, ПОЗИЦИЯ 2 — НЕ, и разликата не е в трудността.
      Позиция 1 е ДЪЛЖИНАТА на отчетния период и тя стои на договора
      (EmploymentContract.bgSirvPeriodMonths, „Отчетен период при СИРВ (месеци)“). Позиция 2 е
      ПОРЕДНОСТТА на месеца в този период, а тя иска НАЧАЛОТО на периода — акт на работодателя по КТ
      чл. 142 ал. 2, който може да започне в който и да е месец. Изведена от календарната година
      („период от 3 месеца → януари е първи“), тя е вярна за половината работодатели и невярна за
      другата, при това с валидна цифра. Затова се въвежда на ръка. -->
    <string name="t13SirvPeriodMonths" title="т. 13 (поз. 1) Брой месеци в периода при СИРВ"
      help="От 02 до 12. Източник: EmploymentContract.bgSirvPeriodMonths. Попълва се САМО за вид осигурен 16. Поле 31, позиции 1–2."/>
    <string name="t13SirvMonthIndex" title="т. 13 (поз. 2) Пореден месец от периода при СИРВ"
      help="От 01 до 12. ⚠️ НЯМА автоматичен източник: началото на отчетния период е акт на работодателя по КТ чл. 142 ал. 2 и не е в модела. Попълва се на ръка. Поле 31, позиции 3–4."/>

    <!-- ═══ т. 14 / т. 15 — ПЕТ ДВОЙКИ ВЪЗНИКВАНЕ/ПРЕКЪСВАНЕ (полета 9–18) ═══

      ⚠️ ПЕТ ДВОЙКИ, НЕ ЕДНА. Наредбата описва точките в единствено число — „попълва се в
      две позиции първият календарен ден“ — и оттам едно поле изглежда достатъчно. Файловият формат
      казва друго: полета 9–18 са ПЕТ ДВОЙКИ, позиции 1–5. Тоест осигуряването може да възникне и да
      се прекъсне до пет пъти в един месец, а запис с една двойка би отчел само първото прекъсване и
      би премълчал останалите — при това правдоподобно, защото първата двойка Е вярна.

      ⚠️ ЗАЩО ДЕСЕТ КОЛОНИ, А НЕ ДЪЩЕРЕН ЕНТИТЕТ. Броят е ЗАКОВАН ОТ ФОРМАТА на пет, не е отворен
      списък. Дъщерна таблица би допуснала шеста двойка, която няма къде да отиде във файла, и би
      преместила проверката „не повече от пет“ от схемата в код. Десет колони са огледало на десет
      полета — същият довод, с който ДДС-стекът държи k01…k82 като колони.

      ⚠️ И ЗАЩО НИЗ, А НЕ ЧИСЛО: „попълва се в ДВЕ ПОЗИЦИИ“. Водещата нула Е част от стойността, а
      Integer я губи мълчаливо — същото решение като при т. 2 (месец).

      ⚠️ ЧЕТЕНЕ НА ДВОЙКАТА: т. 15 е последният ден ПРЕДИ прекъсването, т. 14 на следващата позиция е
      денят на ВЪЗОБНОВЯВАНЕТО. Тоест двойките не са интервали на отсъствие, а границите на
      осигуряването.

      ⚠️ ПОЗИЦИИ 2–5 ИМАТ ИЗТОЧНИК, макар договорът да знае само НАЧАЛОТО и КРАЯ си.
      КСО чл. 10 ал. 2 казва дословно: „Осигуряването се ПРЕКЪСВА през периодите, които НЕ СЕ ЗАЧИТАТ
      за осигурителен стаж, независимо че дейността … не е прекратена.“ А тези периоди имат носител —
      BgAbsenceType.countsAsInsuranceService, — и пет вида отсъствие в речника носят false: неплатеният
      отпуск над 30 работни дни (по желание и по производствена необходимост), неприсъствието,
      самоотлъчката и непредставеният болничен.

      ⚠️ И НЕ ВСЯКО ОТСЪСТВИЕ: болничният, платеният отпуск, отпускът за дете и неплатеният отпуск ДО
      30 работни дни СЕ ЗАЧИТАТ за стаж (чл. 9 ал. 2), тоест НЕ прекъсват осигуряването. Прочетено
      като „отсъствието прекъсва“, правилото щеше да нареже месеца на всеки болничен и да изразходва
      петте позиции на формата за обикновен фиш. Сметката живее в BgD1InsuranceSegments. -->
    <string name="t14Day1" title="т. 14 (1) Ден на възникване/възобновяване"/>
    <string name="t15Day1" title="т. 15 (1) Последен ден в осигуряване"/>
    <string name="t14Day2" title="т. 14 (2) Ден на възобновяване"/>
    <string name="t15Day2" title="т. 15 (2) Последен ден в осигуряване"/>
    <string name="t14Day3" title="т. 14 (3) Ден на възобновяване"/>
    <string name="t15Day3" title="т. 15 (3) Последен ден в осигуряване"/>
    <string name="t14Day4" title="т. 14 (4) Ден на възобновяване"/>
    <string name="t15Day4" title="т. 15 (4) Последен ден в осигуряване"/>
    <string name="t14Day5" title="т. 14 (5) Ден на възобновяване"/>
    <string name="t15Day5" title="т. 15 (5) Последен ден в осигуряване"/>

    <!-- ═══ т. 16 — ДНИ В ОСИГУРЯВАНЕ, ПО КОФИ (полета 19–27) ═══

      ⚠️ ПОЛЕ 19 Е ЕДНО ПОЛЕ С ЧЕТИРИ ПОЗИЦИИ, И ТОВА НЕ Е ЕДНО ЧИСЛО. Файловият формат дава на т. 16
      тип Char с размер РАВЕН НА 4, а указанието описва четири различни неща в тези четири знака:
      позиции 1–2 са ОБЩИЯТ БРОЙ РАБОТНИ ДНИ в осигуряване, позиция 3 е ЗАКОНОУСТАНОВЕНОТО работно
      време за длъжността (в часове), позиция 4 е ДНЕВНОТО ДОГОВОРЕНО работно време на лицето.
      Тоест „2188“ значи 21 дни, 8 часа по закон, 8 часа по договор — а прочетено като число, същото
      поле значи две хиляди сто осемдесет и осем дни.

      Затова записът пази ЧЕТИРИ полета, а сериализаторът ги слепва. Обратното — едно поле „2188“ —
      прави невъзможна всяка проверка: заб. 1 иска позиции 1 и 2 да са СБОРЪТ от т. 16.1 до 16.5 и
      т. 16.А, а сбор не се сверява срещу слепен низ.

      ⚠️ ВСИЧКИТЕ ЕДИНАЙСЕТ ПОЛЕТА СА НИЗОВЕ, А НЕ ЦЕЛИ ЧИСЛА — И ТОВА НЕ Е СТИЛ. Генерираният
      getter за Integer връща 0, НИКОГА null (виж BgDefaultedGetterTest). Тоест разликата
      „точката НЕ се попълва“ / „точката е нула“ НЕ МОЖЕ да живее в Integer колона.

      А тя е ЗАКОНОВА, не козметична, и то на три места наведнъж:
      • заб. 3: „Когато в т. 12 Вид осигурен е попълнен код 90, т. 16 НЕ се попълва“ — а „2100“
        твърди 21 дни в осигуряване, и „0000“ твърди нула. И двете са ПОПЪЛНЕНА точка;
      • позиции 3 и 4: седемнайсетте кода с bgZeroWorkTime попълват НУЛА (твърдение), а за
        останалите законоустановеното работно време няма носител (липса). Слети в 0, двете стават
        едно;
      • т. 16.7/16.8: двайсет и трите кода с bgNoHours не ги попълват по норма, а за останалите
        часовете няма източник — и „нула отработени часа“ е числото, което НАП отхвърля.

      Същият избор като при т. 2 (месец) и т. 14/15 (ден): „попълва се в две позиции“ значи, че
      водещата нула Е част от стойността, а Integer я губи мълчаливо. Аритметиката живее в
      BgD1DayBuckets, който работи с int-ове и не пипа записа.

      ⚠️ КОФАТА НЕ СЕ ИЗВЕЖДА ОТ category ИЛИ legalBasis, а се ЧЕТЕ от BgAbsenceType.d1Code. Причината
      е измерима: категория „Болнични“ (2) се разцепва на ТРИ различни кофи — 16.2 при обезщетение от
      ДОО, 16.А при възнаграждение от работодателя по чл. 40 ал. 5 КСО, и 16.4 при болничен БЕЗ право
      на обезщетение. Един и същи чл. 164б КТ пък отива в 16.2 ИЛИ в 16.3 според това дали има право
      на обезщетение по чл. 53в КСО. Тоест разграничителят е ПРАВНОТО СЛЕДСТВИЕ, а нито категорията,
      нито основанието го носят. -->

    <!-- т. 16 позиции 1–2: общият брой работни дни в осигуряване. ⚠️ СБОР, а не самостоятелно число
      (заб. 1): „В позиции 1 и 2 на т. 16 се вписва сборът от дните, отразени в т. 16.1 до 16.5 и
      т. 16.А.“ Записан независимо, той може да се размине със собствените си съставки. -->
    <string name="t16Days" title="т. 16 (поз. 1–2) Дни в осигуряване — общо"
      help="Сборът от т. 16.1 до 16.5 и т. 16.А (заб. 1). Поле 19, позиции 1–2."/>

    <!-- ⚠️ ДВЕ РАЗЛИЧНИ ЧИСЛА, КОИТО СЪВПАДАТ ПРИ ПЪЛЕН ЩАТ — и точно затова се пазят отделно.
