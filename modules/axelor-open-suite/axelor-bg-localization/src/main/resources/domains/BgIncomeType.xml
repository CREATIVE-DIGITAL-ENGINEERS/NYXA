<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ НОМЕНКЛАТУРАТА НА ВИДА ДОХОД ПО ЗДДФЛ — каталогът зад двете справки по чл. 73 ═══

    ИЗТОЧНИКЪТ Е ОБРАЗЕЦЪТ, НЕ ЗАКОНЪТ. Кодовете не съществуват в ЗДДФЛ: те са номенклатура към
    справките по чл. 73 ал. 1 и ал. 6, утвърдени със заповед на изпълнителния директор на НАП
    (чл. 73 ал. 8 и ал. 11 — „във формат и по ред, одобрени със заповед“). Затова редовете тук се
    сверяват срещу ОБРАЗЕЦА за съответната година, а членът, ставката и разходите — срещу ЗДДФЛ.
    Заведеното е по образците за 2025 г.: 79 кода на ал. 1 (Части І–ІV) и 11 кода на ал. 6.

    ⚠️ ТЕМПОРАЛЕН СПИСЪК, И ТОВА НЕ Е ПРЕДПАЗЛИВОСТ. Образецът за 2025 г. НЕ съдържа кодове 602,
    818, 821, 901, 905 и 906, а по-ранни образци ги носят: 818 отпада с отмяната на чл. 38 ал. 10
    (ДВ бр. 106/2023, в сила от 01.01.2024). Коригираща справка за минала година ползва кодовете,
    валидни ТОГАВА — оттам validFrom/validTo и уникалността по (code, validFrom), а НЕ по code.

    ⚠️ И ОЩЕ ЕДНА ТЕМПОРАЛНОСТ, КОЯТО ВЕЧЕ Е НАСТЪПИЛА И НЕ Е ОТРАЗЕНА ТУК. Код 3061 е „свободна
    професия като адвокат“ по чл. 29 ал. 1 т. 2 б. „г“. ДВ бр. 30 от 2026 г., в сила от 01.01.2026,
    добавя към същата буква И НОТАРИУСА. Тоест обхватът на кода се разширява от 2026 г., но
    образецът за 2026 г. още не е издаден и редът тук е този за 2025 г. Нов ред с validFrom
    2026-01-01 се завежда, когато образецът излезе — не по-рано.

    ⚠️ ВРЪЗКАТА КЪМ ТОЗИ МОДЕЛ Е ПО КОД, НЕ ПО ИМЕ. Имената са дълги по няколкостотин знака (код 101
    е ~2000) и се сменят с всеки образец; кодът е стабилен. Затова name е large="true" — виж
    BgSeedColumnWidthTest: стойност над varchar(255) не се съкращава, а ОТХВЪРЛЯ реда мълчаливо. -->
  <entity name="BgIncomeType">

    <string name="code" title="Код на дохода" required="true"/>

    <!-- ДОСЛОВНОТО описание от образеца, не съкратено. Съкращаването е перифраза на нормативен
      текст: то е точно грешката, срещу която този каталог съществува. -->
    <string name="name" title="Вид на дохода" required="true" large="true"/>

    <!-- Разпоредбата, която урежда ДОХОДА — прочетена ОТ ОПИСАНИЕТО на кода в образеца, а не
      възстановена по памет. Където образецът не назовава член (кодове 101–103), стои
      определението от § 1 на ДР, което описанието преразказва буква по буква. -->
    <string name="article" title="Разпоредба (ЗДДФЛ)" required="true"/>

    <!-- Шаблонът на облагането — кое ПРАВИЛО важи, а не кой ред от справката се пълни.
      Той решава как се стига от бруто до основа и до данък, и затова е признакът, по който
      се избира формулата. -->
    <string name="taxPattern" title="Шаблон на облагане" required="true"
      selection="bg.income.type.pattern.select"/>

    <!-- Нормативно признатите разходи в ПРОЦЕНТИ ОТ БРУТНИЯ ДОХОД — само за шаблони A и B.

      ⚠️ И ИМЕННО ЗАТОВА ШАБЛОН D СТОИ НА НУЛА, А НЕ НА 10. Чл. 33 също говори за „10 на сто
      разходи“ (ал. 1 и ал. 3), но ги прилага върху ПОЛОЖИТЕЛНАТА РАЗЛИКА между продажната цена и
      цената на придобиване, а не върху бруто. Записани тук като 10, те биха дали основа
      „бруто × 0,9“ — правдоподобно число, което не е данъчната основа на нито една сделка.
      Печалбата по чл. 33 иска цена на придобиване, каквато платецът на дохода НЕ знае; тя се
      определя в ГДД на лицето. Това е обявена граница, не пропуск.

      ⚠️ И НЕ УЧАСТВА В КОЛОНА 11 НА СПРАВКАТА. Указание т. 8 към ал. 1, дословно: „в колона 11 се
      посочва брутният размер на дохода, т.е. без приспадане на признатите разходи и/или
      направените удръжки от платеца“. Разходите влизат само в данъка (колона 13) и в ГДД. -->
    <decimal name="expenseRate" title="Нормативни разходи (%)" precision="5" scale="2"
      default="0"/>

    <!-- Ставката на ОКОНЧАТЕЛНИЯ данък по глава шеста — само за шаблон C, по чл. 46:
      ал. 1 → 10 на сто за доходите по чл. 37 и по чл. 38 ал. 5, 8, 11, 12, 14 и 15;
      ал. 2 →  7 на сто за чл. 38 ал. 8 при застраховка „Живот“ с срок 15 или повече години;
      ал. 3 →  5 на сто за доходите по чл. 38 ал. 1 (дивиденти и ликвидационни дялове).
      ⚠️ Седемте на сто са ЕДИН-ЕДИНСТВЕН код — 8171 — и точно затова 817 и 8171 са два реда:
      двата са по чл. 38 ал. 8, но с различна ставка. -->
    <decimal name="finalTaxRate" title="Окончателен данък (%)" precision="5" scale="2"
      default="0"/>

    <!-- Ставката на АВАНСОВИЯ данък: чл. 43 ал. 4 (стопанска дейност по чл. 29), чл. 44 ал. 3
      (наем по чл. 31), чл. 44а ал. 1 (други източници по чл. 35) — и трите 10 на сто.
      ⚠️ За трудовите доходи това е чл. 42 ал. 4 и там ставката НЕ е една: „по данъчна ставка 10 на
      сто, а за доходите, придобити като морско лице — по данъчна ставка 1 на сто“. Оттам код 103
      носи 1,00, а 101 и 102 носят 10,00. -->
    <decimal name="advanceTaxRate" title="Авансов данък (%)" precision="5" scale="2" default="0"/>

    <!-- Удържа ли ПЛАТЕЦЪТ данъка при изплащане.

      ⚠️ ТОВА Е СТОЙНОСТТА ПО ПОДРАЗБИРАНЕ ЗА КОДА, НЕ ОТГОВОРЪТ ЗА КОНКРЕТНОТО ПЛАЩАНЕ. Чл. 43
      ал. 5 и ал. 6: авансовият данък по чл. 29 се удържа от платеца, ОСВЕН когато получателят е
      самоосигуряващо се лице и е декларирало това с писмена декларация — тогава данъкът се внася
      от самото лице. Същият код, две различни поведения, разграничени от лицето, не от кода.
      Затова решението за конкретно плащане живее на BgIndividualIncomePayment, а не тук.

      ⚠️ Шаблон D стои на false по цялата си дължина: доходите по чл. 33 не се облагат авансово от
      платеца изобщо — те влизат в общата годишна данъчна основа и се декларират от лицето. За
      платеца остава САМО редът в справката. -->
    <boolean name="withheldByPayer" title="Данъкът се удържа от платеца" default="false"/>

    <!-- Кодовете, които се подават като ЕДИН СБОРЕН РЕД за всички лица, без имена.

      Указание т. 5 към справката по ал. 1, ДОСЛОВНО: „Колони от 2 до 9, Част ІІ не се попълват за
      изплатени доходи с кодове 5031, 8141 и 820. Колона 14 „Брой лица“ се попълва само за доходи с
      кодове 5031 и 8141.“

      ⚠️ ТОЕСТ ТРИТЕ КОДА НЕ СА ЕДНАКВИ И ФЛАГЪТ НЕ КАЗВА ВСИЧКО. И трите пропускат колони 2–9
      (идентификацията), но „Брой лица“ се пълни само за ДВА от тях — 820 се подава като сборна
      сума БЕЗ брой лица. Разликата е на попълването на образеца (виж reportsPersonCount); тук флагът
      носи само общото: „ред без имена“. Разчитане на този флаг за колона 14 би сложило брой лица
      на ред, който не го иска. -->
    <boolean name="isAggregate" title="Сборен ред (без имена)" default="false"/>

    <!-- Пълни ли се колона 14 „Брой лица“ за този код.

      Указание т. 5 към справката по ал. 1, ДОСЛОВНО: „Колони от 2 до 9, Част ІІ не се попълват за
      изплатени доходи с кодове 5031, 8141 и 820. Колона 14 „Брой лица“ се попълва САМО за доходи с
      кодове 5031 и 8141.“

      ⚠️ ВТОРИ ФЛАГ, А НЕ ВТОРО ЧЕТЕНЕ НА isAggregate.
      Трите сборни кода пропускат колони 2–9 еднакво, но 820 се подава БЕЗ брой лица. Изведена от
      isAggregate, колона 14 би получила число и на реда по чл. 38 ал. 12 — попълнена колона, която
      образецът не иска. Изведена от списък „5031, 8141“ в Java, тя би мълчала при следващия
      образец: НАП сменя номенклатурата със заповед всяка година, а списък в код не се сверява от
      никого. Затова признакът е ДАННИ, на реда на кода, до неговата валидност.

      ⚠️ И ЗАТОВА НЕ Е ИЗВЕДЕН ОТ „сборен ред“: двата флага НЕ са едно и също твърдение. isAggregate
      казва „редът е без имена“; този казва „редът носи брой лица“. Първото важи за три кода,
      второто — за два. -->
    <boolean name="reportsPersonCount" title="Пълни колона 14 „Брой лица“" default="false"/>

    <!-- В КОЯ справка по чл. 73 влиза кодът: „73-1“ или „73-6“.

      ⚠️ Полето е ЕДНОЗНАЧНО за образците от 2025 г. — нито един код не се среща и в двете справки —
      и точно затова е избор, а не набор. Двете справки имат различни колони, различни срокове по
      подаване на корекция и различни правила за идентификатора (ал. 1 познава четири типа
      идентификатор, ал. 6 само два), тоест смесването им на един ред не е икономия, а грешка. -->
    <string name="declarations" title="Справка по чл. 73" required="true"
      selection="bg.income.type.declaration.select"/>

    <date name="validFrom" title="В сила от" required="true"/>
    <date name="validTo" title="В сила до"/>

    <unique-constraint columns="code,validFrom"/>

  </entity>

</domain-models>
