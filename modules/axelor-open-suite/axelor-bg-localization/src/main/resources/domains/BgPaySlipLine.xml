<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ЕДНО ПЕРО НА ФИША. ═══ ЗАМРАЗЯВАНЕ ЧРЕЗ КОПИРАНЕ ═══ Всичко, което редът взима от речника (BgPaySlipLineType),
    се КОПИРА при създаване: номер, име, знак и трите флага. Референцията остава САМО за проследимост — показването
    и смятането ползват копията. Оттам следва, че по-късна редакция на речника не пренаписва издадени фишове:
    ако утре „Нощен труд“ стане необлагаем, вчерашният фиш продължава да казва това, което е било вярно,
    когато е издаден. Това е същият принцип като при BgCompensation и не се нарушава за удобство: препратка
    към речника е един ред по-малко код и една тиха ретроактивна промяна повече. ═══ ЗНАКЪТ Е НА ПЕРОТО,
    НЕ НА СУМАТА ═══ bgAmount е ВИНАГИ положително число. Дали се прибавя или се удържа казва bgSign. Отрицателна
    сума с положителен знак и обратното дават един и същ резултат при събиране, но различен при четене —
    а фишът се чете от човек. -->
  <entity name="BgPaySlipLine">

    <many-to-one name="paySlip" title="Фиш" required="true"
      ref="com.axelor.apps.bglocalization.db.BgPaySlip"/>

    <!-- Само за проследимост: „от кой ред на речника дойде това перо“. НЕ се чете при смятане. -->
    <many-to-one name="bgPaySlipLineType" title="Вид перо"
      ref="com.axelor.apps.bglocalization.db.BgPaySlipLineType"/>

    <!-- ⚠️ КОПИЕ от BgPaySlipLineType.number. Полето там се казва number, а колоната е line_number,
      защото number е запазена дума за генератора на Axelor („Invalid use of an SQL keyword“). Тук името е
      bgLineNumber и проблемът не се повтаря — но всяка ръчна заявка към ДРУГАТА таблица пише line_number. -->
    <integer name="bgLineNumber" title="Номер" required="true"/>
    <string name="name" title="Наименование" required="true" namecolumn="true"/>
    <string name="bgSign" title="Посока" selection="bg.payslip.line.sign.select"
      required="true"/>

    <boolean name="bgIsTaxable" title="Облагаемо" default="true"/>
    <boolean name="bgIsInsuranceIncome" title="Осигурителен доход" default="true"/>
    <boolean name="bgIsPermanentCharacter" title="Постоянен характер (НСОРЗ чл. 15)"
      default="false"/>

    <!-- КОПИЕ от BgPaySlipLineType.bgIsArt17Base — базата, от която се смята среднодневното по КТ
      чл. 177. Замразен по същия довод като съседите: среднодневното се чете от БАЗОВИЯ месец, тоест
      от пера, създадени преди седмици. Прочетен през речника ДНЕС, един отметнат тази сутрин флаг
      би пренаписал базата на вече изплатен отпуск.

      ⚠️ ЧЕТЕ СЕ В ДИЗЮНКЦИЯ С bgIsPermanentCharacter, И ТОВА Е МИГРАЦИЯТА, А НЕ ВТОРО ПРАВИЛО.
      Всеки ред, създаден преди тази колона, я носи празна. Прочетена строго, базата по чл. 17 на
      ВСЕКИ исторически базов месец би станала НУЛА — тоест среднодневно нула и отпуск, платен по
      пода от МРЗ. Дизюнкцията запазва поведението на заварените редове (постоянните влизат,
      престоят не) и запазва историята непокътната: базов месец, смятан без престой, пази числото
      си. Нула backfill, нула пренаписана история. Виж BgArt177LeaveService#art17BaseOf. -->
    <boolean name="bgIsArt17Base" title="В базата за платен отпуск (НСОРЗ чл. 17 ал. 1)"
      default="false"/>

    <!-- КОПИЕ от BgPaySlipLineType.bgFormsGrossWage, по същия довод като останалите флагове тук:
      перото носи какъвто е бил речникът ПРИ СЪЗДАВАНЕТО МУ, а коригираща Д1 за минал период трябва
      да види точно него.

      ⚠️ ТРИ ФЛАГА, ТРИ НОРМИ. bgIsPermanentCharacter НЕ служи на чл. 17: чл. 15 определя
      постоянния характер, а чл. 17 ал. 1 го иска само в т. 3 от седем. Разликата не е академична:
      точно тя държи престоя (т. 6) извън среднодневното.
        • bgIsPermanentCharacter → НСОРЗ чл. 15 → часовата ставка по чл. 7 (нощен, извънреден)
        • bgIsArt17Base         → НСОРЗ чл. 17 ал. 1 → среднодневното по КТ чл. 177 и чл. 228
        • bgFormsGrossWage      → НСОРЗ чл. 16 ал. 2 → т. 29 на Декларация обр. 1 -->
    <boolean name="bgFormsGrossWage" title="Формира БРЗ (НСОРЗ чл. 16 ал. 2)" default="false"/>

    <!-- Количество и ставка са ДОКУМЕНТАЦИЯ на сумата, не неин източник: сумата се пази отделно,
      защото при ръчно въведено перо няма количество, а при изчислено закръглянето вече е станало. -->
    <decimal name="bgQuantity" title="Количество" precision="15" scale="4"/>
    <decimal name="bgRate" title="Ставка" precision="15" scale="4"/>
    <decimal name="bgAmount" title="Сума" precision="20" scale="2" required="true"/>

    <!-- ═══ ВЪВЕДЕНАТА МЕСЕЧНА СУМА — ИЗТОЧНИКЪТ НА РЪЧНОТО ПОСТОЯННО ПЕРО ═══

      За перата с постоянен характер, които операторът въвежда сам (днес: постоянен бонус 180 и
      постоянна премия 181), и за еднократните помощи „в рамките на тавана“ (220/222/224 — там е ЦЯЛАТА
      помощ, а bgAmount е освободената част; превишението е в генерираното 221/223/225, виж
      BgSocialExpenseService#splitPersonalExcess). За всички останали остава ПРАЗНО и нищо не го чете.

      ⚠️ ЗАЩО ВТОРО ПОЛЕ, А НЕ НАМАЛЯВАНЕ НА bgAmount НА МЯСТО. Намалено на място, перото щеше да се
      намали ПАК при второто prepare() — пълната месечна сума е невъзстановима от вече карвирания
      ред. Без второ поле ръчните пера изобщо НЕ биха падали при отпуск и биха надплащали
      сума × дни / норма (при 100,00 €, норма 22 и 5 дни неплатен: 22,73 €).

      ⚠️ И ВТОРИЯТ ЧИТАТЕЛ Е ПО-СКЪПИЯТ ОТ ДВАТА. Същото число храни БАЗАТА ПО НСОРЗ ЧЛ. 7 —
      часовата ставка на нощния и извънредния труд (BgEarningsService#permanentAllowances →
      BgEarningsResolver#permanentPayBase). Тя е УГОВОРЕНОТО МЕСЕЧНО възнаграждение и НЕ се
      пропорционира от отсъствия: прочетена от карвирания ред, ставката щеше да падне и извънредният
      труд да поевтинее точно в месеците с отпуск — тихо, с вид на пресметнато.

      ⚠️ NULLABLE НАРОЧНО, И ПРАЗНОТО НЕ Е НУЛА. Празно значи „още не е уловено“ и prepare() го
      улавя от bgAmount при първото минаване. Оттам следва и миграцията: заварените редове са
      НЕкарвирани, тоест техният bgAmount Е въведената сума и fallback-ът ги чете точно — нула
      backfill. Нула тук, обратно, би карвирала перото до 0,00 при първия отпуск. -->
    <decimal name="bgEnteredAmount" title="Въведена сума" precision="20" scale="2"
      help="Пълната сума на перото, както е уговорена или изплатена. Постоянно перо: сумата на реда е въведена сума × (норма − дни отпуск) / норма. Еднократна помощ: сумата на реда е частта до остатъка от тавана, превишението е отделно перо. Редактира се ТОВА поле, а не „Сума“ — сумата е резултат и се пренаписва при всяко преизчисляване."/>

    <!-- Двете препратки за автоматично попълнените групи. Празни при ръчно перо. -->
    <many-to-one name="bgContributionFund" title="Осигурителен фонд"
      ref="com.axelor.apps.bglocalization.db.BgContributionFund"/>

    <!-- ═══ БАЗА-ДИСКРИМИНАТОРЪТ НА ЗДРАВНАТА ВНОСКА ═══

      ЕДИН ФОНД, ТРИ БАЗИ, ТРИ ТОЧКИ В Д1. Здравното осигуряване е ЕДИН фонд (НЗОК) и има ЕДИН ред в
      речника с фондовете, но декларацията иска вноските му на ТРИ РАЗЛИЧНИ точки според това ВЪРХУ
      КАКВО се дължат:

      • празно / STANDARD → нормалният осигурителен доход (т. 21) → вноската отива в т. 22.1;
      • ART40_1_5 → осигурителният доход по ЗЗО чл. 40 ал. 1 т. 5: времето във временна
        неработоспособност, бременност и раждане, отпуск за отглеждане на дете по чл. 164 ал. 1 и 3,
        чл. 164в КТ и осиновяване до 5 г. по чл. 164б ал. 1 и 4 → базата пълни т. 17, ставката т. 18;
      • HEALTH_ONLY → доходът, върху който се дължат вноски САМО за здравно: неплатен отпуск,
        отглеждане на дете по чл. 167а КТ и др. (ЗЗО чл. 40 ал. 1 т. 1 б. „б“) → базата пълни т. 27,
        ставката т. 28.

      ⚠️ ЗАЩО ДИСКРИМИНАТОР НА ПЕРОТО, А НЕ НОВИ ФОНДОВЕ. Нов ред в
      bg_contribution_fund би значел нов фонд — а фонд се създава и се закрива СЪС ЗАКОН, и НЗОК е
      един. Освен това групата 5xx е ОГЛЕДАЛНА на речника с фондовете: по един тип перо за всеки фонд
      и за всеки платец, точно 20, и BgPaySlipLineTypeCatalogueTest пази съответствието едно към
      едно. Двайсет и първи „фонд“ би скъсал точно този инвариант, за да опише нещо, което не е фонд,
      а БАЗА.

      ⚠️ И ЗАЩО ВПИСВАНЕТО В ЕДНО ПЕРО НЕ РАБОТИ. Три вноски
      върху различни бази, слепени в перо 516, дават ЕДНО число, което не може да се провери от фиша:
      5,27 върху 109,87 и 24,13 върху 502,78 стават 29,40 върху нищо. При това количеството и
      ставката на перото вече ДОКУМЕНТИРАТ първата база, тоест второто число няма как да се обясни.
      С дискриминатора трите пера съществуват ЕДНОВРЕМЕННО, всяко със своята база в bgQuantity и
      своята ставка в bgRate — и всяко се сверява само.

      ⚠️ ПРАЗНОТО СЕ ЧЕТЕ КАТО STANDARD, и това е нарочно: всичките заварени пера са с нормална база,
      а миграция, която ги допише, би пипнала живи фишове за нищо. Тоест НЯМА default в схемата —
      прочитът е в кода, на едно място (BgD1ContributionAggregator#healthBaseOf).

      ⚠️ И ЕДНО, КОЕТО ДИСКРИМИНАТОРЪТ НЕ ПРАВИ: не мени ФОНДА. Перото пак сочи HEALTH, пак влиза в
      разхода за работодателя и в нетото по същия начин, и пак се агрегира в ЕДНО число за Д6 (т. 14
      слива трите). Той мени САМО точката в Д1 — и точно това е потвърждението, че е база, не фонд. -->
    <string name="bgHealthBaseKind" title="База на здравната вноска"
      selection="bg.health.base.kind.select"
      help="Празно значи нормален осигурителен доход (т. 22.1). ART40_1_5 → т. 17/18. HEALTH_ONLY → т. 27/28."/>
    <many-to-one name="bgCompensation" title="Обезщетение (документ)"
      ref="com.axelor.apps.bglocalization.db.BgCompensation"/>

    <!-- ═══ МАРКЕРЪТ НА РЕТРО-КОРЕКЦИЯТА ═══ ПРАЗНО значи „перото е за собствения период на фиша“ —
      тоест всеки обикновен ред. ПОПЪЛНЕНО значи „това перо носи нетната разлика за ДРУГ, вече затворен период“:
      доплащането или удръжката от коригиращ или заличаващ фиш, което лицето получава с текущата заплата. ⚠️
      ОТ ТОЗИ МАРКЕР ЗАВИСИ КОЕ ЧИСЛО В КОЯ ДЕКЛАРАЦИЯ ВЛИЗА, и точно затова той е ПОЛЕ, а не извод. Агрегатите
      за Д1/Д6 четат САМО редовете с празен маркер: осигурителният доход, вноските и данъкът за март са в КОРИГИРАЩИЯ
      мартенски фиш и оттам в коригиращата Д1/Д6 за март. Нетото, ведомостта и банковият файл, обратно, включват
      и маркираните редове — те са пари, които лицето получава в май. Тоест майските Д1/Д6 остават чисти, а
      майската рекапитулация СЕ ПРОМЕНЯ. ⚠️ Флаговете на перото не вършат тази работа сами. Типът „Доплащане/удръжка
      по корекция за минал период“ наистина е обявен извън осигурителния доход и извън данъчната основа, но
      флаг се сменя от формата, а маркерът казва ЗА КОЙ ПЕРИОД са парите — въпрос, на който флаг не отговаря.
      ⚠️ Периодът е СТАНДАРТНИЯТ Period, същият, който носи и фишът — не дата и не низ. Дата не казва кой период
      е затворен, а низ се разминава мълчаливо при преименуване. -->
    <many-to-one name="bgCorrectsPeriod" title="Коригира период"
      ref="com.axelor.apps.base.db.Period"/>

    <!-- ═══ „ТОВА ПЕРО Е НА ГЕНЕРАТОРА“ — ПРИЗНАКЪТ, ПО КОЙТО ГЕНЕРАТОРЪТ ТРИЕ ═══

      Вдига се от двата генератора, които ТРИЯТ свои редове: вноските 5xx
      (BgContributionLineService) и данъкът 700 (BgIncomeTaxService). Те махат ред САМО ако той носи
      признака и това пресмятане вече не го произвежда — отпаднал фонд, законна нула. Ръчен ред със
      същия код НЕ носи признака и затова не се трие никога.

      ⚠️ ЗАЩО ПОЛЕ, А НЕ КОДЪТ ИЛИ ФОНДЪТ. Кодът не различава: операторът може да добави 517 на ръка.
      bgContributionFund е обявен за „празен при ръчно перо“, но нищо не го пази — REST и вносът го
      пишат свободно, а за 700 подобна следа изобщо няма.

      ⚠️ ЗАВАРЕНИТЕ РЕДОВЕ СА БЕЗ ПРИЗНАК. При ПЪРВОТО пресмятане на фиш без отпечатък
      (BgPaySlip.bgCalcFingerprint е празен) генераторът осиновява заварения ред със своя код — инак
      всяка заварена чернова би получила втори комплект вноски. След
      това осиновяване няма: ръчният ред остава ръчен.

      ⚠️ Останалите генератори (начисления, болничен, обезщетения, чл. 177, чл. 49) намират своите
      редове по код и не пишат признака — те не трият по отпаднало право извън
      собствените си кодове. -->
    <boolean name="bgIsGenerated" title="Създадено от генератор (5xx/700)" default="false"/>

    <string name="note" title="Забележка" large="true"/>

  </entity>

</domain-models>
