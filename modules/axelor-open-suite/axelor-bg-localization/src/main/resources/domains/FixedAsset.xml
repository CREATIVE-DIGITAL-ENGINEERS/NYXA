<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="account" package="com.axelor.apps.account.db"/>

  <!-- Български полета към стандартния FixedAsset. Огледални на тези в категорията (виж
    domains/FixedAssetCategory.xml) — данъчният план се строи от стойността НА АКТИВА, а тя се
    пренася от категорията при завеждане (BgFixedAssetGenerationServiceImpl.copyInfos).

    ЗАЩО ОГЛЕДАЛНО, А НЕ ЧЕТЕНЕ ПРЕЗ КАТЕГОРИЯТА. Две причини, и двете са реални случаи.
    Първата: категория VI НЯМА една норма — тя е 100/срока на правото, тоест различна за всеки
    лицензен договор. Норма на категорията там не съществува и стойността може да живее само на
    актива. Категорията е дефинирана в чл. 55 АЛ. 1 Т. 6 („данъчни дълготрайни материални и
    нематериални активи, за които има ограничен срок на ползване съгласно договорни отношения или
    законово задължение“), а самата норма е в таблицата на АЛ. 2 — „100/години на правното
    ограничение. Годишната норма не може да превишава 33 1/3“.
    ⚠️ НЕ „чл. 55 ал. 6“. Ал. 6 е за съвсем друго: тя изключва прилагането на
    т. 1 на ал. 3 при инвестиции за повишаване на енергийната ефективност с доброволни споразумения
    по отменения Закон за енергийната ефективност (нова — ДВ, бр. 106 от 2008 г., в сила от
    01.01.2009 г., изм. — ДВ, бр. 35 от 2015 г.). Сверено дословно на 10.09.2026 г.
    Втората: нормата е ТАВАН, не задължение — предприятието може да избере по-нискa (чл. 55 ал. 2
    казва „не може да превишава“). Изборът е за конкретния актив и не бива да мести заварените.
    Същият довод, по който базовият модел държи целия fiscal* набор на актива, а не на категорията. -->
  <entity name="FixedAsset">

    <!-- Source identity/evidence on the standard asset; no parallel Microinvest asset table. -->
    <string name="bgMicroinvestInventoryNumber" title="Microinvest инвентарен №" readonly="true"/>
    <string name="bgMicroinvestSourceCurrencyCode" title="Microinvest счетоводна валута"
      readonly="true"/>
    <string name="bgMicroinvestSourceHash" title="Microinvest source hash" readonly="true"/>
    <string name="bgMicroinvestLocation" title="Microinvest местонахождение" readonly="true"/>
    <string name="bgMicroinvestTerminationStatus" title="Microinvest статус на отписване"
      readonly="true"/>
    <integer name="bgMicroinvestTerminationAccountingId"
      title="Microinvest termination AccountingID" readonly="true"/>
    <string name="bgMicroinvestDebitAccountNumber" title="Microinvest дебитна сметка"
      readonly="true"/>
    <string name="bgMicroinvestCreditAccountNumber" title="Microinvest кредитна сметка"
      readonly="true"/>
    <string name="bgMicroinvestInventoryAccountNumber" title="Microinvest инвентарна сметка"
      readonly="true"/>
    <many-to-one name="bgBookCurrency" ref="com.axelor.apps.base.db.Currency"
      title="Счетоводна валута при импорт" readonly="true"/>
    <string name="bgMicroinvestSourceJson" title="Microinvest source JSON" large="true"
      multiline="true" readonly="true"/>

    <!-- Категория по чл. 55 ал. 1 ЗКПО (I–VII) — групираща ос за ДАП и ГДД. -->
    <string name="bgTaxCategorySelect" title="Категория по чл. 55 ЗКПО"
      selection="bg.tax.depreciation.category.select"/>

    <!-- Годишна данъчна амортизационна норма (ГДАН) в проценти. Празно (0) значи, че активът не е
      данъчен амортизируем актив (чл. 50) и данъчен план не се строи. -->
    <decimal name="bgTaxDepreciationRate" title="Данъчна норма ГДАН (% годишно)" precision="5"
      scale="2"/>

    <!-- Начало на данъчното амортизиране по чл. 58 ал. 1 ЗКПО: „от началото на месеца, в който
      данъчният амортизируем актив е въведен в експлоатация, ИЛИ от началото на следващия месец“.
      Изборът е на предприятието и е ЗА КОНКРЕТНИЯ АКТИВ, не за категорията.

      ⚠️ DEFAULT-ЪТ Е SERVICE_MONTH, ЗАЩОТО ТОЙ ИЗРАВНЯВА ДВАТА ПЛАНА. Базовият икономически план
      тръгва от края на месеца НА въвеждането (FixedAssetDateServiceImpl.computeEconomicFirstDepreciationDate),
      тъй че със SERVICE_MONTH данъчният и счетоводният тръгват в един и същ месец — нула временни
      разлики, както иска решението за блока. NEXT_MONTH е втората възможност по чл. 58 ал. 1 и
      забавя САМО данъчния план с един месец, тоест съзнателно създава временна разлика по чл. 54 в
      първата година. СС 4 т. 6.1 пък иска СЧЕТОВОДНОТО начисляване от следващия месец — това е
      полето на СЧЕТОВОДНИЯ план и не се пипа оттук; сближаването му със СС 4 е отделна задача,
      заедно със самите разлики.

      ⚠️ Генерираният getter на String връща null за незададено — за заварените активи (създадени
      преди това поле) BgFixedAssetLineTaxComputationServiceImpl чете null като SERVICE_MONTH,
      което е и стойността по подразбиране за нови. -->
    <string name="bgTaxStartSelect" title="Начало на данъчната амортизация (чл. 58 ал. 1)"
      selection="bg.tax.depreciation.start.select" default="SERVICE_MONTH"/>

    <!-- ═══ Праг по чл. 50 / чл. 51 ЗКПО ═══════════════════════════════════════════════════

      Активът НЕ е данъчен амортизируем актив, тъй че данъчен план не се строи. Чл. 50 ал. 1:
      данъчни ДМА са сумите, „чиято стойност е равна или превишава ПО-НИСКАТА стойност от" прага на
      същественост по счетоводната политика и законовата сума.

      ⚠️ ГЕЙТЪТ Е САМО ДАНЪЧЕН. Счетоводното третиране си остава по политиката на клиента — актив под
      данъчния праг може напълно законно да е капитализиран счетоводно и да се амортизира. Затова
      маркерът сваля само FISCAL от depreciationPlanSelect и не пипа икономическия план. Смесването
      на двата прага е грешката, която този коментар пази.

      ⚠️ И НЕ ВСИЧКО МИНАВА ПРЕЗ ПРАГ. Чл. 50 ал. 2 (активи с право на ползване по финансов лизинг
      съгласно МСС) няма препратка към праг, а чл. 51 ал. 1 т. 3 (суми, увеличаващи икономическата
      изгода от наети активи) — също, и там законът изрично добавя „тези суми не формират данъчен
      дълготраен материален актив". Тоест маркерът се вдига от стойността, а тези два случая имат
      своя ос, която тук не се моделира. -->
    <boolean name="bgIsBelowTaxThreshold" title="Под прага — извън ДАП (чл. 50/51)"/>

    <!-- Кой праг е приложен при завеждането — по-ниският от двата. Пази се, защото и двата източника
      се менят: политиката на дружеството и законовата сума в конфига. Без записаната стойност
      по-късен въпрос „защо този актив е извън ДАП" няма отговор от данните. -->
    <decimal name="bgTaxThresholdApplied" title="Приложен праг (EUR)" precision="15" scale="2"/>

    <!-- ═══ Данъчна амортизируема стойност (ДАС) — чл. 53 ал. 1, изменяна по чл. 63 ═══

      ⚠️ ПРАЗНО ЗНАЧИ „КАКТО КАЗВА ОТЧЕТНАТА“, а не нула. Без последващи разходи ДАС и отчетната стойност
      съвпадат (чл. 53 ал. 1: историческа цена, намалена с провизии и дарения, БЕЗ приспадане на
      остатъчна стойност), тъй че данъчният план чете grossValue. Чл. 63 ги разделя:
      „Данъчната амортизируема стойност на актив, наличен в данъчния амортизационен план, се
      увеличава с последващите разходи…“ — а счетоводната капитализация по политиката на клиента
      може да е ДРУГА сума. Оттам се раждат временните разлики по чл. 54, които справката за
      временните разлики чете.

      Празната стойност пази заварените активи непроменени: BgSubsequentCostRules.amortizableValue
      пада обратно на grossValue, тъй че нито един съществуващ план не се мести от това поле. -->
    <decimal name="bgTaxAmortizableValue" title="Данъчна амортизируема стойност — ДАС (EUR)"
      precision="20" scale="3"/>

    <!-- ═══ Спиране по чл. 59 ЗКПО ═════════════════════════════════════════════════════════

      ⚠️ ТРИГЕРЪТ НЕ Е „СПРЯН", А „СПРЯН ЗА ПОВЕЧЕ ОТ 12 МЕСЕЦА". Чл. 59 ал. 1, дословно:
      „Начисляването на данъчни амортизации се преустановява, когато съответният актив временно не се
      използва (не носи икономическа изгода) през период, ПО-ДЪЛЪГ ОТ ДВАНАДЕСЕТ МЕСЕЦА.
      Начисляването се преустановява от началото на месеца, СЛЕДВАЩ месеца, през който е изтекъл
      срокът по изречение първо, и се възобновява от началото на месеца на връщането на актива в
      експлоатация. Данъчният амортизируем актив НЕ СЕ ОТПИСВА от данъчния амортизационен план."

      Тоест консервация за три месеца не спира нищо и датата тук е само начало на отчитането на
      срока. Активът остава на баланс и в ДАП — това не е отписване и няма статия с Кт 20x. -->
    <date name="bgIdleSince" title="Не се използва от (чл. 59 ал. 1)"/>

    <!-- Изчислено: началото на месеца СЛЕД месеца, в който изтичат дванадесетте месеца. Празно,
      докато срокът не е изтекъл — тогава спиране още не се дължи. -->
    <date name="bgTaxSuspensionFrom" title="Данъчната амортизация спира от"/>

    <date name="bgReturnedToServiceOn" title="Върнат в експлоатация на"/>

    <!-- Заповедта за консервация — основанието, което прави датите проверими. -->
    <string name="bgSuspensionOrderNumber" title="Заповед №"/>

    <date name="bgSuspensionOrderDate" title="Дата на заповедта"/>

    <!-- ⚠️ ЧЛ. 59 АЛ. 2 НЕ Е ПАУЗА, А ВРЪЩАНЕ НАЗАД, и това е причината полето да съществува.
      Дословно: „При определянето на данъчния финансов резултат за годината, през която е изтекъл
      дванадесетмесечният срок по ал. 1, годишната данъчна амортизация на данъчно задълженото лице
      СЕ НАМАЛЯВА с размера на начислената данъчна амортизация за актива през дванадесетте месеца,
      през които активът не се е използвал. С размера на намалението по изречение първо СЕ
      КОРИГИРАТ стойностите на данъчния амортизируем актив към датата на преустановяване
      начисляването на данъчна амортизация, както следва: 1. намалява се начислената данъчна
      амортизация за актива; 2. увеличава се данъчната стойност на актива."

      Тоест ДБС се УВЕЛИЧАВА — стойностите не се запазват. (Запазването е чл. 61 ал. 1 — предишен текст на
      чл. 61, ДВ бр. 98 от 2018 г., в сила от 01.01.2019 г. — и важи при
      преоценка, обезценка, промяна в счетоводната политика и ДДС регистрация — друга ситуация.)

      ⚠️ ЧИСЛОТО СЕ ИЗЧИСЛЯВА И СЕ ПОКАЗВА, НО РЕДОВЕ НА ДАП НЕ СЕ ПРЕПИСВАТ САМИ. Спирането се
      задейства на тринайсетия месец, тъй че дванадесетте обърнати месеца почти винаги пресичат
      вече подадена ГДД — това е корекция за МИНАЛ ПЕРИОД и е решение на съставителя, не тих
      пренапис на декларирана история. Когато годината още е отворена, същото число влиза направо в
      текущото изчисление. И в двата случая полето се чете от справката за ГДД — там е
      мястото, където пропускът би станал занижен данък. -->
    <decimal name="bgArt59Al2Reversal" title="Обръщане по чл. 59 ал. 2 (EUR)" precision="20"
      scale="3"/>

    <integer name="bgArt59Al2Year" title="Година на обръщането"/>

    <!-- ГЕЙТ ЗА ЧЕТЕНЕ, а не за годината. Справката за данъчни временни разлики чете
      обръщането по чл. 59 ал. 2 само когато съставителят го е потвърдил — то нарочно се
      изчислява, без да пренаписва редове на ДАП.

      ⚠️ ФЛАГЪТ НЕ МЕСТИ ГОДИНАТА. Ал. 2 казва дословно „при определянето на данъчния финансов
      резултат ЗА ГОДИНАТА, ПРЕЗ КОЯТО Е ИЗТЕКЪЛ дванадесетмесечният срок по ал. 1“ — тоест годината
      е закована от закона и е bgArt59Al2Year, независимо кога е дошло потвърждението. Потвърждаване
      след подадена за тази година ГДД значи КОРИГИРАЩА декларация за нея, а не ред в текущата.
      Флаг, който мести сумата в годината на потвърждаване, би я сложил в година, в която законът не
      я слага.

      ⚠️ И НЕПОТВЪРДЕНОТО НЕ СЕ ПРОПУСКА МЪЛЧАЛИВО. Справката показва видим ред „чака потвърждение
      за <година>“: забравено потвърждение е пропусната ЗАДЪЛЖИТЕЛНА корекция, тоест скрит данъчен
      пасив — същата асиметрия, по която ДДС гардрейлът отказва да свали корекция без доказателство.
      Тихото пропускане прави дупката невидима. -->
    <boolean name="bgIsArt59Al2Confirmed" title="Обръщането по чл. 59 ал. 2 е потвърдено"/>

    <date name="bgArt59Al2ConfirmedOn" title="Потвърдено на"/>

    <!-- ═══ Чл. 60 ал. 3 т. 2 ЗКПО ═════════════════════════════════════════════════════════

      Дословно: „(3) Алинея 2 не се прилага при отписване на активи: … 2. в резултат на УВЕЛИЧЕНИЕ
      В СТОЙНОСТНИЯ ПРАГ НА СЪЩЕСТВЕНОСТ." Тоест тригерът е ВДИГАНЕ НА ПРАГА, а не „актив под
      прага" — това са различни събития: новопридобит актив под прага изобщо не влиза в ДАП по
      чл. 50/51, докато тук говорим за актив, който ВЕЧЕ Е В ДАП и се разписва счетоводно, защото
      дружеството е повишило прага си.

      Връзката към събитието е основанието: чл. 60 ал. 4 — „Активите по ал. 3 се отписват от
      данъчния амортизационен план по реда на ал. 1", тоест при пълно ДАНЪЧНО амортизиране, а
      дотогава амортизацията ТЕЧЕ. Виж и чл. 59 ал. 4: за активите по чл. 60 ал. 3 начисляването
      изобщо не се преустановява. -->
    <many-to-one name="bgMaterialityIncrease" title="Вдигане на прага (чл. 60 ал. 3 т. 2)"
      ref="com.axelor.apps.bglocalization.db.BgAssetMaterialityIncrease"/>

    <!-- ═══ ДДС при ПРИДОБИВАНЕТО — входовете на чл. 79 ал. 3 ЗДДС ═════════════════════════

      ⚠️ ФАКТИТЕ ЖИВЕЯТ НА АКТИВА, А НЕ НА ОТПИСВАНЕТО, и това не е удобство. Те са известни в
      деня на завеждането и стават НЕДОСТЪПНИ точно когато потрябват: корекция по чл. 79 се смята
      години по-късно, при брак или продажба, когато покупната фактура отдавна е извън погледа на
      оператора. Записани при отписването, те щяха да се въвеждат по памет. Записани тук, същите
      полета обслужват и обратната посока по ал. 5 - 7, и (по-късно) годишните по чл. 79а/79б.

      ⚠️ ПОДРАЗБИРАНЕ ОТ ФАКТУРАТА, НО НЕ ЗАДЪЛЖИТЕЛНО ОТ НЕЯ. FixedAsset.invoiceLine го има само
      когато активът е породен от покупна фактура; ръчно заведеният актив и сградата, изградена от
      МНОГО фактури, нямат един ред, който да носи истината. Затова полетата са съхранени и
      редактируеми, а подразбирането е удобство — виж BgArt79Acquisition.applyInvoiceDefaults,
      извикан от BgFixedAssetManagementRepository.save(). Редактират се на панела „ДДС при
      придобиване" на актива (views/FixedAsset-bg.xml). -->

    <!-- Коя точка на ал. 3 — тоест 1/20 или 1/5. Вж. bg.vat.asset.kind.select защо не се извежда
      от bgTaxCategorySelect. -->
    <string name="bgVatAssetKindSelect" title="Класификация по чл. 79 ал. 3"
      selection="bg.vat.asset.kind.select"/>

    <!-- НДДС — „начисленият ДДС при производството, придобиването или вноса на стоката,
      включително при придобиването или изграждането на недвижим имот, или при получаване на
      услугата“ (чл. 79 ал. 3, определението под всяка точка).

      ⚠️ БРУТНИЯТ НАЧИСЛЕН ДАНЪК, НЕ „ПОЛЗВАНИЯТ ДАНЪЧЕН КРЕДИТ“. Ползваният кредит е мярката на
      ал. 1 и ал. 2 (за стоки, които НЕ са ДМА); при ал. 3 К₀ и ПрНИД₀ влизат отделно във
      формулата. Записан тук нетният кредит при частичен коефициент би занижил данъка с квадрата
      на коефициента — 0,60 става 0,36. -->
    <decimal name="bgVatChargedOnAcquisition" title="Начислен ДДС при придобиване — НДДС (EUR)"
      precision="20" scale="2"/>

    <!-- Годината, през която е УПРАЖНЕНО правото на данъчен кредит — началото на 20-/5-годишния
      срок и с това знаменателят на БГ.

      ⚠️ НЕ Е ГОДИНАТА НА ПРИДОБИВАНЕ. Чл. 72 ал. 1 дава правото да се упражни в периода на
      възникване или в един от следващите 12, тъй че фактура от декември 2026 може законно да е
      ползвана през 2027 — и тогава целият срок се мести с година. Датата на фактурата е само
      подразбиране. Чл. 80 ал. 1 т. 5 прави точния период съществен и по друга причина: ако
      документът изобщо не е попаднал в дневника за покупките в срока по чл. 72, корекция не се
      извършва. -->
    <integer name="bgVatCreditYear" title="Година на упражняване на данъчния кредит"/>

    <!-- Видът кредит при придобиването — буквата на точката (а/б/в). Подразбира се от
      InvoiceLine.bgVatCreditType, но НЕ съвпада с него: дневникът не различава пропорционалния по
      чл. 71а/71б от частичния, а формулата ги дели. -->
    <string name="bgVatAcquisitionCreditTypeSelect" title="Вид данъчен кредит при придобиване"
      selection="bg.vat.acquisition.credit.type.select"/>

    <!-- К₀ — „коефициентът по чл. 73 за годината, през която е упражнено право на данъчен кредит“.
      Подразбира се от BgVatCoefficient за bgVatCreditYear. Чл. 73 ал. 2 го иска „изчислен до
      втория знак след десетичната запетая“ — оттам scale="2", а не повече.

      ⚠️ Чл. 79в т. 3 и т. 5: при ИЗЦЯЛО приспаднат кредит и при чл. 70 този коефициент НЕ СЕ
      ВЗЕМА ПРЕДВИД. Калкулаторът го налага (К₀ = 1, съответно 0), тъй че стойност, оставена тук по
      невнимание, не може да свали данъка. -->
    <decimal name="bgVatCoefficientK0" title="К₀ — коеф. чл. 73 за годината на кредита"
      precision="5" scale="2"/>

    <!-- ПрНИД₀ — „пропорция на използването … за независима икономическа дейност спрямо общото …
      използване в годината, през която е упражнено право на данъчен кредит“. Само за буква „в“.
      Чл. 79в т. 8: „ПрНИД₀ не може да бъде 0 или 1“ — калкулаторът отказва тези две. -->
    <decimal name="bgVatProportionNid0" title="ПрНИД₀ — пропорция за НИД в годината на кредита"
      precision="5" scale="2"/>

    <!-- Годината на ФАКТИЧЕСКОТО използване — алтернативното начало на срока.

      ⚠️ САМО ЗА НЕДВИЖИМ ИМОТ (т. 1). Дословно там: „считано от началото на годината на упражняване
      правото на данъчен кредит, СЪОТВЕТНО от началото на годината на фактическото използване, в
      случай че имотът НЕ Е ИЗПОЛЗВАН ПОВЕЧЕ ОТ ЕДНА ГОДИНА след годината на упражняване правото на
      данъчен кредит“. Т. 2 и т. 3 нямат такова изречение, тъй че за движима вещ и за услуга полето
      не мести нищо и калкулаторът го пренебрегва. -->
    <integer name="bgVatFirstUseYear" title="Година на фактическо използване (само имот)"/>

    <!-- SAF-T: ВИДЪТ НА АКТИВА — какво е той за годишния SAF-T и за рамката.
      ДМА / НМА по подразбиране от сметката (21x → НМА, иначе ДМА; BgFixedAssetKinds.defaultFor).
      Инвестиционният имот по цена на придобиване влиза във файла като ДМА; по справедлива
      стойност, държаният за продажба (МСФО 5) и правото на ползване (МСФО 16) засега дават ГРЕШКА
      „не се поддържа“ (обезценка/преоценка/пълно МСФО — отделни задачи). Последните два вида са само
      за дружество с рамка МСФО (BgFixedAssetGuard). Колоната идва от
      db/migration/2026-10-23-fixed-asset-inventory-number.sql. -->
    <string name="bgAssetKindSelect" title="Вид на актива" selection="bg.fixed.asset.kind.select"/>

    <!-- SAF-T: ОТДЕЛЕН ОТ — оригиналът, от който split-ът е отделил този актив. Отделеният актив
      получава НОВ инвентарен номер (поведението на AOS); връзката към оригинала я пише само
      BgFixedAssetServiceImpl.updateValuesAfterSplit и не се сменя (BgFixedAssetGuard).
      associatedFixedAssetsSet на AOS не става за това: двупосочно M2M, редактируемо във формата.
      ⚠️ index="false": индексът с неявно име би го направил Hibernate при старт (DDL); FK-то идва
      от SQL файла и Hibernate 5.6 го разпознава по колоната. -->
    <many-to-one name="bgSplitFrom" title="Отделен от" ref="com.axelor.apps.account.db.FixedAsset"
      readonly="true" index="false"/>

    <!-- SAF-T: ИНВЕНТАРНИЯТ НОМЕР Е УНИКАЛЕН В ДРУЖЕСТВОТО (AssetID, MF.A.2). Тук — за да го има и
      на ЧИСТА база, където схемата идва от домейна, а файловете от db/migration не се пускат. На заварена база го слага db/migration/2026-10-23-fixed-asset-inventory-number.sql със
      същото име, което Hibernate изчислява (uk_a53q3sjcj39twi5ixjpsj1ge4), затова ddl=update не прави
      втори. Празният номер е NULL — PostgreSQL не сравнява NULL-ите, тоест активите без номер не си
      пречат; празен низ BgFixedAssetListener записва като NULL. -->
    <unique-constraint columns="company,fixedAssetSeq"/>

  </entity>

</domain-models>
