<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ГОДИШНАТА КОРЕКЦИЯ ПО ЧЛ. 79а/79б ЗДДС — шапката за ЕДНА ГОДИНА ═══

    Дословно чл. 79а ал. 4 (и дума по дума същото в чл. 79б ал. 4): „Корекцията по ал. 3 се
    извършва в ПОСЛЕДНИЯ ДАНЪЧЕН ПЕРИОД на календарната година, през която са настъпили съответните
    обстоятелства, чрез съставяне на протокол за извършената корекция и отразяване на изменението в
    размера на ползвания данъчен кредит по този протокол в ДНЕВНИКА ЗА ПОКУПКИ и справка-декларацията
    за този данъчен период, както следва: 1. със знак (+), когато е в посока увеличение на размера на
    ползвания данъчен кредит; 2. със знак (-), когато е в посока намаление.“

    ⚠️ ГОДИНАТА Е КЛЮЧЪТ, НЕ ПЕРИОДЪТ. Обстоятелството по ал. 1 е „изменение в използването“ през
    ЦЯЛАТА календарна година, а периодът е само мястото, където протоколът се отразява. Ключувана по
    период, шапката би позволила две корекции за една година (декември и корекционна декларация към
    него) и нищо в схемата нямаше да казва коя от двете е дължимата.

    ⚠️ ЗАТОВА unique-constraint Е (company, year) — ТОЙ Е ИДЕМПОТЕНТНОСТТА. Повторното „Предложи“ за
    същата година намира съществуващата шапка и я презарежда, вместо да роди втора. Двойна шапка
    значи двойно начислен или двойно приспаднат данък, а дневникът не показва, че двата протокола са
    за едно и също.

    ⚠️ ЗАЩО СЪВЕТНИК, А НЕ ДЖОБ. Ал. 4 иска последния данъчен период на годината, но КОЙ период го
    носи е решение на съставителя: при дерегистрация ППЗДДС чл. 66 ал. 10 го мести, а затворен
    период изобщо не приема статия. Освен това Кх и отметката по ал. 6 са преценки. Системата
    ПРЕДЛАГА, счетоводителят потвърждава — същият довод, по който протоколът по чл. 79 ал. 4 е
    отделно действие, а не част от отписването.

    NOTE: importId is inherited from com.axelor.db.Model — do NOT declare it. -->
  <entity name="BgVatAnnualCorrection">

    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <!-- Календарната година, ПРЕЗ КОЯТО е настъпило изменението в използването (ал. 1). -->
    <integer name="year" title="Година на изменението" required="true"/>

    <string name="statusSelect" title="Състояние"
      selection="bg.vat.annual.correction.status.select" default="DRAFT"/>

    <!-- Последният данъчен период на годината — мястото, където протоколите се отразяват (ал. 4).

      ⚠️ Не се извежда от годината. ППЗДДС чл. 66 ал. 10: „Когато датата на дерегистрация … не
      съвпада с последния данъчен период на календарната година, се приема, че за целите на чл. 79а,
      ал. 7 и чл. 79б, ал. 6 … последният данъчен период на календарната година е данъчният период,
      за който възникват задълженията по чл. 111 …“ Тоест декември не е универсалният отговор. -->
    <many-to-one name="vatReturn" ref="com.axelor.apps.bglocalization.db.BgVatReturn"
      title="Данъчен период (чл. 79а ал. 4)"/>

    <one-to-many name="bgVatAnnualCorrectionLineList"
      ref="com.axelor.apps.bglocalization.db.BgVatAnnualCorrectionLine" mappedBy="annualCorrection"
      title="Редове по актив"/>

    <!-- Границите на изведеното — кои активи са прегледани, кои са отказани и по какво основание.
      Обявената граница е разликата между „няма корекции“ и „не е погледнато“. -->
    <string name="bgBoundaryReport" title="Граници на изведеното" large="true" multiline="true"/>

    <string name="comments" title="Забележки" large="true" multiline="true"/>

    <unique-constraint columns="company,year"/>

  </entity>

</domain-models>
