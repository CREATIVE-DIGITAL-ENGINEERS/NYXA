<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ СПРАВКАТА ПО ЧЛ. 73 АЛ. 1 ЗДДФЛ (образец 5-2001) — заглавната част (Част І) ═══

    Подава се от ПРЕДПРИЯТИЯ и от САМООСИГУРЯВАЩИ СЕ ЛИЦА — платци на доходи на физически лица през
    данъчната година. Указание т. 1, дословно: „Предоставя се само по електронен път във формат и по
    ред, одобрени със заповед на изпълнителния директор на НАП.“

    СРОК: до 28 февруари на следващата година. При открита грешка в данните за конкретно физическо
    лице СЛЕД този срок подателят има право да ги променя до 30 СЕПТЕМВРИ на годината, през която е
    предоставена информацията (указание т. 2). Двата срока са различни по естество — първият е за
    подаването, вторият за корекцията — и затова не се сливат в едно поле.

    ⚠️ ОТДЕЛНА ЗАГЛАВНА ЧАСТ ОТ ТАЗИ НА АЛ. 6, ВЪПРЕКИ ЧЕ ДВЕТЕ СЕ КАЗВАТ „СПРАВКА ПО ЧЛ. 73“.
    Част І тук иска ТЕЛЕФОН и E-MAIL за контакт (т. 3.1 и 3.2), каквито образецът на ал. 6 не
    познава; а редовете ѝ са за ЛИЦА (Partner), не за служители (Employee). Слети в един ентитет,
    двете справки биха споделили колони, които едната винаги оставя празни — и празното пак би било
    неразличимо от „няма данни“.

    ⚠️ И ЕДИН ПЛАТЕЦ, ЕДНА ГОДИНА, ЕДНА СПРАВКА — оттам уникалността. Коригиращите и заличаващите
    редове НЕ са втора справка: те са редове с код корекция „1“ и „8“ ВЪТРЕ в същата (указание
    т. 2). -->
  <entity name="BgArt73Para1Report">

    <!-- ПЛАТЕЦЪТ. Справката описва доходите, изплатени ОТ него — не тези, придобити от него. -->
    <many-to-one name="company" title="Дружество (платец)" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- ДАНЪЧНАТА година, за която се подава — не годината на подаване. -->
    <integer name="taxYear" title="Данъчна година" required="true"/>

    <string name="statusSelect" title="Състояние" selection="bg.art73.report.status.select"
      default="DRAFT" required="true"/>

    <!-- ═══ ЧАСТ І — ИДЕНТИФИКАЦИОННИ ДАННИ ЗА ПЛАТЕЦА НА ДОХОДА ═══ -->

    <!-- Т. 1 и т. 2 — ЕИК/Служебен № от регистъра на НАП и наименование на предприятието /име на
      самоосигуряващото се лице.
      ⚠️ ЗАМРАЗЕНИ на справката, а не четени от Company при всеки прочит: подадена справка трябва да
      показва данните, С КОИТО Е БИЛА подадена. Преименувано дружество не пренаписва миналото. -->
    <string name="payerIdentifier" title="ЕИК/Сл. № (Част І, т. 1)"/>
    <string name="payerName" title="Наименование/име (Част І, т. 2)"/>

    <!-- Т. 3.1 и 3.2 — за контакт. ⚠️ НЕ СЕ ИЗВЕЖДАТ ОТ Partner: указание т. 6 казва, че справка,
      която не съдържа ВСИЧКИ изискуеми данни, „не се счита за достоверна и не се приема“. Телефонът
      на дружеството в базата е телефон за фактури, не непременно лицето, което НАП ще потърси по
      тази справка. Затова полетата са ръчни и празни по подразбиране — виждат се и се попълват. -->
    <string name="contactPhone" title="Телефон за контакт (Част І, т. 3.1)"/>
    <string name="contactEmail" title="E-mail за контакт (Част І, т. 3.2)"/>

    <!-- Т. 4.1 и 4.2 — представляващият. Образецът, дословно: „попълват се САМО когато платецът е
      юридическо лице“. Самоосигуряващото се лице подава от свое име и тези две полета остават
      празни; празнотата тук е ОТГОВОР, а не пропуск. -->
    <string name="representativeName" title="Представляващ (Част І, т. 4.1)"/>
    <string name="representativeIdentifier" title="ЕГН/ЛН/ЛНЧ/Сл. № (Част І, т. 4.2)"/>

    <one-to-many name="recordList" title="Данни за изплатените доходи (Част ІІ)"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para1Record" mappedBy="report"/>

    <!-- Закачането към транспорта. ⚠️ Липсваща стойност тук е НОРМАЛНОТО състояние: справката се
      строи и се преглежда далеч преди да има какво да се подава. -->
    <many-to-one name="napSubmission" title="Подаване към НАП"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission"/>

    <!-- Обявените граници на изведеното — какво НЕ е попълнено, защо, и с КОЛКО реда.

      ⚠️ ЧАСТ ОТ ОТГОВОРА, А НЕ ЛОГ. Човекът, който натиска „подай“, отговаря по чл. 82 ЗДДФЛ за
      верността на данните. Празна колона 15 изглежда еднакво при „няма преобразуване“ и при „това
      приложение не знае за преобразувания“; редове, които липсват, изглеждат еднакво с „такива
      доходи не са изплащани“. Разликата се вижда само ако е НАПИСАНА — и с ЧИСЛО, а не с
      предупреждение изобщо. -->
    <string name="bgBoundaryReport" title="Граници на изведеното" large="true"/>


    <!-- ═══ ГЕНЕРИРАНИЯТ ФАЙЛ ═══

      ⚠️ РАЖДА СЕ ПРИ ГЕНЕРИРАНЕ, А НЕ ПРИ ЗАКАЧАНЕ, И ТОВА Е ИЗБОР. Файл, който се появява за пръв
      път ВЪТРЕ в подаването, не може да бъде погледнат преди това — а човекът, който натиска
      „подай“, отговаря за съдържанието му. Затова генерирането го произвежда и го прави сваляем,
      а закачането само пренася СЪЩИЯ файл в одитната следа.

      ⚠️ Липсваща стойност е НОРМАЛНОТО състояние: отчетът се строи и се преглежда далеч преди да
      има какво да се подава — а днес и не може да има, докато форматът на записа не дойде със
      заповед на изпълнителния директор на НАП. -->
    <many-to-one name="generatedFile" title="Генериран файл"
      ref="com.axelor.meta.db.MetaFile"/>
    <datetime name="fileGeneratedOn" title="Файлът е генериран на"/>

    <!-- НЕПРОМЕНИМИЯТ артефакт на същите байтове.

      ⚠️ ДВЕ ВРЪЗКИ КЪМ ЕДНО И СЪЩО СЪДЪРЖАНИЕ, И ТОВА НЕ Е ДУБЛИРАНЕ. {@code generatedFile} е
      MetaFile-ът, който екранът СВАЛЯ; {@code generatedArtifact} е редът, който носи отпечатъка,
      дължината и признака „замразен“ — и който подаването после сочи. Без него закачането щеше да
      вика createFromMetaFile и да ражда ВТОРИ артефакт за същите байтове: два реда, два отпечатъка,
      и никакъв начин да се каже кой е подаденият.

      ⚠️ Артефактът се ражда през RegulatoryFile/createFromFile — вратата, през която минава и
      Приложение № 9 на НОИ. Тя качва файла ВЪТРЕ в услугата и смята SHA-256 веднъж, вместо
      извикващият да държи един миг файл, чийто отпечатък никой не е взел. -->
    <many-to-one name="generatedArtifact" title="Артефакт (непроменим)"
      ref="com.axelor.apps.napsubmissions.db.NapArtifact"/>

    <!-- ⚠️ ОТПЕЧАТЪКЪТ СТОИ И ТУК, ВЪПРЕКИ ЧЕ NapArtifact го пази. Там той се ражда при ЗАКАЧАНЕ;
      тук е нужен ПРЕДИ него — за да може свалилият файла да сравни какво държи в ръцете си с това,
      което екранът твърди, че е генерирал. -->
    <string name="fileSha256" title="SHA-256 на файла"/>

    <!-- Броят ЗАПИСИ във файла. ⚠️ Различно от броя редове на екрана, ако форматът носи заглавен
      или краен запис — НАП сверява точно това число. -->
    <integer name="fileRecordCount" title="Брой записи във файла"/>

    <!-- ═══ РЪЧНИЯТ ИЗХОД ОТ ПОРТАЛА ═══

      ⚠️ РЪЧНИ, ЗАЩОТО КАНАЛЪТ Е РЪЧЕН. Подаването минава през manual_portal — той по устройство не
      извършва транспорт и няма как да върне отговор. Състоянията „приета“ и „отхвърлена“ иначе
      остават недостижими: селекцията ги познава, а нищо не ги пише. -->
    <string name="napIncomingNumber" title="Входящ №/протокол (НАП)"/>
    <date name="napResponseDate" title="Дата на входящия №/отговора"/>
    <string name="napResponseNote" title="Бележка по отговора" large="true"/>

    <unique-constraint columns="company,taxYear"/>

  </entity>

</domain-models>
