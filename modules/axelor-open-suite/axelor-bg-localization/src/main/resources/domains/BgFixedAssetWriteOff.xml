<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ РЕГИСТЪР НА ОТПИСАНИТЕ АКТИВИ — чл. 60 и чл. 66 ЗКПО ═══

    Един ред = едно отписване. Съхранява двете суми, които влизат в ГДД, и основанието им:

      чл. 66 ал. 1 — счетоводният финансов резултат се УВЕЛИЧАВА със счетоводната балансова
                     стойност (СБС) на актива;
      чл. 66 ал. 2 — и се НАМАЛЯВА с данъчната стойност (ДБС).

    ⚠️ ЗАЩО ОТДЕЛЕН ЗАПИС, А НЕ ПОЛЕТА НА АКТИВА. Три причини, и всяка е реален случай.
    Първата: частичната продажба РАЗДЕЛЯ актива (FixedAssetService.splitFixedAsset създава нов
    FixedAsset), тъй че „едно отписване на актив“ не е едно към едно със записа на актива.
    Втората: сумите се четат по ГОДИНА за ГДД, а актив, отписан през 2028, не бива да мести
    декларацията за 2027 — годината трябва да е носеща колона, не изведена от дата при всяко
    четене. Третата: основанието по ал. 3 е решение на съставителя за конкретното отписване и
    трябва да се види в справката до сумите, инак нулата изглежда като липса на данни.

    ⚠️ ЗАЩО СЕ ПАЗЯТ И ДВЕТЕ СУМИ, А НЕ САМО НЕТОТО. Ал. 1 и ал. 2 са ОТДЕЛНИ пера в ГДД —
    увеличението и намалението се декларират поотделно. Само нето би стигнало за проверка на
    данъка, но не за попълване на декларацията.

    ⚠️ Този запис НЕ поражда счетоводна статия. Преобразуването по чл. 66 е извънсчетоводно, както
    и целият данъчен амортизационен план (виж BgFixedAssetLineTaxComputationServiceImpl). -->
  <entity name="BgFixedAssetWriteOff">

    <many-to-one name="fixedAsset" ref="com.axelor.apps.account.db.FixedAsset"
      title="Актив" required="true"/>
    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Дружество"
      required="true"/>

    <!-- Датата на СЧЕТОВОДНОТО отписване. Тя, а не датата на отрязване на ДАП, е носещата: от нея
      чл. 60 ал. 2 извежда данъчния момент (началото на същия месец), и по нея се пада в годината. -->
    <date name="writeOffDate" title="Дата на счетоводно отписване" required="true"/>

    <!-- Годината, в която преобразуването влиза в ГДД. Отделна колона, не изведена от writeOffDate:
      справката се групира по нея и не бива да зависи от часовата зона или от изчисление при четене. -->
    <integer name="taxYear" title="Данъчна година" required="true"/>

    <string name="reasonSelect" title="Основание за отписване"
      selection="bg.asset.write.off.reason.select"/>

    <!-- СБС по чл. 66 ал. 1 — увеличението на счетоводния финансов резултат. -->
    <decimal name="accountingCarryingValue" title="Счетоводна балансова стойност (СБС)"
      precision="20" scale="2"/>

    <!-- ДБС по чл. 66 ал. 2 (определена в чл. 53 ал. 4) — намалението. -->
    <decimal name="taxValue" title="Данъчна стойност (ДБС)" precision="20" scale="2"/>

    <!-- Начислената данъчна амортизация към момента на отписване. Не участва в чл. 66, но без нея
      ДБС е число без произход и справката по ДАП няма как да се сведе. -->
    <decimal name="taxDepreciationCharged" title="Начислена данъчна амортизация"
      precision="20" scale="2"/>

    <!-- Данъчната амортизируема стойност (чл. 53 ал. 1), с която активът е бил заведен. -->
    <decimal name="taxAmortizableValue" title="Данъчна амортизируема стойност (ДАС)"
      precision="20" scale="2"/>

    <!-- Датата, до която данъчният план е останал: последният ден на месеца ПРЕДИ месеца на
      счетоводното отписване (чл. 60 ал. 2). Празна, когато ал. 2 не се прилага — виж
      isArt60Al2Applied. -->
    <date name="taxPlanCutDate" title="ДАП отрязан към"/>

    <!-- Приложена ли е ал. 2, или случаят попада в ал. 3 (напълно счетоводно амортизиран актив по
      т. 1 — тогава активът ОСТАВА в ДАП и се отписва по реда на ал. 1). -->
    <boolean name="isArt60Al2Applied" title="Отписан от ДАП по чл. 60 ал. 2" default="true"/>

    <string name="art66ExceptionSelect" title="Изключение по чл. 66 ал. 3"
      selection="bg.asset.art66.exception.select" default="NONE"/>

    <!-- Прилага ли се преобразуването, тоест НЕ попада ли случаят в изключенията по ал. 3. Пази се,
      а не се извежда при четене, защото условието „ДБС превишава СБС“ по ал. 3 т. 1–3 се мери КЪМ
      МОМЕНТА на отписване, а сумите после не се менят — правилото обаче може.

      ⚠️ ТОВА ПОЛЕ НЕ КАЗВА, ЧЕ ДВЕТЕ АЛИНЕИ СА ДЪЛЖИМИ В ЕДНА И СЪЩА ГОДИНА, и разликата е
      съществена за справката. Ал. 1 (увеличение със СБС) се дължи, когато активът се отпише от
      СЧЕТОВОДНИЯ план — тоест в годината на този запис. Ал. 2 (намаление с ДБС) се дължи, когато
      активът се отпише от ДАНЪЧНИЯ план — а по чл. 60 ал. 3 т. 1 това е ПО-КЪСНО: напълно
      амортизиран за счетоводни цели актив остава в ДАП и излиза оттам по реда на ал. 1, при пълно
      данъчно амортизиране (ал. 4).

      Затова справката за ГДД чете така:
        увеличение по ал. 1 = accountingCarryingValue, когато isArt66Applied;
        намаление по ал. 2  = taxValue, когато isArt66Applied И isArt60Al2Applied.
      Пример: машина със счетоводен срок 24 месеца и данъчна норма 30% (40 месеца),
      бракувана на 31.03.2028, дава СБС 0 и ДБС 3 250 — и тези 3 250 НЕ са намаление за 2028 г.,
      защото данъчният план продължава още 13 месеца. -->
    <boolean name="isArt66Applied" title="Преобразуване по чл. 66 (не попада в ал. 3)"
      default="true"/>

    <!-- ═══ ПРИЧИНАТА, ДОКУМЕНТЪТ И ЗДДС ═══ -->

    <!-- Избраната причина. Тя решава разходната сметка, вида на извеждането и ПРЕДЛОЖЕНОТО ЗДДС
      третиране — виж domains/AssetDisposalReason.xml. Пази се тук, а не само на актива, защото
      причината е факт за ТОВА отписване: частичната продажба разделя актива и всяка част може да
      излезе по свое основание. -->
    <many-to-one name="assetDisposalReason" ref="com.axelor.apps.account.db.AssetDisposalReason"
      title="Причина за извеждане"/>

    <!-- Продажбената фактура по чл. 113 ЗДДС. Тя, а не отписването, носи приходa и ДДС-то:
      Дт 411 / Кт 705 + Кт 4532. Празна при продажба значи разкъсан поток — формата предупреждава. -->
    <many-to-one name="saleInvoice" ref="com.axelor.apps.account.db.Invoice"
      title="Фактура за продажбата (чл. 113 ЗДДС)"/>

    <!-- Протоколът за брак, липси или събитието при непреодолима сила. Свободни полета, а не връзка:
      такъв документ не е обект в системата, а хартия с номер и дата. -->
    <string name="documentNumber" title="Документ №"/>
    <date name="documentDate" title="Дата на документа"/>

    <!-- Третирането по ЗДДС. Подразбирането идва от причината и за брак, липси и непреодолима сила
      е „подлежи на корекция“ — чл. 79 ал. 1 дължи данък при унищожаване, кражба, загуба, липси и
      бракуване. Системата НИКОГА не сваля сама на „не подлежи“. -->
    <string name="vatTreatmentSelect" title="ЗДДС третиране"
      selection="bg.asset.vat.treatment.select" default="CORRECTION_DUE"/>

    <!-- Конкретната точка и буква на чл. 80, ако се твърди освобождаване. Попълва се предложено от
      причината. -->
    <string name="vatGroundSelect" title="Основание по чл. 80 ЗДДС"
      selection="bg.asset.vat.ground.select"/>

    <!-- ⚠️ ГАРДРЕЙЛЪТ. Всички освобождавания по чл. 80 ал. 2 висят под условие в отварящото
      изречение на точката: „ДОКАЗАНО ИЛИ ПОТВЪРДЕНО унищожаване …“. Системата не вижда документи,
      затова превключването на „не подлежи“ иска съставителят да го обяви ИЗРИЧНО и да посочи
      документа — виж BgFixedAssetWriteOffManagementRepository, който отказва иначе. -->
    <boolean name="isDestructionProven"
      title="Доказано/потвърдено унищожаване (чл. 80 ал. 2)" default="false"/>

    <!-- Какво трябва да е доказано за предложеното основание — пренася се от причината, за да е
      пред очите на съставителя, вместо да се търси в закона. -->
    <string name="vatProofNote" title="Условие за доказване" large="true" multiline="true"/>

    <!-- ═══ Корекция по чл. 79 ал. 3 ЗДДС — ИЗЧИСЛЕНОТО ═══════════════════════════════════

      Входовете живеят на АКТИВА (виж domains/FixedAsset.xml): те са факти от придобиването.
      Тук се пази какво е излязло от тях към датата на това извеждане — заедно с множителите,
      защото ППЗДДС чл. 66 ал. 3 иска протоколът да съдържа точно тях: т. 7 брой години, т. 8
      пропорция, т. 9 коефициент, т. 10 размер на дължимия данък.

      ⚠️ СМЯТА СЕ САМО ПРИ CORRECTION_DUE. Гардрейлът по чл. 80 ал. 2 е на страната на активите и
      не се преоткрива тук — обявено „не подлежи“ без доказателство изобщо не стига дотук. -->

    <!-- Коя посока носи сумата по-долу. Виж bg.vat.art79.direction.select защо е маркер, а не
      знак: „корекция“ е думата на закона и за двете, но дневниците са различни. -->
    <string name="vatCorrectionDirection" title="Посока по чл. 79"
      selection="bg.vat.art79.direction.select"/>

    <decimal name="vatCorrectionAmount" title="Сума по чл. 79 (EUR)" precision="18" scale="2"/>

    <!-- БГ — броят на съответните години (ППЗДДС чл. 66 ал. 3 т. 7). Нула значи изтекъл срок. -->
    <integer name="vatCorrectionYears" title="Брой години (БГ)"/>

    <!-- n — 20 за недвижим имот, 5 за останалите. Пази се, за да е проверимо коя точка е приложена
      дори ако класификацията на актива бъде променена по-късно. -->
    <integer name="vatCorrectionPeriodYears" title="Срок по чл. 79 ал. 3 (години)"/>

    <!-- Годината, от началото на която е броен срокът: годината на кредита или — само за имот —
      годината на фактическото използване. -->
    <integer name="vatCorrectionStartYear" title="Срокът тече от година"/>

    <!-- Множителите, както са ПРИЛОЖЕНИ след чл. 79в (К₀ = 1 при пълен кредит, 0 при чл. 70), а не
      както са въведени. Разликата между въведено и приложено е точно това, което прави протокола
      проверим. -->
    <decimal name="vatCorrectionK0" title="Приложен К₀" precision="5" scale="2"/>
    <decimal name="vatCorrectionProportion" title="Приложен ПрНИД₀" precision="5" scale="2"/>

    <!-- Основанието, изписано както го дава законът — напр. „чл. 79 ал. 3 т. 2 б. „б““. Свободен
      текст, а не селекция: комбинациите са точка × буква и се четат, не се филтрират. -->
    <string name="vatCorrectionGround" title="Основание на корекцията"/>

    <!-- Протоколът по чл. 79 ал. 4 — статията, която внася данъка в дневника за продажбите.
      Празно значи „изчислено, но още неначислено“: чл. 79 ал. 4 иска начисляването да стане в
      данъчния период на събитието, тъй че празнотата е видим дълг, а не спокойно състояние. -->
    <many-to-one name="vatCorrectionMove" ref="com.axelor.apps.account.db.Move"
      title="Протокол по чл. 79 ал. 4"/>

    <many-to-one name="disposalMove" ref="com.axelor.apps.account.db.Move"
      title="Статия за отписване"/>
    <many-to-one name="saleMove" ref="com.axelor.apps.account.db.Move"
      title="Статия за продажба"/>

    <string name="comments" title="Забележки" large="true" multiline="true"/>

    <finder-method name="findByFixedAssetAndDate" using="fixedAsset,writeOffDate"/>

    <extra-code><![CDATA[
        // Основание за отписване
        public static final String REASON_SALE = "SALE";
        public static final String REASON_SCRAPPING = "SCRAPPING";
        public static final String REASON_OTHER = "OTHER";
	]]></extra-code>

  </entity>

</domain-models>
