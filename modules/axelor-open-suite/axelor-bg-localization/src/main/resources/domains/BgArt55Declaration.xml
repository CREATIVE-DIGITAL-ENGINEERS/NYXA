<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ДЕКЛАРАЦИЯТА ЗА ДЪЛЖИМИ ДАНЪЦИ — ОБРАЗЕЦ 4001 ═══

    „Декларация по чл. 55, ал. 1 от ЗДДФЛ и чл. 201, ал. 1 от ЗКПО за дължими данъци.“

    Подава се от ПРЕДПРИЯТИЯТА и от САМООСИГУРЯВАЩИТЕ СЕ ЛИЦА — платци на доходи, задължени да
    удържат и внасят данъци (чл. 55 ал. 1). СРОК: чл. 56 ал. 1 я връзва със срока за внасяне, а
    чл. 65 ал. 12 го определя като „края на месеца, следващ тримесечието на придобиване на дохода“.
    Чл. 56 ал. 2: предприятията подават САМО ПО ЕЛЕКТРОНЕН ПЪТ.

    ⚠️ РЕДАКЦИЯТА НА ОБРАЗЕЦА НЕ Е ЗАПИСАНА — ДА СЕ ПОТВЪРДИ. Редовете и заглавията по-долу са
    сверени срещу ТЕКСТА на образеца, но не срещу назован брой на ДВ. Текущата редакция е
    ДВ бр. 35/2026 (евро-редакция, заменя ДВ бр. 82/2023); да се провери дали тя мести редове или
    прагове. Намери ли се разминаване, то е ТУК, а не в агрегатора.

    ⚠️ ЕДНА (ГОДИНА, ТРИМЕСЕЧИЕ, ПЛАТЕЦ) — ЕДНА ДЕКЛАРАЦИЯ, оттам уникалността. Корекцията НЕ е
    втора декларация в базата: образецът, ДОСЛОВНО, иска „нова данъчна декларация, в която се
    съдържат ВСИЧКИ данни за периода, а не само тези, които променяте“ — тоест същият запис,
    построен наново.

    ⚠️ ЧАСТ ІV Е ТРИ ПОЛЕТА, А НЕ СПИСЪК ОТ РЕДОВЕ, И ТОВА Е РАЗЛИКАТА СРЕЩУ СПРАВКАТА ПО ЧЛ. 73.
    Там Част ІІ има по един ред НА ЛИЦЕ и броят им е неизвестен предварително. Тук редовете са
    ЗАКОВАНИ от образеца: ред 1, ред 2 и ред 3 съществуват винаги и нула на ред 3 е валидно
    съдържание, а не липсващ ред. Моделирани като списък, те биха позволили „ред 2 два пъти“ и
    „декларация без ред 1“ — състояния, които образецът не познава.

    ⚠️ И ТУК СТОИ САМО КОЛОНА 3. Част ІV има две колони: к. 3 „от ПЛАТЕЦ на дохода“ и к. 4 „от
    ПОЛУЧАТЕЛ на дохода“. Ние сме платецът (Част І, т. 1). Колона 4 се попълва от ФИЗИЧЕСКОТО ЛИЦЕ,
    което внася данъка само (Част І, т. 2) — друг подател и друго задължение, а на ред 2 образецът
    я е задраскал с „х“. Заведена тук, тя би поканила да бъде попълнена. -->
  <entity name="BgArt55Declaration">

    <!-- ПЛАТЕЦЪТ. Декларацията описва данъка, удържан ОТ него. -->
    <many-to-one name="company" title="Дружество (платец)" required="true"
      ref="com.axelor.apps.base.db.Company"/>

    <!-- ═══ ЧАСТ І — ДАННИ ЗА ДЕКЛАРАЦИЯТА ═══ -->

    <!-- Т. 3.1 — ДАНЪЧНАТА година, не годината на подаване. -->
    <integer name="taxYear" title="Данъчна година (Част І, т. 3.1)" required="true"/>

    <!-- Т. 3.2 — тримесечието. ⚠️ Числово, а не избор от текст: то влиза в сметки (границата на
      Q4 по чл. 65 ал. 13 и срокът по чл. 56 ал. 1), а не само в екрана. -->
    <integer name="quarter" title="Тримесечие (Част І, т. 3.2)" required="true"
      selection="bg.art55.quarter.select"/>

    <string name="statusSelect" title="Състояние" selection="bg.art73.report.status.select"
      default="DRAFT" required="true"/>

    <!-- ═══ ЧАСТ ІІ — ДАННИ ЗА ДАНЪЧНО ЗАДЪЛЖЕНОТО ЛИЦЕ ═══ -->

    <!-- Т. 1 — ЕИК/ЕГН/ЛН/ЛНЧ/Служебен № от регистъра на НАП.
      ⚠️ ЗАМРАЗЕН на декларацията, а не четен от Company при всеки прочит: подадена декларация
      трябва да показва данните, С КОИТО Е БИЛА подадена. Преименувано дружество не пренаписва
      миналото. -->
    <string name="payerIdentifier" title="ЕИК/ЕГН/Сл. № (Част ІІ, т. 1)"/>

    <!-- Т. 2 — кодът по т. 1. Образецът, ДОСЛОВНО: „Ако в т. 1 е вписан ЕИК - в т. 2 се попълва
      цифрата 1; ако в т. 1 е вписан ЕГН – в т. 2 се попълва цифрата 2; ако в т. 1 е вписан ЛН –
      ... 3; ако ... ЛНЧ – ... 4; ако ... служебен № от регистъра на НАП – ... 5.“
      ⚠️ По подразбиране „1“: подателят тук е ДРУЖЕСТВО (Company), тоест носител на ЕИК. Изведен от
      дължината на идентификатора, кодът би сгрешил при ЕГН с водеща нула и при служебен номер. -->
    <string name="payerCodeType" title="Код по т. 1 (Част ІІ, т. 2)" default="1"
      selection="bg.art55.payer.code.select"/>

    <string name="payerName" title="Наименование/Име (Част ІІ, т. 3)"/>

    <!-- Т. 4.1 и 4.2 — за контакт. ⚠️ Ръчни и празни по подразбиране, по същия довод като при
      справката по чл. 73 ал. 1: телефонът на дружеството в базата е телефон за фактури, не
      непременно лицето, което НАП ще потърси по ТАЗИ декларация. -->
    <string name="contactPhone" title="Телефон (Част ІІ, т. 4.1)"/>
    <string name="contactEmail" title="E-mail (Част ІІ, т. 4.2)"/>

    <!-- Т. 7.1 и 7.2 — представляващият. Образецът: „попълват се само когато декларацията се
      подава от юридическо лице“. -->
    <string name="representativeName" title="Представляващ (Част ІІ, т. 7.1)"/>
    <string name="representativeIdentifier" title="ЕГН/ЛН/ЛНЧ/Сл. № (Част ІІ, т. 7.2)"/>

    <!-- ═══ ЧАСТ ІV — ДЕКЛАРИРАНЕ НА ДЪЛЖИМИЯ ДАНЪК, КОЛОНА 3 ═══ -->

    <!-- РЕД 1 — „Авансов данък по чл. 43 от ЗДДФЛ за доходи от друга стопанска дейност; по чл. 44
      от ЗДДФЛ за доходи от наем или от друго възмездно предоставяне за ползване на права или
      имущество и по чл. 44а от ЗДДФЛ за други доходи“.

      ⚠️ ТРИТЕ РАЗПОРЕДБИ СА НА ЕДИН РЕД, И ТОВА Е ИЗБОР НА ОБРАЗЕЦА, НЕ НАШ. Разделени на три
      полета, сборът им пак би се подавал като едно число, а екранът би твърдял разлика, каквато
      декларацията не прави.

      ⚠️ НУЛА ЗА ЧЕТВЪРТОТО ТРИМЕСЕЧИЕ по чл. 65 ал. 13 — виж bgBoundaryReport за потиснатата
      сума. -->
    <decimal name="row1AdvanceTax" title="Ред 1, к. 3 — авансов данък (чл. 43, 44, 44а)"
      precision="20" scale="2" default="0"/>

    <!-- РЕД 2 — „Окончателен данък за доходи от дивиденти и ликвидационни дялове по чл. 38, ал. 1
      от ЗДДФЛ от източници в страната“. ⚠️ Колона 4 на този ред е задраскана с „х“ на образеца:
      получателят НЕ внася сам такъв данък. -->
    <decimal name="row2DividendTax" title="Ред 2, к. 3 — окончателен, дивиденти (чл. 38, ал. 1)"
      precision="20" scale="2" default="0"/>

    <!-- РЕД 3 — „Окончателен данък по чл. 37 и чл. 38 от ЗДДФЛ с изключение на: данъка посочен в
      т. 2 и дължимия данък по чл. 67, ал. 4 от ЗДДФЛ, който се декларира в годишната данъчна
      декларация по чл. 50 от ЗДДФЛ“. ⚠️ Второто изключение НЕ е направено — регистърът няма
      признак за източника на дохода; виж bgBoundaryReport. -->
    <decimal name="row3OtherFinalTax" title="Ред 3, к. 3 — окончателен, друг (чл. 37 и чл. 38)"
      precision="20" scale="2" default="0"/>

    <!-- ⚠️ РЕДОВЕ 4, 4.1–4.5 И 5 ГИ НЯМА, И ТОВА Е ОБЯВЕНА ГРАНИЦА, А НЕ ПРОПУСК. Те са данъкът
      при източника по чл. 194 и чл. 195 ЗКПО — за ЮРИДИЧЕСКИ лица. Регистърът, който захранва
      този екран, е за доходи на ФИЗИЧЕСКИ лица и сочи Partner като получател; за ред 4 и ред 5
      той няма нито вход, нито смисъл. Заведени тук като празни полета, те биха обещали
      попълване, каквото нищо не извършва. Виж bgBoundaryReport. -->

    <!-- ⚠️ И ПРИЛОЖЕНИЯТА (Част І, т. 4–7) ГИ НЯМА: образци 4011, 4021 и 4031 обслужват
      автоматичния обмен по чл. 73а ал. 1 ЗДДФЛ и чл. 201 ал. 5–6 ЗКПО, а 4041 — данните по
      чл. 123 ал. 10 ЗДДС. Своя тема, свой вход. -->

    <!-- Срокът за подаване, изчислен от периода — чл. 56 ал. 1 във връзка с чл. 65 ал. 12. -->
    <date name="dueDate" title="Срок за подаване"/>

    <!-- Закачането към транспорта. ⚠️ Липсваща стойност е НОРМАЛНОТО състояние: декларацията се
      строи и се преглежда далеч преди да има какво да се подава. -->
    <many-to-one name="napSubmission" title="Подаване към НАП"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission"/>

    <!-- Обявените граници на изведеното — какво НЕ е попълнено, защо, и с КОЛКО реда.
      ⚠️ ЧАСТ ОТ ОТГОВОРА, А НЕ ЛОГ. Образецът, ДОСЛОВНО: „За деклариране на неверни данни се носи
      наказателна отговорност по Наказателния кодекс.“ Нула на ред 1 изглежда еднакво при „няма
      удържан аванс“ и при „потиснат по чл. 65 ал. 13“. Разликата се вижда само ако е НАПИСАНА. -->
    <string name="bgBoundaryReport" title="Граници на изведеното" large="true"/>


    <!-- ⚠️ НЯМА ПОЛЕТА ЗА ГЕНЕРИРАН ФАЙЛ, И ТОВА Е ОБЯВЕН ОТКАЗ, А НЕ ПРОПУСК.

      Обр. 4001 се подава през ПОРТАЛА: чл. 56 ал. 2 иска подаване само по електронен път, но НАП
      не е публикувала машинна структура на записа за този образец. Заведени тук, {@code
      generatedFile}, отпечатъкът и броят записи щяха да са полета, които нищо не попълва — тоест
      обещание за файл, какъвто не се произвежда.

      ⚠️ Справките по чл. 73 са ДРУГ случай: там файлова верига има и чака само заповедта.
      Виж service/art73. -->

    <!-- ═══ РЪЧНИЯТ ИЗХОД ОТ ПОРТАЛА ═══

      ⚠️ РЪЧНИ, ЗАЩОТО КАНАЛЪТ Е РЪЧЕН. Подаването минава през manual_portal — той по устройство не
      извършва транспорт и няма как да върне отговор. Състоянията „приета“ и „отхвърлена“ иначе
      остават недостижими: селекцията ги познава, а нищо не ги пише. -->
    <string name="napIncomingNumber" title="Входящ №/протокол (НАП)"/>
    <date name="napResponseDate" title="Дата на входящия №/отговора"/>
    <string name="napResponseNote" title="Бележка по отговора" large="true"/>

    <unique-constraint columns="company,taxYear,quarter"/>

  </entity>

</domain-models>
