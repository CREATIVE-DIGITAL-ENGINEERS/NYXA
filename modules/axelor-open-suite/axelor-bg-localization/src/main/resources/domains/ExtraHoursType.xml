<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="human-resource" package="com.axelor.apps.hr.db"/>

  <!-- КЛАСИФИКАЦИЯТА „ВИД ДОПЪЛНИТЕЛНИ ЧАСОВЕ НА КЛИЕНТА → ВИД ИЗВЪНРЕДЕН ТРУД ПО БЪЛГАРСКОТО ПРАВО“.
    ═══ ЗАЩО ИЗОБЩО ═══ ExtraHoursType на базовия модул носи само name, increase (%) и exportCode. Тоест
    ExtraHoursLine.qty дава СБОРА на извънредните часове, а разпределението им по видове е неразличимо —
    а точно разпределението мени ставката. Това записваше BgPayrollInputBuilder.DECLARED_ABSENT: „сборът
    е наличен, разпределението — не“. ⚠️ increase НЕ Е ДИСКРИМИНАТОР. Изкушението е видът да се изведе от
    процента: 50 % → работен ден, 75 % → почивен, 100 % → празник. Точно затова не се прави — процентът е
    това, което работодателят Е УГОВОРИЛ, а не това, което законът ИЗИСКВА: чл. 262 ал. 1 КТ дава МИНИМУМИ,
    а КТД може да е уговорил повече. Уговорени 100 % за работен ден биха се прочели като празник и биха вкарали
    часовете в друга кофа — тихо и правдоподобно. ═══ ⚠️ ТОВА Е ОПЕРАЦИОНЕН ИЗБОР, НЕ ЗАКОН ═══ Как е кръстен
    видът допълнителни часове е решение на КЛИЕНТА. Затова полето е КОНФИГУРИРУЕМО, а флагът bgExtraHoursKindDefaulted
    казва „това го сложи машина, чака потвърждение“ — по същия довод като LeaveReason.bgAbsenceType. ═══
    ⚠️ НОЩНИЯТ ТРУД И РАЗПОЛОЖЕНИЕТО НЕ СА ТУК, И ТОВА Е НАРОЧНО ═══ Селекцията носи САМО четирите вида ИЗВЪНРЕДЕН
    труд. Нощният труд (НСОРЗ чл. 8) не е извънреден: нощна смяна по график е РЕДОВЕН труд, който се заплаща
    с добавка — тоест той няма да се появи като ExtraHours ред изобщо. Същото важи и за времето на разположение
    (НСОРЗ чл. 10). Сложени като стойности тук, те щяха да обещаят източник, който за повечето инсталации
    не съществува. Затова двете имат СОБСТВЕН деклариран вход: BgDeclaredWorkHours. -->
  <entity name="ExtraHoursType" cacheable="true">

    <!-- NULLABLE НАРОЧНО: некласифицираният вид трябва да е РАЗЛИЧИМ, а не да получи мълчаливо подразбиране.
      Сглобителят ОТКАЗВА, когато срещне валидиран ред с некласифициран вид. -->
    <string name="bgExtraHoursKind" title="Вид извънреден труд (БГ)"
      selection="bg.extra.hours.kind.select"/>

    <boolean name="bgExtraHoursKindDefaulted"
      title="Класификацията е подразбирана (чака потвърждение)" default="false"/>

  </entity>

</domain-models>
