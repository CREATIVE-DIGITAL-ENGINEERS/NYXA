<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ РЕГИСТЪРЪТ НА ИЗПЛАТЕНИТЕ ДОХОДИ НА ФИЗИЧЕСКИ ЛИЦА ═══

    ⚠️ РЕДОВЕТЕ ИДВАТ ОТ ДВЕ МЕСТА И ДВЕТЕ СА ВИДИМИ НА САМИЯ РЕД. Ръчното въвеждане през формата
    оставя source = MANUAL и ПРАЗНА референция; авто-захранването (BgIncomePaymentFeedService,
    ръчно действие „Генерирай записи за период“) оставя PAYROLL или INVOICE и попълнена
    референция „<Модел>#<id>“. Второто никога не пипа първото — виж sourceRef долу.

    ⚠️ ПРАЗНАТА ТАБЛИЦА ВСЕ ОЩЕ Е ВЯРНО СЪСТОЯНИЕ. Захранването е РЪЧНО действие: докато никой не
    го е пуснал, редове няма и това не е дефект — включително за манифестния тест, който я гледа.

    ⚠️ И ТРУДОВИТЕ ДОХОДИ НЕ МИНАВАТ ОТТУК. Справката по чл. 73 ал. 6 се събира ПРЯКО от фишовете
    (BgArt73Para6Aggregator) — кодове 101–103 и 104–111 нямат ред в този регистър. Причината е, че
    фишът вече носи и трите числа на образеца (колони 3, 4 и 7) и второ им копие тук би било втора
    истина, която може да се разсинхронизира. Регистърът е за ИЗВЪНТРУДОВИТЕ доходи.

    ⚠️ ЗАЩО РЕДЪТ ПАЗИ И БРУТО, И ОСНОВА, И ДАНЪК — ТРИ ЧИСЛА, А НЕ ЕДНО. Указание т. 8 към
    справката по ал. 1, ДОСЛОВНО: „в колона 11 се посочва брутният размер на дохода, т.е. без
    приспадане на признатите разходи и/или направените удръжки от платеца“. Тоест СПРАВКАТА иска
    бруто, а декларацията по чл. 55 и вносът на данъка искат основата и данъка. Едно число не
    върши и двете: сметнато обратно от данъка, бруто-то губи стотинки при всяка ставка, различна
    от 10; сметната обратно от бруто, основата иска нормативните разходи ЗА ДАТАТА и ги иска
    отново при всеки прочит. -->
  <entity name="BgIndividualIncomePayment">

    <!-- Получателят. Идентификаторът (ЕГН/ЛН/ЛНЧ/Сл. №/БУЛСТАТ) и датата на раждане живеят на
      Partner, не тук: те са данни за ЛИЦЕТО, не за плащането, и преписани на всеки ред биха се
      разминали помежду си. Тук стои само ТИПЪТ им — виж identifierType. -->
    <many-to-one name="partner" title="Лице (получател)" required="true"
      ref="com.axelor.apps.base.db.Partner"/>

    <!-- ПЛАТЕЦЪТ на дохода. Справката по чл. 73 ал. 1 се подава ОТ ПЛАТЕЦА и в Част І носи
      неговия ЕИК; без този признак редовете на две дружества в една база са неразличими и
      справката на едното би описала доходите на другото.

      ⚠️ НЕ Е required, И ТОВА Е ЗАРАДИ ЗАВАРЕНИТЕ РЕДОВЕ. Полето е добавено към попълнена таблица,
      тоест по-рано въведените ръчни редове го нямат. Обявено задължително, то би направило и самото им
      отваряне невъзможно. Затова формата го попълва по подразбиране с активното дружество, а
      строителят на справката ги БРОИ и ги назовава — виж BgArt73Para1Boundaries: ред без платец не
      се приписва мълчаливо на подателя, а се съобщава като число, което човек да оправи. -->
    <many-to-one name="company" title="Платец (дружество)" ref="com.axelor.apps.base.db.Company"/>

    <!-- Кодът по номенклатурата. ⚠️ m2o, а не низ, и това е обратното на решението при
      BgInsuredType (връзка по КОД). Разликата е в носителя на темпоралността: там кодът се четеше
      за периода на Д1 и редът се избираше при СМЯТАНЕТО; тук плащането е СЪБИТИЕ с дата и видът
      доход се заковава в момента на изплащането. Коригираща справка за минала година трябва да
      покаже кода, с който доходът Е БИЛ подаден — тоест точно този ред, не днешния му наследник. -->
    <many-to-one name="incomeType" title="Вид доход" required="true" ref="BgIncomeType"/>

    <!-- Колона 2 на Част ІІ: „0“, ако лицето не е чуждестранно, „1“, ако е (указание т. 3). -->
    <boolean name="isForeign" title="Чуждестранно лице" default="false"/>

    <!-- Колона 3: тип на идентификатора. Указание т. 4, ДОСЛОВНО: „0“ за лице с ЕГН; „1“ за лице с
      ЛН, ЛНЧ или „Сл. № от регистъра на НАП“; „2“ за физическо лице с БУЛСТАТ; „3“ за чуждестранно
      физическо лице без посочените идентификатори, като в тези случаи колона 4 не се попълва, а се
      попълва датата на раждане.

      ⚠️ ЧЕТИРИ СТОЙНОСТИ ТУК, НО САМО ДВЕ В ДРУГАТА СПРАВКА. Указание т. 4 към ал. 6 познава само
      „0“ и „1“ — трудово правоотношение с лице без ЕГН/ЛН/ЛНЧ/Сл. № няма. Затова изборът е на ТОЗИ
      регистър и НЕ се преизползва от ал. 6: общ избор би предложил стойност, която образецът на
      ал. 6 не приема. -->
    <string name="identifierType" title="Тип идентификатор" required="true"
      selection="bg.income.payment.identifier.type.select"/>

    <!-- Колона 9. Указание т. 6: попълва се САМО за чуждестранни физически лица. -->
    <string name="countryCode" title="Държава (код)"/>

    <!-- Получателят е самоосигуряващо се лице и е декларирал ПИСМЕНО пред платеца, че ще внася
      данъка сам — чл. 43 ал. 5, ДОСЛОВНО: „Алинея 4 не се прилага, когато лицето, придобиващо
      дохода, е самоосигуряващо се лице по смисъла на Кодекса за социално осигуряване и декларира
      това обстоятелство с писмена декларация пред платеца на дохода.“

      ⚠️ ФАКТ ЗА ПЛАЩАНЕТО, НЕ ЗА КОДА — и затова стои тук, а не на BgIncomeType. Един и същ код
      (напр. 3073) се плаща на две лица и се държи различно: на нeсамоосигуряващо се лице платецът
      удържа, на декларирало СОЛ — не. Сложен на каталога, флагът би сменил поведението за ВСИЧКИ
      получатели на кода.

      ⚠️ ДЕЙСТВА САМО ПРИ ШАБЛОН A, И ТОВА Е ПРОЧЕТЕНО, НЕ ПРЕДПОЛОЖЕНО. Чл. 43 ал. 5 отменя ал. 4
      НА СЪЩИЯ ЧЛЕН, тоест обхватът му са доходите по чл. 29. Чл. 44 (наем) НЯМА такава алинея:
      неговата ал. 4 е безусловна и СОЛ-наемодател НЕ попада в изключението. Чл. 44а (чл. 35) —
      също не. Пренесен „по аналогия“ върху B или E, флагът би оставил данък неудържан без норма.

      ⚠️ И РЕДЪТ ВСЕ ПАК СЕ ЗАПИСВА. Данък не се удържа, но доходът е изплатен и влиза в справката
      по чл. 73 ал. 1 с БРУТО в колона 11 и нула в колона 13. Пропуснат ред тук е непълна справка. -->
    <boolean name="selfInsuredDeclared" title="Получателят е СОЛ и е декларирал (чл. 43, ал. 5)"
      default="false"/>

    <!-- ═══ СУМИТЕ ═══ -->

    <!-- Колона 11 — БРУТНИЯТ размер, без приспаднати разходи и без направените удръжки. -->
    <decimal name="grossAmount" title="Брутен размер (к. 11)" precision="20" scale="2"
      required="true"/>

    <!-- Нормативно признатите разходи В ЛЕВОВЕ — не процентът, той е на каталога.
      ⚠️ Пази се СМЕТНАТ, а не се смята при прочит: процентът на кода е темпорален и втора сметка
      след промяна на чл. 29 би дала друга основа за вече подаден и вече платен данък. -->
    <decimal name="expenseAmount" title="Нормативни разходи (лв.)" precision="20" scale="2"
      default="0"/>

    <!-- Основата, върху която е сметнат данъкът. НЕ влиза в справката по чл. 73 — тя е за
      декларацията по чл. 55 и за проверимостта на данъка. -->
    <decimal name="taxableBase" title="Данъчна основа" precision="20" scale="2" default="0"/>

    <!-- Колона 12 — удържаните задължителни осигурителни вноски. -->
    <decimal name="insuranceAmount" title="Удържани ЗОВ (к. 12)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 13 — размерът на удържания данък. -->
    <decimal name="taxAmount" title="Удържан данък (к. 13)" precision="20" scale="2" default="0"/>

    <!-- Кой данък е удържан: авансов (чл. 43, 44 и 44а), окончателен (глава шеста) или никакъв.

      ⚠️ ОТДЕЛНО ПОЛЕ, А НЕ ИЗВОД ОТ taxAmount. Нула данък има ТРИ различни причини — необлагаем
      доход (шаблон F), доход по чл. 33, който платецът не облага (шаблон D), и облагаем доход, при
      който получателят е самоосигуряващо се лице и е декларирал по чл. 43 ал. 6, че ще внася сам.
      Трите се подават различно и се проверяват различно; слети в „taxAmount = 0“, стават
      неразличими. ⚠️ И нулата ТУК не е null: генерираният getter на decimal връща ZERO и за
      непопълнено поле, тоест „не е решено“ и „нула“ биха съвпаднали. -->
    <string name="taxKind" title="Вид данък" required="true"
      selection="bg.income.payment.tax.kind.select"/>

    <!-- Датата на ПРИДОБИВАНЕ на дохода по чл. 11 — тя определя в коя справка влиза редът.
      ⚠️ Едно изключение е изрично: указание т. 4 към ал. 1 слага дивидентите по чл. 38 ал. 1 в
      справката за годината, през която е взето РЕШЕНИЕТО за разпределяне — не на изплащането. -->
    <date name="paymentDate" title="Дата на изплащане" required="true"/>

    <!-- Периодът за чл. 55 (тримесечен) — справката по чл. 73 се групира по ГОДИНАТА на
      paymentDate, не по този период. -->
    <many-to-one name="period" title="Период" ref="com.axelor.apps.base.db.Period"/>

    <!-- ═══ ПРОИЗХОД ═══ Откъде е дошъл редът — за да е проследим до документа си.

      ⚠️ И ТОВА Е ИДЕМПОТЕНТНИЯТ КЛЮЧ, А НЕ САМО ЕТИКЕТ. Авто-захранването пише
      sourceRef във вида „<Модел>#<id>“ — „BgPaySlip#1234“, „InvoicePayment#88“ — и повторният
      прогон НАМИРА своя ред по него, вместо да създава втори. Виж BgIncomePaymentFeedService.

      ⚠️ РЪЧНИТЕ РЕДОВЕ НЯМАТ sourceRef И ТОВА ГИ ПРАВИ НЕДОСЕГАЕМИ. Захранването чете само редове с
      попълнена референция; ред, въведен от човек, не се обновява, не се трие и не се брои за чужд.
      Разграничението е на ДАННИТЕ, а не на флаг, който някой може да вдигне. -->
    <string name="source" title="Източник" required="true"
      selection="bg.income.payment.source.select"/>
    <string name="sourceRef" title="Документ (референция)"/>

    <!-- Код корекция: „0“ основни, „1“ коригиращи, „8“ заличаващи — указание т. 2 към ал. 1.
      При заличаване се попълват само колони 1, 2, 3, 4 или 5, 6, 7, 8 и 10. -->
    <string name="correctionCode" title="Код корекция" required="true" default="0"
      selection="bg.income.correction.code.select"/>

    <!-- ═══ ЕДИН ИЗХОДЕН ДОКУМЕНТ, ЕДИН КОД, ЕДИН РЕД ═══

      ⚠️ ЗАСТРАХОВКА СРЕЩУ ТИХИЯ ДУБЛИКАТ, А НЕ УДОБСТВО. Двата агрегатора СБИРАТ: справката по
      чл. 73 ал. 1 ключира по „лице + код@validFrom + код корекция“ (BgArt73Para1Aggregator#key), а
      декларацията по чл. 55 — по „тримесечие + вид данък“. Тоест втори ред за едно и също плащане
      НЕ изглежда като дубликат никъде — той просто удвоява колона 11 и колона 13 и минава за
      законен. Услугата пази същото правило при всеки прогон; това тук го пази и когато два прогона
      се засекат, и когато някой пише в базата отстрани.

      ⚠️ ВИДЪТ ДОХОД Е В КЛЮЧА, ЗАЩОТО ЕДИН ДОКУМЕНТ НОСИ ПОВЕЧЕ ОТ ЕДИН КОД. Едно плащане по
      фактура покрива редове с наем (401) и с услуга (3073) — два различни кода, тоест два реда на
      образеца, и двата законни. Ключ само по (source, sourceRef) би обявил втория за дубликат на
      първия.

      ⚠️ И РЪЧНИТЕ РЕДОВЕ НЕ СЕ БЛОКИРАТ, ЗАЩОТО NULL НЕ Е РАВЕН НА NULL. Postgres смята NULL
      стойностите за РАЗЛИЧНИ в уникален индекс (NULLS DISTINCT — подразбирането, включително след
      PG 15, където обратното иска изричното NULLS NOT DISTINCT). Ръчният ред няма sourceRef, тоест
      колкото и такива реда да има за едно лице и един код, индексът не ги сравнява помежду им.
      Проверено с BgIncomePaymentFeedSchemaDbTest, който чете pg_index. -->
    <unique-constraint columns="source,sourceRef,incomeType"/>

  </entity>

</domain-models>
