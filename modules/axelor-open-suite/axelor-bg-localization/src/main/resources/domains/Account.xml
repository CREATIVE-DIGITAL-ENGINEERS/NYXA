<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
    http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="account" package="com.axelor.apps.account.db"/>

  <!-- А/П ОСТА на сметката, слята в com.axelor.apps.account.db.Account.

    ⚠️ ОТВАРЯЩИЯТ ТАГ ПОВТАРЯ cacheable="true" ОТ ЯДРОТО. Генераторът слива двете декларации; изпусне
    ли се атрибутът, сливането може да свали кеширането на сметката — а тя се чете на всеки ред от
    всяка статия. Същото правило като при MoveLine (там се повтарят implements и strategy).

    ЗАЩО ОТДЕЛНО ПОЛЕ, А НЕ commonPosition. Изкушението е голямо: ядреното commonPosition е
    „None/Credit/Debit“ и изглежда като същата ос. НЕ Е. commonPosition е ЕРГОНОМИКА НА ВЪВЕЖДАНЕТО —
    help-ът му казва дословно, че предупреждава, когато ръчно въведена сума застане от необичайната
    страна. А/П е ПРИРОДАТА НА САЛДОТО: по коя част на баланса сметката носи остатъка си.

    Че са различни оси е ИЗМЕРЕНО, не предположено: върху заварените 186 сметки двете се разминават
    на 18 реда. Най-ясните:
      · 241 „Амортизация на ДМА“ — активна по раздел (коректив на актива), но се КРЕДИТИРА;
      · 1222 „Непокрита загуба от минали години“ — пасивна по раздел, но се ДЕБИТИРА;
    Слети в едно поле, всяко от тези две би излъгало или баланса, или предупреждението при въвеждане.

    ⚠️ ТРЕТАТА СТОЙНОСТ Е СЪЩЕСТВЕНА. Активно-пасивните разчети (напр. 422 „Подотчетни лица“) сменят
    страна според салдото си; commonPosition няма как да го изрази, защото „None“ там значи „не
    предупреждавай“, а не „и двете са редовни“.

    ⚠️ ПРАЗНО = РЕПОРТЕН ВЪЗЕЛ. Деветнайсетте буквени групи и шестте нови числови view възела нямат
    собствено салдо, тъй че нямат и А/П. Празнотата е значеща — не е непопълнено поле. -->
  <entity name="Account" cacheable="true">

    <string name="bgApSelect" title="А/П ос" selection="bg.account.ap.select"
      help="Природата на салдото по българската счетоводна традиция: активна (дебитно салдо),
        пасивна (кредитно) или активно-пасивна (и двете са редовни). Различава се от „Обичайна
        позиция“, която предупреждава при ръчно въвеждане от необичайната страна."/>

    <!-- G3b: подразбирането за кода 600/700 в SAF-T за всеки ред по тази сметка — напр. аналитична
      сметка „Представителни разходи“ → 600010. ⚠️ ПОЛЕ НА СМЕТКАТА, А НЕ РЕД В BgSafAccountMapping:
      там е кодът по НАП, еднакъв за всяка инсталация; тук е изборът на ПРЕДПРИЯТИЕТО за собствена
      сметка (BG_COA няма сметка за представителни разходи). Ръчният код на реда го бие. -->
    <string name="bgSaftTaxCode" title="Данък 600/700 по подразбиране (SAF-T)"
      selection="bg.saft.tax.code.select"
      help="Кодът за данък върху разходите (600) или при източника (700), който SAF-T слага на всеки ред по тази сметка, напр. 600010 за представителни разходи. Ръчният код на реда го бие."/>

  </entity>

</domain-models>
