<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ЕДНО ИЗМЕНЕНИЕ НА ПРАВООТНОШЕНИЕТО — отделен проследим запис, а не поле на договора.

    ═══ ЗАЩО ОТДЕЛНА ENTITY, А НЕ ПЛОСКИ ПОЛЕТА ═══

    EmploymentContract носи едно amendmentDate и го ПРЕЗАПИСВА при всеки нов анекс. DEC_ETZ62 иска
    ВСЯКО изменение подадено поотделно (тип на документа 2). Тоест при договор с три анекса договорът
    сам възпроизвежда само третия, а първите два са невъзстановими. Тук всеки анекс е ред и нищо не
    се затрива.

    ⚠️ И ЗАТОВА ЗАВАРЕНИТЕ ПОЛЕТА НА ДОГОВОРА ОСТАВАТ НЕПИПНАТИ. amendmentDate,
    amendmentTypeSelect и employmentContractVersion продължават да се пишат от upstream модула;
    тази таблица е ДОПЪЛНЕНИЕ, не замяна. Отпадането им е отделно решение, след като ЕТЗ тръгне.

    ═══ КЛЮЧЪТ Е (договор, дата, ОСНОВАНИЕ) — И ТОВА НЕ Е ПРОИЗВОЛЕН ИЗБОР ═══

    Приложение №1 към Заповед №З-ЦУ-30-1072/22.06.2026 г.: „Ключови полета при подаване на данни за
    ЕТЗ с цел коригиране или заличаване … са 1, 3, 4, 5, 6, 10, 12 и 16 (в случаите на подаване на
    записи с тип на документа 2)“. За фиксиран договор полета 4, 5, 6 и 10 са заковани, тоест
    остават ПОЛЕ 12 (основание) и ПОЛЕ 16 (дата на споразумението).

    ⚠️ ПОЛЕ 17 (changeNo) НЕ Е В КЛЮЧА, и включването му би било дефект в две посоки. Първо, то е
    задължително САМО при вид правоотношение 02 — за трудов договор остава NULL, а Postgres брои
    NULL-ите за различни, тоест ограничението НЕ БИ СРАБОТВАЛО точно в масовия случай. Второ, едно
    допълнително споразумение може да смени И заплатата (код 019), И работното време (код 020) —
    това са ДВА законни записа с еднаква дата, които ключ без Поле 12 би отхвърлил като дубликат.

    ═══ ЗАЩО НЕ Axelor <track> ═══

    Одитната следа е ТЕХНИЧЕСКА: знае „полето се смени на 12.06“, но не знае правното основание по
    номенклатурата — а точно то е реквизитът (Поле 12). Пише се при ВСЯКО записване, включително при
    поправка на печатна грешка, докато регистърът иска само измененията, които са анекс. И няма къде
    да виси NapSubmission, тоест не може да се каже кой анекс е подаден и кой не. -->
  <entity name="BgContractAmendment">

    <many-to-one name="employmentContract" title="Трудов договор" required="true"
      ref="com.axelor.apps.hr.db.EmploymentContract"/>

    <!-- Поле 16 — датата на сключване на допълнителното споразумение или на издаване на акта за
      изменение на служебното правоотношение. -->
    <date name="changeDate" title="Дата на споразумението/акта" required="true"/>

    <!-- Поле 16А. ⚠️ РАЗЛИЧНА ДАТА ОТ ГОРНАТА, и регистърът ги пита поотделно: споразумение,
      подписано на 1-ви и влизащо в сила от 1-ви следващ месец, носи две различни стойности.
      Задължителна е при тип на документа 2 — пазена от BgEtzMandatory, не от required тук, защото
      записът може да се въведе на части. -->
    <date name="entryDate" title="Дата на влизане в сила"/>

    <!-- Поле 17 — номер на акта за изменение. Задължително САМО при служебно правоотношение (вид
      02); за трудов договор остава празно. Виж защо НЕ е в ключа — в бележката на entity-то. -->
    <string name="changeNo" title="Номер на акта за изменение" max="200"/>

    <!-- Поле 12 — КОДИРАНОТО основание за изменението, по номенклатурата на Наредбата.

      ⚠️ ТОВА Е ПОЛЕТО, ЗАРАДИ КОЕТО amendmentTypeSelect НЕ ВЪРШИ РАБОТА. Upstream полето е цяло
      число от чужда селекция и не носи правно основание; регистърът иска код — при трудово
      правоотношение 018–021 (допълнително споразумение по чл. 119 ал. 1 КТ за възнаграждение,
      работно време, срок/длъжност/отпуск/място), при служебно — от списъка 100–128 по ЗДСл.

      ⚠️ И ЗАТОВА СЕЛЕКЦИЯТА НОСИ САМО КОДОВЕТЕ ЗА КТ. Кодовете за ЗДСл са 29 и се препокриват с
      тези за НАЗНАЧАВАНЕ — един списък на екрана би предложил „проведен конкурс“ като основание за
      изменение. Верността се сверява срещу BgEtzGrounds.isContractCode(код, вид правоотношение),
      който познава и двете таблици. -->
    <string name="bgChangeGround" title="Основание за изменението" required="true"
      selection="bg.etz.amendment.ground.select"
      help="Кодът по т. 12 от Наредбата. При служебно правоотношение се въвежда код от списъка 100–128 по ЗДСл, който не е в тази селекция."/>

    <!-- ═══ СЪСТОЯНИЕТО СЛЕД ИЗМЕНЕНИЕТО ═══

      ⚠️ СНИМКА, А НЕ ПРЕПРАТКА КЪМ ДОГОВОРА, и това е съзнателна размяна. При тип на документа 2
      Приложение №1 иска полета 18, 19/20, 21, 22, 23, 23А и 24 попълнени — тоест състоянието СЛЕД
      изменението. Договорът носи само ПОСЛЕДНОТО състояние: за исторически анекс (или при повторно
      подаване след заличаване с код корекция 2) той вече не знае какви са били стойностите тогава.
      Цената са дублирани колони; печалбата е, че вторият анекс не лъже за първия. -->
    <decimal name="newSalary" title="Ново основно възнаграждение" precision="20" scale="2"/>
    <many-to-one name="newNkpd" title="Нов код по НКПД"
      ref="com.axelor.apps.bglocalization.db.BgNkpd"/>
    <string name="newWorkplaceEkatte" title="Нов код по ЕКАТТЕ (място на работа)" max="5"/>
    <integer name="newHoursCode" title="Код за работно време"/>
    <integer name="newWorkingHours" title="Продължителност на работното време"/>
    <date name="newTermDate" title="Нов срок на договора"/>
    <decimal name="newVacationDays" title="Нов платен годишен отпуск (дни)" precision="5"
      scale="2"/>

    <!-- Кой ЕТЗ е подаден за този анекс. ⚠️ Без това поле подаването виси на договора, тоест два анекса сочат един запис и се различават само по дата. -->
    <many-to-one name="napSubmission" title="Подаване към НАП"
      ref="com.axelor.apps.napsubmissions.db.NapSubmission"/>

    <!-- ⚠️ ОГЛЕДАЛО НА КЛЮЧОВИТЕ ПОЛЕТА НА РЕГИСТЪРА — виж бележката на entity-то.
      Две основания на една дата са ДВА законни записа; един и същ код на една дата е дубликат. -->
    <unique-constraint columns="employmentContract,changeDate,bgChangeGround"/>

  </entity>

</domain-models>
