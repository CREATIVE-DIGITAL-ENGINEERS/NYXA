<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- ═══ ЕДИН РЕД ОТ Т. 8 НА ЧАСТ ІІ — едно лице, един код на дохода ═══

    Част ІІ се попълва за всяко лице поотделно; т. 8 вътре в нея е таблица с ред на код. Тук двете
    нива са СПЛЕСНАТИ в един запис: идентификацията (т. 1–7) стои на всеки ред.

    ⚠️ СПЛЕСНАТО НАРОЧНО, И ЦЕНАТА МУ Е ЗАПИСАНА. Изходът е ПЛОСЪК файл по заповед на изпълнителния
    директор на НАП — както Д1, така и тази справка. Второ ниво (лице → редове) би поискало
    сглобяване при всяко четене и разглобяване при всяко записване, без да пази нищо: указание т. 6
    изрично допуска НЯКОЛКО реда с един и същ код за едно лице, когато доходът идва от различни
    работодатели, тоест „ред на лице и код“ и без това не е уникален. Цената е, че имената се
    повтарят на всеки ред; пазачът срещу разминаването им е строителят, който ги пише на едно място.

    ⚠️ И ЕДНО, КОЕТО ТОЗИ ЗАПИС НАРОЧНО НЕ НОСИ: КОЛОНИ 6 И 8–22. Те идват от годишното
    преизчисляване по чл. 49, каквото модулът няма — виж BgArt73Para6Aggregator. Колона, която
    съществува и стои на нула, е неразличима от „лицето няма облекчения“; липсващата колона поне
    не лъже. Добавят се заедно с преизчисляването, не преди него. -->
  <entity name="BgArt73Para6Record">

    <many-to-one name="report" title="Справка" required="true"
      ref="com.axelor.apps.bglocalization.db.BgArt73Para6Report"/>

    <!-- ═══ ЧАСТ ІІ, Т. 1–7 — ИДЕНТИФИКАЦИЯ ═══ -->

    <!-- Т. 1. Указание т. 3: „0“ основни, „1“ коригиращи, „8“ заличаващи.
      ⚠️ При ЗАЛИЧАВАНЕ се попълват САМО точки 1, 2, 3, 4, 5 и 6 — тоест ред с код 8 носи имената и
      идентификатора, но НИТО ЕДНА сума. Нулите там не са „нулев доход“, а „не се попълва“. -->
    <string name="correctionCode" title="Код корекция (т. 1)" required="true" default="0"
      selection="bg.income.correction.code.select"/>

    <many-to-one name="employee" title="Лице" ref="com.axelor.apps.hr.db.Employee"/>

    <string name="firstName" title="Собствено име (т. 2)"/>
    <string name="middleName" title="Презиме (т. 3)"/>
    <string name="lastName" title="Фамилно име (т. 4)"/>

    <!-- Т. 5. Указание т. 4 към ал. 6: „0“ за лице с ЕГН, „1“ за ЛН, ЛНЧ или Сл. № от регистъра.
      ⚠️ САМО ДВЕ СТОЙНОСТИ — справката по ал. 1 познава четири (има и БУЛСТАТ, и чуждестранно лице
      без идентификатор). Затова изборът е СВОЙ, а не споделен с регистъра: споделен, той би
      предложил стойност, която този образец не приема. -->
    <string name="identifierType" title="Тип идентификатор (т. 5)"
      selection="bg.art73.identifier.type.select"/>

    <string name="identifier" title="ЕГН/ЛН/ЛНЧ/Сл. № (т. 6)"/>

    <!-- Т. 7. Указание т. 5: попълва се, когато информацията се подава от работодател по ОСНОВНО
      трудово правоотношение към 31 декември на данъчната година.

      ⚠️ ТОВА НЕ Е КОЗМЕТИКА — ТО РЕШАВА КОИ КОЛОНИ СЕ ПЪЛНЯТ ИЗОБЩО. Указание т. 7: колона 6 на
      редове 8.1–8.3, колони 11–14 и колони 17–21 се попълват САМО от работодателя по основното
      трудово правоотношение. Той е и този, който прави годишното изравняване по чл. 49 и включва
      дохода от другия работодател по служебна бележка по чл. 45 ал. 1 (образец № 1). -->
    <boolean name="isMainEmployer" title="Работодател по основно ТПО към 31 декември (т. 7)"
      default="false"/>

    <!-- ═══ Т. 8 — ЕДИН РЕД ═══ -->

    <!-- Колона 1 — кодът по номенклатурата: 101, 102, 103 или 104–111. -->
    <many-to-one name="incomeType" title="Код на дохода (к. 1)" required="true"
      ref="com.axelor.apps.bglocalization.db.BgIncomeType"/>

    <!-- Колони 2.1 и 2.2 — работодателят, ИЗПЛАТИЛ дохода. Различен от подателя, когато доходът е
      придобит при друг работодател и е включен по служебна бележка по чл. 45 ал. 1 (указание т. 6);
      тогава данните за другия работодател се попълват на ОТДЕЛЕН ред за съответния код. -->
    <string name="payerIdentifier" title="ЕИК/Сл. № на платеца (к. 2.1)"/>
    <string name="payerName" title="Наименование/име на платеца (к. 2.2)"/>

    <!-- Колона 3 — облагаемият доход от този код, изплатен през годината.
      ⚠️ За кодове 104–111 това е ЕДИНСТВЕНАТА сума на реда: указание т. 7, последно тире —
      „данни за доходите с код от 104 до 111 включително се попълват само в колони 2.1, 2.2, 3 и 23“. -->
    <decimal name="income" title="Доход (к. 3)" precision="20" scale="2" default="0"/>

    <!-- Колона 4 — ЗОВ за сметка на лицето, удържани и/или внесени от работодателя по реда на КСО и
      ЗЗО, или авансово внесени чрез дружеството на самоосигуряващо се лице. -->
    <decimal name="insurance" title="Задължителни осигурителни вноски (к. 4)" precision="20"
      scale="2" default="0"/>

    <!-- Колона 5 — ЗОВ за сметка на лицето, ВНЕСЕНИ В ЧУЖБИНА.
      ⚠️ Полето съществува, защото чл. 25 ал. 1 брои и него в годишната основа, но НИКОЙ ред в
      модула не го пълни: числото идва от документ на чуждестранна осигурителна институция, не от
      фиш. Вход за него е Фаза 2. -->
    <decimal name="insuranceAbroad" title="Внесени в чужбина (к. 5)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 7 — удържаният авансово данък по реда на чл. 42 ЗДДФЛ за дохода в колона 3. -->
    <decimal name="advanceTax" title="Авансов данък по чл. 42 (к. 7)" precision="20" scale="2"
      default="0"/>

    <!-- Колона 23 — ЕИК на ПРЕОБРАЗУВАЩОТО СЕ предприятие, когато справката се подава от
      правоприемник (указание т. 1). Пълни се и за редовете с кодове 104–111. -->
    <string name="predecessorIdentifier" title="ЕИК на преобразуващото се предприятие (к. 23)"/>

  </entity>

</domain-models>
