  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Речник на редовете, които могат да се появят на фиша. РЕФЕРЕНТНИ ДАННИ.

    ⚠️ ТИП РЕД НА ФИША, НЕ ВХОДНА ПРОМЕНЛИВА. Тестът за принадлежност е един: ако нещо се ВЪВЕЖДА от
    ТРЗ-специалиста преди изчислението, то не е ред на фиша. Ако се ПОЯВЯВА след изчислението със
    сума в евро, е.

    ЗАЩО СЕ КАЗВА ИЗРИЧНО. Речникът на Microinvest ТРЗ и ЛС Pro смесва вход и изход в едно
    пространство от имена: „Бройки изработка“ (количество) и „Възнаграждение за бройка изработка“
    (ставка) са съседни редове, а редът на фиша — тяхното произведение — изобщо го няма в списъка.
    Различават се само по префикс в името: „Дни …“, „Часове …“, „Сума за …“, „Ставка процент …“.
    Оттам следва, че списъкът не може да се ползва нито за печат, нито за проверка: не се знае кое
    от него изобщо стига до фиша. Часовете, дните, количествата и ставките са ВХОД и живеят другаде.

    НОМЕРАЦИЯТА Е НАША, групирана, и нарочно с дупки за растеж. НЕ следва модела на OmegaTIM, при
    който разграничителят живее в номера на перото и оттам излизат ~500 пера с дубликати.
      1xx заплата и добавки · 2xx социални разходи · 3xx болнични и отпуски · 4xx свободна
      5xx осигуровки · 6xx плащания · 7xx данък · 8xx удръжки · 9xx обезщетения

    ⚠️ 2xx Е ЗАСЕТА. Двайсет и пет
    реда: единайсет БУЛЕВИ (облекло, безплатна храна, задължителни застраховки, помощи за лечение,
    транспорт, „в натура“) и четиринайсет ПОД КАПАЧКА — по ДВА на позиция, „в рамките на капачката“
    и „превишение“, сочещи към общата си BgSocialExpenseCap.

    ⚠️ 3xx ОСТАВА ДЕКЛАРИРАНА И ПРАЗНА, И ТОВА Е РЕШЕНИЕ, НЕ ПРОПУСК. Виж
    началните данни — там стои кое липсва и защо. -->
  <entity name="BgPaySlipLineType" cacheable="true">

    <string name="code" title="Код" required="true" unique="true"
      help="Напр. pl_tspo. Стабилен ключ — по него сочат изчислението и справките."/>
    <!-- Номерът от схемата. unique е нарочно: два реда с един номер значат, че някой е решил да напъха
      ново перо в заета позиция, вместо да ползва дупките между групите. ⚠️ column="line_number" НЕ Е СТИЛ.
      Генераторът на Axelor отказва да построи ентитета с колона на име number — „Invalid use of an SQL keyword:
      number“ — и билдът пада, преди да е стигнал до компилация. Полето в Java остава number, както го иска
      спецификацията; сменя се само името на колоната. Оттам следва, че ВСЯКА ръчна заявка към тази таблица
      пише line_number, а не number: тестовете тук вече го правят. -->
    <integer name="number" column="line_number" title="Номер" required="true" unique="true"/>
    <string name="name" title="Наименование" required="true" namecolumn="true"/>

    <string name="bgGroup" title="Група" selection="bg.payslip.line.group.select"/>

    <!-- ЗНАКЪТ Е НА ТИПА, НЕ НА СУМАТА. Фишът има редове и в двете посоки: удръжките по чл. 221 ал.
      2 КТ се виждат на него. Сума с отрицателен знак би значела, че знакът може да
      се сбърка при въвеждане — при знак на типа не може. -->
    <string name="bgSign" title="Посока" selection="bg.payslip.line.sign.select"/>

    <!-- ПОСТОЯНЕН ХАРАКТЕР ПО НСОРЗ ЧЛ. 15. Критерият по чл. 15: постоянни са тези по чл. 11 и чл. 12
      от наредбата, както и тези, които се плащат постоянно заедно с основното възнаграждение и зависят
      ЕДИНСТВЕНО от отработеното време.

      ⚠️ ФЛАГЪТ ОТГОВАРЯ НА ЧЛ. 15, А НЕ НА ЧЛ. 17. Перата с постоянен характер „влизат в базата за
      платения отпуск“ — вярно, но НЕПЪЛНО, и не е определение на базата. Чл. 17 ал. 1 изброява СЕДЕМ съставки, а постоянният
      характер е само т. 3; т. 5–7 (чл. 266 ал. 1, чл. 267 ал. 1 и 3, чл. 268 ал. 2 и 3) са в базата
      БЕЗ да са постоянни. Прочетен като „това е базата по чл. 17“, флагът би оставил престоя извън
      среднодневното — виж bgIsArt17Base отдолу.

      ⚠️ И ГЛАВНИЯТ МУ ЧИТАТЕЛ Е ДРУГ: базата по НСОРЗ ЧЛ. 7 — часовата ставка на нощния и извънредния
      труд (BgEarningsService#permanentAllowances → BgEarningsResolver#permanentPayBase). Точно затова
      престоят НЕ бива да получи този флаг: вдигнат, той щеше да премести пари в съвсем друго перо. -->
    <boolean name="bgIsPermanentCharacter" title="Постоянен характер (НСОРЗ чл. 15)"
      default="false"/>

    <!-- ═══ ВЛИЗА ЛИ ПЕРОТО В БРУТНАТА РАБОТНА ЗАПЛАТА — НСОРЗ ЧЛ. 16 АЛ. 2 ═══

      Т. 29 на Декларация обр. 1 иска „сумата на брутното трудово възнаграждение, определено съгласно
      Кодекса на труда, Наредбата за структурата и организацията на работната заплата … колективен
      трудов договор и други нормативни актове“. НСОРЗ чл. 16 ал. 2 изброява СЕДЕМ съставки дословно:
      основната работна заплата; възнаграждението над нея по прилаганите системи за заплащане; ДТВ по
      наредбата и по чл. 259 КТ; чл. 266 ал. 1; чл. 267 ал. 1 и 3; чл. 268 ал. 2 и 3; платеният
      годишен отпуск.

      ⚠️ НОВ ФЛАГ, А НЕ ПРЕИЗПОЛЗВАН — И ТОВА Е СЪЩЕСТВЕНОТО РЕШЕНИЕ. Трите флага изглеждат
      взаимозаменяеми и отговарят на ТРИ РАЗЛИЧНИ норми:
      • bgIsPermanentCharacter → НСОРЗ ЧЛ. 15 (определението за постоянен характер). Главният му
        читател е базата по ЧЛ. 7 — часовата ставка на нощния и извънредния труд;
      • bgIsArt17Base → НСОРЗ ЧЛ. 17 АЛ. 1 — базата за платен отпуск по чл. 177 и за обезщетенията
        по чл. 228 КТ. Постоянният характер е само т. 3 от седемте ѝ съставки;
      • този флаг → НСОРЗ ЧЛ. 16 АЛ. 2 — базата на БРЗ, най-ШИРОКАТА от трите: тя включва и нощния
        труд, и извънредния, и (т. 7) самото възнаграждение за платен отпуск, което чл. 17 не включва.
      Тоест ЕДНОКРАТНИЯТ бонус влиза в т. 29 и НЕ влиза в базата за отпуск. Преизползван, флагът щеше
      да свали еднократните възнаграждения от т. 29 — правдоподобно по-малко число на верния ред.

      ⚠️ И ЗАЩО НЕ СЕ ИЗВЕЖДА ОТ ГРУПАТА. Групата 1xx НЕ съвпада с чл. 16 ал. 2: перото 195 (болничен
      от осигурител по чл. 40 ал. 5 КСО) е в 1xx и НЕ е работна заплата, а перото 175 (компенсация по
      чл. 138а КТ) е компенсация, не възнаграждение. Обратно, bgGrossTotal включва цялата група 9xx
      (обезщетенията) и затова НЕ е т. 29.

      ⚠️ БЕЗ default НА ИСТИНА. Ново перо влиза в декларацията САМО когато някой е казал, че влиза —
      подразбирането „да“ би вкарало всяко бъдещо перо в т. 29 мълчаливо. -->
    <boolean name="bgFormsGrossWage" title="Формира БРЗ (НСОРЗ чл. 16 ал. 2)" default="false"
      help="Влиза ли перото в брутната работна заплата по т. 29. ⚠️ НЕ е същото нито като „Постоянен характер“ (НСОРЗ чл. 15), нито като „В базата за платен отпуск“ (чл. 17 ал. 1) — трите са различни норми и различни множества."/>

    <!-- ═══ В БАЗАТА ЗА ПЛАТЕН ОТПУСК И ОБЕЗЩЕТЕНИЯ — НСОРЗ ЧЛ. 17 АЛ. 1 ═══

      ЦИТАТ, чл. 17 ал. 1: „В брутното трудово възнаграждение за определяне на възнаграждението за
      платен годишен отпуск по чл. 177 ИЛИ на обезщетенията по чл. 228 от Кодекса на труда се
      включват: 1. основната работна заплата за отработеното време; 2. възнаграждението над основната
      работна заплата, определено според прилаганите системи за заплащане на труда; 3. допълнителните
      трудови възнаграждения … които имат ПОСТОЯНЕН ХАРАКТЕР; 4. … при вътрешно заместване по чл. 259
      …; 5. възнаграждението по реда на чл. 266, ал. 1 …; 6. възнаграждението, заплатено при престой
      или поради производствена необходимост, по чл. 267, ал. 1 и 3 …; 7. възнаграждението по реда на
      чл. 268, ал. 2 и 3 от Кодекса на труда.“

      ⚠️ ТРЕТИ ФЛАГ, И ТРИТЕ СА РАЗЛИЧНИ МНОЖЕСТВА — измерено, не преценено. В речника днес:
      bgIsPermanentCharacter е true за 5 от 19-те пера в 1xx, bgFormsGrossWage — за 17. Чл. 16 ал. 2
      (БРЗ) е СТРОГО ПО-ШИРОК от чл. 17: той включва и нощния труд, и извънредния, и работата на
      празник, и — т. 7 — САМОТО възнаграждение за платен отпуск, което чл. 17 не включва. Тоест нито
      един от двата заварени флага не може да отговори на този въпрос, колкото и да си приличат.

      ⚠️ КАКВО ПРАВИ ТОЙ, КОЕТО bgIsPermanentCharacter НЕ ПРАВИ: вкарва в среднодневното по чл. 177 и
      онези пера, които СА в базата, но НЕ са постоянни — днес ДВЕ: престоят (170, т. 6) и
      възнаграждението за постигнати резултати (190, т. 2). Без него месец с престой дава ЗАНИЖЕНО
      среднодневно: при престой 210,00 € и 5 дни отпуск отпускът излиза с 47,73 € по-малко.

      ⚠️ И ДВЕТЕ ТОЧКИ СЕ ИЗПУСКАТ ПО ЕДНА И СЪЩА ГРЕШКА, затова се пише тук. Перо 190 носи бележка,
      че НЯМА постоянен характер („зависи от резултат, не единствено от отработеното време“) — а това
      отговаря на т. 3, не на т. 2. Т. 2 иска нещо друго: „възнаграждението НАД ОСНОВНАТА работна
      заплата, определено според прилаганите СИСТЕМИ за заплащане на труда“. Отричането на едната
      точка НЕ е отричане на другата. ⚠️ Дискреционното перо е 185 (еднократен бонус) и то си остава
      вън — разликата е СИСТЕМА срещу преценка, а не „редовно“ срещу „еднократно“.

      ⚠️ ЧЕТЕ ГО САМО BgArt177LeaveService#art17BaseOf. Часовата ставка по чл. 7 минава по ДРУГ път
      (permanentAllowances → permanentPayBase) и не вижда тази колона — затова престоят влиза в
      отпуска, без да поскъпи извънредния труд.

      ⚠️ БЕЗ default НА ИСТИНА, по същия довод като съседа: ново перо влиза в базата за отпуск САМО
      когато някой е казал, че влиза. И НАДМНОЖЕСТВО на постоянните: всеки ред с постоянен характер Е
      в базата (т. 3), тоест perm = true ⟹ bgIsArt17Base = true. Инвариантът се пази от
      BgPaySlipLineTypeSeedMappingTest, а не от паметта на следващия редактор. -->
    <boolean name="bgIsArt17Base" title="В базата за платен отпуск (НСОРЗ чл. 17 ал. 1)"
      default="false"
      help="Влиза ли перото в брутното трудово възнаграждение, от което се смята възнаграждението за платен отпуск по КТ чл. 177 и обезщетенията по чл. 228. ⚠️ НЕ е същото като „Постоянен характер“: т. 2 (възнаграждение по система за заплащане) и т. 5–7 (престой по чл. 267, чл. 266 ал. 1, брак по чл. 268) са в базата, без да са постоянни. Всяко постоянно перо обаче Е в базата."/>

    <boolean name="bgIsTaxable" title="Облагаем по ЗДДФЛ" default="true"/>
    <boolean name="bgIsInsuranceIncome" title="Осигурителен доход" default="true"/>

    <string name="bgCalculationBase" title="Начин на изчисление"
      selection="bg.payslip.calculation.base.select"/>
    <string name="bgLegalBasis" title="Правно основание"
      help="Напр. „чл. 262 ал. 1 т. 1 КТ“."/>

    <!-- ДВЕ ПРЕПРАТКИ КЪМ ГОТОВИ РЕЧНИЦИ, за да не се преписват. Група 9xx сочи към каталога на обезщетенията
      (25 реда), група 5xx — към речника на фондовете (10 реда). И двете групи са ГЕНЕРИРАНИ от тези каталози,
      а BgPaySlipLineTypeCatalogueTest пази съответствието едно към едно: добавен фонд или вид обезщетение
      без ред на фиша се обажда, вместо да липсва тихо. -->
    <many-to-one name="bgCompensationType" title="Вид обезщетение"
      ref="com.axelor.apps.bglocalization.db.BgCompensationType"/>
    <many-to-one name="bgContributionFund" title="Осигурителен фонд"
      ref="com.axelor.apps.bglocalization.db.BgContributionFund"/>

    <!-- ТРЕТАТА ПРЕПРАТКА — КАПАЧКАТА НА СОЦИАЛНИЯ РАЗХОД, и я носят САМО редовете от 2xx.
      Nullable нарочно: 1xx, 5xx, 6xx, 7xx, 8xx и 9xx нямат капачка, а и вътре в 2xx част от редовете
      са БУЛЕВИ (работно облекло, безплатна храна по КТ чл. 285, задължителни застраховки) — за тях
      праг НЯМА, има признак.

      ⚠️ ПРЕПРАТКАТА Е КЪМ ГРУПАТА, НЕ КЪМ РЕДА, и точно затова е m2o, а не поле със сума. Шест реда
      сочат към DDO_HEALTH_LIFE (три позиции × „в рамките“/„превишение“) и делят ЕДНА капачка от
      30,68 EUR — ЗКПО чл. 213 ал. 2 дава основата като „превишението на ТЕЗИ РАЗХОДИ над 60 лв.“, а
      не превишение на всеки поотделно. Сума на реда щеше да даде на трите по 30,68, тоест тройно
      облекчение, при което всеки ред поотделно изглежда верен.

      ⚠️ И ТУК НЯМА ПОВЕДЕНИЕ. Кой ред е „в рамките“ и кой „превишение“ казва bgIsCapExcess отдолу,
      НЕ bgIsTaxable; разпределението на превишението между позициите е на BgSocialExpenseCapResolver. -->
    <many-to-one name="bgSocialExpenseCap" title="Капачка на социалния разход"
      ref="com.axelor.apps.bglocalization.db.BgSocialExpenseCap"/>

    <!-- ⚠️ РЕДЪТ „ПРЕВИШЕНИЕ НАД КАПАЧКАТА“ — изходът на BgSocialExpenseCapResolver, не вход.
      Вдигнат е САМО на редовете под капачка, които носят остатъка над нея (201, 203, 205, 211, 221,
      223, 225); редът „в рамките“ (200, 202, …) е входът и носи ЦЯЛОТО начислено.

      ⚠️ ОТДЕЛЕН ПРИЗНАК, А НЕ bgIsTaxable. Двата въпроса са различни: „облагаем ли е редът за лицето“
      е въпрос на ЗДДФЛ, „вход или изход на капачката“ — на устройството. Слети, те не позволяват
      превишението по ЗКПО чл. 213 ал. 2 да е НЕОБЛАГАЕМО за лицето (ЗДДФЛ чл. 24 ал. 2 т. 9 —
      „социалните разходи … обложени по реда на ЗКПО“): свален bgIsTaxable би вкарал реда като вход
      и основата по ЗКПО би се удвоила. Така 201/203/205 са необлагаеми И превишение едновременно.

      Чете го BgSocialExpenseService (кой ред се подава на резолвера и кой ред изчерпва годишната
      капачка). Инвариантът „DERIVED 2xx ⟺ bgIsCapExcess“ се пази от BgSocialExpenseSeedFileTest. -->
    <boolean name="bgIsCapExcess" title="Превишение над капачката" default="false"
      help="Редът носи остатъка над капачката на социалния разход и се смята от системата — не се въвежда ръчно. Входът е съседният ред „в рамките на капачката“, на който се въвежда цялото начислено."/>

    <!-- ⚠️ ВЛИЗА ЛИ ЦЕЛИЯТ РАЗМЕР В МЕСЕЧНАТА ЗКПО ОСНОВА — за редовете от 2xx БЕЗ капачка.
      Отделен признак от капачката, защото отговаря на друг въпрос: капачката казва „до тук е
      освободено“, а този флаг — „праг НЯМА, целият разход е данъчна основа“.

      Днес е вдигнат на ДВА реда, и на двата по изричен текст:
        · 261 транспорт с лек автомобил или по допълнителни автобусни линии — ЗКПО чл. 210 ал. 2:
          „Алинея 1 НЕ СЕ ПРИЛАГА, когато транспортът е осъществен с лек автомобил или по
          допълнителни автобусни линии.“ Освобождаването отпада напълно, праг не се дава;
        · 270 социален разход в натура, обложен по ЗКПО — самото име на реда е квалификацията: той
          съществува, за да поеме придобивките в натура, за които ЗКПО не дава освобождаваща норма.

      ⚠️ И ЗАТОВА ОСТАВА СВАЛЕН НА ОСТАЛИТЕ ДЕВЕТ БУЛЕВИ РЕДА, А НЕ „ЗАСЕГА“. Облеклото по КТ чл. 296,
      безплатната храна по КТ чл. 285 и задължителните застраховки не са социални придобивки по чл. 294
      КТ — те са задължения на работодателя по друга норма, тоест изобщо не са обект по чл. 204 ал. 1
      т. 2. Помощта за лечение и всяка друга придобивка, за която ЗКПО не дава освобождаване, минава
      през ред 270 — там квалификацията по § 1 т. 34 ДР ЗКПО е взета от човека, който въвежда сумата,
      и е ВИДИМА на фиша като избор на перо. Флаг, вдигнат „за всеки случай“ на облеклото, щеше да
      обложи с данък върху разходите нещо, което не е социален разход. -->
    <boolean name="bgIsCompanyExpenseTaxed" title="Целият размер в месечната ЗКПО основа"
      default="false"
      help="Само за 2xx редове БЕЗ капачка, за които ЗКПО не дава освобождаване (напр. чл. 210 ал. 2). Редовете под капачка се смятат от BgSocialExpenseCapResolver и НЕ ползват този флаг."/>

    <integer name="sequence" title="Пореден №"/>

    <!-- Празни за целия начален набор, и това е нарочно: ПЕРИОДЪТ Е НА СТОЙНОСТТА, НЕ НА ТИПА РЕД. Възнаграждението
      за научна степен сменя размера си от 01.01.2026, но самият ред на фиша не се създава и не се закрива.
      Полетата стоят за деня, в който закон отмени цял вид ред — тогава закритият остава видим за минали периоди,
      вместо да се трие. -->
    <date name="validFrom" title="В сила от"/>
    <date name="validTo" title="В сила до"/>

    <!-- large=true, тоест TEXT, а не varchar(255) — както при BgCompensationType.note и по същата причина:
      App Install отхвърля ЦЕЛИЯ ред с „value too long“, а не отрязва текста. Тук стоят правното основание,
      спорните места и кое е решено от кого. -->
    <string name="note" title="Бележка" large="true"/>
    <boolean name="active" title="Активен" default="true"/>

  </entity>

</domain-models>
