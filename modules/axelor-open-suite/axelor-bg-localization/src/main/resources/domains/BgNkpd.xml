<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="bg-localization" package="com.axelor.apps.bglocalization.db"/>

  <!-- Национална класификация на професиите и длъжностите (НКПД). -->
  <entity name="BgNkpd">

    <string name="code" title="Код по НКПД" required="true" unique="true" max="8"/>
    <string name="name" title="Наименование" required="true"/>
    <integer name="qualificationGroup" title="Квалификационна група" min="0" max="9"/>

    <!-- Computed display name: "code — name" (напр. "24115004 — Счетоводител"). Ползва се като namecolumn
      и за автокомплийт по код и наименование. -->
    <string name="fullName" title="Код по НКПД" namecolumn="true" search="code,name"
      depends="code,name">
      <![CDATA[
      return code + " — " + name;
      ]]>
    </string>

  </entity>

</domain-models>
