<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <!-- Bulgarian localization fields added to the standard Country entity. Merged into
    com.axelor.apps.base.db.Country by the code generator. -->
  <entity name="Country">
    <!-- Английското име на държавата. `name` е българското (apps/init-data/bg_country.csv),
      а английското живее тук, за да не се губи: за печат на чужд език по-късно и за да съвпада с вече
      записаните адреси (formattedFullName носи името, каквото е било). Кодът НЕ търси държава по име —
      само по alpha2Code. -->
    <string name="bgNameEn" title="Име на английски"/>
  </entity>

</domain-models>
