        </xsd:restriction>
        <!-- двуцифрен или едноцифрен код -->
    </xsd:simpleType>
	<xsd:simpleType name="CodeType4">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="\d{4}"/>
		</xsd:restriction>
